# Local developer-only example.
# Safe to copy to `.env` for workstation defaults.
# Do not store long-lived secrets, signing keys, production DSNs, or CI tokens here.

POLISYOS_EXECUTION_PROFILE=dev
POLISYOS_CONTROL_WORKER_BACKEND=embedded
POLISYOS_CONTROL_STATE_STORE_BACKEND=sqlite
POLISYOS_CONTROL_SQLITE_PATH=.polisyos/control_plane.sqlite3

POLISYOS_CAS_BACKEND=filesystem
POLISYOS_CAS_ROOT=.polisyos/cas

LOG_LEVEL=INFO
DUCKDB_MEMORY_LIMIT=4GB
DUCKDB_THREADS=4

POLISYOS_OTEL_CONSOLE_EXPORT=false
POLISYOS_TRACE_SAMPLING_RATIO=1.0
