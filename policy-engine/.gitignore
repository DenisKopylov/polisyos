# Application logs
logs/

# Test runs (keep local, do not commit)
runs/

.polisyos/

# Benchmark outputs
benchmarks/_reports/
benchmark-results/

# Temporary directories
.tmp/
.arch-freeze/

# Frontend build artifacts
frontend/runtime-dashboard/node_modules/
frontend/runtime-dashboard/dist/

# Local metrics (do not commit)
test_collect.txt
compileall.txt
ruff_stats.txt
stale_sources_missing_paths.txt

# Accidental shell redirection artifacts like `pip install foo>=1.2`
/=*

# Documentation (auto-generated or working docs)
docs/*
