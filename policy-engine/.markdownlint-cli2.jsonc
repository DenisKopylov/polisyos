{
  "config": {
    "default": true,
    "MD013": false,
    "MD024": {
      "siblings_only": true
    },
    "MD025": {
      "front_matter_title": ""
    },
    "MD033": false,
    "MD041": false
  },
  "globs": [
    "*.md",
    "docs/**/*.md",
    "**/README.md",
    "**/CONTRIBUTING.md"
  ],
  "ignores": [
    ".venv/**",
    ".venv_codex/**",
    ".pytest_cache/**",
    ".mypy_cache/**",
    ".ruff_cache/**",
    "**/node_modules/**",
    "benchmarks/**/*.md",
    "docs/archive/**",
    "site/**",
    "storybook-static/**",
    "tools/research/**/*.md"
  ]
}
