extends: default

ignore: |
  .venv/
  .venv_codex/
  .pytest_cache/
  .mypy_cache/
  .ruff_cache/
  apps/runtime-dashboard/node_modules/
  docs/archive/
  ops/cloud/helm/*/templates/
  ops/cloud/helm/*/tests/
  policy-engine/ops/cloud/helm/*/templates/
  policy-engine/ops/cloud/helm/*/tests/
  data/raw/
  benchmark-results/
  coverage/
  dist/
  site/
  storybook-static/

rules:
  comments-indentation: disable
  document-start: disable
  line-length: disable
  truthy:
    check-keys: false
