{
  "name": "@polisyos/runtime-dashboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "vite",
    "dev:mock": "VITE_USE_MOCKS=true vite",
    "build": "corepack pnpm run typecheck && vite build && node ./scripts/postbuild-security.mjs && node ./scripts/check-atlas-ui-tailwind-source.mjs",
    "preview": "vite preview",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build --output-dir ../../_build/apps/runtime-dashboard/storybook-static",
    "test:storybook": "vitest run --config vitest.storybook.config.ts",
    "test": "corepack pnpm run test:components",
    "test:components": "vitest run",
    "test:components:watch": "vitest",
    "test:contracts": "vitest run src/test/contracts/contractFixtures.test.ts",
    "test:glyph-vocabulary": "node ./scripts/check-glyph-vocabulary.mjs",
    "test:watch": "corepack pnpm run test:components:watch",
    "test:coverage": "vitest run --coverage --maxWorkers=1 --testTimeout=20000 --hookTimeout=20000 && node ./scripts/check-coverage-ratchet.mjs",
    "test:a11y": "corepack pnpm run a11y:contrast && corepack pnpm run a11y:motion && corepack pnpm run a11y:color-blind && corepack pnpm run test:a11y:components && corepack pnpm run test:a11y:pages",
    "test:components:a11y": "vitest run --config vitest.a11y.config.ts",
    "test:a11y:components": "vitest run --config vitest.a11y.config.ts",
    "test:a11y:pages": "playwright test e2e/a11y --project=chromium",
    "a11y:contrast": "node --experimental-strip-types ../../tools/design/check-contrast.ts",
    "a11y:contrast:write": "node --experimental-strip-types ../../tools/design/check-contrast.ts --write",
    "a11y:motion": "node --experimental-strip-types ../../tools/design/check-reduced-motion.ts",
    "a11y:color-blind": "node --experimental-strip-types ../../tools/design/check-color-blind.ts",
    "design:polish": "corepack pnpm run design:atlas-v4 && corepack pnpm run design:palettes && corepack pnpm run design:motion && corepack pnpm run design:print && corepack pnpm run design:composition && corepack pnpm run design:bureaucratic",
    "design:atlas-v4": "node --experimental-strip-types ../../tools/design/check-atlas-v4-token-drift.ts",
    "design:palettes": "node --experimental-strip-types ../../tools/design/check-categorical-palettes.ts",
    "design:motion": "node --experimental-strip-types ../../tools/design/check-motion-tokens.ts",
    "design:print": "node --experimental-strip-types ../../tools/design/check-print-snapshots.ts",
    "design:composition": "node --experimental-strip-types ../../tools/design/check-composition-rules.ts",
    "design:bureaucratic": "node --experimental-strip-types ../../tools/design/check-bureaucratic-review.ts",
    "quantity:coverage": "eslint \"src/**/*.{ts,tsx}\" --config eslint.quantity.config.mjs --max-warnings=0",
    "lint:wave2-quantity": "corepack pnpm run quantity:coverage",
    "test:wave2": "vitest run src/api/hooks/useScenarioManifest.test.tsx src/app/providers/temporal-scope.test.ts src/app/providers/TemporalCursorProvider.test.tsx src/app/providers/scenario-scope.test.ts src/app/providers/CounterfactualProvider.test.tsx src/app/providers/TrustViewProvider.test.tsx src/shared/ui/quantity/Quantity.test.tsx src/shared/ui/quantity/ProvenancePopover.test.tsx src/shared/ui/quantity/ProvenanceMiniGraph.test.tsx src/shared/ui/quantity/ProvenanceDeepDiveDialog.test.tsx src/shared/ui/quantity/CounterfactualQuantity.test.tsx src/shared/ui/counterfactual/CounterfactualControls.test.tsx src/shared/ui/trust-view/TrustInspector.test.tsx src/shared/ui/trust-view/TrustViewToggle.test.tsx src/features/runs/compare/PolicyDiffView.test.tsx src/features/artifacts/bureaucratic/BureaucraticArtifactView.test.tsx src/shared/charts/categorical-palettes.test.ts src/shared/charts/SmallMultiples.test.tsx src/features/export/social/OGCard.test.tsx",
    "wave2:backend": "cd ../.. && uv run --extra runtime --extra ml pytest tests/unit/runtime/http/test_lineage_api.py tests/unit/runtime/http/test_temporal_api.py tests/unit/runtime/http/test_run_compare_api.py tests/unit/runtime/http/test_scenarios_api.py tests/unit/runtime/http/test_bureaucratic_rendering_api.py tests/unit/fabric/test_world_time_travel.py tests/unit/fabric/test_lineage.py -q",
    "wave2:cli": "corepack pnpm --dir ../.. --filter @polisyos/cli run typecheck && corepack pnpm --dir ../.. --filter @polisyos/cli test",
    "wave2:gate": "corepack pnpm run typecheck && corepack pnpm run test:wave2 && corepack pnpm run lint:wave2-quantity && corepack pnpm run design:polish && corepack pnpm run wave2:cli",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.tools.json --noEmit",
    "generate:api": "./scripts/generate-api-client.sh",
    "contracts:record": "node ./scripts/record-runtime-contracts.mjs",
    "contracts:verify": "node ./scripts/verify-runtime-contracts.mjs",
    "test:e2e": "corepack pnpm run test:journeys",
    "test:journeys": "playwright test e2e/journeys --project=chromium",
    "test:e2e:journeys": "corepack pnpm run test:journeys",
    "test:journeys:smoke": "playwright test e2e/journeys --grep @smoke",
    "test:e2e:smoke": "corepack pnpm run test:journeys:smoke",
    "test:journeys:mobile-smoke": "playwright test e2e/journeys --project=mobile-chromium --grep @smoke",
    "test:e2e:mobile-smoke": "corepack pnpm run test:journeys:mobile-smoke",
    "test:journeys:quarantine": "PLAYWRIGHT_INCLUDE_QUARANTINE=1 playwright test e2e/journeys --grep @quarantine",
    "test:journeys:flaky": "PLAYWRIGHT_INCLUDE_QUARANTINE=1 playwright test e2e/journeys --grep @flaky",
    "test:e2e:headed": "playwright test e2e/journeys --project=chromium --headed",
    "test:visual": "playwright test --config=playwright.visual.config.ts --project=chromium",
    "test:visual:quarantine": "PLAYWRIGHT_INCLUDE_QUARANTINE=1 playwright test --config=playwright.visual.config.ts --project=chromium --grep @quarantine",
    "playwright:install": "playwright install chromium",
    "lint": "mkdir -p ../../_cache/apps/runtime-dashboard/eslint && eslint src .storybook e2e scripts eslint.config.mjs vite.config.ts vitest.config.ts vitest.a11y.config.ts vitest.storybook.config.ts playwright.config.ts playwright.visual.config.ts tailwind.config.ts --cache --cache-location ../../_cache/apps/runtime-dashboard/eslint/.eslintcache --max-warnings=0",
    "lint:fix": "mkdir -p ../../_cache/apps/runtime-dashboard/eslint && eslint src .storybook e2e scripts eslint.config.mjs vite.config.ts vitest.config.ts vitest.a11y.config.ts vitest.storybook.config.ts playwright.config.ts playwright.visual.config.ts tailwind.config.ts --cache --cache-location ../../_cache/apps/runtime-dashboard/eslint/.eslintcache --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "check:architecture": "node ./scripts/check-architecture.mjs && depcruise --config .dependency-cruiser.mjs src",
    "analyze:bundle": "ANALYZE_BUNDLE=true corepack pnpm run build",
    "check:bundle": "node ./scripts/check-bundle-budgets.mjs",
    "bundle:stats": "node ./scripts/emit-bundle-stats.mjs",
    "bundle:diff": "node ./scripts/compare-bundle-stats.mjs",
    "lighthouse:ci": "lhci autorun --config=.lighthouserc.json",
    "lighthouse:report": "node ./scripts/summarize-lighthouse.mjs",
    "audit:ci": "mkdir -p ../../_build/apps/runtime-dashboard/audit && (corepack pnpm audit --json > ../../_build/apps/runtime-dashboard/audit/pnpm-audit-raw.json || true) && node ./scripts/run-audit.mjs",
    "visual:report": "node ./scripts/summarize-playwright-visual.mjs",
    "prepare": "LEFTHOOK_CONFIG=policy-engine/apps/runtime-dashboard/lefthook.yml lefthook install --force"
  },
  "dependencies": {
    "@polisyos/atlas-ui": "workspace:*",
    "@polisyos/runtime-api-client": "workspace:*",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource/ibm-plex-mono": "^5.2.7",
    "@fontsource/manrope": "^5.2.8",
    "@hookform/resolvers": "^5.2.2",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toggle": "^1.1.10",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@sentry/react": "^10.42.0",
    "@tanstack/react-query": "^5.90.21",
    "@tanstack/react-virtual": "^3.13.21",
    "axe-core": "4.11.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "d3-dag": "^1.1.0",
    "idb": "^8.0.3",
    "intl-messageformat": "10.7.18",
    "lucide-react": "^1.7.0",
    "motion": "^12.38.0",
    "openapi-fetch": "^0.15.2",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-hook-form": "^7.71.2",
    "react-resizable-panels": "^4.9.0",
    "react-router-dom": "^7.13.1",
    "recharts": "^2.15.4",
    "tailwind-merge": "^3.5.0",
    "vite-plugin-pwa": "^1.2.0",
    "workbox-core": "7.4.0",
    "workbox-precaching": "7.4.0",
    "workbox-routing": "7.4.0",
    "workbox-window": "7.4.0",
    "yjs": "^13.6.30",
    "zod": "^4.3.6",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.1",
    "@eslint/js": "^9.39.4",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.55.0",
    "@resvg/resvg-js": "^2.6.2",
    "@sentry/vite-plugin": "^5.1.1",
    "@storybook/addon-a11y": "^9.1.20",
    "@storybook/addon-vitest": "^9.1.20",
    "@storybook/react-vite": "^9.1.20",
    "@tailwindcss/postcss": "^4.2.1",
    "@tailwindcss/vite": "^4.2.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.3.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.4",
    "@vitest/browser-playwright": "^4.0.18",
    "@vitest/coverage-v8": "^4.0.18",
    "@vitest/eslint-plugin": "^1.6.9",
    "dependency-cruiser": "^16.10.4",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-boundaries": "^5.4.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-storybook": "^9.1.20",
    "eslint-plugin-testing-library": "^7.16.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.4.0",
    "jsdom": "^27.0.1",
    "lefthook": "^2.1.3",
    "msw": "^2.12.10",
    "openapi-typescript": "^7.6.1",
    "playwright": "1.59.1",
    "postcss": "^8.5.3",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "rollup": "^4.60.2",
    "rollup-plugin-visualizer": "^7.0.1",
    "satori": "^0.26.0",
    "storybook": "^9.1.20",
    "tailwindcss": "^4.2.1",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.56.1",
    "vite": "^7.3.1",
    "vitest": "^4.0.18",
    "vitest-axe": "^0.1.0",
    "web-vitals": "^5.1.0"
  }
}
