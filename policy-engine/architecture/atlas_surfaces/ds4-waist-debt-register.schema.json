{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ds4-waist-debt-register.schema.json",
  "title": "Atlas DS4 waist-debt register",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "register_id",
    "as_of",
    "authority",
    "entries"
  ],
  "properties": {
    "$schema": { "const": "./ds4-waist-debt-register.schema.json" },
    "schema_version": { "const": "1.1" },
    "register_id": { "const": "atlas-ds4-waist-debt" },
    "as_of": { "type": "string", "format": "date-time" },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authoritative_for", "may_not_use_for"],
      "properties": {
        "authoritative_for": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "may_not_use_for": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "entries": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": { "$ref": "#/$defs/entry" }
    }
  },
  "$defs": {
    "nonEmpty": { "type": "string", "minLength": 1 },
    "path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*\\.\\./).+$"
    },
    "anchor": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "anchor_kind",
            "canonical_path",
            "canonical_line",
            "canonical_identity",
            "types_path",
            "schema_line",
            "schema_identity",
            "symbol"
          ],
          "properties": {
            "anchor_kind": { "const": "present_projection" },
            "canonical_path": { "$ref": "#/$defs/path" },
            "canonical_line": { "type": "integer", "minimum": 1 },
            "canonical_identity": {
              "type": "string",
              "pattern": "#ts-identity="
            },
            "types_path": { "$ref": "#/$defs/path" },
            "schema_line": { "type": "integer", "minimum": 1 },
            "schema_identity": {
              "type": "string",
              "pattern": "#ts-identity="
            },
            "symbol": { "$ref": "#/$defs/nonEmpty" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "anchor_kind",
            "absence_scope",
            "canonical_path",
            "types_path",
            "symbol"
          ],
          "properties": {
            "anchor_kind": { "const": "missing_export" },
            "absence_scope": {
              "const": "canonical_module_exports_and_schema_owners"
            },
            "canonical_path": { "$ref": "#/$defs/path" },
            "types_path": { "$ref": "#/$defs/path" },
            "symbol": { "$ref": "#/$defs/nonEmpty" }
          }
        }
      ]
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "debt_id",
        "vocabulary",
        "owner",
        "owner_slice",
        "capability_states",
        "generated_client_anchor",
        "swap_module",
        "target_cluster",
        "closure_truth",
        "master_inherited_debt_action",
        "estate_denominator_effect"
      ],
      "properties": {
        "debt_id": { "type": "string", "pattern": "^ds4-waist-[a-z0-9-]+$" },
        "vocabulary": { "$ref": "#/$defs/nonEmpty" },
        "owner": { "const": "DS5 waist" },
        "owner_slice": { "const": "DS5" },
        "capability_states": {
          "const": ["bridge_missing", "surface_missing"]
        },
        "generated_client_anchor": { "$ref": "#/$defs/anchor" },
        "swap_module": { "$ref": "#/$defs/path" },
        "target_cluster": { "enum": ["C09", "C14", "C19"] },
        "closure_truth": { "$ref": "#/$defs/nonEmpty" },
        "master_inherited_debt_action": {
          "const": "flag_for_architect_insertion_at_c20"
        },
        "estate_denominator_effect": { "const": "none" }
      }
    }
  }
}
