{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://policyos.dev/schemas/atlas/frontend-baseline-debt.schema.json",
  "title": "PolicyOS Atlas DS19 Frontend Baseline Debt Manifest",
  "description": "Strict evidence contract for pre-existing dashboard lint and test failures admitted by DS19's baseline-relative no-regression gate.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "manifest_id",
    "captured_at",
    "baseline_revision",
    "scope",
    "authority",
    "baseline_relative_laws",
    "lint",
    "architecture",
    "vitest"
  ],
  "properties": {
    "$schema": {
      "const": "./frontend-baseline-debt.schema.json"
    },
    "schema_version": {
      "const": "1.1"
    },
    "manifest_id": {
      "const": "atlas-ds19-frontend-baseline-debt"
    },
    "captured_at": {
      "type": "string",
      "format": "date-time"
    },
    "baseline_revision": {
      "$ref": "#/$defs/gitRevision"
    },
    "scope": {
      "const": "apps/runtime-dashboard"
    },
    "authority": {
      "$ref": "#/$defs/authorityBoundary"
    },
    "baseline_relative_laws": {
      "$ref": "#/$defs/baselineRelativeLaws"
    },
    "lint": {
      "$ref": "#/$defs/lintBaseline"
    },
    "architecture": {
      "$ref": "#/$defs/architectureBaseline"
    },
    "vitest": {
      "$ref": "#/$defs/vitestBaseline"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "positiveInteger": {
      "type": "integer",
      "minimum": 1
    },
    "nonNegativeInteger": {
      "type": "integer",
      "minimum": 0
    },
    "ownerSlice": {
      "const": "DS4"
    },
    "debtOwnerSlice": {
      "enum": ["DS4", "DS6"]
    },
    "disposition": {
      "const": "rebind_pending"
    },
    "repoPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    },
    "gitRevision": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "authorityBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authoritative_for", "not_authoritative_for"],
      "properties": {
        "authoritative_for": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "not_authoritative_for": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "subsetLaw": {
      "type": "object",
      "additionalProperties": false,
      "required": ["comparison", "identity_fields", "removals", "additions"],
      "properties": {
        "comparison": {
          "const": "post_identity_set_is_subset_of_baseline_identity_set"
        },
        "identity_fields": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "removals": {
          "const": "allowed"
        },
        "additions": {
          "const": "fail"
        }
      }
    },
    "baselineRelativeLaws": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lint", "vitest", "architecture", "absolute_green_gates"],
      "properties": {
        "lint": {
          "allOf": [
            {
              "$ref": "#/$defs/subsetLaw"
            },
            {
              "properties": {
                "identity_fields": {
                  "const": [
                    "path",
                    "rule_id",
                    "severity",
                    "line",
                    "column",
                    "end_line",
                    "end_column",
                    "message_id",
                    "message"
                  ]
                }
              }
            }
          ]
        },
        "vitest": {
          "allOf": [
            {
              "$ref": "#/$defs/subsetLaw"
            },
            {
              "properties": {
                "identity_fields": {
                  "const": [
                    "test_file",
                    "test_name",
                    "assertion_line",
                    "assertion_anchor"
                  ]
                }
              }
            }
          ]
        },
        "architecture": {
          "allOf": [
            {
              "$ref": "#/$defs/subsetLaw"
            },
            {
              "properties": {
                "identity_fields": {
                  "const": [
                    "source_path",
                    "source_content_sha256",
                    "line",
                    "specifier",
                    "resolved_target_path",
                    "rule_id",
                    "message"
                  ]
                }
              }
            }
          ]
        },
        "absolute_green_gates": {
          "const": ["typecheck", "production_build"]
        }
      }
    },
    "ruleCount": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rule_id", "count"],
      "properties": {
        "rule_id": {
          "type": "string",
          "minLength": 1
        },
        "count": {
          "$ref": "#/$defs/positiveInteger"
        }
      }
    },
    "lintDiagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "rule_id",
        "severity",
        "line",
        "column",
        "end_line",
        "end_column",
        "message_id",
        "message"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/repoPath"
        },
        "rule_id": {
          "type": "string",
          "minLength": 1
        },
        "severity": {
          "const": 2
        },
        "line": {
          "$ref": "#/$defs/positiveInteger"
        },
        "column": {
          "$ref": "#/$defs/positiveInteger"
        },
        "end_line": {
          "$ref": "#/$defs/positiveInteger"
        },
        "end_column": {
          "$ref": "#/$defs/positiveInteger"
        },
        "message_id": {
          "type": "string",
          "minLength": 1
        },
        "message": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "lintIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "source_content_sha256",
        "rule_id",
        "severity",
        "line",
        "column",
        "end_line",
        "end_column",
        "message_id",
        "message"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/repoPath"
        },
        "source_content_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "rule_id": {
          "type": "string",
          "minLength": 1
        },
        "severity": {
          "const": 2
        },
        "line": {
          "$ref": "#/$defs/positiveInteger"
        },
        "column": {
          "$ref": "#/$defs/positiveInteger"
        },
        "end_line": {
          "$ref": "#/$defs/positiveInteger"
        },
        "end_column": {
          "$ref": "#/$defs/positiveInteger"
        },
        "message_id": {
          "type": "string",
          "minLength": 1
        },
        "message": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "lintFile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "content_sha256",
        "diagnostic_count",
        "rule_counts",
        "diagnostics"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/repoPath"
        },
        "content_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "diagnostic_count": {
          "$ref": "#/$defs/positiveInteger"
        },
        "rule_counts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/ruleCount"
          }
        },
        "diagnostics": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/lintDiagnostic"
          }
        }
      }
    },
    "ruleIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rule_id",
        "implementation_path",
        "implementation_sha256",
        "configuration_path",
        "configuration_sha256"
      ],
      "properties": {
        "rule_id": {
          "const": "policyos/quantity-must-be-wrapped"
        },
        "implementation_path": {
          "$ref": "#/$defs/repoPath"
        },
        "implementation_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "configuration_path": {
          "$ref": "#/$defs/repoPath"
        },
        "configuration_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "canonicalSet": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hash_algorithm",
        "serialization",
        "payload",
        "sort_key",
        "sha256"
      ],
      "properties": {
        "hash_algorithm": {
          "const": "sha256"
        },
        "serialization": {
          "const": "RFC8785_JCS"
        },
        "payload": {
          "type": "string",
          "enum": [
            "flat_sorted_diagnostics",
            "flat_sorted_failures",
            "flat_sorted_architecture_violations"
          ]
        },
        "sort_key": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "lintOrigin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "owner_slice",
        "disposition",
        "command",
        "exit_code",
        "raw_receipt_sha256",
        "error_count",
        "warning_count",
        "source_file_count",
        "rule_identity",
        "diagnostic_set",
        "identity_set_sha256"
      ],
      "properties": {
        "owner_slice": {
          "$ref": "#/$defs/ownerSlice"
        },
        "disposition": {
          "$ref": "#/$defs/disposition"
        },
        "command": {
          "type": "string",
          "minLength": 1
        },
        "exit_code": {
          "const": 1
        },
        "raw_receipt_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "error_count": {
          "const": 75
        },
        "warning_count": {
          "const": 0
        },
        "source_file_count": {
          "const": 22
        },
        "rule_identity": {
          "$ref": "#/$defs/ruleIdentity"
        },
        "diagnostic_set": {
          "allOf": [
            {
              "$ref": "#/$defs/canonicalSet"
            },
            {
              "properties": {
                "payload": {
                  "const": "flat_sorted_diagnostics"
                },
                "sort_key": {
                  "const": [
                    "path",
                    "rule_id",
                    "severity",
                    "line",
                    "column",
                    "end_line",
                    "end_column",
                    "message_id",
                    "message"
                  ]
                }
              }
            }
          ]
        },
        "identity_set_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "lintResolution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "origin_identity_sha256",
        "origin_identity",
        "cluster_id",
        "semantic_kind",
        "classification",
        "implementation_refs",
        "consumer_refs",
        "closure_test_ref"
      ],
      "properties": {
        "origin_identity_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "origin_identity": {
          "$ref": "#/$defs/lintIdentity"
        },
        "cluster_id": {
          "type": "string",
          "pattern": "^C(?:06|07|08)$"
        },
        "semantic_kind": {
          "enum": ["decision_bearing", "non_authority_control"]
        },
        "classification": {
          "enum": [
            "quantity_enveloped",
            "authority_guess_removed",
            "collection_control",
            "parser_control",
            "quantity_semantics",
            "layout_geometry",
            "interaction_control",
            "motion_geometry",
            "operational_request_control"
          ]
        },
        "implementation_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/repoPath"
          }
        },
        "consumer_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/repoPath"
          }
        },
        "closure_test_ref": {
          "$ref": "#/$defs/repoPath"
        }
      }
    },
    "resolutionContentBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cluster_id", "path", "roles", "sha256"],
      "properties": {
        "cluster_id": {
          "type": "string",
          "pattern": "^C(?:06|07|08)$"
        },
        "path": {
          "$ref": "#/$defs/repoPath"
        },
        "roles": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "uniqueItems": true,
          "items": {
            "enum": ["implementation", "consumer", "closure_test"]
          }
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "lintBaseline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "owner_slice",
        "disposition",
        "command",
        "exit_code",
        "error_count",
        "warning_count",
        "source_file_count",
        "rule_identity",
        "diagnostic_set",
        "identity_set_sha256",
        "files",
        "immutable_origin",
        "resolutions",
        "resolution_content_bindings"
      ],
      "properties": {
        "owner_slice": {
          "$ref": "#/$defs/ownerSlice"
        },
        "disposition": {
          "enum": ["rebind_pending", "resolved"]
        },
        "command": {
          "type": "string",
          "minLength": 1
        },
        "exit_code": {
          "enum": [0, 1]
        },
        "error_count": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "warning_count": {
          "const": 0
        },
        "source_file_count": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "rule_identity": {
          "$ref": "#/$defs/ruleIdentity"
        },
        "diagnostic_set": {
          "allOf": [
            {
              "$ref": "#/$defs/canonicalSet"
            },
            {
              "properties": {
                "payload": {
                  "const": "flat_sorted_diagnostics"
                },
                "sort_key": {
                  "const": [
                    "path",
                    "rule_id",
                    "severity",
                    "line",
                    "column",
                    "end_line",
                    "end_column",
                    "message_id",
                    "message"
                  ]
                }
              }
            }
          ]
        },
        "identity_set_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "files": {
          "type": "array",
          "maxItems": 22,
          "items": {
            "$ref": "#/$defs/lintFile"
          }
        },
        "immutable_origin": {
          "$ref": "#/$defs/lintOrigin"
        },
        "resolutions": {
          "type": "array",
          "maxItems": 75,
          "items": {
            "$ref": "#/$defs/lintResolution"
          }
        },
        "resolution_content_bindings": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/resolutionContentBinding"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "error_count": {
                "const": 0
              }
            }
          },
          "then": {
            "properties": {
              "disposition": {
                "const": "resolved"
              },
              "exit_code": {
                "const": 0
              },
              "source_file_count": {
                "const": 0
              },
              "files": {
                "maxItems": 0
              }
            }
          },
          "else": {
            "properties": {
              "disposition": {
                "const": "rebind_pending"
              },
              "exit_code": {
                "const": 1
              }
            }
          }
        }
      ]
    },
    "architectureViolation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_path",
        "source_content_sha256",
        "line",
        "specifier",
        "resolved_target_path",
        "rule_id",
        "message",
        "display"
      ],
      "properties": {
        "source_path": {
          "$ref": "#/$defs/repoPath"
        },
        "source_content_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "line": {
          "oneOf": [
            {
              "$ref": "#/$defs/positiveInteger"
            },
            {
              "type": "null"
            }
          ]
        },
        "specifier": {
          "type": ["string", "null"]
        },
        "resolved_target_path": {
          "oneOf": [
            {
              "$ref": "#/$defs/repoPath"
            },
            {
              "type": "null"
            }
          ]
        },
        "rule_id": {
          "type": "string",
          "minLength": 1
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "display": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "architectureOrigin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "producer",
        "producer_path",
        "producer_sha256",
        "violation_count",
        "source_file_count",
        "identity_set_sha256"
      ],
      "properties": {
        "producer": {
          "const": "runtime-dashboard-custom-import-boundary"
        },
        "producer_path": {
          "const": "apps/runtime-dashboard/scripts/check-architecture.mjs"
        },
        "producer_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "violation_count": {
          "const": 36
        },
        "source_file_count": {
          "const": 28
        },
        "identity_set_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "architectureResolution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "origin_identity_sha256",
        "origin_identity",
        "cluster_id",
        "classification",
        "implementation_refs",
        "consumer_refs",
        "closure_test_ref"
      ],
      "properties": {
        "origin_identity_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "origin_identity": {
          "$ref": "#/$defs/architectureViolation"
        },
        "cluster_id": {
          "type": "string",
          "pattern": "^C(?:0[6-9]|1[0-8])$"
        },
        "classification": {
          "enum": [
            "shared_dependency_inverted",
            "feature_public_barrel"
          ]
        },
        "implementation_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/repoPath"
          }
        },
        "consumer_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/repoPath"
          }
        },
        "closure_test_ref": {
          "$ref": "#/$defs/repoPath"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "cluster_id": {
                "const": "C18"
              }
            },
            "required": ["cluster_id"]
          },
          "then": {
            "properties": {
              "classification": {
                "const": "feature_public_barrel"
              }
            }
          },
          "else": {
            "properties": {
              "classification": {
                "const": "shared_dependency_inverted"
              }
            }
          }
        }
      ]
    },
    "architectureBaseline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "owner_slice",
        "disposition",
        "command",
        "producer",
        "producer_path",
        "producer_sha256",
        "exit_code",
        "violation_count",
        "source_file_count",
        "identity_set_sha256",
        "violations",
        "immutable_origin",
        "resolutions"
      ],
      "properties": {
        "owner_slice": {
          "$ref": "#/$defs/ownerSlice"
        },
        "disposition": {
          "enum": ["rebind_pending", "resolved"]
        },
        "command": {
          "const": "node ./scripts/check-architecture.mjs --format=json"
        },
        "producer": {
          "const": "runtime-dashboard-custom-import-boundary"
        },
        "producer_path": {
          "const": "apps/runtime-dashboard/scripts/check-architecture.mjs"
        },
        "producer_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "exit_code": {
          "enum": [0, 1]
        },
        "violation_count": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "source_file_count": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "identity_set_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "violations": {
          "type": "array",
          "maxItems": 36,
          "items": {
            "$ref": "#/$defs/architectureViolation"
          }
        },
        "immutable_origin": {
          "$ref": "#/$defs/architectureOrigin"
        },
        "resolutions": {
          "type": "array",
          "maxItems": 36,
          "items": {
            "$ref": "#/$defs/architectureResolution"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "violation_count": {
                "const": 0
              }
            }
          },
          "then": {
            "properties": {
              "disposition": {
                "const": "resolved"
              },
              "exit_code": {
                "const": 0
              },
              "source_file_count": {
                "const": 0
              },
              "violations": {
                "maxItems": 0
              }
            }
          },
          "else": {
            "properties": {
              "disposition": {
                "const": "rebind_pending"
              },
              "exit_code": {
                "const": 1
              }
            }
          }
        }
      ]
    },
    "testFailure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "test_file",
        "test_name",
        "assertion_line",
        "assertion_anchor"
      ],
      "properties": {
        "test_file": {
          "$ref": "#/$defs/repoPath"
        },
        "test_name": {
          "type": "string",
          "minLength": 1
        },
        "assertion_line": {
          "$ref": "#/$defs/positiveInteger"
        },
        "assertion_anchor": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "testDebtClass": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "class_id",
        "owner_slice",
        "disposition",
        "rationale",
        "failure_count",
        "failures"
      ],
      "properties": {
        "class_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "owner_slice": {
          "$ref": "#/$defs/debtOwnerSlice"
        },
        "disposition": {
          "$ref": "#/$defs/disposition"
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        },
        "failure_count": {
          "$ref": "#/$defs/positiveInteger"
        },
        "failures": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/testFailure"
          }
        }
      }
    },
    "fileTotals": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total", "passed", "failed"],
      "properties": {
        "total": {
          "$ref": "#/$defs/positiveInteger"
        },
        "passed": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "failed": {
          "$ref": "#/$defs/nonNegativeInteger"
        }
      }
    },
    "testTotals": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total", "passed", "failed"],
      "properties": {
        "total": {
          "$ref": "#/$defs/positiveInteger"
        },
        "passed": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "failed": {
          "$ref": "#/$defs/nonNegativeInteger"
        }
      }
    },
    "parentReproduction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "revision",
        "command",
        "wall_duration_seconds",
        "exit_code",
        "test_files",
        "tests",
        "matches_full_run_failure_set"
      ],
      "properties": {
        "revision": {
          "$ref": "#/$defs/gitRevision"
        },
        "command": {
          "type": "string",
          "minLength": 1
        },
        "wall_duration_seconds": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "exit_code": {
          "const": 1
        },
        "test_files": {
          "$ref": "#/$defs/fileTotals"
        },
        "tests": {
          "$ref": "#/$defs/testTotals"
        },
        "matches_full_run_failure_set": {
          "const": true
        }
      }
    },
    "vitestBaseline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "owner_slice",
        "disposition",
        "command",
        "wall_duration_seconds",
        "vitest_duration_seconds",
        "exit_code",
        "test_files",
        "tests",
        "failure_set",
        "debt_classes",
        "parent_reproduction"
      ],
      "properties": {
        "owner_slice": {
          "$ref": "#/$defs/ownerSlice"
        },
        "disposition": {
          "$ref": "#/$defs/disposition"
        },
        "command": {
          "type": "string",
          "minLength": 1
        },
        "wall_duration_seconds": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "vitest_duration_seconds": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "exit_code": {
          "const": 1
        },
        "test_files": {
          "$ref": "#/$defs/fileTotals"
        },
        "tests": {
          "$ref": "#/$defs/testTotals"
        },
        "failure_set": {
          "allOf": [
            {
              "$ref": "#/$defs/canonicalSet"
            },
            {
              "properties": {
                "payload": {
                  "const": "flat_sorted_failures"
                },
                "sort_key": {
                  "const": [
                    "test_file",
                    "test_name",
                    "assertion_line",
                    "assertion_anchor"
                  ]
                }
              }
            }
          ]
        },
        "debt_classes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "items": {
            "$ref": "#/$defs/testDebtClass"
          }
        },
        "parent_reproduction": {
          "$ref": "#/$defs/parentReproduction"
        }
      }
    }
  }
}
