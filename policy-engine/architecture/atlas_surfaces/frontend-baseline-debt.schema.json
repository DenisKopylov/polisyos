{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://policyos.dev/schemas/atlas/frontend-baseline-debt.schema.json",
  "title": "PolicyOS Atlas DS19 Frontend Baseline Debt Manifest",
  "description": "Strict evidence contract for pre-existing dashboard lint and test failures admitted by DS19's baseline-relative no-regression gate.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "manifest_id",
    "captured_at",
    "baseline_revision",
    "scope",
    "authority",
    "baseline_relative_laws",
    "lint",
    "vitest"
  ],
  "properties": {
    "$schema": {
      "const": "./frontend-baseline-debt.schema.json"
    },
    "schema_version": {
      "const": "1.0"
    },
    "manifest_id": {
      "const": "atlas-ds19-frontend-baseline-debt"
    },
    "captured_at": {
      "type": "string",
      "format": "date-time"
    },
    "baseline_revision": {
      "$ref": "#/$defs/gitRevision"
    },
    "scope": {
      "const": "apps/runtime-dashboard"
    },
    "authority": {
      "$ref": "#/$defs/authorityBoundary"
    },
    "baseline_relative_laws": {
      "$ref": "#/$defs/baselineRelativeLaws"
    },
    "lint": {
      "$ref": "#/$defs/lintBaseline"
    },
    "vitest": {
      "$ref": "#/$defs/vitestBaseline"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "positiveInteger": {
      "type": "integer",
      "minimum": 1
    },
    "nonNegativeInteger": {
      "type": "integer",
      "minimum": 0
    },
    "ownerSlice": {
      "const": "DS4"
    },
    "disposition": {
      "const": "rebind_pending"
    },
    "repoPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    },
    "gitRevision": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "authorityBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authoritative_for",
        "not_authoritative_for"
      ],
      "properties": {
        "authoritative_for": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "not_authoritative_for": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "subsetLaw": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "comparison",
        "identity_fields",
        "removals",
        "additions"
      ],
      "properties": {
        "comparison": {
          "const": "post_identity_set_is_subset_of_baseline_identity_set"
        },
        "identity_fields": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "removals": {
          "const": "allowed"
        },
        "additions": {
          "const": "fail"
        }
      }
    },
    "baselineRelativeLaws": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lint",
        "vitest",
        "absolute_green_gates"
      ],
      "properties": {
        "lint": {
          "allOf": [
            {
              "$ref": "#/$defs/subsetLaw"
            },
            {
              "properties": {
                "identity_fields": {
                  "const": [
                    "path",
                    "rule_id",
                    "severity",
                    "line",
                    "column",
                    "end_line",
                    "end_column",
                    "message_id",
                    "message"
                  ]
                }
              }
            }
          ]
        },
        "vitest": {
          "allOf": [
            {
              "$ref": "#/$defs/subsetLaw"
            },
            {
              "properties": {
                "identity_fields": {
                  "const": [
                    "test_file",
                    "test_name",
                    "assertion_line",
                    "assertion_anchor"
                  ]
                }
              }
            }
          ]
        },
        "absolute_green_gates": {
          "const": [
            "typecheck",
            "production_build"
          ]
        }
      }
    },
    "ruleCount": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rule_id",
        "count"
      ],
      "properties": {
        "rule_id": {
          "type": "string",
          "minLength": 1
        },
        "count": {
          "$ref": "#/$defs/positiveInteger"
        }
      }
    },
    "lintDiagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "rule_id",
        "severity",
        "line",
        "column",
        "end_line",
        "end_column",
        "message_id",
        "message"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/repoPath"
        },
        "rule_id": {
          "type": "string",
          "minLength": 1
        },
        "severity": {
          "const": 2
        },
        "line": {
          "$ref": "#/$defs/positiveInteger"
        },
        "column": {
          "$ref": "#/$defs/positiveInteger"
        },
        "end_line": {
          "$ref": "#/$defs/positiveInteger"
        },
        "end_column": {
          "$ref": "#/$defs/positiveInteger"
        },
        "message_id": {
          "type": "string",
          "minLength": 1
        },
        "message": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "lintFile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "content_sha256",
        "diagnostic_count",
        "rule_counts",
        "diagnostics"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/repoPath"
        },
        "content_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "diagnostic_count": {
          "$ref": "#/$defs/positiveInteger"
        },
        "rule_counts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/ruleCount"
          }
        },
        "diagnostics": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/lintDiagnostic"
          }
        }
      }
    },
    "ruleIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rule_id",
        "implementation_path",
        "implementation_sha256",
        "configuration_path",
        "configuration_sha256"
      ],
      "properties": {
        "rule_id": {
          "const": "policyos/quantity-must-be-wrapped"
        },
        "implementation_path": {
          "$ref": "#/$defs/repoPath"
        },
        "implementation_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "configuration_path": {
          "$ref": "#/$defs/repoPath"
        },
        "configuration_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "canonicalSet": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hash_algorithm",
        "serialization",
        "payload",
        "sort_key",
        "sha256"
      ],
      "properties": {
        "hash_algorithm": {
          "const": "sha256"
        },
        "serialization": {
          "const": "RFC8785_JCS"
        },
        "payload": {
          "type": "string",
          "enum": [
            "flat_sorted_diagnostics",
            "flat_sorted_failures"
          ]
        },
        "sort_key": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "lintBaseline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "owner_slice",
        "disposition",
        "command",
        "exit_code",
        "raw_receipt_sha256",
        "error_count",
        "warning_count",
        "source_file_count",
        "rule_identity",
        "diagnostic_set",
        "files"
      ],
      "properties": {
        "owner_slice": {
          "$ref": "#/$defs/ownerSlice"
        },
        "disposition": {
          "$ref": "#/$defs/disposition"
        },
        "command": {
          "type": "string",
          "minLength": 1
        },
        "exit_code": {
          "const": 1
        },
        "raw_receipt_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "error_count": {
          "const": 75
        },
        "warning_count": {
          "const": 0
        },
        "source_file_count": {
          "const": 22
        },
        "rule_identity": {
          "$ref": "#/$defs/ruleIdentity"
        },
        "diagnostic_set": {
          "allOf": [
            {
              "$ref": "#/$defs/canonicalSet"
            },
            {
              "properties": {
                "payload": {
                  "const": "flat_sorted_diagnostics"
                },
                "sort_key": {
                  "const": [
                    "path",
                    "rule_id",
                    "severity",
                    "line",
                    "column",
                    "end_line",
                    "end_column",
                    "message_id",
                    "message"
                  ]
                }
              }
            }
          ]
        },
        "files": {
          "type": "array",
          "minItems": 22,
          "maxItems": 22,
          "items": {
            "$ref": "#/$defs/lintFile"
          }
        }
      }
    },
    "testFailure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "test_file",
        "test_name",
        "assertion_line",
        "assertion_anchor"
      ],
      "properties": {
        "test_file": {
          "$ref": "#/$defs/repoPath"
        },
        "test_name": {
          "type": "string",
          "minLength": 1
        },
        "assertion_line": {
          "$ref": "#/$defs/positiveInteger"
        },
        "assertion_anchor": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "testDebtClass": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "class_id",
        "owner_slice",
        "disposition",
        "rationale",
        "failure_count",
        "failures"
      ],
      "properties": {
        "class_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "owner_slice": {
          "$ref": "#/$defs/ownerSlice"
        },
        "disposition": {
          "$ref": "#/$defs/disposition"
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        },
        "failure_count": {
          "$ref": "#/$defs/positiveInteger"
        },
        "failures": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/testFailure"
          }
        }
      }
    },
    "fileTotals": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "total",
        "passed",
        "failed"
      ],
      "properties": {
        "total": {
          "$ref": "#/$defs/positiveInteger"
        },
        "passed": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "failed": {
          "$ref": "#/$defs/nonNegativeInteger"
        }
      }
    },
    "testTotals": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "total",
        "passed",
        "failed"
      ],
      "properties": {
        "total": {
          "$ref": "#/$defs/positiveInteger"
        },
        "passed": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "failed": {
          "$ref": "#/$defs/nonNegativeInteger"
        }
      }
    },
    "parentReproduction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "revision",
        "command",
        "wall_duration_seconds",
        "exit_code",
        "test_files",
        "tests",
        "matches_full_run_failure_set"
      ],
      "properties": {
        "revision": {
          "$ref": "#/$defs/gitRevision"
        },
        "command": {
          "type": "string",
          "minLength": 1
        },
        "wall_duration_seconds": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "exit_code": {
          "const": 1
        },
        "test_files": {
          "$ref": "#/$defs/fileTotals"
        },
        "tests": {
          "$ref": "#/$defs/testTotals"
        },
        "matches_full_run_failure_set": {
          "const": true
        }
      }
    },
    "vitestBaseline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "owner_slice",
        "disposition",
        "command",
        "wall_duration_seconds",
        "vitest_duration_seconds",
        "exit_code",
        "test_files",
        "tests",
        "failure_set",
        "debt_classes",
        "parent_reproduction"
      ],
      "properties": {
        "owner_slice": {
          "$ref": "#/$defs/ownerSlice"
        },
        "disposition": {
          "$ref": "#/$defs/disposition"
        },
        "command": {
          "type": "string",
          "minLength": 1
        },
        "wall_duration_seconds": {
          "const": 181.12
        },
        "vitest_duration_seconds": {
          "const": 178.12
        },
        "exit_code": {
          "const": 1
        },
        "test_files": {
          "$ref": "#/$defs/fileTotals"
        },
        "tests": {
          "$ref": "#/$defs/testTotals"
        },
        "failure_set": {
          "allOf": [
            {
              "$ref": "#/$defs/canonicalSet"
            },
            {
              "properties": {
                "payload": {
                  "const": "flat_sorted_failures"
                },
                "sort_key": {
                  "const": [
                    "test_file",
                    "test_name",
                    "assertion_line",
                    "assertion_anchor"
                  ]
                }
              }
            }
          ]
        },
        "debt_classes": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "$ref": "#/$defs/testDebtClass"
          }
        },
        "parent_reproduction": {
          "$ref": "#/$defs/parentReproduction"
        }
      }
    }
  }
}
