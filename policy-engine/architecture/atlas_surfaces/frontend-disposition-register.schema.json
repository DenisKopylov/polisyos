    "supplementalFinding": {
      "type": "object",
      "description": "Supplemental debt is descriptor-derived; producer, integrate-contract, and authority-presentation debt remain open until their typed closure signals pass.",
      "additionalProperties": false,
      "required": [
        "finding_id",
        "finding_kind",
        "disposition",
        "status",
        "evidence_refs",
        "owner_slice",
        "decision_date",
        "rationale"
      ],
      "properties": {
        "finding_id": {
          "$ref": "#/$defs/id"
        },
        "finding_kind": {
          "type": "string",
          "enum": [
            "baseline_lint_debt",
            "baseline_test_debt",
            "dependency_declaration",
            "fixture_contract_drift",
            "producer_binding_debt",
            "integrate_contract_debt",
            "authority_presentation_debt"
          ]
        },
        "disposition": {
          "$ref": "#/$defs/disposition"
        },
        "status": {
          "type": "string",
          "enum": [
            "open_debt",
            "repaired"
          ]
        },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/pathRef"
          }
        },
        "owner_slice": {
          "$ref": "#/$defs/ownerSlice"
        },
        "owner_team": {
          "type": "string",
          "pattern": "^team-[a-z0-9-]+$"
        },
        "decision_date": {
          "$ref": "#/$defs/date"
        },
        "repair_commit": {
          "type": "string",
          "pattern": "^[a-f0-9]{9,40}$"
        },
        "capability_states": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "contract_only",
              "producer_missing",
              "artifact_missing",
              "bridge_missing",
              "consumer_missing",
              "verification_missing",
              "implemented_but_not_orchestrated",
              "surface_missing",
              "surface_out_of_scope",
              "semantic_test_missing"
            ]
          }
        },
        "closure_signal": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "integrate_contract": {
          "$ref": "#/$defs/integrateContract"
        },
        "authority_sink": {
          "$ref": "#/$defs/authoritySinkDescriptor"
        },
        "raw_transport_receipt": {
          "$ref": "#/$defs/rawTransportDriftReceipt"
        },
        "rationale": {
          "$ref": "#/$defs/nonEmptyString"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "finding_kind": {
                "enum": [
                  "producer_binding_debt",
                  "integrate_contract_debt",
                  "authority_presentation_debt"
                ]
              }
            },
            "required": ["finding_kind"]
          },
          "then": {
            "required": ["capability_states", "closure_signal"],
            "properties": {
              "disposition": { "const": "rebind_pending" },
              "status": { "const": "open_debt" }
            },
            "not": { "required": ["repair_commit"] }
          },
          "else": {
            "not": {
              "anyOf": [
                { "required": ["capability_states"] },
                { "required": ["closure_signal"] },
                { "required": ["owner_team"] },
                { "required": ["integrate_contract"] },
                { "required": ["authority_sink"] }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "finding_kind": { "const": "integrate_contract_debt" }
            },
            "required": ["finding_kind"]
          },
          "then": {
            "required": ["owner_team", "integrate_contract"]
          },
          "else": {
            "not": {
              "anyOf": [
                { "required": ["owner_team"] },
                { "required": ["integrate_contract"] }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "finding_kind": {"const": "authority_presentation_debt"}
            },
            "required": ["finding_kind"]
          },
          "then": {
            "required": ["authority_sink"]
          },
          "else": {
            "not": {"required": ["authority_sink"]}
        }
      },
      {
        "if": {
          "allOf": [
            {
              "properties": {
                "finding_id": { "const": "raw-transport-denominator-drift" }
              },
              "required": ["finding_id"]
            },
            {
              "properties": {
                "finding_kind": { "const": "producer_binding_debt" }
              },
              "required": ["finding_kind"]
            }
          ]
        },
        "then": {
          "required": ["raw_transport_receipt"]
        },
        "else": {
          "not": { "required": ["raw_transport_receipt"] }
        }
      }
    ]
  },
    "seededNegative": {
