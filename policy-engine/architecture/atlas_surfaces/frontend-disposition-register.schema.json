{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "frontend-disposition-register.schema.json",
  "title": "PolicyOS Atlas Frontend Disposition Register",
  "description": "DS19's single authority for frontend estate disposition, strangle state, and fresh-census receipts. DS1 and DS2 evidence is referenced by identifier rather than restated.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "register_id",
    "as_of",
    "controlled_vocabulary_source",
    "authority",
    "sources",
    "seed_policy",
    "baseline_debt_manifest_ref",
    "ds2_unbound_adoption_ids",
    "reference_censuses",
    "storage_construction_census",
    "entries",
    "subunits",
    "supplemental_findings",
    "seeded_negative_lifecycle"
  ],
  "properties": {
    "$schema": {
      "const": "./frontend-disposition-register.schema.json"
    },
    "schema_version": {
      "const": "1.0"
    },
    "register_id": {
      "const": "atlas-ds19-frontend-disposition"
    },
    "as_of": {
      "type": "string",
      "format": "date-time"
    },
    "controlled_vocabulary_source": {
      "const": "docs/plans/active/POLICYOS_ATLAS_SURFACE_IMPLEMENTATION_MASTER_PLAN.md"
    },
    "authority": {
      "$ref": "#/$defs/authorityBoundary"
    },
    "sources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ds1",
        "ds2",
        "ds0"
      ],
      "properties": {
        "ds1": {
          "$ref": "#/$defs/sourceLedger"
        },
        "ds2": {
          "$ref": "#/$defs/sourceLedger"
        },
        "ds0": {
          "$ref": "#/$defs/sourceRecord"
        }
      }
    },
    "seed_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rules",
        "ds1_root_count",
        "ds2_mapped_count",
        "ds2_unbound_count"
      ],
      "properties": {
        "rules": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          }
        },
        "ds1_root_count": {
          "const": 261
        },
        "ds2_mapped_count": {
          "const": 173
        },
        "ds2_unbound_count": {
          "const": 60
        }
      }
    },
    "baseline_debt_manifest_ref": {
      "const": "architecture/atlas_surfaces/frontend-baseline-debt-manifest.json"
    },
    "ds2_unbound_adoption_ids": {
      "type": "array",
      "minItems": 60,
      "maxItems": 60,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/id"
      }
    },
    "reference_censuses": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/referenceCensus"
      }
    },
    "storage_construction_census": {
      "$ref": "#/$defs/storageConstructionCensus"
    },
    "entries": {
      "type": "array",
      "minItems": 261,
      "maxItems": 261,
      "items": {
        "$ref": "#/$defs/registerEntry"
      }
    },
    "subunits": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/subunitEntry"
      }
    },
    "supplemental_findings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/supplementalFinding"
      }
    },
    "seeded_negative_lifecycle": {
      "type": "array",
      "minItems": 23,
      "maxItems": 23,
      "items": {
        "$ref": "#/$defs/seededNegative"
      }
    }
  },
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "pathRef": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*\\.\\./).+$"
    },
    "ownerSlice": {
      "$ref": "surface-readiness-ledger.schema.json#/$defs/owningSlice"
    },
    "authorityBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authoritative_for",
        "may_not_use_for"
      ],
      "properties": {
        "authoritative_for": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          }
        },
        "may_not_use_for": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          }
        }
      }
    },
    "sourceLedger": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "ledger_id",
        "sha256",
        "expected_entries"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/pathRef"
        },
        "ledger_id": {
          "$ref": "#/$defs/id"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "expected_entries": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "sourceRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "decision_id",
        "decision_date"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/pathRef"
        },
        "decision_id": {
          "const": "D4"
        },
        "decision_date": {
          "$ref": "#/$defs/date"
        }
      }
    },
    "disposition": {
      "type": "string",
      "enum": [
        "use_as_is",
        "rebind_pending",
        "frozen_legacy_continuity",
        "delete_pending",
        "deleted",
        "retire_disposition",
        "wire_disposition"
      ]
    },
    "strangleStatus": {
      "type": "string",
      "enum": [
        "not_applicable",
        "pending",
        "strangled"
      ]
    },
    "evidenceLink": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ds1_entry_id",
        "ds2_adoption_ids"
      ],
      "properties": {
        "ds1_entry_id": {
          "$ref": "#/$defs/id"
        },
        "ds2_adoption_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        }
      }
    },
    "successor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "unit_id",
        "consumer_refs"
      ],
      "properties": {
        "unit_id": {
          "$ref": "#/$defs/id"
        },
        "consumer_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/pathRef"
          }
        }
      }
    },
    "decisionDetail": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "consumer_slice",
        "rationale"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "wire",
            "retire"
          ]
        },
        "consumer_slice": {
          "$ref": "#/$defs/ownerSlice"
        },
        "rationale": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "retirement_scope": {
          "type": "string",
          "enum": [
            "frontend_adoption",
            "frontend_exposure_registry"
          ]
        },
        "revisit_condition": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    },
    "registerEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "unit_id",
        "evidence_link",
        "disposition",
        "strangle_status",
        "owner",
        "owner_slice",
        "decision_date",
        "seed_rule",
        "rationale"
      ],
      "properties": {
        "unit_id": {
          "$ref": "#/$defs/id"
        },
        "evidence_link": {
          "$ref": "#/$defs/evidenceLink"
        },
        "disposition": {
          "$ref": "#/$defs/disposition"
        },
        "strangle_status": {
          "$ref": "#/$defs/strangleStatus"
        },
        "reference_census_id": {
          "$ref": "#/$defs/id"
        },
        "successor": {
          "$ref": "#/$defs/successor"
        },
        "decision_detail": {
          "$ref": "#/$defs/decisionDetail"
        },
        "aggregate_disposition_receipt": {
          "$ref": "#/$defs/aggregateMixedDispositionReceipt"
        },
        "owner": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "owner_slice": {
          "$ref": "#/$defs/ownerSlice"
        },
        "decision_date": {
          "$ref": "#/$defs/date"
        },
        "seed_rule": {
          "$ref": "#/$defs/id"
        },
        "rationale": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    },
    "aggregateMixedDispositionReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "receipt_id",
        "kind",
        "reason",
        "counts",
        "c03b_members",
        "reference_census_id",
        "pre_deletion_resurrection_anchor",
        "resurrection_rule"
      ],
      "properties": {
        "receipt_id": {
          "const": "ds4-c03b-ui-primitives-mixed-disposition"
        },
        "kind": {
          "const": "aggregate_mixed_disposition"
        },
        "reason": {
          "const": "no_production_consumer"
        },
        "counts": {
          "$ref": "#/$defs/aggregateDispositionCounts"
        },
        "c03b_members": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "items": {
            "$ref": "#/$defs/c03bPrimitiveDisposition"
          }
        },
        "reference_census_id": {
          "const": "census-ds4-c03b-dormant-primitives"
        },
        "pre_deletion_resurrection_anchor": {
          "$ref": "#/$defs/gitResurrectionAnchor"
        },
        "resurrection_rule": {
          "const": "recreate_in_atlas_ui_only_with_a_real_production_consumer_never_restore_in_the_app_tree"
        }
      }
    },
    "aggregateDispositionCounts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "total",
        "package_migrated",
        "dashboard_rebound",
        "retired",
        "use_as_is",
        "c03b_candidates",
        "production_consumers"
      ],
      "properties": {
        "total": {
          "type": "integer",
          "minimum": 0
        },
        "package_migrated": {
          "type": "integer",
          "minimum": 0
        },
        "dashboard_rebound": {
          "type": "integer",
          "minimum": 0
        },
        "retired": {
          "type": "integer",
          "minimum": 0
        },
        "use_as_is": {
          "type": "integer",
          "minimum": 0
        },
        "c03b_candidates": {
          "type": "integer",
          "minimum": 0
        },
        "production_consumers": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "c03bPrimitiveDisposition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "primitive",
        "disposition",
        "ds2_adoption_id",
        "governing_condition",
        "ledger_absence_reason"
      ],
      "properties": {
        "primitive": {
          "type": "string",
          "enum": [
            "DropdownMenu",
            "ScrollArea",
            "Separator",
            "Sheet",
            "Tabs"
          ]
        },
        "disposition": {
          "type": "string",
          "enum": [
            "retire",
            "use_as_is"
          ]
        },
        "ds2_adoption_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/id"
            },
            {
              "type": "null"
            }
          ]
        },
        "governing_condition": {
          "anyOf": [
            {
              "$ref": "#/$defs/nonEmptyString"
            },
            {
              "type": "null"
            }
          ]
        },
        "ledger_absence_reason": {
          "anyOf": [
            {
              "const": "no_exact_ds2_row"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "gitResurrectionAnchor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "git_commit",
        "files"
      ],
      "properties": {
        "git_commit": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "files": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "items": {
            "$ref": "#/$defs/gitBlobRef"
          }
        }
      }
    },
    "gitBlobRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "git_blob"
      ],
      "properties": {
        "path": {
          "type": "string",
          "enum": [
            "apps/runtime-dashboard/src/shared/ui/DropdownMenu.tsx",
            "apps/runtime-dashboard/src/shared/ui/DropdownMenu.a11y.test.tsx",
            "apps/runtime-dashboard/src/shared/ui/Separator.tsx",
            "apps/runtime-dashboard/src/shared/ui/Separator.a11y.test.tsx",
            "apps/runtime-dashboard/src/shared/ui/Sheet.tsx",
            "apps/runtime-dashboard/src/shared/ui/Sheet.a11y.test.tsx"
          ]
        },
        "git_blob": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        }
      }
    },
    "censusProbe": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "targets",
        "scan_roots",
        "expected_count",
        "observed_refs"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "path_absent",
            "reference_count",
            "protected_live_consumers",
            "typescript_import_census",
            "typescript_symbol_consumer_census"
          ]
        },
        "targets": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          }
        },
        "scan_roots": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/pathRef"
          }
        },
        "expected_count": {
          "type": "integer",
          "minimum": 0
        },
        "observed_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/pathRef"
          }
        },
        "checked_import_forms": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "direct",
              "barrel",
              "namespace",
              "relative",
              "dynamic",
              "composition"
            ]
          }
        }
      }
    },
    "referenceCensus": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "census_id",
        "captured_at",
        "covers_unit_ids",
        "ds1_evidence_ids",
        "result",
        "probes"
      ],
      "properties": {
        "census_id": {
          "$ref": "#/$defs/id"
        },
        "captured_at": {
          "type": "string",
          "format": "date-time"
        },
        "covers_unit_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "ds1_evidence_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "result": {
          "type": "string",
          "enum": [
            "zero_consumers",
            "live_consumers_found",
            "protected_live_chain"
          ]
        },
        "probes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/censusProbe"
          }
        },
        "verification_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/pathRef"
          }
        }
      }
    },
    "storageConstructionCensus": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "census_id",
        "captured_at",
        "scanner_rule_version",
        "production_source_count",
        "production_file_count",
        "site_count",
        "api_counts",
        "authority_factory_count",
        "authority_factory_receipts_sha256",
        "authority_factory_receipts",
        "rows_sha256",
        "sites"
      ],
      "properties": {
        "schema_version": { "const": "1.0" },
        "census_id": { "const": "ds5-c17b-storage-construction" },
        "captured_at": { "type": "string", "format": "date-time" },
        "scanner_rule_version": { "const": "c17b-declaration-resolver-v2" },
        "production_source_count": { "const": 574 },
        "production_file_count": { "const": 15 },
        "site_count": { "const": 36 },
        "api_counts": {
          "type": "object",
          "additionalProperties": false,
          "required": ["indexed_db", "web_storage", "zustand"],
          "properties": {
            "indexed_db": { "const": 5 },
            "web_storage": { "const": 26 },
            "zustand": { "const": 5 }
          }
        },
        "authority_factory_count": { "const": 9 },
        "authority_factory_receipts_sha256": { "$ref": "#/$defs/sha256" },
        "authority_factory_receipts": {
          "type": "array",
          "minItems": 9,
          "maxItems": 9,
          "items": { "$ref": "#/$defs/authorityFactoryReceipt" }
        },
        "rows_sha256": { "$ref": "#/$defs/sha256" },
        "sites": {
          "type": "array",
          "minItems": 36,
          "maxItems": 36,
          "items": { "$ref": "#/$defs/storageConstructionSite" }
        }
      }
    },
    "authorityFactoryReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "factory_site_id",
        "path",
        "factory",
        "declaration_chain",
        "source_fingerprint",
        "site_fingerprint"
      ],
      "properties": {
        "factory_site_id": { "$ref": "#/$defs/id" },
        "path": { "$ref": "#/$defs/pathRef" },
        "factory": {
          "enum": [
            "createAuthorityLocalStateEnvelopeFamily",
            "createAuthorityLocalStateFamily"
          ]
        },
        "declaration_chain": { "$ref": "#/$defs/nonEmptyString" },
        "source_fingerprint": { "$ref": "#/$defs/sha256" },
        "site_fingerprint": { "$ref": "#/$defs/sha256" }
      }
    },
    "authorityBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "factory_site_ids",
        "proof_kind",
        "proof_sha256",
        "source_fingerprints"
      ],
      "properties": {
        "factory_site_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        },
        "proof_kind": {
          "enum": [
            "owner_derived_arguments",
            "persistence_adapter_flow",
            "registered_transport_bootstrap",
            "registered_transport_parameter",
            "storage_provider_flow"
          ]
        },
        "proof_sha256": { "$ref": "#/$defs/sha256" },
        "source_fingerprints": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "source_fingerprint"],
            "properties": {
              "path": { "$ref": "#/$defs/pathRef" },
              "source_fingerprint": { "$ref": "#/$defs/sha256" }
            }
          }
        }
      }
    },
    "storageConstructionSite": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "site_id",
        "path",
        "resolved_api_declaration",
        "operation",
        "store_owner",
        "source_fingerprint",
        "site_fingerprint",
        "classification"
      ],
      "properties": {
        "site_id": { "$ref": "#/$defs/id" },
        "path": { "$ref": "#/$defs/pathRef" },
        "resolved_api_declaration": { "$ref": "#/$defs/nonEmptyString" },
        "operation": {
          "enum": [
            "acquire",
            "clear",
            "createJSONStorage",
            "createObjectStore",
            "delete",
            "get",
            "getItem",
            "key",
            "openDB",
            "persist",
            "put",
            "removeItem",
            "setItem"
          ]
        },
        "store_owner": { "$ref": "#/$defs/pathRef" },
        "source_fingerprint": { "$ref": "#/$defs/sha256" },
        "site_fingerprint": { "$ref": "#/$defs/sha256" },
        "classification": {
          "enum": [
            "scoped_authority",
            "interaction_benign",
            "rollout_cache_pending"
          ]
        },
        "scoped_envelope_owner": { "$ref": "#/$defs/pathRef" },
        "registered_codec_id": { "$ref": "#/$defs/id" },
        "authority_binding": { "$ref": "#/$defs/authorityBinding" },
        "benign_reason": {
          "enum": ["locale", "theme", "ui_preference"]
        },
        "owner_slice": { "$ref": "#/$defs/ownerSlice" },
        "capability_states": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "contract_only",
              "producer_missing",
              "artifact_missing",
              "bridge_missing",
              "consumer_missing",
              "verification_missing",
              "implemented_but_not_orchestrated",
              "surface_missing",
              "surface_out_of_scope",
              "semantic_test_missing"
            ]
          }
        },
        "closure_signal": { "$ref": "#/$defs/nonEmptyString" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "classification": { "const": "scoped_authority" } },
            "required": ["classification"]
          },
          "then": {
            "required": [
              "scoped_envelope_owner",
              "registered_codec_id",
              "authority_binding"
            ],
            "not": {
              "anyOf": [
                { "required": ["benign_reason"] },
                { "required": ["owner_slice"] },
                { "required": ["capability_states"] },
                { "required": ["closure_signal"] }
              ]
            }
          }
        },
        {
          "if": {
            "properties": { "classification": { "const": "interaction_benign" } },
            "required": ["classification"]
          },
          "then": {
            "required": ["benign_reason"],
            "not": {
              "anyOf": [
                { "required": ["scoped_envelope_owner"] },
                { "required": ["registered_codec_id"] },
                { "required": ["authority_binding"] },
                { "required": ["owner_slice"] },
                { "required": ["capability_states"] },
                { "required": ["closure_signal"] }
              ]
            }
          }
        },
        {
          "if": {
            "properties": { "classification": { "const": "rollout_cache_pending" } },
            "required": ["classification"]
          },
          "then": {
            "required": ["owner_slice", "capability_states", "closure_signal"],
            "not": {
              "anyOf": [
                { "required": ["scoped_envelope_owner"] },
                { "required": ["registered_codec_id"] },
                { "required": ["authority_binding"] },
                { "required": ["benign_reason"] }
              ]
            }
          }
        }
      ]
    },
