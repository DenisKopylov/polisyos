          "candidate_unverified",
          "grounded",
          "valued",
          "promoted",
          "blocked"
        ],
        "title": "Status",
        "type": "string"
      },
      "target_selector": {
        "$ref": "#/$defs/TargetSelectorBinding"
      },
      "target_world_slots": {
        "items": {
          "type": "string"
        },
        "title": "Target World Slots",
        "type": "array"
      },
      "world_model_record_ref": {
