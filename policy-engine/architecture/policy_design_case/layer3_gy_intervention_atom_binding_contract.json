    "additionalProperties": false,
    "description": "Bind one executable Trinity action to one proof-kernel causal atom.\n\n``InterventionAtomBinding`` is a bridge over existing halves, not a second\nintervention hierarchy. The Trinity side remains ``InterventionSpec`` plus\n``LinkedIntervention`` slots. The proof-kernel side remains a typed\n``InterventionExpr``, ``QueryTarget``, and ``InterventionIdentificationPlan``.\nThis artifact records only the content correspondence needed by the\ngeneration cycle: same selector context, same written world slot, consistent\noperator kind, authoritative estimand, forward world-model reference, and a\ntime-invariant content hash.\n\nAttributes:\n    atom_id: Stable atom identifier derived from the content hash.\n    problem_frame_ref: ProblemFrame or DesignProblem reference.\n    policy_spec_ref: PolicySpec or Trinity bundle reference.\n    intervention_id: Trinity intervention id.\n    operator_kind: Trinity mechanism kind plus proof-kernel type.\n    target_selector: Trinity selector and population projection.\n    target_world_slots: Linker-resolved slots written by the action.\n    read_slots: Linker-resolved slots read by the action.\n    direct_effect_bundle: Trinity direct-effect projection.\n    causal_do_expr: Proof-kernel intervention expression projection.\n    intended_downstream_estimand: Authoritative QueryTarget projection.\n    causal_path_or_identification_plan_ref: Identification plan projection.\n    world_model_record_ref: Forward hook to the future WorldModelRecord.\n    measurement_expectations: Retained Trinity free-form metadata.\n    measurement_expectations_authority: Always supporting metadata.\n    content_hash: Time-invariant hash over the content-bound fields.\n    producer_ref: Producer that emitted this atom candidate.\n    provenance_refs: Upstream Trinity/proof-kernel provenance references.\n    status: Lifecycle state for A-side promotion.",
    "properties": {
      "atom_id": {
        "pattern": "^atom_[a-f0-9]{16}$",
        "title": "Atom Id",
        "type": "string"
      },
      "causal_do_expr": {
        "$ref": "#/$defs/CausalDoExpression"
      },
      "causal_path_or_identification_plan_ref": {
        "$ref": "#/$defs/IdentificationPlanRef"
      },
      "content_hash": {
        "pattern": "^sha256:[0-9a-f]{64}$",
        "title": "Content Hash",
        "type": "string"
      },
      "direct_effect_bundle": {
        "$ref": "#/$defs/DirectEffectBundle"
      },
      "intended_downstream_estimand": {
        "$ref": "#/$defs/IntendedDownstreamEstimand"
      },
      "intervention_id": {
        "minLength": 1,
        "title": "Intervention Id",
        "type": "string"
      },
      "measurement_expectations": {
        "additionalProperties": true,
        "title": "Measurement Expectations",
        "type": "object"
      },
      "measurement_expectations_authority": {
        "const": "supporting_metadata",
        "default": "supporting_metadata",
        "title": "Measurement Expectations Authority",
        "type": "string"
      },
      "operator_kind": {
        "$ref": "#/$defs/OperatorKind"
      },
      "policy_spec_ref": {
        "pattern": "^(?:[a-z][a-z0-9_.-]*|sha256:[0-9a-f]{64})$",
        "title": "Policy Spec Ref",
        "type": "string"
      },
      "problem_frame_ref": {
        "pattern": "^(?:[a-z][a-z0-9_.-]*|sha256:[0-9a-f]{64})$",
        "title": "Problem Frame Ref",
        "type": "string"
      },
      "producer_ref": {
        "minLength": 1,
        "title": "Producer Ref",
        "type": "string"
      },
      "provenance_refs": {
        "default": [],
        "items": {
          "type": "string"
        },
        "title": "Provenance Refs",
        "type": "array"
      },
      "read_slots": {
        "default": [],
        "items": {
          "type": "string"
        },
        "title": "Read Slots",
        "type": "array"
      },
      "schema_version": {
        "const": "policyos.runtime.intervention_atom_binding.v1",
        "default": "policyos.runtime.intervention_atom_binding.v1",
        "title": "Schema Version",
        "type": "string"
      },
      "status": {
