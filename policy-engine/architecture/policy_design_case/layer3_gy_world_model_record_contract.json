          },
          "source_data_snapshot_id": {
            "minLength": 1,
            "title": "Source Data Snapshot Id",
            "type": "string"
          },
          "transport_score_refs": {
            "default": [],
            "items": {
              "type": "string"
            },
            "title": "Transport Score Refs",
            "type": "array"
          }
        },
        "required": [
          "skg_snapshot_ref",
          "skg_version_id",
          "source_data_snapshot_id"
        ],
        "title": "SkgCausalPriorRef",
        "type": "object"
      },
      "SubstrateLayer": {
        "description": "Production-data substrate layer labels.",
        "enum": [
          "L1",
          "L2",
          "L3",
          "L4",
          "L5",
          "L6"
        ],
        "title": "SubstrateLayer",
        "type": "string"
      },
      "SubstrateRegistryRef": {
        "additionalProperties": false,
        "description": "Name the production-data substrate registry version used by this world.",
        "properties": {
          "content_hash": {
            "pattern": "^sha256:[0-9a-f]{64}$",
            "title": "Content Hash",
            "type": "string"
          },
          "registry_artifact_ref": {
            "anyOf": [
              {
                "type": "string"
              },
              {
