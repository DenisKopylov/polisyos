            "default": null,
            "title": "Content Query Row Count"
          },
          "provenance_manifest_ref": {
            "minLength": 1,
            "title": "Provenance Manifest Ref",
            "type": "string"
          },
          "snapshot_id": {
            "minLength": 1,
            "title": "Snapshot Id",
            "type": "string"
          },
          "snapshot_root": {
            "minLength": 1,
            "title": "Snapshot Root",
            "type": "string"
          },
          "world_query_policy": {
            "minLength": 1,
            "title": "World Query Policy",
            "type": "string"
          }
        },
        "required": [
          "snapshot_root",
          "snapshot_id",
          "branch",
          "world_query_policy",
          "provenance_manifest_ref"
