            "default": null,
            "title": "Unit"
          }
        },
        "required": [
          "slot_id",
          "state_path",
          "entity_scope",
          "temporal_granularity"
        ],
        "title": "PolicySlotBinding",
        "type": "object"
      },
      "ResolvedSubstrateEntryRef": {
        "additionalProperties": false,
        "description": "Resolved substrate registry entry consumed by a world-model version.",
        "properties": {
          "coverage_score": {
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Coverage Score",
            "type": "number"
          },
          "data_version": {
            "minLength": 1,
            "title": "Data Version",
            "type": "string"
          },
          "entry_content_hash": {
            "pattern": "^sha256:[0-9a-f]{64}$",
            "title": "Entry Content Hash",
            "type": "string"
          },
          "family_id": {
            "minLength": 1,
            "title": "Family Id",
            "type": "string"
          },
          "identification_mode": {
            "minLength": 1,
            "title": "Identification Mode",
            "type": "string"
          },
          "layer": {
            "$ref": "#/$defs/SubstrateLayer"
          },
          "schema_regime_id": {
            "minLength": 1,
            "title": "Schema Regime Id",
            "type": "string"
          },
          "snapshot_id": {
            "minLength": 1,
            "title": "Snapshot Id",
            "type": "string"
          },
          "source_id": {
            "minLength": 1,
            "title": "Source Id",
            "type": "string"
          },
          "source_snapshot_id": {
            "minLength": 1,
            "title": "Source Snapshot Id",
            "type": "string"
          },
          "trust_cap": {
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Trust Cap",
            "type": "number"
          },
          "trust_tier": {
            "minLength": 1,
            "title": "Trust Tier",
            "type": "string"
          }
        },
        "required": [
          "source_id",
          "family_id",
          "layer",
          "coverage_score",
          "trust_tier",
          "trust_cap",
          "identification_mode",
          "schema_regime_id",
          "data_version",
          "snapshot_id",
          "source_snapshot_id",
          "entry_content_hash"
        ],
        "title": "ResolvedSubstrateEntryRef",
        "type": "object"
      },
      "SimulationModelRef": {
        "additionalProperties": false,
        "description": "Reference the IR model contract and mechanism/program graph surfaces.",
        "properties": {
          "assumptions": {
            "default": [],
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "title": "Assumptions",
            "type": "array"
          },
          "calibrated": {
            "default": false,
            "title": "Calibrated",
            "type": "boolean"
          },
          "calibration_ref": {
            "anyOf": [
              {
                "pattern": "^sha256:[0-9a-f]{64}$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Calibration Ref"
          },
          "data_snapshot_ref": {
            "pattern": "^sha256:[0-9a-f]{64}$",
            "title": "Data Snapshot Ref",
            "type": "string"
          },
          "fidelity_level": {
            "minLength": 1,
            "title": "Fidelity Level",
            "type": "string"
          },
          "gcm_refs": {
            "default": [],
            "items": {
              "type": "string"
            },
            "title": "Gcm Refs",
            "type": "array"
          },
          "mechanism_refs": {
            "default": [],
            "items": {
              "type": "string"
            },
            "title": "Mechanism Refs",
            "type": "array"
          },
          "model_id": {
            "minLength": 1,
            "title": "Model Id",
            "type": "string"
          },
          "model_spec_hash": {
            "pattern": "^sha256:[0-9a-f]{64}$",
            "title": "Model Spec Hash",
            "type": "string"
          },
          "model_spec_ref": {
            "pattern": "^sha256:[0-9a-f]{64}$",
            "title": "Model Spec Ref",
            "type": "string"
          },
          "ncm_refs": {
            "default": [],
            "items": {
              "type": "string"
            },
            "title": "Ncm Refs",
            "type": "array"
          },
          "program_graph_refs": {
            "default": [],
            "items": {
              "type": "string"
            },
            "title": "Program Graph Refs",
            "type": "array"
          },
          "registry_bundle_ref": {
            "pattern": "^sha256:[0-9a-f]{64}$",
            "title": "Registry Bundle Ref",
            "type": "string"
          }
        },
