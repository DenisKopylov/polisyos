          "model_spec_ref",
          "model_spec_hash",
          "model_id",
          "data_snapshot_ref",
          "registry_bundle_ref",
          "fidelity_level"
        ],
        "title": "SimulationModelRef",
        "type": "object"
      },
      "SkgCausalPriorRef": {
        "additionalProperties": false,
        "description": "Reference SKG/G2 causal priors and transport traces for this world.",
        "properties": {
          "edge_prior_refs": {
            "default": [],
            "items": {
              "type": "string"
            },
            "title": "Edge Prior Refs",
            "type": "array"
          },
          "query_trace_refs": {
            "default": [],
            "items": {
              "type": "string"
            },
            "title": "Query Trace Refs",
            "type": "array"
          },
          "skg_snapshot_ref": {
            "minLength": 1,
            "title": "Skg Snapshot Ref",
            "type": "string"
          },
          "skg_version_id": {
            "minLength": 1,
            "title": "Skg Version Id",
