            "default": [],
            "items": {
              "type": "string"
            },
            "title": "Unavailable Data",
            "type": "array"
          },
          "unresolved_conflicts": {
            "default": [],
            "items": {
              "type": "string"
            },
            "title": "Unresolved Conflicts",
            "type": "array"
          }
        },
        "title": "WorldModelLimitations",
        "type": "object"
      }
    },
    "additionalProperties": false,
    "description": "Name one versioned, simulatable world built from existing substrates.\n\n``WorldModelRecord`` is a bridge contract, not a second world store. The\nFabric world remains the fact/provenance/snapshot owner, Data Forge remains\nthe read-surface binding owner, ``ModelSpec`` remains the simulation\ncontract, Foundry owns ``GlobalState`` and mechanism execution, and SKG/G2\nown causal prior traces. This record binds their corresponding versions,\nrecords a policy-slot map into the bound state, and carries Phase-6\ndeployment-update refs as forward hooks only.",
    "properties": {
      "authority_status": {
        "default": "bound",
        "enum": [
          "candidate_unverified",
          "bound",
          "limited",
          "contested",
          "blocked",
          "publishable"
        ],
        "title": "Authority Status",
        "type": "string"
      },
      "branch_mode": {
        "$ref": "#/$defs/BranchMode"
      },
      "content_hash": {
        "pattern": "^sha256:[0-9a-f]{64}$",
        "title": "Content Hash",
        "type": "string"
      },
      "created_at": {
        "title": "Created At",
        "type": "string"
      },
      "data_forge_binding_ref": {
        "$ref": "#/$defs/DataForgeBindingRef"
      },
      "deployment_update_refs": {
        "$ref": "#/$defs/DeploymentUpdateRefs"
      },
      "fabric_world_ref": {
        "$ref": "#/$defs/FabricWorldRef"
      },
      "foundry_binding_ref": {
        "$ref": "#/$defs/FoundryBindingRef"
      },
      "limitations": {
        "$ref": "#/$defs/WorldModelLimitations"
      },
      "policy_domain": {
        "minLength": 1,
        "title": "Policy Domain",
        "type": "string"
      },
      "policy_slot_map": {
        "items": {
          "$ref": "#/$defs/PolicySlotBinding"
        },
        "title": "Policy Slot Map",
        "type": "array"
      },
      "population_scope": {
        "minLength": 1,
        "title": "Population Scope",
        "type": "string"
      },
      "producer_ref": {
        "minLength": 1,
        "title": "Producer Ref",
        "type": "string"
      },
      "region_or_jurisdiction": {
        "minLength": 1,
        "title": "Region Or Jurisdiction",
        "type": "string"
      },
      "resolution": {
        "minLength": 1,
        "title": "Resolution",
        "type": "string"
      },
      "schema_version": {
        "default": "policyos.runtime.world_model_record.v1",
        "title": "Schema Version",
        "type": "string"
      },
      "simulation_model_ref": {
        "$ref": "#/$defs/SimulationModelRef"
      },
      "skg_causal_prior_ref": {
        "$ref": "#/$defs/SkgCausalPriorRef"
      },
      "substrate_registry_ref": {
        "$ref": "#/$defs/SubstrateRegistryRef"
      },
      "tx_time_scope": {
        "minLength": 1,
        "title": "Tx Time Scope",
        "type": "string"
      },
      "valid_time_scope": {
        "minLength": 1,
        "title": "Valid Time Scope",
        "type": "string"
      },
      "world_model_record_id": {
        "pattern": "^world_model_record_[a-f0-9]{16}$",
        "title": "World Model Record Id",
        "type": "string"
      }
    },
    "required": [
      "world_model_record_id",
      "producer_ref",
      "content_hash",
      "region_or_jurisdiction",
      "population_scope",
      "policy_domain",
      "valid_time_scope",
      "tx_time_scope",
      "resolution",
      "branch_mode",
      "fabric_world_ref",
      "data_forge_binding_ref",
      "simulation_model_ref",
      "foundry_binding_ref",
      "skg_causal_prior_ref",
      "substrate_registry_ref",
      "policy_slot_map"
    ],
    "title": "WorldModelRecord",
    "type": "object"
  },
  "owner": "polisyos.runtime.quality.world_model_record.WorldModelRecord",
  "parallel_world_store_allowed": false,
  "phase_6_forward_hook": "deployment_update_refs",
  "producer": "build_world_model_record",
  "schema_version": "policyos.policy_design_case.layer3_gy.world_model_record_contract.v1",
  "source_module": "src/polisyos/runtime/quality/world_model_record.py",
  "synthetic_world_disposition": "benchmark_only_not_production_world_owner",
  "unify_existing_substrates": [
    "fabric.world.query.WorldQueryRequest",
    "data_forge.kernel.snapshot.write_snapshot_binding",
    "ir.model_layer.model_spec.ModelSpec",
    "foundry.data_plane.bindings.build_input_bindings",
    "data_forge.read_api.academic.SKGQuery",
    "runtime.quality.substrate_registry.SubstrateRegistry"
  ],
  "value_step_naming_deferred_to": "GY-N8",
  "world_model_record_schema_version": "policyos.runtime.world_model_record.v1"
}
