            "title": "Phase",
            "type": "string"
          },
          "posterior_update_refs": {
            "default": [],
            "items": {
              "type": "string"
            },
            "title": "Posterior Update Refs",
            "type": "array"
          },
          "refute_refs": {
            "default": [],
            "items": {
              "type": "string"
            },
            "title": "Refute Refs",
            "type": "array"
          },
          "reissue_refs": {
            "default": [],
            "items": {
              "type": "string"
            },
            "title": "Reissue Refs",
            "type": "array"
          }
        },
        "title": "DeploymentUpdateRefs",
        "type": "object"
      },
      "FabricWorldRef": {
        "additionalProperties": false,
        "description": "Reference the Fabric world snapshot/branch and bitemporal query context.",
        "properties": {
          "as_of_tx_time": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "As Of Tx Time"
          },
          "as_of_valid_time": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "As Of Valid Time"
          },
          "branch": {
            "minLength": 1,
            "title": "Branch",
            "type": "string"
          },
          "content_query_digest": {
            "anyOf": [
