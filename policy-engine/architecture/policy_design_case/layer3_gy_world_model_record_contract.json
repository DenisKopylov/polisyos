            "type": "string"
          },
          "lineage_refs": {
            "default": [],
            "items": {
              "type": "string"
            },
            "title": "Lineage Refs",
            "type": "array"
          },
          "merkle_root": {
            "minLength": 1,
            "title": "Merkle Root",
            "type": "string"
          },
          "provenance_manifest_ref": {
            "minLength": 1,
            "title": "Provenance Manifest Ref",
            "type": "string"
          },
          "quality_gate_refs": {
            "default": [],
            "items": {
              "type": "string"
            },
            "title": "Quality Gate Refs",
            "type": "array"
          },
          "read_api_identity": {
            "minLength": 1,
            "title": "Read Api Identity",
            "type": "string"
          },
          "release_id": {
            "minLength": 1,
            "title": "Release Id",
            "type": "string"
          },
          "role": {
            "minLength": 1,
            "title": "Role",
            "type": "string"
          },
          "snapshot_id": {
            "minLength": 1,
            "title": "Snapshot Id",
            "type": "string"
          },
          "snapshot_ref": {
            "minLength": 1,
            "title": "Snapshot Ref",
            "type": "string"
          }
        },
        "required": [
          "snapshot_id",
          "release_id",
          "role",
          "read_api_identity",
          "snapshot_ref",
          "merkle_root",
          "data_hash",
