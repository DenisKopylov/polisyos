        "title": "FabricWorldRef",
        "type": "object"
      },
      "FoundryBindingRef": {
        "additionalProperties": false,
        "description": "Reference the actual Foundry input binding and bound GlobalState snapshot.",
        "properties": {
          "bound_state_snapshot_ref": {
            "pattern": "^sha256:[0-9a-f]{64}$",
            "title": "Bound State Snapshot Ref",
            "type": "string"
          },
          "input_bindings_ref": {
            "pattern": "^sha256:[0-9a-f]{64}$",
            "title": "Input Bindings Ref",
            "type": "string"
