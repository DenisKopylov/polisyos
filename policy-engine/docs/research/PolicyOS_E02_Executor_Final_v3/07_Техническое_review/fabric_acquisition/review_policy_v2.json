  "conclusions": [
    {
      "finding": "PS-F01",
      "packets": [
        "FUN-03"
      ],
      "verdict": "ACCEPT",
      "reason": "Actual tracker uses FDR, precision and FOR denominators under legacy FPR/TPR/FNR names. New versioned counts/metric/window/cohort contract and consumer migration directly address this. DEC selects the operational purpose rather than forcing FNR. Observed zero remains data; population qualification requires justified sampling/interval/power, not n>0. Existing rejected-label burn-in is acknowledged, while selected lessons/sentinels are not treated as representative traffic.",
      "evidence": [
        "stages.py:398–408,502–545,682–714",
        "calibration_report.py:112–171",
        "cold_start.py:190–230,250–280",
        "funnel/orchestrator.py:781–804,2096–2134",
        "funnel/correlation.py:83–111"
      ]
    },
    {
      "finding": "PS-F07",
      "packets": [
        "FUN-03"
      ],
      "verdict": "ACCEPT",
      "reason": "record really selects named scores by truthiness. None-only fallback fixes zero without replacing the intended carrier or allowing invalid score profiles. Symmetric zero-versus-distinct-fallback cases catch each carrier independently; malformed inputs do not append. Snapshot extraction version and source/status/domain guards remain explicit.",
      "evidence": [
        "stages.py:370–396",
        "stage_contracts.py:23–61",
        "test_fun_03.py:234–254"
      ]
    },
    {
      "finding": "PS-F03",
      "packets": [
        "OPT-02"
      ],
      "verdict": "ACCEPT",
      "reason": "Existing duplicate logic is pending-only; cold/batch branches bypass it and random fallback returns a new random attempt after 20 misses. Revised completed/pending measurement scope and typed search-budget exhaustion address actual paths. Finite-domain exhaustion requires a complete feasible census; genuine replicas remain allowed and continuous identity is not rounded away.",
      "evidence": [
        "bayesian.py:896–1006,1601–1649",
        "test_bayesian.py:385–452",
        "grid.py:89–126"
      ]
    },
    {
      "finding": "PS-F02",
      "packets": [
        "OPT-03",
        "TRN-01"
      ],
      "verdict": "ACCEPT_OPTIONAL_SCOPE",
      "reason": "The source-fitted historical guard is deliberate and verified by current accepted1/rejected3 test. The proposal does not remove that guard or rewrite its tests. Separate strategy-neutral measured-observation reuse is an optional DEC/profile, with selected actual source, objective/unit/data/split/tenant/space/replica validation; predictions and surrogate continuation remain different entities.",
      "evidence": [
        "bayesian_generator.py:437–507",
        "bayesian.py:249–312,1209–1266",
        "test_v5_search_pipeline.py:2063–2104"
      ]
    },
    {
      "finding": "PS-F04",
      "packets": [
        "SIM-03"
      ],
      "verdict": "ACCEPT_AFTER_SEED_FIX",
      "reason": "The noise expression can use actual u and parent a through the existing nonlinear expression owner. Empty evidence leaves sampled noise active; paired worlds share the draw. Formula baseline=u, policy=2+2u, effect=2+u gives a separate algebraic oracle. Actual trace variation, first-seed/replay and pairing mutations strengthen native execution evidence, without pretending to validate a population law. Native request schedule now correctly uses seed7/replications3→7,8,9.",
