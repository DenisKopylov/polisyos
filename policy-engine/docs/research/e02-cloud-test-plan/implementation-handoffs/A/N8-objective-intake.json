  "property": {
    "statement": "The new N8 helper binds a consumed CAS-resolved N5 result to the expected candidate, outcome and intervention-atom identities, then applies the simulate-only blocker/tamper refusals before owner-gateway authority.",
    "runtime_path": [
      "N5 producer result",
      "persisted CAS reference",
      "simulation_evaluation_input_ref candidate/outcome/atom recomputation",
      "FoundryValuePort consumer",
      "simulate-only owner-gateway refusal"
    ],
    "code_actually_checks": "Expected candidate outcome and intervention-atom IDs are reconstructed from the active candidate and compared with the resolved N5 artifact before the helper returns an evaluation input; simulate-only checks reject unknown/fatal blockers and the tampered persisted reference.",
    "proxy_divergence": "Correct shape/hash alone is insufficient: a CAS result with another candidate/outcome/atom binding must be refused. The focused mismatch and removal controls exercise that divergence, but do not establish the full conditional production surface."
  },
  "predicate_basis": "recomputed",
