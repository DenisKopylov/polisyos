  "property": {
    "statement": "When the N7 controller has no precomposed resolver, it loads the configured, manifest-checked capability-index release and builds the existing resolver from that release; a controlled query over an emitted capability row returns a binding tied to the loaded release. An unavailable release becomes a typed N7 refusal instead of a fixture fallback.",
    "runtime_path": [
      "Test fixture inputs -> canonical CapabilityIndexCompiler(mode=fixture) -> persisted DuckDB and manifest in pytest temp storage.",
      "GenerationCycleController._n7_capability_resolver -> capability_discovery.load_default_capability_index_release -> RequirementToCapabilityResolver.from_capability_index.",
      "RequirementToCapabilityResolver.resolve receives a query built from the loaded index capability row and returns the same capability_index_ref."
    ],
    "proxy_divergence": "A loader marker or schema presence could pass while the consumer used another index. The test observes the configured loader call, checks release_ref, forbids governed_fixture fallback, and resolves an index-derived query; those assertions distinguish the configured persisted-release path.",
    "negative_controls": [
      "Four unavailable states: missing configuration, missing DuckDB, invalid manifest digest, and malformed database all produce the typed n7_capability_index_unavailable error and expected provider reason.",
      "Present empty requirements and the exact any_of gap do not invoke the resolver.",
      "Controller routing reports acquisition_required on unavailable N7 and creates no acquisition receipt/routing report."
    ],
    "authority_boundary": "The compiled index is mode=fixture and proves configured loader/resolver wiring only. It is not C source authority, an action permission, production admission, or world growth."
  },
  "predicate_basis": "consumer_asserted",
