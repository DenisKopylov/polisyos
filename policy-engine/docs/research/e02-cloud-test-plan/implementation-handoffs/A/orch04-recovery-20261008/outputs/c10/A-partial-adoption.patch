+            expected_parent = parent_by_ref.get(node_ref)
+            expected_children = tuple(children_by_ref[node_ref])
+            if (
+                node.parent_ref != expected_parent
+                or node.depth != depths[node_ref]
+                or node.child_refs != expected_children
+            ):
