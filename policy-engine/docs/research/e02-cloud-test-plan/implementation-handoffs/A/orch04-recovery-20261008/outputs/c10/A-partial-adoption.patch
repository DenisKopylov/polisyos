+
+        depths: dict[str, int] = {}
+
+        def visit(node_ref: str, depth: int) -> None:
+            if node_ref in depths or depth > self.recursive_budget.max_depth:
+                raise ValueError("recursive_partial_graph_topology_incoherent")
+            depths[node_ref] = depth
