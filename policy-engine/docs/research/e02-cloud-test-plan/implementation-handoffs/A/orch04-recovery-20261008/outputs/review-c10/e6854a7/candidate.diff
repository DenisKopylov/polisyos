+            ),
+          )}
+        </div>
+      ) : checkpoint ? (
+        <p data-testid="overview-checkpoint-refused">
+          {t("pages.runs.candidateSimulation.checkpointRefused")}
+        </p>
+      ) : null}
+    </Card>
+  );
+}
