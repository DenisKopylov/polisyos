+                    parent_ref=parent_by_node.get(node_ref),
+                    depth=depths[node_ref],
+                    child_refs=tuple(children_by_node[node_ref]),
+                    design_problem_ref=_problem_ref(problems_by_node[node_ref]),
+                )
+            )
