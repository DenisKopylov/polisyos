    {
      "id": "B130@TRN-01",
      "finding_id": "B130",
      "criterion_card": "TRN-01",
      "canonical_closure_owner": "TRN-01",
      "role": "canonical_owner",
      "original_fragment": {
        "document_key": "B_r19",
