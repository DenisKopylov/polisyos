  "available_contract": "BudgetMiddleware.budget_state reads the configured recorded state; current282/adapters29d identity is public, runtime dae identity absent. FileBudgetLedger.snapshot() already returns typed BudgetLedgerSnapshot, but no checked middleware profile exposes a public snapshot delegate. Checked ExecutionContext has no budget field.",
  "requested_minimum": {
    "source_path": "policy-engine/src/polisyos/scientist/orchestration/engine/budget_middleware.py",
    "existing_supplier_type": "policy-engine/src/polisyos/scientist/orchestration/engine/budget_ledger.py:BudgetLedgerSnapshot",
    "proposed_signature": "owner-chosen public budget snapshot method -> BudgetLedgerSnapshot | None",
    "semantics": "Read the already configured ledger snapshot under middleware lock, without a second ledger parameter. Memory profile returns explicit unavailable snapshot/None, not a synthetic durable ledger, revision or receipt. Delegate must preserve schema/ledger/contract/revision/spend_receipts from one canonical supplier view.",
    "test_path": "policy-engine/tests/unit/scientist/orchestration/engine/test_budget_middleware.py",
    "acceptance": "Actual FileBudgetLedger settlement/reopen through a fresh configured middleware returns the same typed snapshot revision and immutable event receipt; another real writer updates recorded spend and revision; unsupported/corrupt supplier schema refuses; memory accounting has no synthetic receipt/revision. D consumes only the public port and preserves cost-origin unavailability until separately supplied."
  },
  "D_consumer_paths": [
    "policy-engine/src/polisyos/scientist/methods/search/controller.py:_refresh_budget_snapshot",
    "policy-engine/src/polisyos/scientist/methods/search/run_state.py:budget_evidence",
    "policy-engine/src/polisyos/scientist/methods/search/stopping.py:CostBudgetStopping"
  ],
  "actual_current_consumer": "Public recorded-state scalar and optional public owner identity; recorded_by_provider aggregate. ledger revision/receipt and provider cost-origin unavailable. Configured middleware remains the owner; no private _ledger access, new ledger, producer billing/source authority or run attribution invented.",
  "limits": [
