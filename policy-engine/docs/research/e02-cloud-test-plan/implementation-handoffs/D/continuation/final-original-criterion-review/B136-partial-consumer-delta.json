  "mechanism_review": {
    "actual_route": "LessonRegistry.query_with_transfer -> namespaced find_transfer_candidates -> existing FileSystemCAS ArtifactRef load -> admission predicate/projected status -> materialize_transfer -> namespaced persisted index -> fresh LessonRegistry reader",
    "shared_query_predicate": "source_run_id equality, min_confidence, effective trust, stage/fidelity/candidate/task/domain/tag filters remain before eligible discovery quota and before persistence and return",
    "partial_answer_policy": "Retain admitted local results, fill remaining slots with admitted transfer evidence, suppress copies of original evidence already returned locally and copies from several discovery namespaces before discovery quota/materialization. No weakening on local miss.",
    "evidence_identity": "Canonical JSON of original semantic/source content. Excludes route-generated lesson_id/domain/trust/provenance/access/transfer_chain and the materialized_transfer metadata marker. Retains created_at, source_run_id, original run/domain/tenant, source refs, candidate, summary, other metadata and substantive fields.",
    "distinct_newer_evidence": "created_at stays in identity. Actual new-CAS same-pattern newer version is discoverable despite an older materialized result and increments the existing index through ordinary materialize path. This is existing persisted version behavior, not a scientific novelty or authorized revalidation law.",
    "quota_order": "matches are eligibility-filtered and sorted first; evidence duplicates removed before candidates reach context.limit; query_with_transfer passes exclude_cards=results before any new materialization.",
    "freshness_and_access": "Future-as-of refusal remains common to all routes; same TTL/confidence/trust applies locally and transferred. Access can update retention sidecar but not artifact_ref/card_refs/occurrence_count/evidence time/transfer chain.",
    "independent_expected_output_basis": "Tests assert literal expected local+distinct summaries/trust/source IDs and exact CAS-created_at/ref/index evidence snapshots. They do not use the new evidence-identity helper as their expected-value oracle."
  },
  "ordinary_consumers": [
    "test_partial_local_answer_is_filled_by_one_admitted_transfer: real CAS source and target; fresh reader sees materialized card",
    "test_source_run_filter_excludes_other_sources_before_partial_fill: equality admits allowed-source on both routes, wrong source not materialized",
    "test_duplicate_evidence_across_routes_does_not_consume_partial_quota_or_refresh: local materialization plus three copied namespaces returns duplicate+distinct and preserves original evidence",
    "test_distinct_newer_evidence_is_not_suppressed_as_route_metadata: fresh source CAS occurrence remains eligible",
    "future/stale paired route controls: irrelevant transfer never enters destination index",
    "Existing actual SearchController._build_lesson_hints typed and JSON contexts and destination projection are exercised in the full 40-case run"
  ],
