+id = "2026-10-08-c09-backtest-interval-admission"
+title = "Preserve unavailable backtest intervals and their requested denominator"
+type = "fixed"
+component = "scientist"
+owner = "team-scientist"
+summary = "Admit finite ordered interval pairs without reordering or truncation, retain point comparisons and paired-cell limitations, and withhold trust eligibility when requested interval evaluation is limited."
