{"notes":["v2.0: Added formal algebra properties (commutativity, associativity, idempotency)","v2.0: Added conflict_resolution strategies","v2.0: Added type constraints for SUM rule"],"rules":{"error":{"associativity":true,"commutativity":true,"conflict_resolution":"error","description":"Explicit conflict detection - raises MergeConflict","idempotency":true,"kind":"error","rule_id":"error"},"override":{"associativity":false,"commutativity":false,"conflict_resolution":"last","description":"Last-write-wins by node_id ordering","idempotency":true,"kind":"override","rule_id":"override"},"priority":{"associativity":true,"commutativity":true,"conflict_resolution":"error","default_priority":100,"description":"Highest priority wins, node_id tiebreaker","idempotency":true,"kind":"priority","rule_id":"priority"},"sum":{"allowed_value_types":["int","decimal","array"],"associativity":true,"commutativity":true,"conflict_resolution":"aggregate","description":"Additive merge: v1 + v2 (commutative, associative)","idempotency":false,"kind":"sum","rule_id":"sum"}},"schema_version":"2.0"}