  "release_fragment": {
    "id": "2026-10-08-c08-partial-graph-query",
    "title": "Preserve finite CPDAG query completion limits",
    "type": "added",
    "component": "foundry",
    "owner": "team-foundry",
    "summary": "Evaluate every consistent extension in a declared finite static CPDAG query profile and persist common or conditional results through existing proof artifacts.",
    "change_class": "internal",
    "surface_classification": "internal: bounded CausalEngine partial-graph query routing",
    "compatibility": "Existing static DAG/ADMG identification and reconciliation remain unchanged. CPDAG query routing supports at most four observed nodes with fixed arrows/tail-tail edges and one ordinary unconditional treatment/outcome. Existing pag_ambiguous means conditional or unsupported completion result; it does not add PAG identification support.",
    "migration": "Consume persisted partial_graph_query limitation and completion scope; do not treat sampled agreement or a declared graph as scientific authority.",
