  "author_proposals": [
    {
      "id": "B31",
      "outcome": "held",
      "evidence_boundary": "The synthetic ForestDR witness demonstrates an actual native fit/inference call chain and typed numerical output, but supplies no owner-derived identification set or producer-owned join binding the output to the same source-derived estimand and unit consumed downstream. It therefore does not demonstrate B31's required separation and preservation of native statistical/model uncertainty from identification bounds for that coordinate, and does not close B31. The legacy 1.96/CATE-variance guard is a separate unqualified HTE-inference limitation documented by the HTE decision packet.",
      "next_check": "Keep B31 held/not_adjudicated pending G and the B31-specific producer-owned source/assignment/estimand/unit join plus native-uncertainty consumer falsifier described in LOCAL/decisions/b31-s3-owner-coordinate-current-packet-v1-20261011.md@938c36d42a0401f79bb40040a34b79a5772055db476f814349fab717733dc54d. Treat any new point-without-ATE-inference or inference-basis contract as a separate technical proposal for G under LOCAL/decisions/g-choice-hte-ate-inference-unavailable-20261021.md@f9a2aaf523b3300498821e3ba8cedc8611f288baef23ab9e64467ec8826dbf6; that packet expressly does not adjudicate B31.",
      "status_authority": "Author recommendation held/not_adjudicated only; G remains sole adjudicator."
    }
  ],
