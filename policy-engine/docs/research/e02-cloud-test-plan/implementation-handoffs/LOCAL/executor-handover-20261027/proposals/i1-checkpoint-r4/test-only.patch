+def test_checksum_free_legacy_harvest_manifest_is_not_resume_evidence_and_recovers(
+    monkeypatch: pytest.MonkeyPatch, tmp_path: Path
+) -> None:
+    _install_non_private_profile_registry(monkeypatch)
+    registry = SourceRegistry(
+        version=1,
+        sources=(
+            SourceSpec(
+                name="source_a",
+                family="worldbank",
+                wave="A",
+                endpoint="https://example.test/a",
+                execution_tier="transport_ready",
+                run_lane="empirical",
+                publish_blocking=True,
+            ),
+        ),
+    )
+    monkeypatch.setattr(DatasetBatchConfig, "load_registry", lambda _self: registry)
+    monkeypatch.setattr(catalog_harvester, "load_metrics_map", lambda _path: {})
+    config = DatasetBatchConfig(
+        snapshot_root=tmp_path / "snapshot",
+        stages=frozenset({"harvest"}),
+        run_profile="prod_core_blocking",
+        resume=True,
+    )
+    calls: list[str] = []
+
+    async def harvest_fixture(endpoint: str, _limit: int, _timeout: int) -> list[dict]:
+        calls.append(endpoint)
+        return [{"id": "fixture", "name": "Fixture"}]
+
+    monkeypatch.setattr(catalog_harvester, "_harvest_worldbank", harvest_fixture)
+    config.resume = False
+    asyncio.run(catalog_harvester.harvest_sources(config))
+    _record_stage_completion(config, "harvest")
+    config.resume = True
+    assert _should_skip_stage(config, "harvest")
+
+    stage = json.loads((config.manifests_dir / "harvest.json").read_text(encoding="utf-8"))
+    outcome = stage["metrics"]["source_outcomes"]["source_a"]
+    manifest_path = Path(str(outcome["manifest_path"]))
+    raw = json.loads(manifest_path.read_text(encoding="utf-8"))
+    assert raw.get("sha256")
+    raw.pop("sha256")
+    manifest_path.write_text(
+        json.dumps(raw, ensure_ascii=False, indent=2, sort_keys=True) + "\n",
+        encoding="utf-8",
+    )
+
+    assert catalog_pipeline._harvest_stage_receipt(config) is None
+    assert not _should_skip_stage(config, "harvest")
+    assert current_content_stage_receipt(config, "harvest") is None
+    assert run_dataset_pipeline_sync(config).skipped_stages == []
+    assert calls == ["https://example.test/a", "https://example.test/a"]
+    assert _should_skip_stage(config, "harvest")
+
+    repaired_stage = json.loads(
+        (config.manifests_dir / "harvest.json").read_text(encoding="utf-8")
+    )
+    repaired_outcome = repaired_stage["metrics"]["source_outcomes"]["source_a"]
+    repaired_raw = json.loads(
+        Path(str(repaired_outcome["manifest_path"])).read_text(encoding="utf-8")
+    )
+    assert repaired_raw.get("sha256")
+    receipt = current_content_stage_receipt(config, "harvest")
+    assert receipt is not None and receipt.get("state") == "current"
+
+    def fail_if_harvested(*_args, **_kwargs):
+        raise AssertionError("current harvest receipt was not reused")
+
+    monkeypatch.setattr(catalog_harvester, "_harvest_worldbank", fail_if_harvested)
+    assert run_dataset_pipeline_sync(config).skipped_stages == ["harvest"]
+
