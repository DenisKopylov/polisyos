+@pytest.mark.parametrize(
+    "malformed_state",
+    [
+        pytest.param("{\n", id="invalid-json"),
+        pytest.param('{"embed":[]}\n', id="wrong-shape"),
+    ],
+)
+def test_malformed_embed_stage_state_reruns_and_recovers(
+    monkeypatch: pytest.MonkeyPatch, tmp_path: Path, malformed_state: str
+) -> None:
+    _install_non_private_profile_registry(monkeypatch)
+    config = DatasetBatchConfig(
+        snapshot_root=tmp_path / "snapshot",
+        stages=frozenset({"embed"}),
+        resume=True,
+        embedding_model="fixture-model",
+        embedding_dimension=4,
+    )
+    _create_empty_embedding_database(config)
+    assert build_embedding_generation(
+        rows=[],
+        index_dir=config.index_dir,
+        embedding_model="fixture-model",
+        embedding_device="cpu",
+        embedding_dimension=4,
+    ) == (0, 4)
+    _record_stage_completion(config, "embed")
+    assert _should_skip_stage(config, "embed")
+
+    config.stage_state_path.write_text(malformed_state, encoding="utf-8")
+    assert not _should_skip_stage(config, "embed")
+    assert current_content_stage_receipt(config, "embed") is None
+
+    assert run_dataset_pipeline_sync(config).skipped_stages == []
+    recovered = json.loads(config.stage_state_path.read_text(encoding="utf-8"))
+    assert recovered["embed"]["status"] == "complete"
+    receipt = current_content_stage_receipt(config, "embed")
+    assert receipt is not None and receipt.get("state") == "current"
+
+    def fail_if_reembedded(*_args, **_kwargs):
+        raise AssertionError("persisted recovery was not reused")
+
+    monkeypatch.setattr(catalog_embedder, "run_embed", fail_if_reembedded)
+    assert run_dataset_pipeline_sync(config).skipped_stages == ["embed"]
+
