  "consumer_relationship_and_profile_lineage": {
    "bridge_finding": "The harness passes the same original ref to two independent consumer calls. It does not pass the persisted Phase-5 report or Phase-5-discovered default manifest profile into the Runtime warrant reader. In the omitted-selector row, the Phase-5 report input and Runtime normalized ref omit manifest_profile_sha256 although the Core default observation identifies the base profile. Therefore R7 is not evidence of a Phase-5-report-to-Runtime production bridge or resolved-profile lineage propagation.",
    "phase5_route": {
      "behavior": "calls run_phase5 with the selected ref, then loads the resulting validation report from the CAS and returns its report manifest/inputs",
      "helper_path": "raw/resume-la036-competing-manifest-views-20261018/runner-r2.py:239-289",
      "product_source": "src/polisyos/scientist/validation/phase5_preflight.py",
      "profile_binding": "publication InputRef derives manifest_profile_sha256 from the caller-supplied ref; omitted input profile remains omitted in report_inputs even though Core default selection is separately observed as the base view"
    },
    "request_calls": "runner-r7-stage-aware.py builds one ref per selector and supplies that ref separately to phase5_route and runtime_route inside the same loop; runtime_route builds a new warrant reliability record from ref.model_dump_json and calls evaluate_warrant_berl_reliability with a fresh FileSystemCAS.",
    "runtime_reader": {
      "behavior": "build_berl_warrant_reliability_record serializes its own explanation_bundle_ref; evaluate_warrant_berl_reliability resolves that ref through its CAS store",
      "helper_path": "raw/resume-la036-competing-manifest-views-20261018/runner-r2.py:290-344",
      "product_source": "src/polisyos/runtime/quality/explanation_reliability.py"
    }
