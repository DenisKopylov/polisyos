+"""Attest actual Runtime owners for resumed child-effect verification."""
+
+from pathlib import Path
+
+import pytest
+
+from polisyos.core.artifacts.child_release import (
+    _JOB_OWNER_BOOTSTRAP_TOKEN,
+    ChildReleaseUnavailableError,
+    _install_child_job_owner,
+    child_store_identity,
+)
+from polisyos.core.artifacts.store import FileSystemCAS
+from polisyos.core.registry import build_default_registry_bundle
+from polisyos.core.run.context import RunContext
+from polisyos.runtime.http.resilience import (
+    GuardedDependencyProxy,
+    _bootstrap_child_effect_replay,
+    build_runtime_control_store_guard,
+    guard_runtime_cas,
+    guard_runtime_control_store,
+)
+from polisyos.runtime.http.services.control_plane_store import ControlPlaneStore
+
+
+@pytest.mark.parametrize("control_profile", ["raw", "guarded"])
+def test_effect_replay_bootstrap_uses_attested_existing_owners(
+    tmp_path: Path, control_profile: str
+) -> None:
+    raw = FileSystemCAS(tmp_path / "cas", ownership_enforced=False)
+    registry = build_default_registry_bundle(raw, return_selected_profile=True)
+    served = guard_runtime_cas(raw)
+    root = RunContext.start(served, registry.bundle_ref, run_id="effect-root", run_dir=tmp_path / "run")
+    control = ControlPlaneStore(backend="sqlite", sqlite_path=tmp_path / "control.sqlite3")
+    guarded = guard_runtime_control_store(control)
+    actual = guarded if control_profile == "guarded" else control
+    try:
+        with pytest.raises(ChildReleaseUnavailableError, match="job_release_authority_bridge_unavailable"):
+            _bootstrap_child_effect_replay(root)
+        assert root._child_effect_served is None
+        _install_child_job_owner(child_store_identity(raw.root), actual, token=_JOB_OWNER_BOOTSTRAP_TOKEN)
+        _bootstrap_child_effect_replay(root)
+        assert root._child_effect_served is raw
+        assert root._child_effect_store is served
+        _bootstrap_child_effect_replay(root)
+        other = guard_runtime_cas(FileSystemCAS(tmp_path / "other", ownership_enforced=False))
+        try:
+            root.store = other
+            with pytest.raises(ChildReleaseUnavailableError, match="job_release_authority_bridge_unavailable"):
+                _bootstrap_child_effect_replay(root)
+            root.store = served
+        finally:
+            other.close()
+        if control_profile == "guarded":
+            guarded._target = object()
+            with pytest.raises(ValueError, match="registered_control_guard_binding_changed"):
+                _bootstrap_child_effect_replay(root)
+            guarded._target = control
+    finally:
+        root.store = served
+        root.finalize()
+        guarded.close()
+        served.close()
+
+
+def test_effect_replay_refuses_unattested_control_proxy(tmp_path: Path) -> None:
+    raw = FileSystemCAS(tmp_path / "cas", ownership_enforced=False)
+    registry = build_default_registry_bundle(raw, return_selected_profile=True)
+    served = guard_runtime_cas(raw)
+    root = RunContext.start(served, registry.bundle_ref, run_id="effect-root", run_dir=tmp_path / "run")
+    control = ControlPlaneStore(backend="sqlite", sqlite_path=tmp_path / "control.sqlite3")
+    forged = GuardedDependencyProxy(target=control, guard=build_runtime_control_store_guard())
+    try:
+        _install_child_job_owner(child_store_identity(raw.root), forged, token=_JOB_OWNER_BOOTSTRAP_TOKEN)
+        with pytest.raises(ValueError, match="registered_control_guard_binding_not_established"):
+            _bootstrap_child_effect_replay(root)
+        assert root._child_effect_served is None
+    finally:
+        root.finalize()
+        forged.close()
+        served.close()
+
+
+def test_replaced_control_factory_cannot_issue_attested_proxy(
+    tmp_path: Path, monkeypatch: pytest.MonkeyPatch
+) -> None:
+    import polisyos.runtime.http.resilience as resilience
+
+    control = ControlPlaneStore(backend="sqlite", sqlite_path=tmp_path / "control.sqlite3")
+    original = resilience.build_runtime_control_store_guard
+    monkeypatch.setattr(resilience, "build_runtime_control_store_guard", lambda: original())
+    proxy = guard_runtime_control_store(control)
+    try:
+        with pytest.raises(ValueError, match="registered_control_guard_binding_not_established"):
+            resilience._require_runtime_control_guard(proxy)
+    finally:
+        proxy.close()
