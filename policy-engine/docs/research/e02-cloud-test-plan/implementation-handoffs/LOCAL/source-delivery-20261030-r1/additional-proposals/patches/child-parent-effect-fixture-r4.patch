+def test_budget_claim_rolls_back_after_insert_failure(
+    tmp_path: Path, monkeypatch: pytest.MonkeyPatch
+) -> None:
+    from polisyos.runtime.http.services.control.child_execution_budget import (
+        ChildExecutionBudgetPolicy,
+    )
+
+    db_path = tmp_path / "budget-rollback.sqlite3"
+    store = ControlPlaneStore(backend="sqlite", sqlite_path=db_path)
+    attempt = _job(store, kind="workflow_run")
+    policy = ChildExecutionBudgetPolicy("test-policy", "1", 10.0)
+    original_execute = store._execute
+
+    def fail_after_insert(sql: str, parameters: object = ()) -> object:
+        result = original_execute(sql, parameters)
+        if sql.startswith("INSERT INTO control_job_events"):
+            assert result == 1
+            raise RuntimeError("simulated_budget_insert_failure")
+        return result
+
+    with store.job_execution_fence(job_id="job-a", worker_id="worker-a", attempt=attempt):
+        with monkeypatch.context() as patch:
+            patch.setattr(store, "_execute", fail_after_insert)
+            with pytest.raises(RuntimeError, match="simulated_budget_insert_failure"):
+                store.claim_child_attempt_budget(policy)
+        fresh = ControlPlaneStore(backend="sqlite", sqlite_path=db_path)
+        assert fresh._child_event_row("job-a", f"child.budget.attempt.{attempt}") is None
+        store.claim_child_attempt_budget(policy)
+    assert fresh._child_event_row("job-a", f"child.budget.attempt.{attempt}") is not None
