+def test_competing_budget_claims_have_one_durable_winner(tmp_path: Path) -> None:
+    from concurrent.futures import ThreadPoolExecutor
+    from threading import Barrier
+
+    from polisyos.runtime.http.services.control.child_execution_budget import (
+        ChildExecutionBudgetPolicy,
+    )
+
+    db_path = tmp_path / "budget-race.sqlite3"
+    owner = ControlPlaneStore(backend="sqlite", sqlite_path=db_path)
+    attempt = _job(owner, kind="workflow_run")
+    policy = ChildExecutionBudgetPolicy("test-policy", "1", 10.0)
+    barrier = Barrier(2)
+
+    def claim() -> str:
+        store = ControlPlaneStore(backend="sqlite", sqlite_path=db_path)
+        with store.job_execution_fence(job_id="job-a", worker_id="worker-a", attempt=attempt):
+            barrier.wait(timeout=5.0)
+            try:
+                store.claim_child_attempt_budget(policy)
+            except ControlJobExecutionAdmissionError as exc:
+                if exc.code != "child_budget_attempt_already_issued":
+                    raise
+                return "refused"
+            return "issued"
+
+    with ThreadPoolExecutor(max_workers=2) as pool:
+        results = list(pool.map(lambda _index: claim(), range(2)))
+    assert sorted(results) == ["issued", "refused"]
+    assert owner._child_event_row("job-a", f"child.budget.attempt.{attempt}") is not None
+
