+"""Spawn-safe effect replay through actual attested Runtime owners."""
+
+from __future__ import annotations
+
+import json
+import sqlite3
+from pathlib import Path
+from typing import Any
+
+
+def replay_in_fresh_process(
+    served_root: str, db_path: str, run_dir: str, registry_json: str,
+    release_json: str, scope_json: str, results: Any,
+) -> None:
+    """Resume the real Root and reappoint exact CAS and Control owners."""
+    from polisyos.core.artifacts.child_release import (
+        _JOB_OWNER_BOOTSTRAP_TOKEN,
+        ChildReleaseUnavailableError,
+        _install_child_job_owner,
+        child_store_identity,
+    )
+    from polisyos.core.artifacts.manifest import ArtifactRef
+    from polisyos.core.artifacts.store import FileSystemCAS
+    from polisyos.core.run.context import RunContext, _FinalizeRecoveryError
+    from polisyos.core.security.access_scope import AccessScope
+    from polisyos.runtime.http.resilience import (
+        _bootstrap_child_effect_replay,
+        guard_runtime_cas,
+        guard_runtime_control_store,
+    )
+    from polisyos.runtime.http.services.control_plane_store import ControlPlaneStore
+
+    root_path = Path(served_root)
+    raw_store = FileSystemCAS(root_path, tenant_id="tenant-a", cell_id="cell-a", ownership_enforced=False)
+    store = guard_runtime_cas(raw_store)
+    registry_ref = ArtifactRef.model_validate_json(registry_json)
+    release_ref = ArtifactRef.model_validate_json(release_json)
+    resumed = None
+    guarded_owner = None
+    try:
+        resumed = RunContext.resume(
+            store, run_id="run-a", run_dir=Path(run_dir), registry_bundle=registry_ref,
+            producer=None, env=None, access_scope=AccessScope.from_dict(json.loads(scope_json)),
+        )
+        try:
+            resumed._verify_child_parent_effects(release_ref)
+        except _FinalizeRecoveryError as exc:
+            if str(exc) != "child_effect_store_not_appointed":
+                raise
+        else:
+            raise AssertionError("unappointed replay unexpectedly admitted")
+        try:
+            _bootstrap_child_effect_replay(resumed)
+        except ChildReleaseUnavailableError as exc:
+            if str(exc) != "job_release_authority_bridge_unavailable":
+                raise
+        else:
+            raise AssertionError("bootstrap admitted without the actual job owner")
+        owner = ControlPlaneStore(backend="sqlite", sqlite_path=Path(db_path))
+        guarded_owner = guard_runtime_control_store(owner)
+        _install_child_job_owner(
+            child_store_identity(root_path), guarded_owner, token=_JOB_OWNER_BOOTSTRAP_TOKEN
+        )
+        _bootstrap_child_effect_replay(resumed)
+        assert resumed._verify_child_parent_effects(release_ref) == 3
+        # An actual SQLite connect to a directory fails; no owner data is moved.
+        actual_db = owner._sqlite_path
+        try:
+            owner._sqlite_path = Path(run_dir)
+            try:
+                resumed._verify_child_parent_effects(release_ref)
+            except _FinalizeRecoveryError as exc:
+                if str(exc) != "child_effect_release_unavailable":
+                    raise
+                cause: BaseException | None = exc
+                seen: set[int] = set()
+                while cause is not None and id(cause) not in seen and not isinstance(cause, sqlite3.OperationalError):
+                    seen.add(id(cause))
+                    cause = cause.__cause__ or cause.__context__
+                if not isinstance(cause, sqlite3.OperationalError):
+                    raise AssertionError("SQLite outage failed for an unrelated reason") from exc
+            else:
+                raise AssertionError("replay admitted with unavailable SQLite")
+        finally:
+            owner._sqlite_path = actual_db
+        assert resumed._verify_child_parent_effects(release_ref) == 3
+        results.put({
+            "unappointed": "REFUSED", "missing_job_owner": "REFUSED",
+            "unavailable_sqlite": "REFUSED", "recorded_effects": 3,
+            "restored_effects": 3,
+        })
+    finally:
+        try:
+            if resumed is not None:
+                resumed.suspend_for_resume()
+        finally:
+            try:
+                if guarded_owner is not None:
+                    guarded_owner.close()
+            finally:
+                store.close()
