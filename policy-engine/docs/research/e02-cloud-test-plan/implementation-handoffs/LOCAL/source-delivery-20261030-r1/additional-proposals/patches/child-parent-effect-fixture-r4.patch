+def test_actual_worker_revokes_budget_when_renewal_is_not_proven(
+    tmp_path: Path, monkeypatch: pytest.MonkeyPatch, renewal: str
+) -> None:
+    from threading import Event
+
+    from polisyos.runtime.http.errors import RuntimeDependencyUnavailableError
+    from polisyos.runtime.http.services.control.child_execution_budget import (
+        ChildExecutionBudgetPolicy,
+        _require_attempt_budget,
+    )
+    from polisyos.runtime.http.services.control_worker import ControlWorker
+
+    store = ControlPlaneStore(backend="sqlite", sqlite_path=tmp_path / "worker-revocation.sqlite3")
+    attempt = _job(store, kind="workflow_run")
+    actual_job = store.get_job("job-a")
+    assert actual_job is not None
+    called = Event()
+
+    def renew(**_kwargs: object) -> bool:
+        called.set()
+        if renewal == "unavailable":
+            raise RuntimeDependencyUnavailableError("test-control-store")
+        return False
+
+    monkeypatch.setattr(store, "renew_job_lease", renew)
+    observed: list[str] = []
+
+    def handler(_job_record: object) -> None:
+        _require_attempt_budget("job-a", "run-a", attempt)
+        assert called.wait(3.0)
+        until = time.monotonic() + 3.0
+        while time.monotonic() < until:
+            try:
+                _require_attempt_budget("job-a", "run-a", attempt)
+            except RuntimeError:
+                observed.append("revoked")
+                return
+            Event().wait(0.01)
+        pytest.fail("heartbeat uncertainty left the budget active")
+
+    worker = ControlWorker(
+        store=store, handler=handler, worker_id="worker-a", lease_seconds=1,
+        child_execution_budget_policy=ChildExecutionBudgetPolicy("test-policy", "1", 10.0),
+    )
+    worker._run_with_lease_heartbeat(actual_job)
+    assert observed == ["revoked"]
