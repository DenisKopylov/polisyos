+@pytest.mark.parametrize("probe", [
+    "normal", "retained_binding", "oversized", "stale_lease", "unknown_progress",
+    "reissue_first", "session_first", "other_scope_reissue_first", "other_scope_session_first",
+    "malformed_session_scope", "oversized_session_set", "concurrent_order", "revocation_unknown",
+    "scope_transaction_failure", "scope_wrong_parent", "scope_root_busy", "scope_owner_busy", "scope_verifier_removal", "scope_start_partial", "scope_preflight_fail", "scope_release_preparing", "scope_release_prepared", "scope_prepare_root_available", "scope_sql_root_available",
+    "effect_owner_positive", "effect_owner_tamper_limit", "scope_readback_failure", "scope_precommit_failure", "scope_conditional_refusal", "scope_new_store_fail", "scope_new_store_revoke_unknown", "root_finalizes_after_authorize",
+])
+def test_owner_authorization_and_fresh_readback(
+    tmp_path: Path, monkeypatch: pytest.MonkeyPatch, probe: str
+) -> None:
+    replay_timeout: float | None = None
+    if probe == "effect_owner_positive":
+        import math
+        import os
+
+        raw_timeout = os.environ.get("E02_EFFECT_REPLAY_TIMEOUT_SECONDS", "")
+        try:
+            replay_timeout = float(raw_timeout)
+        except ValueError:
+            pytest.fail("HARNESS_ERROR: set a measured E02_EFFECT_REPLAY_TIMEOUT_SECONDS")
+        if not math.isfinite(replay_timeout) or replay_timeout <= 0:
+            pytest.fail("HARNESS_ERROR: replay timeout must be finite and positive")
+    db_path = tmp_path / "control.sqlite3"
+    owner = ControlPlaneStore(backend="sqlite", sqlite_path=db_path)
+    attempt = _job(owner)
+    guard = BlockingDependencyGuard(
+        dependency_name="child-release-test",
+        timeout_seconds=60,
+        breaker=CircuitBreaker("child-release-test"),
+        executor=get_shared_executor(),
+    )
+    try:
+        with owner.job_execution_fence(job_id="job-a", worker_id="worker-a", attempt=attempt):
+            replay_input = guard.run_with_parent_admission(
+                lambda grant: _exercise(
+                    tmp_path, db_path, owner, grant, monkeypatch, probe
+                ),
+                deadline_monotonic=time.monotonic() + 60,
+            )
+    finally:
+        guard.close()
+    if probe == "effect_owner_positive":
+        import multiprocessing
+
+        from tests._helpers.child_effect_fresh_replay import replay_in_fresh_process
+
+        assert replay_input is not None
+        spawn = multiprocessing.get_context("spawn")
+        results = spawn.Queue()
+        process = spawn.Process(target=replay_in_fresh_process, args=(*replay_input, results))
+        assert replay_timeout is not None
+        started = False
+        unreaped_pid: int | None = None
+        try:
+            process.start()
+            started = True
+            process.join(timeout=replay_timeout)
+            if process.is_alive():
+                pytest.fail("HARNESS_ERROR: fresh replay exceeded the configured measured timeout")
+            assert process.exitcode == 0
+            assert results.get(timeout=5) == {
+                "unappointed": "REFUSED", "missing_job_owner": "REFUSED",
+                "unavailable_sqlite": "REFUSED", "recorded_effects": 3, "restored_effects": 3,
+            }
+        finally:
+            if started and process.is_alive():
+                process.terminate()
+                process.join(timeout=5)
+                if process.is_alive():
+                    process.kill()
+                    process.join(timeout=5)
+                if process.is_alive():
+                    unreaped_pid = process.pid
+            if unreaped_pid is None:
+                process.close()
+            results.close()
+            if unreaped_pid is not None:
+                pytest.fail(f"HARNESS_ERROR: replay child remains unreaped: pid={unreaped_pid}")
+
+
+def _exercise(
+    tmp_path: Path,
+    db_path: Path,
+    owner: ControlPlaneStore,
+    grant: _BorrowedExecutionGrant,
+    monkeypatch: pytest.MonkeyPatch,
+    probe: str,
+) -> tuple[str, str, str, str, str, str] | None:
+    served = FileSystemCAS(
+        tmp_path / "served", tenant_id="tenant-a", cell_id="cell-a", ownership_enforced=False
+    )
+    registry = build_default_registry_bundle(served, return_selected_profile=True)
+    effect_scope = None
+    if probe in {"effect_owner_positive", "effect_owner_tamper_limit"}:
+        from polisyos.core.security.access_scope import AccessScope
+
+        effect_scope = AccessScope.for_service(
+            tenant_id="tenant-a", cell_id="cell-a", spiffe_id="spiffe://test/child-effects"
+        )
+    root = RunContext.start(
+        served,
+        registry.bundle_ref,
+        run_id="run-a",
+        run_dir=served.root / "runs" / "run-a",
+        tenant_id="tenant-a",
+        cell_id="cell-a",
+        control_job_id="job-a",
+        access_scope=effect_scope,
+    )
+    workflow = served.put_json(
+        {},
+        PutOptions(kind="tests.workflow", media_type="application/json"),
+        return_selected_profile=True,
+    )
+    state = served.put_json(
+        {},
+        PutOptions(kind="tests.state", media_type="application/json"),
+        return_selected_profile=True,
+    )
+    parent_attempt = str(uuid4())
+    basis = root._record_runtime_invocation_started(
+        attempt_id=parent_attempt,
+        attempt_number=1,
+        workflow_spec_ref=workflow,
+        node_alias="parent",
+        component_id="tests.parent",
+        input_state_ref=state,
+    )
+    binding = ChildComputationBinding(
+        root_run_id="run-a",
+        control_job_id="job-a",
+        parent_attempt_id=parent_attempt,
+        parent_basis_ref=basis,
+        tenant_id="tenant-a",
+        cell_id="cell-a",
+        policy_id="tests",
+        policy_version="1",
+        template_sha256="sha256:" + "1" * 64,
+        admission_id="test-owner",
+        child_invocation_id="parent",
+        admission_generation=1,
+        deadline=datetime.now(UTC) + timedelta(seconds=45),
+    )
+    basis_text = json.dumps(
+        basis.model_dump(mode="json"), sort_keys=True, separators=(",", ":"), ensure_ascii=True
+    )
+    grant.bind_parent(
+        run_id="run-a", job_id="job-a", attempt_id=parent_attempt, basis_ref=basis_text
+    )
+    fence = owner.child_computation_publication_fence(grant=grant, binding=binding)
+    custody = ChildComputationCustody(
+        root,
+        staging_root=tmp_path / "private",
+        closure_resolver=_Resolver(),
+        publication_fence=fence,
+    )
+    _install_child_job_owner(
+        custody._ledger.store_identity, owner, token=_JOB_OWNER_BOOTSTRAP_TOKEN
+    )
+    intent = custody.job_session_intent(binding)
+    if probe == "concurrent_order":
+        from threading import Barrier, Thread
+
+        barrier = Barrier(2)
+        reissue_result: list[str] = []
+
+        def race_reissue() -> None:
+            fresh = ControlPlaneStore(backend="sqlite", sqlite_path=db_path)
+            barrier.wait(timeout=5.0)
+            try:
+                _job(fresh, job_id="job-b", run_id="run-b", kind="workflow_run",
+                     child_reissue_source_run_id="run-a")
+            except ControlJobExecutionAdmissionError as exc:
+                reissue_result.append(exc.code)
+            except BaseException as exc:
+                reissue_result.append(f"unexpected:{type(exc).__name__}")
+            else:
+                reissue_result.append("reissue_won")
+
+        racer = Thread(target=race_reissue, daemon=True)
+        racer.start()
+        barrier.wait(timeout=5.0)
+        try:
+            fence.begin_session(intent)
+        except ControlJobExecutionAdmissionError as exc:
+            session_result = exc.code
+        else:
+            session_result = "session_won"
+        racer.join(timeout=5.0)
+        assert not racer.is_alive()
+        assert (session_result, reissue_result) in (
+            ("session_won", ["child_reissue_source_reconciliation_required"]),
+            ("child_session_source_already_reissued", ["reissue_won"]),
+        )
+        return
+    if probe == "other_scope_reissue_first":
+        fresh = ControlPlaneStore(backend="sqlite", sqlite_path=db_path)
+        _job(fresh, job_id="job-b", run_id="run-b", kind="workflow_run",
+             child_reissue_source_run_id="run-a", child_reissue_source_tenant_id="tenant-b",
+             child_reissue_source_cell_id="cell-b")
+    if probe == "reissue_first":
+        fresh = ControlPlaneStore(backend="sqlite", sqlite_path=db_path)
+        _job(fresh, job_id="job-b", run_id="run-b", kind="workflow_run",
+             child_reissue_source_run_id="run-a")
+        with pytest.raises(ControlJobExecutionAdmissionError, match="source_already_reissued"):
+            fence.begin_session(intent)
+        assert fresh.find_child_job_session(
+            job_id="job-a", run_id="run-a", parent_attempt_id=parent_attempt,
+            parent_basis_ref=basis,
+        ) is None
+        return
+    original_recompute = intent.recompute
+    recompute_count = 0
+
+    def fail_before_transaction():
+        nonlocal recompute_count
+        recompute_count += 1
+        if recompute_count == 2:
+            raise OSError("pretransaction_source_failure")
+        return original_recompute()
+
+    with monkeypatch.context() as patch:
+        patch.setattr(intent, "recompute", fail_before_transaction)
+        with pytest.raises(OSError, match="pretransaction_source_failure"):
+            fence.begin_session(intent)
+    forged_intent = intent.recompute()
+    forged_intent.parent_basis_ref.kind = "tests.forged.basis"
+    with pytest.raises(ChildReleaseUnavailableError):
+        intent.admission(forged_intent)
+    fresh_intent = intent.recompute()
+    assert intent.admission(fresh_intent)
+    original_grant_check = grant.require_parent
+
+    def refuse_at_sql_decision(**kwargs: object) -> None:
+        if sys._getframe(1).f_code.co_name == "resource_current":
+            raise RuntimeError("simulated_resource_revocation_at_sql_decision")
+        original_grant_check(**kwargs)
+
+    with monkeypatch.context() as patch:
+        patch.setattr(grant, "require_parent", refuse_at_sql_decision)
+        with pytest.raises(ControlJobLeaseLostError, match="conditional_admission_refused"):
+            fence.begin_session(intent)
+    assert (
+        owner.find_child_job_session(
+            job_id="job-a",
+            run_id="run-a",
+            parent_attempt_id=parent_attempt,
+            parent_basis_ref=basis,
+            admission_generation=1,
+        )
+        is None
+    )
+    # The positive owner decision is not itself a durable authorization.
+    # A failure after the INSERT must roll the transaction back and leave no
+    # locator that a fresh owner can verify.
+    original_execute = owner._execute
+
+    def fail_after_insert(sql: str, parameters: object = ()) -> object:
+        result = original_execute(sql, parameters)
+        if sql.startswith("INSERT INTO control_job_events") and "child_resource_current" in sql:
+            assert result == 1
+            raise RuntimeError("simulated_failure_after_positive_decision")
+        return result
+
+    with monkeypatch.context() as patch:
+        patch.setattr(owner, "_execute", fail_after_insert)
+        with pytest.raises(RuntimeError, match="simulated_failure_after_positive_decision"):
+            fence.begin_session(intent)
+    assert ControlPlaneStore(backend="sqlite", sqlite_path=db_path).find_child_job_session(
+        job_id="job-a",
+        run_id="run-a",
+        parent_attempt_id=parent_attempt,
+        parent_basis_ref=basis,
+    ) is None
+
+    original_row_reader = owner._child_event_row
+
+    def lose_fresh_read(job_id: str, event_type: str):
+        if not owner._has_active_job_transaction() and event_type.startswith(
+            "child.release.session."
+        ):
+            raise OSError("simulated_post_commit_readback_loss")
+        return original_row_reader(job_id, event_type)
+
+    from polisyos.core.run.child_custody import ChildSessionAdmissionUnknown
+
+    with monkeypatch.context() as patch:
+        patch.setattr(owner, "_child_event_row", lose_fresh_read)
+        with pytest.raises(ChildSessionAdmissionUnknown) as unknown:
+            fence.begin_session(intent)
+        assert isinstance(unknown.value.__cause__, OSError)
+        assert unknown.value.recovery is not None
+        assert unknown.value.recovery.root_run_id == "run-a"
+        assert unknown.value.recovery.parent_attempt_id == parent_attempt
+        assert json.loads(unknown.value.recovery.parent_basis_json) == basis.model_dump(mode="json")
+        assert unknown.value.recovery.job_intent_locator is None
+    recovered = ControlPlaneStore(backend="sqlite", sqlite_path=db_path).find_child_job_session(
+        job_id="job-a",
+        run_id="run-a",
+        parent_attempt_id=parent_attempt,
+        parent_basis_ref=basis,
+    )
+    assert recovered is not None
+    intent_locator, recovered_claim = recovered
+    intent_claim = intent.recompute()
+    assert recovered_claim == intent_claim
+    if probe == "oversized_session_set":
+        event_type = owner._child_job_event_type("session", intent_claim)
+        row = owner._child_event_row("job-a", event_type)
+        assert row is not None
+        with owner._job_transaction():
+            for index in range(32):
+                owner._execute(
+                    "INSERT INTO control_job_events (job_id, event_type, payload_json, created_at) "
+                    "VALUES (?, ?, ?, ?)",
+                    ("job-a", f"child.release.session.extra-{index}", row["payload_json"],
+                     datetime.now(UTC).isoformat()),
+                )
+        fresh = ControlPlaneStore(backend="sqlite", sqlite_path=db_path)
+        with pytest.raises(ControlJobExecutionAdmissionError, match="session_set_oversized"):
+            _job(fresh, job_id="job-b", run_id="run-b", kind="workflow_run",
+                 child_reissue_source_run_id="run-a")
+        assert fresh.get_job("job-b") is None
+        return
+    if probe == "malformed_session_scope":
+        event_type = owner._child_job_event_type("session", intent_claim)
+        row = owner._child_event_row("job-a", event_type)
+        assert row is not None
+        malformed = json.loads(row["payload_json"])
+        malformed["claim"]["tenant_id"] = 7
+        with owner._job_transaction():
+            owner._execute(
+                "UPDATE control_job_events SET payload_json = ? WHERE event_id = ?",
+                (json.dumps(malformed), intent_locator.event_id),
+            )
+        fresh = ControlPlaneStore(backend="sqlite", sqlite_path=db_path)
+        with pytest.raises(ControlJobExecutionAdmissionError):
+            _job(fresh, job_id="job-b", run_id="run-b", kind="workflow_run",
+                 child_reissue_source_run_id="run-a", child_reissue_source_tenant_id="tenant-b",
+                 child_reissue_source_cell_id="cell-b")
+        assert fresh.get_job("job-b") is None
+        return
+    if probe == "other_scope_session_first":
+        fresh = ControlPlaneStore(backend="sqlite", sqlite_path=db_path)
+        _job(fresh, job_id="job-b", run_id="run-b", kind="workflow_run",
+             child_reissue_source_run_id="run-a", child_reissue_source_tenant_id="tenant-b",
+             child_reissue_source_cell_id="cell-b")
+        return
+    if probe == "session_first":
+        fresh = ControlPlaneStore(backend="sqlite", sqlite_path=db_path)
+        with pytest.raises(ControlJobExecutionAdmissionError, match="source_reconciliation_required"):
+            _job(fresh, job_id="job-b", run_id="run-b", kind="workflow_run",
+                 child_reissue_source_run_id="run-a")
+        assert fresh.get_job("job-b") is None
+        return
+    if probe == "unknown_progress":
+        wrong_locator = intent_locator.model_copy(update={"event_id": intent_locator.event_id + 1})
+        with pytest.raises(ControlJobExecutionAdmissionError, match="unknown_locator_invalid"):
+            owner.record_child_release_unknown(
+                locator=wrong_locator, run_id="run-a", parent_attempt_id=parent_attempt,
+                parent_basis_ref=basis,
+            )
+        owner.record_child_release_unknown(
+            locator=intent_locator, run_id="run-a", parent_attempt_id=parent_attempt,
+            parent_basis_ref=basis,
+        )
+        owner.record_child_release_unknown(
+            locator=intent_locator, run_id="run-a", parent_attempt_id=parent_attempt,
+            parent_basis_ref=basis, sibling_error_types=("ValueError",),
+        )
+        recorded = ControlPlaneStore(backend="sqlite", sqlite_path=db_path).get_job("job-a")
+        assert recorded is not None and recorded.state == "running"
+        assert recorded.progress["child_release_reconciliation"]["status"] == "reconciliation_required"
+        intents = recorded.progress["child_release_reconciliation"]["intents"]
+        assert len(intents) == 1 and intents[0]["intent_event_id"] == intent_locator.event_id
+        assert recorded.progress["child_release_reconciliation"]["sibling_error_types"] == ["ValueError"]
+        return
+    if probe == "stale_lease":
+        # Simulate process loss after the durable intent, before any handler can
+        # record an unknown outcome. The normal expired-job path must not rerun it.
+        expired = (datetime.now(UTC) - timedelta(seconds=1)).isoformat()
+        with owner._job_transaction():
+            owner._execute(
+                "UPDATE control_jobs SET lease_expires_at = ? WHERE job_id = ?",
+                (expired, "job-a"),
+            )
+        fresh_owner = ControlPlaneStore(backend="sqlite", sqlite_path=db_path)
+        assert fresh_owner.lease_next_job(worker_id="worker-b") is None
+        with pytest.raises(ControlJobLeaseLostError):
+            fresh_owner.mark_running(job_id="job-a", worker_id="worker-b")
+        # A different job without an intent still gets its ordinary lease.
+        assert _job(fresh_owner, job_id="job-b", run_id="run-b") == 1
+        assert fresh_owner.get_job("job-b").state == "running"
+        assert fresh_owner.find_child_job_session(
+            job_id="job-a",
+            run_id="run-a",
+            parent_attempt_id=parent_attempt,
+            parent_basis_ref=basis,
+        ) == recovered
+        return
+    with (
+        owner._job_transaction(),
+        pytest.raises(ControlJobExecutionAdmissionError, match="fresh_read_required"),
+    ):
+        owner.verify_intent(intent_locator, intent_claim)
+    custody.bind_job_intent(intent, intent_locator)
+    parent = custody.parent_store(binding, input_refs=())
+    if probe == "revocation_unknown":
+        from polisyos.core.run.child_custody import (
+            ChildGuardedTransferUnknown,
+            ChildRevocationUnknown,
+        )
+
+        recovery = custody._recovery_locator()
+        assert recovery is not None and recovery.job_intent_locator == intent_locator
+
+        def fail_revoke(_reason: str) -> None:
+            raise OSError("lost durable revocation acknowledgement")
+
+        with monkeypatch.context() as patch:
+            patch.setattr(custody._ledger, "revoke", fail_revoke)
+            original = ChildGuardedTransferUnknown(recovery)
+            custody._revoke_preserving_outcome(original, reason="transfer_unknown")
