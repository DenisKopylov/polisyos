+def test_actual_worker_issues_one_policy_budget_inside_live_job_fence(tmp_path: Path) -> None:
+    from polisyos.runtime.http.services.control.child_execution_budget import (
+        ChildExecutionBudgetPolicy,
+        _require_attempt_budget,
+    )
+    from polisyos.runtime.http.services.control_worker import ControlWorker
+
+    store = ControlPlaneStore(backend="sqlite", sqlite_path=tmp_path / "worker.sqlite3")
+    attempt = _job(store, kind="workflow_run")
+    actual_job = store.get_job("job-a")
+    assert actual_job is not None
+    observed: list[float] = []
+
+    def handler(job: object) -> None:
+        assert job is actual_job
+        budget = _require_attempt_budget("job-a", "run-a", attempt)
+        observed.append(budget.deadline_monotonic)
+        fresh = ControlPlaneStore(backend="sqlite", sqlite_path=tmp_path / "worker.sqlite3")
+        event = fresh._child_event_row("job-a", f"child.budget.attempt.{attempt}")
+        assert event is not None
+        assert fresh.read_child_attempt_budget("job-a", attempt) == budget.claim
+        assert budget.claim.event_id == event["event_id"]
+        assert _require_attempt_budget("job-a", "run-a", attempt) is budget
+        with pytest.raises(RuntimeError, match="child_execution_budget_unavailable"):
+            _require_attempt_budget("job-a", "run-a", attempt + 1)
+
+    worker = ControlWorker(
+        store=store, handler=handler, worker_id="worker-a",
+        child_execution_budget_policy=ChildExecutionBudgetPolicy("test-policy", "1", 10.0),
+    )
+    worker._run_with_lease_heartbeat(actual_job)
+    assert len(observed) == 1
+    with pytest.raises(ValueError, match="reserved_for_owner"):
+        store.append_event(job_id="job-a", event_type="child.budget.attempt.2", payload={})
+    with pytest.raises(ValueError, match="reserved_for_owner"):
+        store.enqueue_outbox_event(topic="control.child.budget.attempt", payload={})
+    with pytest.raises(RuntimeError, match="child_execution_budget_unavailable"):
+        _require_attempt_budget("job-a", "run-a", attempt)
+    with pytest.raises(ControlJobExecutionAdmissionError, match="child_budget_attempt_already_issued"):
+        worker._run_with_lease_heartbeat(actual_job)
