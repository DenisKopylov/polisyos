+
+class _RetainedBindingProbeCompleteError(Exception):
+    """End the isolated mutated-owner fixture without restoring its binding."""
+
+
+class _Projection(BaseModel):
+    model_config = ConfigDict(extra="forbid")
+    selected: ArtifactRef
+
+
+class _Resolver:
+    def resolve(self, store: ArtifactReader, ref: ArtifactRef) -> tuple[ArtifactRef, ...]:
+        manifest = store.get_manifest(ref)
+        if manifest.kind == "tests.child.value":
+            return ()
+        if manifest.kind != "tests.child.projection":
+            raise ValueError("unsupported_test_schema")
+        selected = _Projection.model_validate_json(store.get_bytes(ref)).selected
+        store.get_bytes(selected)
+        return (selected,)
+
+
+def _job(
+    store: ControlPlaneStore, *, job_id: str = "job-a", run_id: str = "run-a",
+    kind: str = "natural_language_run", child_reissue_source_run_id: str | None = None,
+    child_reissue_source_tenant_id: str | None = None,
+    child_reissue_source_cell_id: str | None = None,
+) -> int:
+    scope = {
+        "schema_version": "polisyos.runtime.control_execution_scope.v1",
+        "status": "established",
+        "tenant_id": "tenant-a",
+        "cell_id": "cell-a",
+        "actor_subject": "actor-a",
+        "actor_authenticated": True,
+        "actor_roles": ["analyst"],
+    }
+    payload = {
+        "job_id": job_id,
+        "run_id": run_id,
+        "job_kind": kind,
+        "pipeline_id": None,
+        "payload_ref": "sha256:fixture-payload",
+        "submitted_by": "actor-a",
+        "requested_execution_profile": None,
+        "effective_execution_profile": "dev",
+        "policy_flags": {"candidate": True},
+        "capability_manifest_ref": None,
+        "execution_scope": scope,
+    }
+    store.create_job(
+        job_id=job_id,
+        kind=kind,
+        run_id=run_id,
+        pipeline_id=None,
+        requested_execution_profile=None,
+        effective_execution_profile="dev",
+        policy_flags={"candidate": True},
+        capability_manifest_ref=None,
+        payload_ref="sha256:fixture-payload",
+        submitted_by="actor-a",
+        creation_event_payload=payload,
+        child_reissue_source_run_id=child_reissue_source_run_id,
+        child_reissue_source_tenant_id=child_reissue_source_tenant_id,
+        child_reissue_source_cell_id=child_reissue_source_cell_id,
+    )
+    job = store.lease_next_job(worker_id="worker-a", lease_seconds=120)
+    assert job is not None and job.job_id == job_id
+    return job.attempt
+
