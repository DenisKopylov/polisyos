+def test_dynamic_import_unsupported_subscript_fixture_reaches_real_import(
+    tmp_path: Path,
+    monkeypatch: pytest.MonkeyPatch,
+) -> None:
+    """The unresolved-index fixture reaches an actual, controlled module import."""
+    module_name = "unsupported_subscript_origin"
+    module_path = tmp_path / f"{module_name}.py"
+    module_path.write_text("fixture_executed = True\n", encoding="utf-8")
+    monkeypatch.syspath_prepend(str(tmp_path))
+    monkeypatch.delitem(sys.modules, module_name, raising=False)
+    fixture_path = tmp_path / "dynamic_import_fixture.py"
+    fixture_path.write_text(_UNSUPPORTED_SUBSCRIPT_SOURCE, encoding="utf-8")
+    try:
+        assert module_name not in sys.modules
+        namespace = runpy.run_path(str(fixture_path))
+        module = sys.modules[module_name]
+        assert module.__name__ == module_name
+        assert module.__spec__ is not None
+        assert module.__spec__.origin == str(module_path)
+        assert module.fixture_executed is True
+        assert namespace["unknown_index"] == 0
+        assert namespace["loader"] is namespace["importlib"].import_module
+    finally:
+        sys.modules.pop(module_name, None)
 
 
