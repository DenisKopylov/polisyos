+class _DynamicComprehensionAssignmentCollector(ast.NodeVisitor):
+    """Find outer-binding assignments across expression children, respecting lambdas."""
+
+    def __init__(self) -> None:
+        self.assignments: list[ast.NamedExpr] = []
+
+    def visit_NamedExpr(self, node: ast.NamedExpr) -> None:
+        self.assignments.append(node)
+        self.visit(node.value)
+
+    def visit_Lambda(self, node: ast.Lambda) -> None:
+        # Defaults execute here; the lambda body has a separate binding scope.
+        for default in (*node.args.defaults, *node.args.kw_defaults):
+            if default is not None:
+                self.visit(default)
