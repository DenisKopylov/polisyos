+        "dict-key-call",
+    ],
+)
+def test_dynamic_import_scope_falsifier_runtime_selects_controlled_target(
+    source: str, expected_target: str, tmp_path: Path, monkeypatch: pytest.MonkeyPatch
+) -> None:
+    """The same source shape reaches the correct controlled target in real Python."""
+    zero_name = "r16_scope_controlled_zero"
+    one_name = "r16_scope_controlled_one"
+    zero_path = tmp_path / f"{zero_name}.py"
+    one_path = tmp_path / f"{one_name}.py"
+    zero_path.write_text("controlled_target = 'zero'\n", encoding="utf-8")
+    one_path.write_text("controlled_target = 'one'\n", encoding="utf-8")
+    assert source.count("polisyos.zero") == source.count("polisyos.one") == 1
+    safe_source = source.replace("polisyos.zero", zero_name).replace("polisyos.one", one_name)
+    fixture_path = tmp_path / "scope_runtime_fixture.py"
+    fixture_path.write_text(safe_source, encoding="utf-8")
+    monkeypatch.syspath_prepend(str(tmp_path))
+    monkeypatch.delitem(sys.modules, zero_name, raising=False)
+    monkeypatch.delitem(sys.modules, one_name, raising=False)
+    try:
+        assert zero_name not in sys.modules and one_name not in sys.modules
+        namespace = runpy.run_path(str(fixture_path))
+        selected_name = zero_name if expected_target == "zero" else one_name
+        other_name = one_name if expected_target == "zero" else zero_name
+        selected_path = zero_path if expected_target == "zero" else one_path
+        selected_module = sys.modules[selected_name]
+        assert other_name not in sys.modules
+        assert selected_module.__spec__ is not None
+        assert selected_module.__spec__.origin == str(selected_path)
+        assert selected_module.controlled_target == expected_target
+        if "index" in namespace:
+            assert namespace["index"] == (0 if expected_target == "zero" else 1)
+    finally:
+        sys.modules.pop(zero_name, None)
+        sys.modules.pop(one_name, None)
+
+
+@pytest.mark.parametrize(
+    "source",
+    [_DICT_DISPLAY_ORDER_SOURCE, _DICT_UNKNOWN_ORDER_SOURCE, _DICT_KEY_CALL_SOURCE],
+    ids=["known-namedexpr-key", "unknown-namedexpr-key", "function-call-key"],
+)
+def test_dynamic_import_effectful_dict_pair_order_refuses(
+    source: str, tmp_path: Path, monkeypatch: pytest.MonkeyPatch
+) -> None:
+    """Do not inventory a dict pair whose swapped evaluation order may change effects."""
+    _dynamic_import_fixture(tmp_path, monkeypatch, source)
+    with pytest.raises(
+        preflight.DynamicImportCollectionError,
+        match="dict display key/value evaluation order is unproven",
+    ):
+        preflight.collect_dynamic_imports()
+
+
+def test_dynamic_import_dict_unknown_registry_cannot_launder_order_effect(
+    tmp_path: Path, monkeypatch: pytest.MonkeyPatch
+) -> None:
+    """The actual matching unknown row is green only when the order gate is removed."""
+    registry_path = _dynamic_import_fixture(tmp_path, monkeypatch, _DICT_UNKNOWN_ORDER_SOURCE)
+    with monkeypatch.context() as removal:
+        removal.setattr(
+            preflight, "_dynamic_dict_pair_order_is_commutative", lambda _key, _value: True
+        )
+        unguarded_entries = preflight.collect_dynamic_imports()
+        assert len(unguarded_entries) == 1
+        assert unguarded_entries[0]["allowed_targets"] == []
+        registry_path.write_text(_render_dynamic_imports_toml(unguarded_entries), encoding="utf-8")
+        assert preflight.validate_dynamic_imports() == []
+    findings = preflight.validate_dynamic_imports()
+    assert any(
+        finding.message == "dynamic import source inventory is incomplete"
+        and "dict display key/value evaluation order is unproven" in finding.detail
+        for finding in findings
+    )
+
+
+def test_dynamic_import_dict_literal_key_preserves_dynamic_value(
+    tmp_path: Path, monkeypatch: pytest.MonkeyPatch
+) -> None:
+    _dynamic_import_fixture(
+        tmp_path,
+        monkeypatch,
+        "from importlib import import_module\n{'fixed': import_module('polisyos.reached')}\n",
+    )
+    entries = preflight.collect_dynamic_imports()
+    assert len(entries) == 1
+    assert entries[0]["allowed_targets"] == ["polisyos.reached"]
+
+
+def test_dynamic_import_dict_plain_name_reads_stay_nonfailing(
+    tmp_path: Path, monkeypatch: pytest.MonkeyPatch
+) -> None:
+    _dynamic_import_fixture(tmp_path, monkeypatch, "key = 1\nvalue = 2\n{key: value}\n")
+    assert preflight.collect_dynamic_imports() == []
+
+
+def test_dynamic_import_dict_unknown_order_no_sink_is_refused(
+    tmp_path: Path, monkeypatch: pytest.MonkeyPatch
+) -> None:
+    """The bounded syntactic proof also refuses this harmless no-import display."""
+    _dynamic_import_fixture(tmp_path, monkeypatch, "key = 1\n{key: len(())}\n")
+    with pytest.raises(
+        preflight.DynamicImportCollectionError,
+        match="dict display key/value evaluation order is unproven",
+    ):
+        preflight.collect_dynamic_imports()
