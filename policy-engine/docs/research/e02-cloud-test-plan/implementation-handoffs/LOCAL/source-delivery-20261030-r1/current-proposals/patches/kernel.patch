+            timeout_seconds=3,
+            breaker=CircuitBreaker("completion-signal"),
+            executor=pool,
+        )
+        handle = guard.create_parent_completion(store, budget)
+        saved.append(handle)
+
+        def parent(grant) -> str:
+            basis = json.dumps(
+                {
+                    "artifact_id": "sha256:" + "1" * 64,
+                    "kind": "test.basis",
+                    "media_type": "application/json",
+                    "manifest_profile_sha256": "sha256:" + "2" * 64,
+                },
+                sort_keys=True,
+                separators=(",", ":"),
