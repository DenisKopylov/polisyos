+    worker = ControlWorker(
+        store=store,
+        handler=handler,
+        worker_id="worker-a",
+        lease_seconds=1,
+        child_execution_budget_policy=ChildExecutionBudgetPolicy("test", "1", 10),
+    )
+    try:
+        worker._run_with_lease_heartbeat(job)
+        assert saved[0].observe().interrupted
+    finally:
+        pool.shutdown(wait=True)
