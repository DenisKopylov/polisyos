+        assert guard.has_unsettled_operations()
+        release.set()
+        running._worker_future.result(timeout=3)
+        pool.shutdown(wait=True)
+        assert not callback_started.is_set()
+        assert not guard.has_unsettled_operations()
+    finally:
+        release.set()
+        guard.close()
+        pool.shutdown(wait=True)
