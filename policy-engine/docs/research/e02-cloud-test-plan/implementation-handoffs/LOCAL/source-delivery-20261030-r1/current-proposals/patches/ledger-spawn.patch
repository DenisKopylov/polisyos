+"""Importable target for durable compute reservation process tests."""
+
+from __future__ import annotations
+
+from decimal import Decimal
+from pathlib import Path
+
+from polisyos.scientist.orchestration.engine.budget_ledger import FileBudgetLedger
+
+REQUEST = "1" * 64
+
+
+def _process_reserve(path: str, event: str, barrier, result) -> None:  # noqa: ANN001
+    owner = FileBudgetLedger(Path(path))
+    barrier.wait()
+    try:
+        owner.reserve_compute(event, REQUEST, "run", Decimal("0.75"))
+    except ValueError as exc:
+        result.put(("refused", str(exc)))
+    else:
+        result.put(("reserved", event))
