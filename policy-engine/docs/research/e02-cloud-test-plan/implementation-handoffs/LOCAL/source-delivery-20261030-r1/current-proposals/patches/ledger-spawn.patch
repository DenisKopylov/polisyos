+_OWNED_CHILD_CLEANUP_SECONDS = 5.0
+
+
+def _timeout_child_statuses(
+    processes: list[BaseProcess],
+) -> list[dict[str, object]]:
+    statuses: list[dict[str, object]] = []
+    for process in processes:
+        if process.pid is not None:
+            process.join(timeout=0)
+        statuses.append(
+            {
+                "name": process.name,
+                "pid": process.pid,
+                "is_alive": process.is_alive(),
+                "exitcode": process.exitcode,
+            }
+        )
+    return statuses
+
+
+def _cleanup_owned_children(
+    processes: list[BaseProcess],
+) -> tuple[list[dict[str, object]], list[str]]:
+    observations: list[dict[str, object]] = []
+    errors: list[str] = []
+    for process in processes:
+        if process.pid is not None and process.is_alive():
+            try:
+                process.terminate()
+                process.join(timeout=_OWNED_CHILD_CLEANUP_SECONDS)
+                if process.is_alive():
+                    process.kill()
+                    process.join(timeout=_OWNED_CHILD_CLEANUP_SECONDS)
+            except Exception as exc:
+                errors.append(f"pid={process.pid}: {type(exc).__name__}: {exc}")
+        observations.append(
+            {
+                "name": process.name,
+                "pid": process.pid,
+                "is_alive_after_cleanup": process.is_alive(),
+                "exitcode_after_cleanup": process.exitcode,
+            }
+        )
+        if process.is_alive():
+            errors.append(f"pid={process.pid}: still alive after bounded cleanup")
+    return observations, errors
 
 
