+    assert selected is protocol.ArtifactReader is facade.ArtifactReader
+    events = [event for event in capture.import_events() if event.provider_name == "polisyos.core.artifacts.protocol" and event.importer_name == "polisyos.core.artifacts" and "ArtifactReader" in event.retained_exports]
+    assert events
