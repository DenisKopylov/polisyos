+
+def _passive_capture_lookup(mapping: object, name: str) -> object:
+    if type(mapping) not in (dict, types.MappingProxyType):
+        return _NO_EXECUTION_BINDING
+    try:
+        for key, value in mapping.items():
+            if type(key) is str and key == name:
+                return value
+    except RuntimeError:
+        return _NO_EXECUTION_BINDING
+    return _NO_EXECUTION_BINDING
