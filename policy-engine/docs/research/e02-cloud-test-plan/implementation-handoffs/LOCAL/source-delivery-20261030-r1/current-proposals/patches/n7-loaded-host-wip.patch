+from polisyos.runtime.quality import confidence_ledger as ledger
+from polisyos.runtime.quality import promotion_sequence as promotion
+
+
+def _scope(purpose: str) -> ledger.ConfidenceRiskBudgetScope:
+    return ledger.ConfidenceRiskBudgetScope(
+        scope_owner_ref="polisyos.runtime.quality.promotion_sequence",
+        authority_purpose=purpose,
+        owner_scope_key="design-problem:unsealed-loaded-execution-test",
+        owner_projection_hash="sha256:" + "1" * 64,
+        epoch_ref=None,
+        model_ref=None,
+        rule_ref="policyos.layer3.gy.n9.v1",
+        schema_ref="policyos.runtime.design_problem.v1",
+    )
+
+
+def test_unsealed_n9_session_refuses_before_creating_owner_state() -> None:
+    root = ledger._loaded_policy_engine_root()
+    scope = _scope("n9_promotion")
+    scope_id = scope.scope_id
+    with pytest.raises(ledger.ConfidenceLedgerError) as error:
+        ledger.ConfidenceLedgerSession.from_repo(root, risk_scope=scope)
+    assert error.value.code == "canonical_loaded_runtime_mismatch"
+    assert "protected use are not established" in error.value.detail
+    assert scope.scope_id == scope_id
+
+
+def test_n9_replay_refuses_before_invoking_unqualified_resolver() -> None:
+    class ResolverMustNotRun:
+        def __getattribute__(self, name: str) -> object:
+            raise AssertionError(f"resolver was consulted: {name}")
+
+    issues = promotion.validate_canonical_promotion_receipt(
+        {},
+        open_world_resolver=ResolverMustNotRun(),  # type: ignore[arg-type]
+    )
+    assert issues == (
+        {
+            "code": "confidence_ledger_recomputation_failed",
+            "reason": "canonical_loaded_runtime_mismatch",
+            "detail": "loaded execution profile and protected use are not established",
+        },
+    )
+
+
+def test_unsealed_n9_sequence_refuses_before_consumer_callbacks() -> None:
+    with pytest.raises(ValueError, match="confidence_ledger_loaded_execution_not_established"):
+        promotion.run_canonical_promotion_sequence(
+            object(),
+            confidence_ledger_session=object(),  # type: ignore[arg-type]
+        )
+
+
+def test_new_gate_does_not_relabel_the_legacy_loaded_observation(
+    monkeypatch: pytest.MonkeyPatch,
+) -> None:
+    before = ledger.capture_loaded_deployment_identity()
+    monkeypatch.setattr(ledger, "_loaded_execution_authority_ready", lambda: True)
+    after = ledger.capture_loaded_deployment_identity()
+    assert before == after
