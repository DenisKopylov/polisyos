  "implementation": {
    "strategy": "Extend the existing Trinity owner writer and selected-view persistence path with optional typed tenant context; preserve None as intentionally unscoped.",
    "contract": "persist_trinity_bundle_artifact(store, bundle, *, tenant_context=...) accepts an existing typed context or mapping; the owner-write options preserve tenant context on the Trinity artifact manifest.",
    "producer": "The typed persistence helper is implemented and exercised by owner unit tests.",
