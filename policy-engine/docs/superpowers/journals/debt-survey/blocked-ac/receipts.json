  "assessment-consistency": {
    "command": "python3 -c 'from collections import Counter\nimport hashlib\nimport json\nfrom pathlib import Path\nimport re\nreport_path = Path(\"docs/superpowers/specs/2026-09-11-debt-nature-survey-blocked-ac.md\")\nmanifest_path = Path(\"docs/superpowers/journals/debt-survey/denominator/reconciliation.json\")\nreceipt_path = Path(\"docs/superpowers/journals/debt-survey/blocked-ac/receipts.json\")\nsource = report_path.read_text()\nrows = json.loads(source.split(\"```json\\n\", 1)[1].split(\"\\n```\", 1)[0])\nheadings = re.findall(r\"^### [0-9]+\\. `([^`]+)`\", source, re.M)\nmanifest = json.loads(manifest_path.read_text())\nexpected = [r[\"id\"] for r in manifest[\"nonterminal\"] if r[\"status\"] == \"blocked\" and r[\"section\"] in {\"A\", \"C\"}]\nids = [r[\"id\"] for r in rows]\nassert len(ids) == len(set(ids)) == len(headings) == len(expected)\nassert set(ids) == set(headings) == set(expected)\nfields = (\"premise_false\", \"appointment_effect\", \"engineering\", \"allocation\", \"confidence\")\nfirst = {f: dict(sorted(Counter(r[f] for r in rows).items())) for f in fields}\nsecond = {f: {v: sum(r[f] == v for r in rows) for v in sorted({r[f] for r in rows})} for f in fields}\nassert first == second\nassert all(sum(v.values()) == len(rows) for v in first.values())\nreceipts = {k: v for k, v in json.loads(receipt_path.read_text()).items() if k != \"assessment-consistency\"}\nmismatches = [k for k,v in receipts.items() if hashlib.sha256(Path(v[\"complete_output\"]).read_bytes()).hexdigest() != v[\"sha256\"]]\nassert not mismatches\nprint(json.dumps({\n \"measurement\": \"assessment document consistency, not source capability verification\",\n \"report\": str(report_path), \"report_file_type\": \".md\",\n \"report_sha256\": hashlib.sha256(report_path.read_bytes()).hexdigest(),\n \"manifest\": str(manifest_path), \"manifest_file_type\": \".json\",\n \"base\": manifest[\"base\"], \"membership\": {\"count\": len(rows), \"json_equals_numbered_headings_equals_manifest\": True},\n \"aggregation\": \"Counter equals independent predicate sum; all field counts sum to membership\",\n \"distributions\": first,\n \"engineering_complete_and_changes_reachable_slot\": sum(r[\"engineering\"] == \"complete\" and r[\"appointment_effect\"] == \"changes_reachable_slot\" for r in rows),\n \"receipt_index\": str(receipt_path), \"receipt_denominator_excluding_this_record\": len(receipts),\n \"receipt_hash_mismatch_labels\": mismatches\n}, indent=2))\n'",
    "cwd": "/Users/deniskopylov/polisyos/.worktrees/debt-nature-survey/policy-engine",
    "exit_code": 0,
    "seconds": 0.059,
    "complete_output": "docs/superpowers/journals/debt-survey/blocked-ac/raw/assessment-consistency.txt",
