{
  "name": "@polisyos/runtime-dashboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "vite",
    "dev:mock": "VITE_USE_MOCKS=true vite",
    "build": "npm run typecheck && vite build && node ./scripts/postbuild-security.mjs",
    "preview": "vite preview",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test:storybook": "vitest run --config vitest.storybook.config.ts",
    "test": "npm run test:components",
    "test:components": "vitest run",
    "test:components:watch": "vitest",
    "test:contracts": "vitest run src/test/contracts/contractFixtures.test.ts",
    "test:watch": "npm run test:components:watch",
    "test:coverage": "vitest run --coverage --maxWorkers=1 --testTimeout=20000 --hookTimeout=20000 && node ./scripts/check-coverage-ratchet.mjs",
    "test:a11y": "npm run test:a11y:components && npm run test:a11y:pages",
    "test:components:a11y": "vitest run --config vitest.a11y.config.ts",
    "test:a11y:components": "vitest run --config vitest.a11y.config.ts",
    "test:a11y:pages": "playwright test e2e/a11y --project=chromium",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "generate:api": "./scripts/generate-api-client.sh",
    "contracts:record": "node ./scripts/record-runtime-contracts.mjs",
    "contracts:verify": "node ./scripts/verify-runtime-contracts.mjs",
    "test:e2e": "npm run test:journeys",
    "test:journeys": "playwright test e2e/journeys --project=chromium",
    "test:e2e:journeys": "npm run test:journeys",
    "test:journeys:smoke": "playwright test e2e/journeys --grep @smoke",
    "test:e2e:smoke": "npm run test:journeys:smoke",
    "test:journeys:mobile-smoke": "playwright test e2e/journeys --project=mobile-chromium --grep @smoke",
    "test:e2e:mobile-smoke": "npm run test:journeys:mobile-smoke",
    "test:journeys:quarantine": "PLAYWRIGHT_INCLUDE_QUARANTINE=1 playwright test e2e/journeys --grep @quarantine",
    "test:journeys:flaky": "PLAYWRIGHT_INCLUDE_QUARANTINE=1 playwright test e2e/journeys --grep @flaky",
    "test:e2e:headed": "playwright test e2e/journeys --project=chromium --headed",
    "test:visual": "playwright test e2e/runtime-dashboard.visual.spec.ts --project=chromium",
    "test:visual:quarantine": "PLAYWRIGHT_INCLUDE_QUARANTINE=1 playwright test e2e/runtime-dashboard.visual.spec.ts --grep @quarantine",
    "playwright:install": "playwright install chromium",
    "lint": "eslint src .storybook e2e scripts eslint.config.mjs vite.config.ts vitest.config.ts vitest.a11y.config.ts vitest.storybook.config.ts playwright.config.ts tailwind.config.ts --cache --cache-location .eslintcache --max-warnings=0",
    "lint:fix": "eslint src .storybook e2e scripts eslint.config.mjs vite.config.ts vitest.config.ts vitest.a11y.config.ts vitest.storybook.config.ts playwright.config.ts tailwind.config.ts --cache --cache-location .eslintcache --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "check:architecture": "node ./scripts/check-architecture.mjs && depcruise --config .dependency-cruiser.mjs src",
    "analyze:bundle": "ANALYZE_BUNDLE=true npm run build",
    "check:bundle": "node ./scripts/check-bundle-budgets.mjs",
    "bundle:stats": "node ./scripts/emit-bundle-stats.mjs",
    "bundle:diff": "node ./scripts/compare-bundle-stats.mjs",
    "lighthouse:ci": "lhci autorun --config=.lighthouserc.json",
    "lighthouse:report": "node ./scripts/summarize-lighthouse.mjs",
    "audit:ci": "node ./scripts/run-audit.mjs",
    "visual:report": "node ./scripts/summarize-playwright-visual.mjs",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.2.7",
    "@fontsource/manrope": "^5.2.8",
    "@hookform/resolvers": "^5.2.2",
    "@sentry/react": "^10.42.0",
    "@tanstack/react-query": "^5.90.21",
    "@tanstack/react-virtual": "^3.13.21",
    "clsx": "^2.1.1",
    "idb": "^8.0.3",
    "openapi-fetch": "^0.15.2",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-hook-form": "^7.71.2",
    "react-router-dom": "^7.13.1",
    "recharts": "^2.15.4",
    "tailwind-merge": "^3.5.0",
    "vite-plugin-pwa": "^1.2.0",
    "zod": "^4.3.6",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.1",
    "@eslint/js": "^9.39.4",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.55.0",
    "@storybook/addon-a11y": "^9.1.20",
    "@storybook/addon-vitest": "^9.1.20",
    "@storybook/react-vite": "^9.1.20",
    "@tailwindcss/postcss": "^4.2.1",
    "@tailwindcss/vite": "^4.2.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.3.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.4",
    "@sentry/vite-plugin": "^5.1.1",
    "@vitest/browser-playwright": "^4.0.18",
    "@vitest/coverage-v8": "^4.0.18",
    "@vitest/eslint-plugin": "^1.6.9",
    "dependency-cruiser": "^16.10.4",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-boundaries": "^5.4.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-storybook": "^9.1.20",
    "eslint-plugin-testing-library": "^7.16.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.4.0",
    "jsdom": "^27.0.1",
    "lefthook": "^2.1.3",
    "msw": "^2.12.10",
    "openapi-typescript": "^7.6.1",
    "postcss": "^8.5.3",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "rollup-plugin-visualizer": "^7.0.1",
    "storybook": "^9.1.20",
    "tailwindcss": "^4.2.1",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.56.1",
    "vite": "^7.3.1",
    "vitest": "^4.0.18",
    "vitest-axe": "^0.1.0",
    "web-vitals": "^5.1.0"
  }
}
