PROJECT_ID=polisyos-lex
PROJECT_NAME=PolicyOS Lex Pipeline
BILLING_ACCOUNT_ID=REPLACE_ME
REGION=europe-west1
ZONE=europe-west1-b
BUCKET_NAME=polisyos-lex-data
WORKER_SA_NAME=lex-workers
SNAPSHOT_LABEL=2026-04-05
STATUS_PASS=current
WORKER_MODE=preflight
MACHINE_TYPE=t2d-standard-2
BOOT_DISK_SIZE_GB=30
BOOT_DISK_TYPE=pd-standard
RUN_LABEL=phase1-YYYYMMDD-HHMMSS
SYNC_INTERVAL_SEC=120
AUTO_SHUTDOWN=1
RESUME_CACHE_ENABLED=1
# Optional override. By default workers use:
# gs://$BUCKET_NAME/cache/lex_resume/$SNAPSHOT_LABEL/$STATUS_PASS/shards_$SHARD_COUNT/
# RESUME_CACHE_ROOT=gs://polisyos-lex-data/cache/lex_resume/2026-04-05/current/shards_6
# Example for quota-aware multi-region fan-out:
# SHARD_ZONE_MAP=0:europe-west1-b,1:europe-west1-b,2:europe-west1-b,3:europe-west4-b,4:europe-west4-b,5:europe-west4-b
