{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "",
      "type": "datasource",
      "pluginId": "prometheus"
    }
  ],
  "title": "PolicyOS — Scientist LLM Cost Dashboard",
  "uid": "polisyos-scientist-llm-cost",
  "version": 1,
  "panels": [
    {
      "title": "LLM Cost over Time",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "targets": [
        {
          "expr": "sum(rate(polisyos_llm_cost_usd_sum[5m])) by (model_id)",
          "legendFormat": "{{model_id}}"
        }
      ]
    },
    {
      "title": "Token Usage by Model",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "targets": [
        {
          "expr": "sum(rate(polisyos_llm_tokens_total[5m])) by (model_id, direction)",
          "legendFormat": "{{model_id}} — {{direction}}"
        }
      ]
    },
    {
      "title": "Budget Utilization",
      "type": "gauge",
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 8},
      "targets": [
        {
          "expr": "polisyos_scientist_llm_budget_utilization",
          "legendFormat": "{{budget_key}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 0.8},
              {"color": "red", "value": 0.95}
            ]
          },
          "max": 1,
          "min": 0
        }
      }
    },
    {
      "title": "Cost Anomalies",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 8, "x": 8, "y": 8},
      "targets": [
        {
          "expr": "sum(rate(polisyos_scientist_llm_cost_anomalies_total[5m])) by (model_id)",
          "legendFormat": "{{model_id}}"
        }
      ]
    },
    {
      "title": "Latency P50 / P95 / P99",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 8, "x": 16, "y": 8},
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(polisyos_llm_latency_ms_bucket[5m])) by (le, model_id))",
          "legendFormat": "P50 {{model_id}}"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(polisyos_llm_latency_ms_bucket[5m])) by (le, model_id))",
          "legendFormat": "P95 {{model_id}}"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(polisyos_llm_latency_ms_bucket[5m])) by (le, model_id))",
          "legendFormat": "P99 {{model_id}}"
        }
      ]
    }
  ]
}
