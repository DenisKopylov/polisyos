            "--muted": "var(--slate)",
            "--panel": "rgba(255, 255, 255, 0.85)",
            "--panel-strong": "rgba(255, 255, 255, 0.9)",
            "--shadow-panel": "0 24px 70px rgba(24, 28, 31, 0.16)",
