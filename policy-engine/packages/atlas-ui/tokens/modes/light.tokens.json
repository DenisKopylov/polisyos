            "--chart-primary": "var(--teal-vibrant)",
            "--chart-secondary": "color-mix(in srgb, var(--teal) 58%, var(--graphite))",
            "--chart-success": "color-mix(in srgb, var(--teal) 78%, white 22%)",
            "--chart-tertiary": "color-mix(in srgb, var(--ink) 82%, var(--gold) 18%)",
            "--chart-warning": "color-mix(in srgb, var(--gold) 80%, white 20%)",
            "--danger": "var(--ember)",
            "--ember-soft": "rgba(146, 57, 29, 0.12)",
            "--focus-ring": "rgba(28, 139, 130, 0.9)",
            "--gold-soft": "rgba(108, 81, 17, 0.16)",
