{
  "name": "@polisyos/runtime-api-client",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./canonicalRuntimeApiClient.js",
  "types": "./canonicalRuntimeApiClient.ts",
  "exports": {
    ".": {
      "types": "./canonicalRuntimeApiClient.ts",
      "import": "./canonicalRuntimeApiClient.js"
    },
    "./types": {
      "types": "./types.ts"
    }
  },
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "build": "corepack pnpm run typecheck",
    "generate": "bash ./scripts/generate-runtime-api-client.sh",
    "contracts:verify": "cd ../.. && PYTHONPATH=src:. uv run --extra runtime --extra ml python tools/ops_runners/runtime/check_runtime_api_contract.py",
    "test": "node --test runtimeApiClient.test.mjs scripts/canonicalize-runtime-client.test.mjs",
    "lint": "eslint runtimeApiClient.ts canonicalRuntimeApiClient.ts runtimeApiClient.type-test.ts runtimeApiClient.js canonicalRuntimeApiClient.js runtimeApiClient.test.mjs scripts/*.mjs eslint.config.mjs --max-warnings=0",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check:architecture": "node ./scripts/check-architecture.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "eslint": "^9.39.4",
    "globals": "^17.4.0",
    "prettier": "^3.8.1",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.56.1"
  }
}
