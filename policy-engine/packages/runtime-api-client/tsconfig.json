{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["DOM", "ES2023"],
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true
  },
  "include": [
    "runtimeApiClient.ts",
    "canonicalRuntimeApiClient.ts",
    "runtimeApiClient.type-test.ts",
    "runtimeApiClient.js",
    "canonicalRuntimeApiClient.js",
    "types.ts"
  ]
}
