{
  "$defs": {
    "AdvisoryEntity": {
      "additionalProperties": false,
      "properties": {
        "entity_id": {
          "pattern": "^[a-z][a-z0-9_.-]*$",
          "title": "Entity Id",
          "type": "string"
        },
        "entity_type": {
          "$ref": "#/$defs/EntityType"
        },
        "name": {
          "anyOf": [
            {
              "$ref": "#/$defs/TranslatableString"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "parent_id": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9_.-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parent Id"
        },
        "attributes": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              },
              {
                "type": "boolean"
              }
            ]
          },
          "title": "Attributes",
          "type": "object"
        }
      },
      "required": [
        "entity_id",
        "entity_type"
      ],
      "title": "AdvisoryEntity",
      "type": "object"
    },
    "ConstraintSpec": {
      "additionalProperties": false,
      "properties": {
        "constraint_id": {
          "pattern": "^[a-z][a-z0-9_.-]*$",
          "title": "Constraint Id",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "$ref": "#/$defs/MoneyValue"
            },
            {
              "$ref": "#/$defs/RateValue"
            },
            {
              "$ref": "#/$defs/CountValue"
            },
            {
              "$ref": "#/$defs/DurationValue"
            },
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "integer"
            },
            {
              "type": "string"
            },
            {
              "type": "boolean"
            }
          ],
          "title": "Value"
        },
        "notes": {
          "items": {
            "type": "string"
          },
          "title": "Notes",
          "type": "array"
        }
      },
      "required": [
        "constraint_id",
        "value"
      ],
      "title": "ConstraintSpec",
      "type": "object"
    },
    "CountValue": {
      "additionalProperties": false,
      "properties": {
        "value": {
          "minimum": 0,
          "title": "Value",
          "type": "integer"
        },
        "label": {
          "anyOf": [
            {
              "maxLength": 64,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Label"
        }
      },
      "required": [
        "value"
      ],
      "title": "CountValue",
      "type": "object"
    },
    "DurationValue": {
      "additionalProperties": false,
      "properties": {
        "value": {
          "minimum": 0,
          "title": "Value",
          "type": "integer"
        },
        "unit": {
          "default": "step",
          "enum": [
            "step",
            "day",
            "month",
            "quarter",
            "year"
          ],
          "title": "Unit",
          "type": "string"
        }
      },
      "required": [
        "value"
      ],
      "title": "DurationValue",
      "type": "object"
    },
    "EntityType": {
      "description": "\u0422\u0438\u043f\u044b \u0430\u0433\u0435\u043d\u0442\u043e\u0432 \u0438 \u043e\u0431\u044a\u0435\u043a\u0442\u043e\u0432 \u0432 \u0441\u0438\u0441\u0442\u0435\u043c\u0435.",
      "enum": [
        "agent",
        "resource",
        "infrastructure",
        "environment"
      ],
      "title": "EntityType",
      "type": "string"
    },
    "InterventionSpec": {
      "additionalProperties": false,
      "properties": {
        "intervention_id": {
          "pattern": "^[a-z][a-z0-9_.-]*$",
          "title": "Intervention Id",
          "type": "string"
        },
        "kind": {
          "pattern": "^[a-z][a-z0-9_.-]*$",
          "title": "Kind",
          "type": "string"
        },
        "target": {
          "discriminator": {
            "mapping": {
              "all_of": "#/$defs/SelectorAll",
              "any_of": "#/$defs/SelectorAny",
              "not": "#/$defs/SelectorNot",
              "predicate": "#/$defs/SelectorPredicate"
            },
            "propertyName": "kind"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/SelectorPredicate"
            },
            {
              "$ref": "#/$defs/SelectorAll"
            },
            {
              "$ref": "#/$defs/SelectorAny"
            },
            {
              "$ref": "#/$defs/SelectorNot"
            }
          ],
          "title": "Target"
        },
        "schedule": {
          "$ref": "#/$defs/ScheduleSpec"
        },
        "params": {
          "additionalProperties": true,
          "title": "Params",
          "type": "object"
        },
        "priority": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Priority"
        },
        "notes": {
          "items": {
            "type": "string"
          },
          "title": "Notes",
          "type": "array"
        }
      },
      "required": [
        "intervention_id",
        "kind",
        "target",
        "schedule"
      ],
      "title": "InterventionSpec",
      "type": "object"
    },
    "MoneyValue": {
      "additionalProperties": false,
      "properties": {
        "amount": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Amount"
        },
        "currency": {
          "pattern": "^[A-Z]{3}$",
          "title": "Currency",
          "type": "string"
        },
        "nominal_year": {
          "anyOf": [
            {
              "maximum": 2100,
              "minimum": 1900,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Nominal Year"
        }
      },
      "required": [
        "amount",
        "currency"
      ],
      "title": "MoneyValue",
      "type": "object"
    },
    "ObjectiveSpec": {
      "additionalProperties": false,
      "properties": {
        "objective_id": {
          "pattern": "^[a-z][a-z0-9_.-]*$",
          "title": "Objective Id",
          "type": "string"
        },
        "metric_id": {
          "pattern": "^[a-z][a-z0-9_.-]*$",
          "title": "Metric Id",
          "type": "string"
        },
        "direction": {
          "$ref": "#/$defs/OptimizationDirection"
        },
        "target": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target"
        },
        "weight": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "default": "1",
          "ge": 0,
          "title": "Weight"
        }
      },
      "required": [
        "objective_id",
        "metric_id",
        "direction"
      ],
      "title": "ObjectiveSpec",
      "type": "object"
    },
    "OptimizationDirection": {
      "description": "\u041a\u0443\u0434\u0430 \u0434\u0432\u0438\u0433\u0430\u0442\u044c \u043c\u0435\u0442\u0440\u0438\u043a\u0443.",
      "enum": [
        "maximize",
        "minimize",
        "maintain_range"
      ],
      "title": "OptimizationDirection",
      "type": "string"
    },
    "PolicyAdvisory": {
      "additionalProperties": false,
      "properties": {
        "entities": {
          "items": {
            "$ref": "#/$defs/AdvisoryEntity"
          },
          "title": "Entities",
          "type": "array"
        },
        "narrative": {
          "anyOf": [
            {
              "maxLength": 2000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Narrative"
        },
        "labels": {
          "items": {
            "type": "string"
          },
          "title": "Labels",
          "type": "array"
        },
        "notes": {
          "items": {
            "type": "string"
          },
          "title": "Notes",
          "type": "array"
        }
      },
      "title": "PolicyAdvisory",
      "type": "object"
    },
    "PolicySemantic": {
      "additionalProperties": false,
      "properties": {
        "context_snapshot_ref": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Context Snapshot Ref",
          "type": "string"
        },
        "registry_bundle_ref": {
          "anyOf": [
            {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Registry Bundle Ref"
        },
        "time_semantics": {
          "anyOf": [
            {
              "$ref": "#/$defs/TimeSemantics"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "objectives": {
          "items": {
            "$ref": "#/$defs/ObjectiveSpec"
          },
          "title": "Objectives",
          "type": "array"
        },
        "interventions": {
          "items": {
            "$ref": "#/$defs/InterventionSpec"
          },
          "title": "Interventions",
          "type": "array"
        },
        "constraints": {
          "items": {
            "$ref": "#/$defs/ConstraintSpec"
          },
          "title": "Constraints",
          "type": "array"
        },
        "notes": {
          "items": {
            "type": "string"
          },
          "title": "Notes",
          "type": "array"
        }
      },
      "required": [
        "context_snapshot_ref"
      ],
      "title": "PolicySemantic",
      "type": "object"
    },
    "RateValue": {
      "additionalProperties": false,
      "properties": {
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Value"
        },
        "base": {
          "default": "ratio",
          "enum": [
            "ratio",
            "percent"
          ],
          "title": "Base",
          "type": "string"
        }
      },
      "required": [
        "value"
      ],
      "title": "RateValue",
      "type": "object"
    },
    "ScheduleSpec": {
      "additionalProperties": false,
      "properties": {
        "start_step": {
          "minimum": 0,
          "title": "Start Step",
          "type": "integer"
        },
        "end_step": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "End Step"
        },
        "duration_steps": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Duration Steps"
        }
      },
      "required": [
        "start_step"
      ],
      "title": "ScheduleSpec",
      "type": "object"
    },
    "SelectorAll": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "all_of",
          "default": "all_of",
          "title": "Kind",
          "type": "string"
        },
        "clauses": {
          "items": {
            "discriminator": {
              "mapping": {
                "all_of": "#/$defs/SelectorAll",
                "any_of": "#/$defs/SelectorAny",
                "not": "#/$defs/SelectorNot",
                "predicate": "#/$defs/SelectorPredicate"
              },
              "propertyName": "kind"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/SelectorPredicate"
              },
              {
                "$ref": "#/$defs/SelectorAll"
              },
              {
                "$ref": "#/$defs/SelectorAny"
              },
              {
                "$ref": "#/$defs/SelectorNot"
              }
            ]
          },
          "title": "Clauses",
          "type": "array"
        }
      },
      "required": [
        "clauses"
      ],
      "title": "SelectorAll",
      "type": "object"
    },
    "SelectorAny": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "any_of",
          "default": "any_of",
          "title": "Kind",
          "type": "string"
        },
        "clauses": {
          "items": {
            "discriminator": {
              "mapping": {
                "all_of": "#/$defs/SelectorAll",
                "any_of": "#/$defs/SelectorAny",
                "not": "#/$defs/SelectorNot",
                "predicate": "#/$defs/SelectorPredicate"
              },
              "propertyName": "kind"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/SelectorPredicate"
              },
              {
                "$ref": "#/$defs/SelectorAll"
              },
              {
                "$ref": "#/$defs/SelectorAny"
              },
              {
                "$ref": "#/$defs/SelectorNot"
              }
            ]
          },
          "title": "Clauses",
          "type": "array"
        }
      },
      "required": [
        "clauses"
      ],
      "title": "SelectorAny",
      "type": "object"
    },
    "SelectorNot": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "not",
          "default": "not",
          "title": "Kind",
          "type": "string"
        },
        "clause": {
          "discriminator": {
            "mapping": {
              "all_of": "#/$defs/SelectorAll",
              "any_of": "#/$defs/SelectorAny",
              "not": "#/$defs/SelectorNot",
              "predicate": "#/$defs/SelectorPredicate"
            },
            "propertyName": "kind"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/SelectorPredicate"
            },
            {
              "$ref": "#/$defs/SelectorAll"
            },
            {
              "$ref": "#/$defs/SelectorAny"
            },
            {
              "$ref": "#/$defs/SelectorNot"
            }
          ],
          "title": "Clause"
        }
      },
      "required": [
        "clause"
      ],
      "title": "SelectorNot",
      "type": "object"
    },
    "SelectorOperator": {
      "description": "\u0420\u0430\u0437\u0440\u0435\u0448\u0435\u043d\u043d\u044b\u0435 \u043e\u043f\u0435\u0440\u0430\u0442\u043e\u0440\u044b \u0434\u043b\u044f TargetSelector (AST).",
      "enum": [
        "==",
        "!=",
        ">",
        "<",
        ">=",
        "<=",
        "in",
        "not_in",
        "between",
        "contains"
      ],
      "title": "SelectorOperator",
      "type": "string"
    },
    "SelectorPredicate": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "predicate",
          "default": "predicate",
          "title": "Kind",
          "type": "string"
        },
        "field": {
          "maxLength": 64,
          "title": "Field",
          "type": "string"
        },
        "operator": {
          "$ref": "#/$defs/SelectorOperator"
        },
        "value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            },
            {
              "type": "boolean"
            },
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "items": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "integer"
                  },
                  {
                    "type": "boolean"
                  },
                  {
                    "type": "number"
                  },
                  {
                    "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
                    "type": "string"
                  }
                ]
              },
              "type": "array"
            }
          ],
          "title": "Value"
        }
      },
      "required": [
        "field",
        "operator",
        "value"
      ],
      "title": "SelectorPredicate",
      "type": "object"
    },
    "TimeFrequency": {
      "description": "\u0415\u0434\u0438\u043d\u0438\u0446\u044b \u0432\u0440\u0435\u043c\u0435\u043d\u0438 \u0434\u043b\u044f \u0441\u0438\u043c\u0443\u043b\u044f\u0446\u0438\u0438.",
      "enum": [
        "M",
        "Q",
        "Y"
      ],
      "title": "TimeFrequency",
      "type": "string"
    },
    "TimeSemantics": {
      "additionalProperties": false,
      "properties": {
        "frequency": {
          "$ref": "#/$defs/TimeFrequency"
        },
        "start_date": {
          "title": "Start Date",
          "type": "string"
        },
        "step_count": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Step Count"
        },
        "end_date": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "End Date"
        },
        "notes": {
          "items": {
            "type": "string"
          },
          "title": "Notes",
          "type": "array"
        }
      },
      "required": [
        "frequency",
        "start_date"
      ],
      "title": "TimeSemantics",
      "type": "object"
    },
    "TranslatableString": {
      "additionalProperties": false,
      "description": "\u041c\u0443\u043b\u044c\u0442\u0438\u044f\u0437\u044b\u0447\u043d\u0430\u044f \u0441\u0442\u0440\u043e\u043a\u0430.\nLLM \u0432\u0438\u0434\u0438\u0442 'en' \u0434\u043b\u044f \u043b\u043e\u0433\u0438\u043a\u0438, \u0430 'ua'/'ru' \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u044e\u0442\u0441\u044f \u0434\u043b\u044f UI.",
      "properties": {
        "en": {
          "description": "English text for LLM logic",
          "maxLength": 200,
          "title": "En",
          "type": "string"
        },
        "ua": {
          "description": "Ukrainian text for Reporting/UI",
          "maxLength": 200,
          "title": "Ua",
          "type": "string"
        },
        "ru": {
          "anyOf": [
            {
              "maxLength": 200,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Russian text (optional)",
          "title": "Ru"
        }
      },
      "required": [
        "en",
        "ua"
      ],
      "title": "TranslatableString",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "default": "2.0",
      "pattern": "^\\d+\\.\\d+$",
      "title": "Schema Version",
      "type": "string"
    },
    "semantic": {
      "$ref": "#/$defs/PolicySemantic"
    },
    "advisory": {
      "anyOf": [
        {
          "$ref": "#/$defs/PolicyAdvisory"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "semantic"
  ],
  "title": "PolicySurfaceIR",
  "type": "object"
}