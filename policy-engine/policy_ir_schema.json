{
  "$defs": {
    "EntityType": {
      "description": "\u0422\u0438\u043f\u044b \u0430\u0433\u0435\u043d\u0442\u043e\u0432 \u0438 \u043e\u0431\u044a\u0435\u043a\u0442\u043e\u0432 \u0432 \u0441\u0438\u0441\u0442\u0435\u043c\u0435.",
      "enum": [
        "agent",
        "resource",
        "infrastructure",
        "environment"
      ],
      "title": "EntityType",
      "type": "string"
    },
    "GeneratorInfo": {
      "properties": {
        "name": {
          "description": "Component name",
          "maxLength": 500,
          "title": "Name",
          "type": "string"
        },
        "version": {
          "description": "Component version",
          "maxLength": 500,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "name",
        "version"
      ],
      "title": "GeneratorInfo",
      "type": "object"
    },
    "Intervention": {
      "properties": {
        "id": {
          "maxLength": 64,
          "pattern": "^[a-z0-9_]+$",
          "title": "Id",
          "type": "string"
        },
        "name": {
          "$ref": "#/$defs/TranslatableString"
        },
        "target_selector": {
          "$ref": "#/$defs/TargetSelector"
        },
        "mechanism_type": {
          "description": "\u0421\u0441\u044b\u043b\u043a\u0430 \u043d\u0430 \u043c\u0435\u0445\u0430\u043d\u0438\u0437\u043c \u0432 Foundry",
          "maxLength": 500,
          "title": "Mechanism Type",
          "type": "string"
        },
        "parameters": {
          "additionalProperties": true,
          "title": "Parameters",
          "type": "object"
        },
        "constraints": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Constraints",
          "type": "object"
        }
      },
      "required": [
        "id",
        "name",
        "target_selector",
        "mechanism_type",
        "parameters"
      ],
      "title": "Intervention",
      "type": "object"
    },
    "Objective": {
      "properties": {
        "metric_name": {
          "description": "Name of the metric to optimize (e.g. 'gdp', 'unemployment')",
          "maxLength": 500,
          "title": "Metric Name",
          "type": "string"
        },
        "direction": {
          "$ref": "#/$defs/OptimizationDirection"
        },
        "threshold": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Target value boundary if direction is RANGE",
          "title": "Threshold"
        },
        "priority_weight": {
          "default": 1.0,
          "maximum": 10.0,
          "minimum": 0.0,
          "title": "Priority Weight",
          "type": "number"
        }
      },
      "required": [
        "metric_name",
        "direction"
      ],
      "title": "Objective",
      "type": "object"
    },
    "OptimizationDirection": {
      "description": "\u041a\u0443\u0434\u0430 \u0434\u0432\u0438\u0433\u0430\u0442\u044c \u043c\u0435\u0442\u0440\u0438\u043a\u0443.",
      "enum": [
        "maximize",
        "minimize",
        "maintain_range"
      ],
      "title": "OptimizationDirection",
      "type": "string"
    },
    "PolicyEntity": {
      "description": "\u0421\u0443\u0449\u043d\u043e\u0441\u0442\u044c \u0432 \u043f\u043b\u043e\u0441\u043a\u043e\u043c \u0441\u043f\u0438\u0441\u043a\u0435 (Adjacency List).\n\u0418\u0435\u0440\u0430\u0440\u0445\u0438\u044f \u0441\u0442\u0440\u043e\u0438\u0442\u0441\u044f \u0447\u0435\u0440\u0435\u0437 parent_id.",
      "properties": {
        "id": {
          "description": "Unique slug (snake_case)",
          "maxLength": 64,
          "pattern": "^[a-z0-9_]+$",
          "title": "Id",
          "type": "string"
        },
        "entity_type": {
          "$ref": "#/$defs/EntityType"
        },
        "name": {
          "$ref": "#/$defs/TranslatableString"
        },
        "parent_id": {
          "anyOf": [
            {
              "maxLength": 64,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "ID \u0440\u043e\u0434\u0438\u0442\u0435\u043b\u044f. \u0414\u043e\u043b\u0436\u0435\u043d \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u043e\u0432\u0430\u0442\u044c \u0432 \u0441\u043f\u0438\u0441\u043a\u0435.",
          "title": "Parent Id"
        },
        "state_variables": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "integer"
              },
              {
                "type": "boolean"
              },
              {
                "type": "string"
              }
            ]
          },
          "description": "Initial state: {'balance': 1000.0}",
          "title": "State Variables",
          "type": "object"
        }
      },
      "required": [
        "id",
        "entity_type",
        "name"
      ],
      "title": "PolicyEntity",
      "type": "object"
    },
    "Scenarios": {
      "properties": {
        "random_seed": {
          "description": "Deterministic seed for scenarios",
          "title": "Random Seed",
          "type": "integer"
        },
        "shocks": {
          "items": {
            "$ref": "#/$defs/Shock"
          },
          "title": "Shocks",
          "type": "array"
        },
        "timeline": {
          "$ref": "#/$defs/Timeline"
        }
      },
      "required": [
        "random_seed",
        "timeline"
      ],
      "title": "Scenarios",
      "type": "object"
    },
    "SelectorOperator": {
      "description": "\u0420\u0430\u0437\u0440\u0435\u0448\u0435\u043d\u043d\u044b\u0435 \u043e\u043f\u0435\u0440\u0430\u0442\u043e\u0440\u044b \u0434\u043b\u044f TargetSelector (AST).",
      "enum": [
        "==",
        "!=",
        ">",
        "<",
        ">=",
        "<=",
        "in",
        "not_in",
        "between",
        "contains"
      ],
      "title": "SelectorOperator",
      "type": "string"
    },
    "SelectorPredicate": {
      "additionalProperties": false,
      "description": "\u0410\u0442\u043e\u043c\u0430\u0440\u043d\u043e\u0435 \u0443\u0441\u043b\u043e\u0432\u0438\u0435: field op value",
      "properties": {
        "field": {
          "description": "\u0410\u0442\u0440\u0438\u0431\u0443\u0442 \u0441\u0443\u0449\u043d\u043e\u0441\u0442\u0438, \u043d\u0430\u043f\u0440. 'sector'",
          "maxLength": 64,
          "title": "Field",
          "type": "string"
        },
        "operator": {
          "$ref": "#/$defs/SelectorOperator"
        },
        "value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "type": "boolean"
            },
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "items": {
                "type": "integer"
              },
              "type": "array"
            },
            {
              "items": {
                "type": "number"
              },
              "type": "array"
            },
            {
              "items": {
                "type": "boolean"
              },
              "type": "array"
            }
          ],
          "title": "Value"
        }
      },
      "required": [
        "field",
        "operator",
        "value"
      ],
      "title": "SelectorPredicate",
      "type": "object"
    },
    "Shock": {
      "description": "\u0412\u043d\u0435\u0448\u043d\u0438\u0439 \u0448\u043e\u043a/\u0441\u043e\u0431\u044b\u0442\u0438\u0435.",
      "properties": {
        "id": {
          "maxLength": 64,
          "pattern": "^[a-z0-9_]+$",
          "title": "Id",
          "type": "string"
        },
        "name": {
          "$ref": "#/$defs/TranslatableString"
        },
        "description": {
          "anyOf": [
            {
              "$ref": "#/$defs/TranslatableString"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "magnitude": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Magnitude"
        },
        "at_step": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "At Step"
        }
      },
      "required": [
        "id",
        "name"
      ],
      "title": "Shock",
      "type": "object"
    },
    "SimulationParameters": {
      "description": "\u0422\u0435\u0445\u043d\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u043f\u0430\u0440\u0430\u043c\u0435\u0442\u0440\u044b \u0441\u0438\u043c\u0443\u043b\u044f\u0446\u0438\u0438.",
      "properties": {
        "scope_years": {
          "maximum": 50,
          "minimum": 1,
          "title": "Scope Years",
          "type": "integer"
        },
        "time_frequency": {
          "$ref": "#/$defs/TimeFrequency",
          "default": "M"
        },
        "start_date": {
          "default": "2024-01-01",
          "title": "Start Date",
          "type": "string"
        },
        "random_seed": {
          "default": 42,
          "title": "Random Seed",
          "type": "integer"
        }
      },
      "required": [
        "scope_years"
      ],
      "title": "SimulationParameters",
      "type": "object"
    },
    "TargetSelector": {
      "additionalProperties": false,
      "description": "\u0421\u0442\u0440\u0443\u043a\u0442\u0443\u0440\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u044b\u0439 \u0444\u0438\u043b\u044c\u0442\u0440 \u0446\u0435\u043b\u0435\u0439.\n\u0417\u0430\u043c\u0435\u043d\u044f\u0435\u0442 \u0441\u0442\u0440\u043e\u043a\u0443 \"sector == 'IT'\".\n\u041f\u043e\u0434\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u0435\u0442 \u043a\u043e\u043c\u043f\u043e\u0437\u0438\u0446\u0438\u044e all_of/any_of/not.",
      "properties": {
        "all_of": {
          "items": {
            "$ref": "#/$defs/SelectorPredicate"
          },
          "title": "All Of",
          "type": "array"
        },
        "any_of": {
          "items": {
            "$ref": "#/$defs/SelectorPredicate"
          },
          "title": "Any Of",
          "type": "array"
        },
        "not": {
          "anyOf": [
            {
              "$ref": "#/$defs/TargetSelector"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "title": "TargetSelector",
      "type": "object"
    },
    "TimeFrequency": {
      "description": "\u0415\u0434\u0438\u043d\u0438\u0446\u044b \u0432\u0440\u0435\u043c\u0435\u043d\u0438 \u0434\u043b\u044f \u0441\u0438\u043c\u0443\u043b\u044f\u0446\u0438\u0438.",
      "enum": [
        "M",
        "Q",
        "Y"
      ],
      "title": "TimeFrequency",
      "type": "string"
    },
    "TimeUnit": {
      "description": "\u0415\u0434\u0438\u043d\u0438\u0446\u044b \u0432\u0440\u0435\u043c\u0435\u043d\u0438 \u0432 IR (\u0447\u0435\u043b\u043e\u0432\u0435\u0447\u0435\u0441\u043a\u0438\u0439 \u0444\u043e\u0440\u043c\u0430\u0442).",
      "enum": [
        "month",
        "quarter",
        "year"
      ],
      "title": "TimeUnit",
      "type": "string"
    },
    "Timeline": {
      "properties": {
        "start_year": {
          "maximum": 2100,
          "minimum": 1900,
          "title": "Start Year",
          "type": "integer"
        },
        "end_year": {
          "maximum": 2100,
          "minimum": 1900,
          "title": "End Year",
          "type": "integer"
        }
      },
      "required": [
        "start_year",
        "end_year"
      ],
      "title": "Timeline",
      "type": "object"
    },
    "TranslatableString": {
      "additionalProperties": false,
      "description": "\u041c\u0443\u043b\u044c\u0442\u0438\u044f\u0437\u044b\u0447\u043d\u0430\u044f \u0441\u0442\u0440\u043e\u043a\u0430.\nLLM \u0432\u0438\u0434\u0438\u0442 'en' \u0434\u043b\u044f \u043b\u043e\u0433\u0438\u043a\u0438, \u0430 'ua'/'ru' \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u044e\u0442\u0441\u044f \u0434\u043b\u044f UI.",
      "properties": {
        "en": {
          "description": "English text for LLM logic",
          "maxLength": 200,
          "title": "En",
          "type": "string"
        },
        "ua": {
          "description": "Ukrainian text for Reporting/UI",
          "maxLength": 200,
          "title": "Ua",
          "type": "string"
        },
        "ru": {
          "anyOf": [
            {
              "maxLength": 200,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Russian text (optional)",
          "title": "Ru"
        }
      },
      "required": [
        "en",
        "ua"
      ],
      "title": "TranslatableString",
      "type": "object"
    }
  },
  "description": "\u041a\u043e\u0440\u043d\u0435\u0432\u043e\u0439 \u0430\u0440\u0442\u0435\u0444\u0430\u043a\u0442.\n\u0421\u043e\u0434\u0435\u0440\u0436\u0438\u0442 \u0432\u0435\u0440\u0441\u0438\u043e\u043d\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u0435 \u0438 \u0433\u043b\u043e\u0431\u0430\u043b\u044c\u043d\u0443\u044e \u0432\u0430\u043b\u0438\u0434\u0430\u0446\u0438\u044e \u0433\u0440\u0430\u0444\u0430.",
  "properties": {
    "project_name": {
      "$ref": "#/$defs/TranslatableString"
    },
    "schema_version": {
      "default": "1.0",
      "pattern": "^\\d+\\.\\d+$",
      "title": "Schema Version",
      "type": "string"
    },
    "generated_at": {
      "title": "Generated At",
      "type": "string"
    },
    "generator": {
      "$ref": "#/$defs/GeneratorInfo"
    },
    "currency": {
      "default": "USD",
      "pattern": "^[A-Z]{3}$",
      "title": "Currency",
      "type": "string"
    },
    "time_unit": {
      "$ref": "#/$defs/TimeUnit",
      "default": "year"
    },
    "price_base_year": {
      "anyOf": [
        {
          "maximum": 2100,
          "minimum": 1900,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Price Base Year"
    },
    "simulation_params": {
      "$ref": "#/$defs/SimulationParameters"
    },
    "scenarios": {
      "$ref": "#/$defs/Scenarios"
    },
    "entities": {
      "items": {
        "$ref": "#/$defs/PolicyEntity"
      },
      "title": "Entities",
      "type": "array"
    },
    "interventions": {
      "items": {
        "$ref": "#/$defs/Intervention"
      },
      "title": "Interventions",
      "type": "array"
    },
    "objectives": {
      "items": {
        "$ref": "#/$defs/Objective"
      },
      "title": "Objectives",
      "type": "array"
    },
    "global_constraints": {
      "additionalProperties": {
        "type": "number"
      },
      "title": "Global Constraints",
      "type": "object"
    }
  },
  "required": [
    "project_name",
    "generator",
    "simulation_params",
    "scenarios",
    "entities",
    "interventions",
    "objectives"
  ],
  "title": "PolicyRequestIR",
  "type": "object"
}