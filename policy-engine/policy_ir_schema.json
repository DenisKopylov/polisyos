{
  "$defs": {
    "EntityType": {
      "description": "\u0422\u0438\u043f\u044b \u0430\u0433\u0435\u043d\u0442\u043e\u0432 \u0438 \u043e\u0431\u044a\u0435\u043a\u0442\u043e\u0432 \u0432 \u0441\u0438\u0441\u0442\u0435\u043c\u0435.",
      "enum": [
        "agent",
        "resource",
        "infrastructure",
        "environment"
      ],
      "title": "EntityType",
      "type": "string"
    },
    "Intervention": {
      "description": "\u041c\u0435\u0440\u0430 \u043f\u043e\u043b\u0438\u0442\u0438\u043a\u0438. \u0421\u043e\u0434\u0435\u0440\u0436\u0438\u0442 Self-Healing \u0432\u0430\u043b\u0438\u0434\u0430\u0442\u043e\u0440\u044b.",
      "properties": {
        "id": {
          "pattern": "^[a-z0-9_]+$",
          "title": "Id",
          "type": "string"
        },
        "name": {
          "$ref": "#/$defs/TranslatableString"
        },
        "target_selector": {
          "description": "SQL-like filter: sector == 'IT' and size == 'SME'",
          "title": "Target Selector",
          "type": "string"
        },
        "mechanism_type": {
          "description": "Foundry mechanism ID: 'tax_subsidy', 'direct_grant'",
          "title": "Mechanism Type",
          "type": "string"
        },
        "parameters": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "integer"
              },
              {
                "type": "string"
              }
            ]
          },
          "title": "Parameters",
          "type": "object"
        },
        "constraints": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "integer"
              }
            ]
          },
          "title": "Constraints",
          "type": "object"
        }
      },
      "required": [
        "id",
        "name",
        "target_selector",
        "mechanism_type",
        "parameters"
      ],
      "title": "Intervention",
      "type": "object"
    },
    "Objective": {
      "properties": {
        "metric_name": {
          "description": "Name of the metric to optimize (e.g. 'gdp', 'unemployment')",
          "title": "Metric Name",
          "type": "string"
        },
        "direction": {
          "$ref": "#/$defs/OptimizationDirection"
        },
        "threshold": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Target value boundary if direction is RANGE",
          "title": "Threshold"
        },
        "priority_weight": {
          "default": 1.0,
          "maximum": 10.0,
          "minimum": 0.0,
          "title": "Priority Weight",
          "type": "number"
        }
      },
      "required": [
        "metric_name",
        "direction"
      ],
      "title": "Objective",
      "type": "object"
    },
    "OptimizationDirection": {
      "description": "\u041a\u0443\u0434\u0430 \u0434\u0432\u0438\u0433\u0430\u0442\u044c \u043c\u0435\u0442\u0440\u0438\u043a\u0443.",
      "enum": [
        "maximize",
        "minimize",
        "maintain_range"
      ],
      "title": "OptimizationDirection",
      "type": "string"
    },
    "PolicyEntity": {
      "description": "\u0410\u0431\u0441\u0442\u0440\u0430\u043a\u0446\u0438\u044f \u043b\u044e\u0431\u043e\u0433\u043e \u0430\u043a\u0442\u043e\u0440\u0430 \u0438\u043b\u0438 \u043e\u0431\u044a\u0435\u043a\u0442\u0430.\n\u041f\u043e\u0434\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u0435\u0442 \u0432\u043b\u043e\u0436\u0435\u043d\u043d\u043e\u0441\u0442\u044c (Composite Pattern).",
      "properties": {
        "id": {
          "description": "Unique slug identifier (snake_case)",
          "pattern": "^[a-z0-9_]+$",
          "title": "Id",
          "type": "string"
        },
        "entity_type": {
          "$ref": "#/$defs/EntityType"
        },
        "name": {
          "$ref": "#/$defs/TranslatableString"
        },
        "parent_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "ID \u0440\u043e\u0434\u0438\u0442\u0435\u043b\u044c\u0441\u043a\u043e\u0439 \u0441\u0443\u0449\u043d\u043e\u0441\u0442\u0438 (\u0434\u043b\u044f \u0438\u0435\u0440\u0430\u0440\u0445\u0438\u0438)",
          "title": "Parent Id"
        },
        "state_variables": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "integer"
              },
              {
                "type": "boolean"
              },
              {
                "type": "string"
              }
            ]
          },
          "description": "Initial state: {'balance': 1000.0, 'health': 0.8}",
          "title": "State Variables",
          "type": "object"
        }
      },
      "required": [
        "id",
        "entity_type",
        "name"
      ],
      "title": "PolicyEntity",
      "type": "object"
    },
    "SimulationParameters": {
      "description": "\u0422\u0435\u0445\u043d\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u043f\u0430\u0440\u0430\u043c\u0435\u0442\u0440\u044b \u0441\u0438\u043c\u0443\u043b\u044f\u0446\u0438\u0438.",
      "properties": {
        "scope_years": {
          "maximum": 50,
          "minimum": 1,
          "title": "Scope Years",
          "type": "integer"
        },
        "time_frequency": {
          "$ref": "#/$defs/TimeFrequency",
          "default": "M"
        },
        "start_date": {
          "default": "2024-01-01",
          "title": "Start Date",
          "type": "string"
        },
        "random_seed": {
          "default": 42,
          "title": "Random Seed",
          "type": "integer"
        }
      },
      "required": [
        "scope_years"
      ],
      "title": "SimulationParameters",
      "type": "object"
    },
    "TimeFrequency": {
      "description": "\u0415\u0434\u0438\u043d\u0438\u0446\u044b \u0432\u0440\u0435\u043c\u0435\u043d\u0438 \u0434\u043b\u044f \u0441\u0438\u043c\u0443\u043b\u044f\u0446\u0438\u0438.",
      "enum": [
        "M",
        "Q",
        "Y"
      ],
      "title": "TimeFrequency",
      "type": "string"
    },
    "TranslatableString": {
      "description": "\u041c\u0443\u043b\u044c\u0442\u0438\u044f\u0437\u044b\u0447\u043d\u0430\u044f \u0441\u0442\u0440\u043e\u043a\u0430.\nLLM \u0432\u0438\u0434\u0438\u0442 'en' \u0434\u043b\u044f \u043b\u043e\u0433\u0438\u043a\u0438, \u0430 'ua'/'ru' \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u044e\u0442\u0441\u044f \u0434\u043b\u044f UI.",
      "properties": {
        "en": {
          "description": "English text for LLM logic",
          "title": "En",
          "type": "string"
        },
        "ua": {
          "description": "Ukrainian text for Reporting/UI",
          "title": "Ua",
          "type": "string"
        },
        "ru": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Russian text (optional)",
          "title": "Ru"
        }
      },
      "required": [
        "en",
        "ua"
      ],
      "title": "TranslatableString",
      "type": "object"
    }
  },
  "description": "\u041a\u043e\u0440\u043d\u0435\u0432\u043e\u0439 \u0434\u043e\u043a\u0443\u043c\u0435\u043d\u0442, \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u0434\u043e\u043b\u0436\u043d\u0430 \u0441\u0433\u0435\u043d\u0435\u0440\u0438\u0440\u043e\u0432\u0430\u0442\u044c LLM.\n\u042d\u0442\u043e \u0438 \u0435\u0441\u0442\u044c '\u041a\u043e\u043d\u0442\u0440\u0430\u043a\u0442'.",
  "properties": {
    "project_name": {
      "$ref": "#/$defs/TranslatableString"
    },
    "schema_version": {
      "default": "1.0.0",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "title": "Schema Version",
      "type": "string"
    },
    "simulation_params": {
      "$ref": "#/$defs/SimulationParameters"
    },
    "entities": {
      "items": {
        "$ref": "#/$defs/PolicyEntity"
      },
      "title": "Entities",
      "type": "array"
    },
    "objectives": {
      "items": {
        "$ref": "#/$defs/Objective"
      },
      "title": "Objectives",
      "type": "array"
    },
    "interventions": {
      "items": {
        "$ref": "#/$defs/Intervention"
      },
      "title": "Interventions",
      "type": "array"
    },
    "global_constraints": {
      "additionalProperties": {
        "type": "number"
      },
      "title": "Global Constraints",
      "type": "object"
    }
  },
  "required": [
    "project_name",
    "simulation_params",
    "entities",
    "objectives",
    "interventions"
  ],
  "title": "PolicyRequestIR",
  "type": "object"
}
