{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://polisyos.local/schemas/fabric/source_contract.schema.json",
  "title": "Fabric SourceContract v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "version",
    "owner",
    "reviewer",
    "source",
    "schema",
    "semantics",
    "security",
    "quality",
    "sla",
    "terms",
    "replay",
    "lineage",
    "source_trust",
    "processing",
    "status"
  ],
  "properties": {
    "schema_version": { "const": "fabric.source_contract.v2" },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)*$" },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "owner": { "type": "string", "minLength": 1 },
    "reviewer": { "type": "string", "minLength": 1 },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["connector_id", "dataset_pattern", "profile_id"],
      "properties": {
        "connector_id": { "type": "string", "minLength": 1 },
        "dataset_pattern": { "type": "string", "minLength": 1 },
        "profile_id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "source_name": { "type": "string" },
        "source_organization": { "type": "string" },
        "source_url": { "type": ["string", "null"] }
      }
    },
    "schema": {
      "type": "object",
      "additionalProperties": true,
      "required": ["fields"],
      "properties": {
        "schema_id": { "type": ["string", "null"] },
        "schema_version": { "type": ["string", "null"], "pattern": "^\\d+\\.\\d+(\\.\\d+)?$" },
        "fields": { "type": "array" },
        "schema_contract_ref": { "type": ["string", "null"] },
        "compatibility_status": {
          "enum": ["contracted", "template_only", "pending_profile_specific_schema"]
        }
      }
    },
    "semantics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["domain"],
      "properties": {
        "domain": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "metric_definitions": { "type": "array" },
        "canonical_ids": { "type": "array", "items": { "type": "string" } }
      }
    },
    "security": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pii_tier", "classification", "tenant_scope", "field_policies"],
      "properties": {
        "pii_tier": { "enum": ["none", "low", "moderate", "high", "regulated"] },
        "classification": {
          "enum": ["public", "internal", "confidential", "regulated_pii", "sensitive_policy_legal_signal"]
        },
        "tenant_scope": { "enum": ["shared_public", "tenant_isolated", "restricted"] },
        "safe_filters_required": { "type": "boolean" },
        "audit_required": { "type": "boolean" },
        "field_policies": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "field_id",
              "decision_role",
              "classification",
              "pii_tier",
              "tenant_scope",
              "redaction",
              "reason"
            ],
            "properties": {
              "field_id": { "type": "string", "minLength": 1 },
              "decision_role": {
                "enum": ["decision", "telemetry", "layout", "debug"]
              },
              "classification": {
                "enum": ["public", "internal", "confidential", "regulated_pii", "sensitive_policy_legal_signal"]
              },
              "pii_tier": { "enum": ["none", "low", "moderate", "high", "regulated"] },
              "tenant_scope": { "enum": ["shared_public", "tenant_isolated", "restricted"] },
              "redaction": { "enum": ["none", "masked", "redacted", "aggregate_only", "denied"] },
              "policy_ref": { "type": ["string", "null"] },
              "reason": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract_ref", "required_checks"],
      "properties": {
        "contract_ref": { "type": "string", "minLength": 1 },
        "required_checks": { "type": "array", "items": { "type": "string" } },
        "min_quality_score": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "sla": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "refresh_frequency": { "type": "string" },
        "max_latency": { "type": "string" },
        "availability_target": { "type": "number", "minimum": 0, "maximum": 1 },
        "freshness_slo_seconds": { "type": "integer", "minimum": 0 },
        "p95_latency_ms": { "type": "number", "minimum": 0 },
        "replay_success_target": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "terms": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "allowed_uses": { "type": "array", "items": { "type": "string" } },
        "disallowed_uses": { "type": "array", "items": { "type": "string" } },
        "terms_url": { "type": ["string", "null"] },
        "attribution_required": { "type": "boolean" }
      }
    },
    "replay": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "required": { "type": "boolean" },
        "fixture_ref": { "type": ["string", "null"] },
        "non_replayable_reason": { "type": ["string", "null"] },
        "determinism_key": { "type": ["string", "null"] }
      }
    },
    "lineage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "seed_node_kind": { "type": "string", "minLength": 1 },
        "seed_fields": { "type": "array", "items": { "type": "string" } },
        "evidence_ref": { "type": ["string", "null"] }
      }
    },
    "source_trust": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tier": {
          "enum": ["institutional", "government", "community", "vendor", "internal", "synthetic", "unknown"]
        },
        "calibration_status": { "enum": ["measured", "heuristic", "declared", "unknown"] },
        "rationale": { "type": "string" }
      }
    },
    "processing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "guarantee",
        "idempotency",
        "out_of_order",
        "cdc_schema_changes",
        "backpressure"
      ],
      "properties": {
        "guarantee": {
          "enum": [
            "batch_atomic",
            "at_least_once",
            "at_least_once_with_dedupe",
            "effectively_once",
            "exactly_once_narrow",
            "replay_only"
          ]
        },
        "idempotency": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled",
            "key_fields",
            "missing_key_action",
            "dedupe_window_seconds",
            "max_dedupe_keys",
            "replay_retention_days"
          ],
          "properties": {
            "enabled": { "type": "boolean" },
            "key_fields": { "type": "array", "items": { "type": "string" } },
            "missing_key_action": { "enum": ["hash_payload", "quarantine", "reject"] },
            "dedupe_window_seconds": { "type": "integer", "minimum": 0 },
            "max_dedupe_keys": { "type": "integer", "minimum": 1 },
            "replay_retention_days": { "type": "integer", "minimum": 0 }
          }
        },
        "out_of_order": {
          "type": "object",
          "additionalProperties": false,
          "required": ["handling", "timestamp_field", "max_lateness_seconds", "late_event_action"],
          "properties": {
            "handling": { "enum": ["wait", "reorder", "watermark", "drop", "quarantine"] },
            "timestamp_field": { "type": "string", "minLength": 1 },
            "max_lateness_seconds": { "type": "integer", "minimum": 0 },
            "late_event_action": { "enum": ["wait", "reorder", "watermark", "drop", "quarantine"] }
          }
        },
        "cdc_schema_changes": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "additive_change_action",
            "breaking_change_action",
            "metadata_only_action",
            "require_lineage_impact"
          ],
          "properties": {
            "additive_change_action": { "enum": ["accept", "review"] },
            "breaking_change_action": { "enum": ["quarantine", "fail_closed", "review"] },
            "metadata_only_action": { "enum": ["accept", "review"] },
            "require_lineage_impact": { "type": "boolean" }
          }
        },
        "backpressure": {
          "type": "object",
          "additionalProperties": false,
          "required": ["strategy", "max_buffered_rows", "max_buffered_bytes", "pause_seconds"],
          "properties": {
            "strategy": { "enum": ["pause", "throttle", "spill_to_disk", "fail_closed"] },
            "max_buffered_rows": { "type": "integer", "minimum": 1 },
            "max_buffered_bytes": { "type": "integer", "minimum": 1 },
            "pause_seconds": { "type": "number", "minimum": 0 },
            "max_backpressure_events": { "type": ["integer", "null"], "minimum": 1 }
          }
        },
        "atomicity_proof": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "properties": {
            "input_offsets_committed_atomically": { "type": "boolean" },
            "state_updates_committed_atomically": { "type": "boolean" },
            "output_writes_committed_atomically": { "type": "boolean" },
            "proof_refs": { "type": "array", "items": { "type": "string" } },
            "notes": { "type": "string" }
          }
        },
        "notes": { "type": "string" }
      }
    },
    "retention": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "policy": { "enum": ["retain", "expire", "source_terms_bound"] },
        "min_retention_days": { "type": "integer", "minimum": 0 },
        "artifact_retention_days": { "type": "integer", "minimum": 0 },
        "cold_storage_required": { "type": "boolean" }
      }
    },
    "docs": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "reference_page": { "type": "string" },
        "generated_anchor": { "type": ["string", "null"] }
      }
    },
    "status": { "enum": ["draft", "active", "deprecated", "sunset"] },
    "deprecation": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "deprecated_at": { "type": ["string", "null"] },
        "sunset_at": { "type": ["string", "null"] },
        "replacement_contract_id": { "type": ["string", "null"] },
        "reason": { "type": "string" },
        "migration_note": { "type": "string" }
      }
    },
    "created_at": { "type": "string" }
  }
}
