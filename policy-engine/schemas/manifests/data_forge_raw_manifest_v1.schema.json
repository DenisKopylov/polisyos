{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "polisyos://schemas/manifests/data_forge_raw_manifest_v1.schema.json",
  "title": "Data Forge Raw Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "source",
    "endpoint",
    "fetched_at",
    "count",
    "payload",
    "sha256",
    "filters",
    "parser_version",
    "trace_id",
    "span_id"
  ],
  "properties": {
    "kind": {
      "const": "raw"
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "endpoint": {
      "type": "string",
      "minLength": 1
    },
    "fetched_at": {
      "type": "string",
      "format": "date-time"
    },
    "count": {
      "type": "integer",
      "minimum": 0
    },
    "payload": {
      "type": "string",
      "minLength": 1
    },
    "sha256": {
      "type": "string",
      "pattern": "^$|^[0-9a-f]{64}$"
    },
    "filters": {
      "type": "object"
    },
    "parser_version": {
      "type": "string",
      "minLength": 1
    },
    "trace_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "span_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{16}$"
    }
  }
}
