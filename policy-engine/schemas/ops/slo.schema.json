{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "polisyos://schemas/ops/slo.schema.json",
  "title": "SLO Definition",
  "type": "object",
  "required": ["service", "version", "objectives"],
  "properties": {
    "service": {"type": "string", "minLength": 1},
    "version": {"type": "integer", "minimum": 1},
    "owner": {"type": "string"},
    "objectives": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "sli", "threshold", "window", "owner", "runbook"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "sli": {"type": "string", "minLength": 1},
          "threshold": {"type": "string", "minLength": 1},
          "window": {"type": "string", "minLength": 1},
          "owner": {"type": "string", "minLength": 1},
          "runbook": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
