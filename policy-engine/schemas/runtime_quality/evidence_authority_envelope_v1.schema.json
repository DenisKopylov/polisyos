{
  "$defs": {
    "GovernanceMetadata": {
      "additionalProperties": false,
      "description": "Governance metadata that controls downstream authority consumption.",
      "properties": {
        "approval_policy": {
          "minLength": 1,
          "title": "Approval Policy",
          "type": "string"
        },
        "authority_boundary": {
          "minLength": 1,
          "title": "Authority Boundary",
          "type": "string"
        },
        "classification": {
          "minLength": 1,
          "title": "Classification",
          "type": "string"
        },
        "override_policy": {
          "minLength": 1,
          "title": "Override Policy",
          "type": "string"
        },
        "pii": {
          "minLength": 1,
          "title": "Pii",
          "type": "string"
        },
        "retention_policy": {
          "minLength": 1,
          "title": "Retention Policy",
          "type": "string"
        },
        "review_status": {
          "minLength": 1,
          "title": "Review Status",
          "type": "string"
        }
      },
      "required": [
        "classification",
        "authority_boundary",
        "pii",
        "retention_policy",
        "review_status",
        "override_policy",
        "approval_policy"
      ],
      "title": "GovernanceMetadata",
      "type": "object"
    },
    "SameInputClosure": {
      "additionalProperties": false,
      "description": "Identity of the input context shared by authority-bearing evidence.",
      "properties": {
        "cell_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cell Id"
        },
        "closure_id": {
          "minLength": 1,
          "title": "Closure Id",
          "type": "string"
        },
        "closure_sha256": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Closure Sha256"
        },
        "degradation_ledger_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Degradation Ledger Ref"
        },
        "effective_mode_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Effective Mode Ref"
        },
        "evidence_input_refs": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Evidence Input Refs",
          "type": "array"
        },
        "job_id": {
          "minLength": 1,
          "title": "Job Id",
          "type": "string"
        },
        "legal_snapshot_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Legal Snapshot Ref"
        },
        "method_plan_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Method Plan Ref"
        },
        "policy_intent_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Policy Intent Ref"
        },
        "production_data_manifest_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Production Data Manifest Ref"
        },
        "provider_mode_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Provider Mode Ref"
        },
        "run_id": {
          "minLength": 1,
          "title": "Run Id",
          "type": "string"
        },
        "status": {
          "enum": [
            "closed",
            "not_closed",
            "mismatched",
            "blocked"
          ],
          "title": "Status",
          "type": "string"
        },
        "tenant_id": {
          "minLength": 1,
          "title": "Tenant Id",
          "type": "string"
        },
        "time_context_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
