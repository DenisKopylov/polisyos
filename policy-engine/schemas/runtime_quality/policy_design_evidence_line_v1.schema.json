{
  "$id": "https://schemas.polisyos.dev/runtime_quality/policy_design_evidence_line_v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Policy Design Evidence Line",
  "type": "object",
  "required": [
    "schema_version",
    "line_id",
    "portfolio_id",
    "claim_id",
    "evidence_strand",
    "source_lineage",
    "method_id",
    "method_assumptions",
    "specification_id",
    "producer_identity",
    "execution_context"
  ],
  "properties": {
    "schema_version": {
      "const": "policyos.runtime.policy_design_case.evidence_line.v1"
    },
    "contract_id": {
      "const": "policy_design_case.evidence_line.v1"
    },
    "line_id": {
      "type": "string",
      "minLength": 1
    },
    "portfolio_id": {
      "type": "string",
      "minLength": 1
    },
    "portfolio_strand_id": {
      "type": "string",
      "minLength": 1
    },
    "claim_id": {
      "type": "string",
      "minLength": 1
    },
    "claim_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "evidence_strand": {
      "enum": [
        "legal",
        "data",
        "literature",
        "method",
        "simulation",
        "distributional",
        "feasibility",
        "monitoring"
      ]
    },
    "source_lineage": {
      "type": "object",
      "minProperties": 1
    },
    "method_id": {
      "type": "string",
      "minLength": 1
    },
    "method_assumptions": {
      "type": "array",
      "minItems": 1
    },
    "specification_id": {
      "type": "string",
      "minLength": 1
    },
    "producer_identity": {
      "type": "object",
      "required": ["component", "version", "owner"],
      "properties": {
        "component": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "owner": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "execution_context": {
      "type": "object",
      "minProperties": 1
    },
    "evidence_ref": {
      "type": "string"
    },
    "runtime_event_ref": {
      "type": "string"
    }
  },
  "additionalProperties": true
}
