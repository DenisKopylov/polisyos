        "properties": {
          "strand_id": {
            "type": "string",
            "minLength": 1
          },
          "claim_id": {
            "type": "string",
            "minLength": 1
          },
          "authority_level": {
            "type": "string",
            "minLength": 1
          },
          "candidate_data_source_families": {
            "type": "array",
            "minItems": 1
          },
          "candidate_method_families": {
            "type": "array",
            "minItems": 1
          },
          "defensible_specification_space": {
            "type": "object"
          },
          "inclusion_rules": {
            "type": "array",
            "minItems": 1
          },
          "exclusion_rules": {
            "type": "array",
            "minItems": 1
          },
          "disconfirming_lines": {
            "type": "array",
            "minItems": 1
          },
          "synthesis_rules": {
            "type": "object"
          },
          "stopping_rules": {
            "type": "object"
          },
          "cost_proportionality": {
            "type": "object"
          }
        },
        "additionalProperties": true
      }
    },
    "candidate_data_source_families": {
      "type": "array",
      "minItems": 1
    },
    "candidate_method_families": {
      "type": "array",
      "minItems": 1
    },
    "inclusion_rules": {
      "type": "array",
      "minItems": 1
    },
    "exclusion_rules": {
      "type": "array",
      "minItems": 1
    },
    "disconfirming_lines": {
      "type": "array",
      "minItems": 1
    },
    "synthesis_rules": {
      "type": "object"
    },
    "stopping_rules": {
      "type": "object"
    },
    "cost_proportionality": {
      "type": "object"
    },
    "cas_ref": {
      "type": "string"
    },
    "runtime_event_ref": {
      "type": "string"
    }
  },
  "additionalProperties": true
}
