{
  "$id": "https://schemas.polisyos.dev/runtime_quality/policy_design_evidence_portfolio_design_v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Policy Design Evidence Portfolio Design",
  "type": "object",
  "required": [
    "schema_version",
    "portfolio_id",
    "claim_ids",
    "predeclared",
    "declared_at",
    "authority_level",
    "strands",
    "candidate_data_source_families",
    "candidate_method_families",
    "inclusion_rules",
    "exclusion_rules",
    "disconfirming_lines",
    "synthesis_rules",
    "stopping_rules",
    "cost_proportionality"
