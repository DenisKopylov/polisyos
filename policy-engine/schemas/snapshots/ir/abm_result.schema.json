{
  "$defs": {
    "ABMBifurcationReport": {
      "additionalProperties": false,
      "description": "Lightweight Phase-4 bifurcation/attractor report pointer for ABM results.",
      "properties": {
        "attractor_analysis_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/_ABMAttractorAnalysisArtifactRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "attractor_count": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Attractor Count"
        },
        "bifurcation_count": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Bifurcation Count"
        },
        "metadata": {
          "additionalProperties": true,
          "title": "Metadata",
          "type": "object"
        },
        "status": {
          "default": "not_available",
          "enum": [
            "available",
            "not_available",
            "failed"
          ],
          "title": "Status",
          "type": "string"
        },
        "summary": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Summary"
        }
      },
      "title": "ABMBifurcationReport",
      "type": "object"
    },
    "ABMIdentifiabilityCertificate": {
      "additionalProperties": false,
      "description": "Lightweight Phase-4 certificate pointing to aggregate-moment ABM diagnostics.",
      "properties": {
        "diagnostic_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/_ABMIdentifiabilityDiagnosticArtifactRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "identified": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Identified"
        },
        "metadata": {
          "additionalProperties": true,
          "title": "Metadata",
          "type": "object"
        },
        "method": {
          "default": "aggregate_moment_identifiability",
          "title": "Method",
          "type": "string"
        },
        "status": {
          "default": "not_available",
          "enum": [
            "certified",
            "diagnostic_attached",
            "not_available",
            "failed"
          ],
          "title": "Status",
          "type": "string"
        },
        "summary": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Summary"
        }
      },
      "title": "ABMIdentifiabilityCertificate",
      "type": "object"
    },
    "ArtifactID": {
      "description": "IR-local artifact ID model compatible with CAS interfaces.",
      "title": "ArtifactID",
      "type": "string"
    },
    "ArtifactRefModel": {
      "additionalProperties": false,
      "description": "Provide the common mapping-compatible base contract for artifact refs.",
      "properties": {
        "artifact_id": {
          "$ref": "#/$defs/ArtifactID"
        },
        "kind": {
          "title": "Kind",
          "type": "string"
        },
        "media_type": {
          "title": "Media Type",
          "type": "string"
        }
      },
      "required": [
        "artifact_id",
        "kind",
        "media_type"
      ],
      "title": "ArtifactRefModel",
      "type": "object"
    },
    "DistributionalReportRef": {
      "additionalProperties": false,
      "description": "Stable handle for persisted distributional-impact reports read by equity and policy-governance workflows.",
      "properties": {
        "artifact_id": {
          "$ref": "#/$defs/ArtifactID"
        },
        "kind": {
          "const": "ir.distributional_report",
          "default": "ir.distributional_report",
          "title": "Kind",
          "type": "string"
        },
        "media_type": {
          "const": "application/json",
          "default": "application/json",
          "title": "Media Type",
          "type": "string"
        }
      },
      "required": [
        "artifact_id"
      ],
      "title": "DistributionalReportRef",
      "type": "object"
    },
    "FairnessAuditReportRef": {
      "additionalProperties": false,
      "description": "Stable handle for persisted validation-stage fairness audit reports.",
      "properties": {
        "artifact_id": {
          "$ref": "#/$defs/ArtifactID"
        },
        "kind": {
          "const": "scientist.fairness_audit_report",
          "default": "scientist.fairness_audit_report",
          "title": "Kind",
          "type": "string"
        },
        "media_type": {
          "const": "application/json",
          "default": "application/json",
          "title": "Media Type",
          "type": "string"
        }
      },
      "required": [
        "artifact_id"
      ],
      "title": "FairnessAuditReportRef",
      "type": "object"
    },
    "MetricValidationReportRef": {
      "additionalProperties": false,
      "description": "Stable handle for persisted metric-validation reports.",
      "properties": {
        "artifact_id": {
          "$ref": "#/$defs/ArtifactID"
        },
        "kind": {
          "const": "scientist.metric_validation_report",
          "default": "scientist.metric_validation_report",
          "title": "Kind",
          "type": "string"
        },
        "media_type": {
          "const": "application/json",
          "default": "application/json",
          "title": "Media Type",
          "type": "string"
        }
      },
      "required": [
        "artifact_id"
      ],
      "title": "MetricValidationReportRef",
      "type": "object"
    },
    "UncertaintyEnvelopeRef": {
      "additionalProperties": false,
      "description": "Stable handle for a persisted uncertainty envelope produced by estimators and read by reporting layers.",
      "properties": {
        "artifact_id": {
          "$ref": "#/$defs/ArtifactID"
        },
        "kind": {
          "const": "ir.uncertainty_envelope",
          "default": "ir.uncertainty_envelope",
          "title": "Kind",
          "type": "string"
        },
        "media_type": {
          "const": "application/json",
          "default": "application/json",
          "title": "Media Type",
          "type": "string"
        }
      },
      "required": [
        "artifact_id"
      ],
      "title": "UncertaintyEnvelopeRef",
      "type": "object"
    },
    "WelfareBundleRef": {
      "additionalProperties": false,
      "description": "Stable handle for persisted welfare aggregation summaries.",
      "properties": {
        "artifact_id": {
          "$ref": "#/$defs/ArtifactID"
        },
        "kind": {
          "const": "ir.welfare_bundle",
          "default": "ir.welfare_bundle",
          "title": "Kind",
          "type": "string"
        },
        "media_type": {
          "const": "application/json",
          "default": "application/json",
          "title": "Media Type",
          "type": "string"
        }
      },
      "required": [
        "artifact_id"
      ],
      "title": "WelfareBundleRef",
      "type": "object"
    },
    "_ABMAttractorAnalysisArtifactRef": {
      "additionalProperties": false,
      "description": "Neutral typed reference to a Foundry attractor-analysis result.",
      "properties": {
        "artifact_id": {
          "$ref": "#/$defs/ArtifactID"
        },
        "kind": {
          "const": "foundry.attractor_analysis_result",
          "default": "foundry.attractor_analysis_result",
          "title": "Kind",
          "type": "string"
        },
        "media_type": {
          "const": "application/json",
          "default": "application/json",
          "title": "Media Type",
          "type": "string"
        }
      },
      "required": [
        "artifact_id"
      ],
      "title": "_ABMAttractorAnalysisArtifactRef",
      "type": "object"
    },
    "_ABMEnvironmentArtifactRef": {
      "additionalProperties": false,
      "description": "Neutral typed reference to the Foundry execution environment manifest.",
      "properties": {
        "artifact_id": {
          "$ref": "#/$defs/ArtifactID"
        },
        "kind": {
          "const": "foundry.environment_manifest",
          "default": "foundry.environment_manifest",
          "title": "Kind",
          "type": "string"
        },
        "media_type": {
          "const": "application/json",
          "default": "application/json",
          "title": "Media Type",
          "type": "string"
        }
      },
      "required": [
        "artifact_id"
      ],
      "title": "_ABMEnvironmentArtifactRef",
      "type": "object"
    },
    "_ABMExecPlanArtifactRef": {
      "additionalProperties": false,
      "description": "Neutral typed reference to the Foundry execution plan used by an ABM run.",
      "properties": {
        "artifact_id": {
          "$ref": "#/$defs/ArtifactID"
        },
        "kind": {
          "const": "foundry.exec_plan",
          "default": "foundry.exec_plan",
          "title": "Kind",
          "type": "string"
        },
        "media_type": {
          "const": "application/json",
          "default": "application/json",
          "title": "Media Type",
          "type": "string"
        }
      },
      "required": [
        "artifact_id"
      ],
      "title": "_ABMExecPlanArtifactRef",
      "type": "object"
    },
    "_ABMFeedbackResultArtifactRef": {
      "additionalProperties": false,
      "description": "Neutral typed reference to a Foundry feedback result.",
      "properties": {
        "artifact_id": {
          "$ref": "#/$defs/ArtifactID"
        },
        "kind": {
          "const": "foundry.feedback_result",
          "default": "foundry.feedback_result",
          "title": "Kind",
          "type": "string"
        },
        "media_type": {
          "const": "application/json",
          "default": "application/json",
          "title": "Media Type",
          "type": "string"
        }
      },
      "required": [
        "artifact_id"
      ],
      "title": "_ABMFeedbackResultArtifactRef",
      "type": "object"
    },
    "_ABMIdentifiabilityDiagnosticArtifactRef": {
      "additionalProperties": false,
      "description": "Neutral typed reference to a Foundry identifiability diagnostic.",
      "properties": {
        "artifact_id": {
          "$ref": "#/$defs/ArtifactID"
        },
        "kind": {
          "const": "foundry.identifiability_diagnostic",
          "default": "foundry.identifiability_diagnostic",
          "title": "Kind",
          "type": "string"
        },
        "media_type": {
          "const": "application/json",
          "default": "application/json",
          "title": "Media Type",
          "type": "string"
        }
      },
      "required": [
        "artifact_id"
      ],
      "title": "_ABMIdentifiabilityDiagnosticArtifactRef",
      "type": "object"
    },
    "_ABMMetricObservationBundleArtifactRef": {
      "additionalProperties": false,
      "description": "Neutral typed reference to metric observations emitted by Foundry.",
      "properties": {
        "artifact_id": {
          "$ref": "#/$defs/ArtifactID"
        },
        "kind": {
          "const": "foundry.metric_observation_bundle",
          "default": "foundry.metric_observation_bundle",
          "title": "Kind",
          "type": "string"
        },
        "media_type": {
          "const": "application/json",
          "default": "application/json",
          "title": "Media Type",
          "type": "string"
        }
      },
      "required": [
        "artifact_id"
      ],
      "title": "_ABMMetricObservationBundleArtifactRef",
      "type": "object"
    },
    "_ABMMetricsArtifactRef": {
      "additionalProperties": false,
      "description": "Neutral typed reference to metrics emitted by an ABM run.",
      "properties": {
        "artifact_id": {
          "$ref": "#/$defs/ArtifactID"
        },
        "kind": {
          "const": "foundry.metrics",
          "default": "foundry.metrics",
          "title": "Kind",
          "type": "string"
        },
        "media_type": {
          "const": "application/json",
          "default": "application/json",
          "title": "Media Type",
          "type": "string"
        }
      },
      "required": [
        "artifact_id"
      ],
      "title": "_ABMMetricsArtifactRef",
      "type": "object"
    },
    "_ABMStateSnapshotArtifactRef": {
      "additionalProperties": false,
      "description": "Neutral typed reference to a Foundry state snapshot.",
      "properties": {
        "artifact_id": {
          "$ref": "#/$defs/ArtifactID"
        },
        "kind": {
          "const": "foundry.state_snapshot",
          "default": "foundry.state_snapshot",
          "title": "Kind",
          "type": "string"
        },
        "media_type": {
          "const": "application/json",
          "default": "application/json",
          "title": "Media Type",
          "type": "string"
        }
      },
      "required": [
        "artifact_id"
      ],
      "title": "_ABMStateSnapshotArtifactRef",
      "type": "object"
    },
    "_ABMTraceSliceArtifactRef": {
      "additionalProperties": false,
      "description": "Neutral typed reference to a Foundry execution trace slice.",
      "properties": {
        "artifact_id": {
          "$ref": "#/$defs/ArtifactID"
        },
        "kind": {
          "const": "foundry.trace_slice",
          "default": "foundry.trace_slice",
          "title": "Kind",
          "type": "string"
        },
        "media_type": {
          "const": "application/jsonl",
          "default": "application/jsonl",
          "title": "Media Type",
          "type": "string"
        }
      },
      "required": [
        "artifact_id"
      ],
      "title": "_ABMTraceSliceArtifactRef",
      "type": "object"
    },
    "_ABMWelfareBoundArtifactRef": {
      "additionalProperties": false,
      "description": "Neutral typed reference to a Foundry welfare-bound report.",
      "properties": {
        "artifact_id": {
          "$ref": "#/$defs/ArtifactID"
        },
        "kind": {
          "const": "foundry.welfare_bound_report",
          "default": "foundry.welfare_bound_report",
          "title": "Kind",
          "type": "string"
        },
        "media_type": {
          "const": "application/json",
          "default": "application/json",
          "title": "Media Type",
          "type": "string"
        }
      },
      "required": [
        "artifact_id"
      ],
      "title": "_ABMWelfareBoundArtifactRef",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Neutral Phase-4 analytical result for a completed ABM execution.",
  "properties": {
    "bifurcation_report": {
      "anyOf": [
        {
          "$ref": "#/$defs/ABMBifurcationReport"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "distributional_report_ref": {
      "anyOf": [
        {
          "$ref": "#/$defs/DistributionalReportRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "environment_fingerprint": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Environment Fingerprint"
    },
    "environment_ref": {
      "anyOf": [
        {
          "$ref": "#/$defs/_ABMEnvironmentArtifactRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "exec_plan_ref": {
      "$ref": "#/$defs/_ABMExecPlanArtifactRef"
    },
    "fairness_audit_report_ref": {
      "anyOf": [
        {
          "$ref": "#/$defs/FairnessAuditReportRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "feedback_result_ref": {
      "anyOf": [
        {
          "$ref": "#/$defs/_ABMFeedbackResultArtifactRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "identifiability_certificate": {
      "anyOf": [
        {
          "$ref": "#/$defs/ABMIdentifiabilityCertificate"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "identifiability_diagnostic_ref": {
      "anyOf": [
        {
          "$ref": "#/$defs/_ABMIdentifiabilityDiagnosticArtifactRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "metric_observation_bundle_ref": {
      "anyOf": [
        {
          "$ref": "#/$defs/_ABMMetricObservationBundleArtifactRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "metric_validation_report_ref": {
      "anyOf": [
        {
          "$ref": "#/$defs/MetricValidationReportRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "metrics_ref": {
      "$ref": "#/$defs/_ABMMetricsArtifactRef"
    },
    "notes": {
      "items": {
        "type": "string"
      },
      "title": "Notes",
      "type": "array"
    },
    "propagation_config_ref": {
      "anyOf": [
        {
          "$ref": "#/$defs/ArtifactRefModel"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "propagation_report_ref": {
      "anyOf": [
        {
          "$ref": "#/$defs/ArtifactRefModel"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "schema_version": {
      "default": "1.3",
      "pattern": "^\\d+\\.\\d+$",
      "title": "Schema Version",
      "type": "string"
    },
    "state_snapshot_ref": {
      "anyOf": [
        {
          "$ref": "#/$defs/_ABMStateSnapshotArtifactRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "trace_slice_ref": {
      "anyOf": [
        {
          "$ref": "#/$defs/_ABMTraceSliceArtifactRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "uncertainty_envelopes": {
      "anyOf": [
        {
          "additionalProperties": {
            "$ref": "#/$defs/UncertaintyEnvelopeRef"
          },
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Uncertainty Envelopes"
    },
    "welfare_bound_refs": {
      "anyOf": [
        {
          "additionalProperties": {
            "$ref": "#/$defs/_ABMWelfareBoundArtifactRef"
          },
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Welfare Bound Refs"
    },
    "welfare_bundle_ref": {
      "anyOf": [
        {
          "$ref": "#/$defs/WelfareBundleRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "exec_plan_ref",
    "metrics_ref"
  ],
  "title": "ABMResult",
  "type": "object"
}
