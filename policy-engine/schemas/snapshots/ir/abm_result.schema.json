{
  "$defs": {
    "ABMBifurcationReport": {
      "additionalProperties": false,
      "description": "Lightweight Phase-4 bifurcation/attractor report pointer for ABM results.",
      "properties": {
        "attractor_analysis_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/ArtifactRefModel"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "attractor_count": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Attractor Count"
        },
        "bifurcation_count": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Bifurcation Count"
        },
        "metadata": {
          "additionalProperties": true,
          "title": "Metadata",
          "type": "object"
        },
        "status": {
          "default": "not_available",
          "enum": [
            "available",
            "not_available",
            "failed"
          ],
          "title": "Status",
          "type": "string"
        },
        "summary": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Summary"
        }
      },
      "title": "ABMBifurcationReport",
      "type": "object"
    },
    "ABMIdentifiabilityCertificate": {
      "additionalProperties": false,
      "description": "Lightweight Phase-4 certificate pointing to aggregate-moment ABM diagnostics.",
      "properties": {
        "diagnostic_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/ArtifactRefModel"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "identified": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Identified"
        },
        "metadata": {
          "additionalProperties": true,
          "title": "Metadata",
          "type": "object"
        },
        "method": {
          "default": "aggregate_moment_identifiability",
          "title": "Method",
          "type": "string"
        },
        "status": {
          "default": "not_available",
          "enum": [
            "certified",
            "diagnostic_attached",
            "not_available",
            "failed"
          ],
          "title": "Status",
          "type": "string"
        },
        "summary": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Summary"
        }
      },
      "title": "ABMIdentifiabilityCertificate",
      "type": "object"
    },
    "ArtifactRef": {
      "additionalProperties": false,
      "description": "Reference an artifact across service, registry, and governance boundaries.",
      "properties": {
        "artifact_id": {
          "$ref": "#/$defs/polisyos__core__artifacts__ids__ArtifactID"
        },
        "kind": {
          "title": "Kind",
          "type": "string"
        },
        "media_type": {
          "title": "Media Type",
          "type": "string"
        }
      },
      "required": [
        "artifact_id",
        "kind",
        "media_type"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "ArtifactRefModel": {
      "additionalProperties": false,
      "description": "Provide the common mapping-compatible base contract for artifact refs.",
      "properties": {
        "artifact_id": {
          "$ref": "#/$defs/polisyos__ir__artifacts__contracts__ArtifactID"
        },
        "kind": {
          "title": "Kind",
          "type": "string"
        },
        "media_type": {
          "title": "Media Type",
          "type": "string"
        }
      },
      "required": [
        "artifact_id",
        "kind",
        "media_type"
      ],
      "title": "ArtifactRefModel",
      "type": "object"
    },
    "DistributionalReportRef": {
      "additionalProperties": false,
      "description": "Stable handle for persisted distributional-impact reports read by equity and policy-governance workflows.",
      "properties": {
        "artifact_id": {
          "$ref": "#/$defs/polisyos__ir__artifacts__contracts__ArtifactID"
        },
        "kind": {
          "const": "ir.distributional_report",
          "default": "ir.distributional_report",
          "title": "Kind",
          "type": "string"
        },
        "media_type": {
          "const": "application/json",
          "default": "application/json",
          "title": "Media Type",
          "type": "string"
        }
      },
      "required": [
        "artifact_id"
      ],
      "title": "DistributionalReportRef",
      "type": "object"
    },
    "EnvironmentManifestRef": {
      "additionalProperties": false,
      "description": "Typed reference to EnvironmentManifest artifact.",
      "properties": {
        "artifact_id": {
          "$ref": "#/$defs/polisyos__core__artifacts__ids__ArtifactID"
        },
        "kind": {
          "default": "foundry.environment_manifest",
          "title": "Kind",
          "type": "string"
        },
        "media_type": {
          "default": "application/json",
          "title": "Media Type",
          "type": "string"
        }
      },
      "required": [
        "artifact_id"
      ],
      "title": "EnvironmentManifestRef",
      "type": "object"
    },
    "ExecPlanRef": {
      "additionalProperties": false,
      "description": "Artifact reference for the resolved Foundry execution plan and runtime posture.",
      "properties": {
        "artifact_id": {
          "$ref": "#/$defs/polisyos__core__artifacts__ids__ArtifactID"
        },
        "kind": {
          "default": "foundry.exec_plan",
          "title": "Kind",
          "type": "string"
        },
        "media_type": {
          "default": "application/json",
          "title": "Media Type",
          "type": "string"
        }
      },
      "required": [
        "artifact_id"
      ],
      "title": "ExecPlanRef",
      "type": "object"
    },
    "FeedbackResultRef": {
      "additionalProperties": false,
      "description": "Artifact reference for the top-level feedback solve result.",
      "properties": {
        "artifact_id": {
          "$ref": "#/$defs/polisyos__core__artifacts__ids__ArtifactID"
        },
        "kind": {
          "default": "foundry.feedback_result",
          "title": "Kind",
          "type": "string"
        },
        "media_type": {
          "default": "application/json",
          "title": "Media Type",
          "type": "string"
        }
      },
      "required": [
        "artifact_id"
      ],
      "title": "FeedbackResultRef",
      "type": "object"
    },
    "IdentifiabilityDiagnosticRef": {
      "additionalProperties": false,
      "description": "Artifact reference for aggregate-moment identifiability diagnostics.",
      "properties": {
        "artifact_id": {
          "$ref": "#/$defs/polisyos__core__artifacts__ids__ArtifactID"
        },
        "kind": {
          "default": "foundry.identifiability_diagnostic",
          "title": "Kind",
          "type": "string"
        },
        "media_type": {
          "default": "application/json",
          "title": "Media Type",
          "type": "string"
        }
      },
      "required": [
        "artifact_id"
      ],
      "title": "IdentifiabilityDiagnosticRef",
      "type": "object"
    },
    "MetricObservationBundleRef": {
      "additionalProperties": false,
      "description": "Artifact reference for per-example observations required for formal metric validation.",
      "properties": {
        "artifact_id": {
          "$ref": "#/$defs/polisyos__core__artifacts__ids__ArtifactID"
        },
        "kind": {
          "default": "foundry.metric_observation_bundle",
          "title": "Kind",
          "type": "string"
        },
        "media_type": {
          "default": "application/json",
          "title": "Media Type",
          "type": "string"
        }
      },
      "required": [
        "artifact_id"
      ],
      "title": "MetricObservationBundleRef",
      "type": "object"
    },
    "MetricValidationReportRef": {
      "additionalProperties": false,
      "description": "Reference to a stored formal metric-validation report artifact.",
      "properties": {
        "artifact_id": {
          "$ref": "#/$defs/polisyos__core__artifacts__ids__ArtifactID"
        },
        "kind": {
          "default": "scientist.metric_validation_report",
          "title": "Kind",
          "type": "string"
        },
        "media_type": {
          "default": "application/json",
          "title": "Media Type",
          "type": "string"
        }
      },
      "required": [
        "artifact_id"
      ],
      "title": "MetricValidationReportRef",
      "type": "object"
    },
    "MetricsRef": {
      "additionalProperties": false,
      "description": "Artifact reference for the scalar metrics emitted by a Foundry execution.",
      "properties": {
        "artifact_id": {
          "$ref": "#/$defs/polisyos__core__artifacts__ids__ArtifactID"
        },
        "kind": {
          "default": "foundry.metrics",
          "title": "Kind",
          "type": "string"
        },
        "media_type": {
          "default": "application/json",
          "title": "Media Type",
          "type": "string"
        }
      },
      "required": [
        "artifact_id"
      ],
      "title": "MetricsRef",
      "type": "object"
    },
    "StateSnapshotRef": {
      "additionalProperties": false,
      "description": "Artifact reference for a persisted state snapshot emitted by a simulation.",
      "properties": {
        "artifact_id": {
          "$ref": "#/$defs/polisyos__core__artifacts__ids__ArtifactID"
        },
        "kind": {
          "default": "foundry.state_snapshot",
          "title": "Kind",
          "type": "string"
        },
        "media_type": {
          "default": "application/json",
          "title": "Media Type",
          "type": "string"
        }
      },
      "required": [
        "artifact_id"
      ],
      "title": "StateSnapshotRef",
      "type": "object"
    },
    "TraceSliceRef": {
      "additionalProperties": false,
      "description": "Artifact reference for the structured execution trace slice captured during a run.",
      "properties": {
        "artifact_id": {
          "$ref": "#/$defs/polisyos__core__artifacts__ids__ArtifactID"
        },
        "kind": {
          "default": "foundry.trace_slice",
          "title": "Kind",
          "type": "string"
        },
        "media_type": {
          "default": "application/jsonl",
          "title": "Media Type",
          "type": "string"
        }
      },
      "required": [
        "artifact_id"
      ],
      "title": "TraceSliceRef",
      "type": "object"
    },
    "UncertaintyEnvelopeRef": {
      "additionalProperties": false,
      "description": "Stable handle for a persisted uncertainty envelope produced by estimators and read by reporting layers.",
      "properties": {
        "artifact_id": {
          "$ref": "#/$defs/polisyos__ir__artifacts__contracts__ArtifactID"
        },
        "kind": {
          "const": "ir.uncertainty_envelope",
          "default": "ir.uncertainty_envelope",
          "title": "Kind",
          "type": "string"
        },
        "media_type": {
          "const": "application/json",
          "default": "application/json",
          "title": "Media Type",
          "type": "string"
        }
      },
      "required": [
        "artifact_id"
      ],
      "title": "UncertaintyEnvelopeRef",
      "type": "object"
    },
    "WelfareBoundReportRef": {
      "additionalProperties": false,
      "description": "Artifact reference for a mechanism-level welfare-loss certificate.",
      "properties": {
        "artifact_id": {
          "$ref": "#/$defs/polisyos__core__artifacts__ids__ArtifactID"
        },
        "kind": {
          "default": "foundry.welfare_bound_report",
          "title": "Kind",
          "type": "string"
        },
        "media_type": {
          "default": "application/json",
          "title": "Media Type",
          "type": "string"
        }
      },
      "required": [
        "artifact_id"
      ],
      "title": "WelfareBoundReportRef",
      "type": "object"
    },
    "WelfareBundleRef": {
      "additionalProperties": false,
      "description": "Stable handle for persisted welfare aggregation summaries.",
      "properties": {
        "artifact_id": {
          "$ref": "#/$defs/polisyos__ir__artifacts__contracts__ArtifactID"
        },
        "kind": {
          "const": "ir.welfare_bundle",
          "default": "ir.welfare_bundle",
          "title": "Kind",
          "type": "string"
        },
        "media_type": {
          "const": "application/json",
          "default": "application/json",
          "title": "Media Type",
          "type": "string"
        }
      },
      "required": [
        "artifact_id"
      ],
      "title": "WelfareBundleRef",
      "type": "object"
    },
    "polisyos__core__artifacts__ids__ArtifactID": {
      "description": "Represent a normalized CAS identifier in `sha256:<64hex>` form.\n\nThe `sha256:` prefix and lowercase 64-hex digest are part of the stable ABI\nused in manifests, runtime URLs, CLI arguments, and signature statements.",
      "title": "ArtifactID",
      "type": "string"
    },
    "polisyos__ir__artifacts__contracts__ArtifactID": {
      "description": "IR-local artifact ID model compatible with CAS interfaces.",
      "title": "ArtifactID",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Phase-4 ABM execution result with exact identifiability and bifurcation fields.",
  "properties": {
    "bifurcation_report": {
      "anyOf": [
        {
          "$ref": "#/$defs/ABMBifurcationReport"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "distributional_report_ref": {
      "anyOf": [
        {
          "$ref": "#/$defs/DistributionalReportRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "environment_fingerprint": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Environment Fingerprint"
    },
    "environment_ref": {
      "anyOf": [
        {
          "$ref": "#/$defs/EnvironmentManifestRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "exec_plan_ref": {
      "$ref": "#/$defs/ExecPlanRef"
    },
    "feedback_result_ref": {
      "anyOf": [
        {
          "$ref": "#/$defs/FeedbackResultRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "identifiability_certificate": {
      "anyOf": [
        {
          "$ref": "#/$defs/ABMIdentifiabilityCertificate"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "identifiability_diagnostic_ref": {
      "anyOf": [
        {
          "$ref": "#/$defs/IdentifiabilityDiagnosticRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "metric_observation_bundle_ref": {
      "anyOf": [
        {
          "$ref": "#/$defs/MetricObservationBundleRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "metric_validation_report_ref": {
      "anyOf": [
        {
          "$ref": "#/$defs/MetricValidationReportRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "metrics_ref": {
      "$ref": "#/$defs/MetricsRef"
    },
    "notes": {
      "items": {
        "type": "string"
      },
      "title": "Notes",
      "type": "array"
    },
    "propagation_config_ref": {
      "anyOf": [
        {
          "$ref": "#/$defs/ArtifactRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "propagation_report_ref": {
      "anyOf": [
        {
          "$ref": "#/$defs/ArtifactRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "schema_version": {
      "default": "1.3",
      "pattern": "^\\d+\\.\\d+$",
      "title": "Schema Version",
      "type": "string"
    },
    "state_snapshot_ref": {
      "anyOf": [
        {
          "$ref": "#/$defs/StateSnapshotRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "trace_slice_ref": {
      "anyOf": [
        {
          "$ref": "#/$defs/TraceSliceRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "uncertainty_envelopes": {
      "anyOf": [
        {
          "additionalProperties": {
            "$ref": "#/$defs/UncertaintyEnvelopeRef"
          },
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Uncertainty Envelopes"
    },
    "welfare_bound_refs": {
      "anyOf": [
        {
          "additionalProperties": {
            "$ref": "#/$defs/WelfareBoundReportRef"
          },
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Welfare Bound Refs"
    },
    "welfare_bundle_ref": {
      "anyOf": [
        {
          "$ref": "#/$defs/WelfareBundleRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "exec_plan_ref",
    "metrics_ref"
  ],
  "title": "ABMResult",
  "type": "object"
}
