{
  "$defs": {
    "ArtifactID": {
      "description": "IR-local artifact ID model compatible with CAS interfaces.",
      "maxLength": 71,
      "minLength": 71,
      "pattern": "^sha256:[0-9A-Fa-f]{64}$",
      "title": "ArtifactID",
      "type": "string"
    },
    "ArtifactRefModel": {
      "additionalProperties": false,
      "description": "Provide the common mapping-compatible base contract for artifact refs.",
      "properties": {
        "artifact_id": {
          "$ref": "#/$defs/ArtifactID"
        },
        "kind": {
          "title": "Kind",
          "type": "string"
        },
        "manifest_profile_sha256": {
          "anyOf": [
            {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Manifest Profile Sha256"
        },
        "media_type": {
          "title": "Media Type",
          "type": "string"
        }
      },
      "required": [
        "artifact_id",
        "kind",
        "media_type"
      ],
      "title": "ArtifactRefModel",
      "type": "object"
    },
    "HTEInputSourceRef": {
      "additionalProperties": false,
      "description": "Selected source-data ref retained by an HTE outcome.",
