{
  "$defs": {
    "ContractCompatibilityTarget": {
      "additionalProperties": false,
      "description": "Identifier of a downstream contract that an observation bundle targets.",
      "properties": {
        "contract_fqn": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Contract Fqn",
          "type": "string"
        },
        "contract_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Contract Id",
          "type": "string"
        }
      },
      "required": [
        "contract_id",
        "contract_fqn"
      ],
      "title": "ContractCompatibilityTarget",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Bundle of neutral historical-validation payloads and frozen observations.",
  "properties": {
    "artifact_name": {
      "const": "backtest_plan_bundle.json",
      "default": "backtest_plan_bundle.json",
      "title": "Artifact Name",
      "type": "string"
    },
    "contract_target": {
      "$ref": "#/$defs/ContractCompatibilityTarget"
    },
    "gap_reason": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Gap Reason"
    },
    "historical_payloads": {
      "additionalProperties": {
        "additionalProperties": true,
        "type": "object"
      },
      "title": "Historical Payloads",
      "type": "object"
    },
    "holdout_windows": {
      "items": {
        "type": "string"
      },
      "title": "Holdout Windows",
      "type": "array"
    },
    "plans": {
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "title": "Plans",
      "type": "array"
    },
    "required_fields": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Required Fields",
      "type": "array"
    },
    "schema_version": {
      "default": "1.0",
      "pattern": "^\\d+\\.\\d+$",
      "title": "Schema Version",
      "type": "string"
    },
    "selected_holdout_role": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Selected Holdout Role"
    },
    "selected_training_role": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Selected Training Role"
    },
    "selected_validation_role": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Selected Validation Role"
    }
  },
  "required": [
    "contract_target",
    "required_fields"
  ],
  "title": "BacktestPlanBundle",
  "type": "object"
}
