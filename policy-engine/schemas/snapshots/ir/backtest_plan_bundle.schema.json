{
  "$defs": {
    "ContractCompatibilityTarget": {
      "additionalProperties": false,
      "description": "Identifier of a downstream contract that an observation bundle targets.",
      "properties": {
        "contract_fqn": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Contract Fqn",
          "type": "string"
        },
        "contract_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Contract Id",
          "type": "string"
        }
      },
      "required": [
        "contract_id",
        "contract_fqn"
      ],
      "title": "ContractCompatibilityTarget",
      "type": "object"
    },
    "HistoricalValidationPlan": {
      "additionalProperties": false,
      "description": "Backtest plan describing one historical validation scenario.",
      "properties": {
        "confidence_level": {
          "default": 0.95,
          "exclusiveMaximum": 1.0,
          "exclusiveMinimum": 0.0,
          "title": "Confidence Level",
          "type": "number"
        },
        "description": {
          "default": "",
          "title": "Description",
          "type": "string"
        },
        "ground_truth_outcomes": {
          "additionalProperties": {
            "items": {
              "type": "number"
            },
            "type": "array"
          },
          "title": "Ground Truth Outcomes",
          "type": "object"
        },
        "historical_data_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Historical Data Path"
        },
        "historical_data_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Historical Data Ref"
        },
        "intervention_date": {
          "default": "",
          "title": "Intervention Date",
          "type": "string"
        },
        "intervention_step": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Intervention Step"
        },
        "jurisdiction": {
          "default": "",
          "title": "Jurisdiction",
          "type": "string"
        },
        "masking_strategy": {
          "$ref": "#/$defs/MaskingStrategy",
          "default": "drop_post"
        },
        "metadata": {
          "additionalProperties": true,
          "title": "Metadata",
          "type": "object"
        },
        "model_spec_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model Spec Ref"
        },
        "n_simulation_runs": {
          "default": 1,
          "minimum": 1,
          "title": "N Simulation Runs",
          "type": "integer"
        },
        "plan_id": {
          "title": "Plan Id",
          "type": "string"
        },
        "plan_label": {
          "default": "",
          "title": "Plan Label",
          "type": "string"
        },
        "policy_spec_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Policy Spec Ref"
        },
        "post_intervention_periods": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Post Intervention Periods"
        },
        "pre_intervention_periods": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pre Intervention Periods"
        },
        "predicted_outcomes": {
          "anyOf": [
            {
              "additionalProperties": {
                "items": {
                  "type": "number"
                },
                "type": "array"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Predicted Outcomes"
        },
        "prediction_intervals": {
          "anyOf": [
            {
              "additionalProperties": {
                "items": {
                  "maxItems": 2,
                  "minItems": 2,
                  "prefixItems": [
                    {
                      "type": "number"
                    },
                    {
                      "type": "number"
                    }
                  ],
                  "type": "array"
                },
                "type": "array"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Prediction Intervals"
        },
        "prediction_source": {
          "$ref": "#/$defs/PredictionSource",
          "default": "naive"
        },
        "random_seed": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Random Seed"
        },
        "scientist_state": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Scientist State"
        },
        "target_metrics": {
          "items": {
            "type": "string"
          },
          "title": "Target Metrics",
          "type": "array"
        }
      },
      "required": [
        "plan_id"
      ],
      "title": "HistoricalValidationPlan",
      "type": "object"
    },
    "MaskingStrategy": {
      "description": "How temporal backtests hide post-intervention observations from the evaluator.",
      "enum": [
        "drop_post",
        "replace_nan",
        "truncate"
      ],
      "title": "MaskingStrategy",
      "type": "string"
    },
    "PredictionSource": {
      "description": "Prediction source public type.",
      "enum": [
        "provided",
        "scientist",
        "naive"
      ],
      "title": "PredictionSource",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Bundle of historical validation plans and their frozen payloads.",
  "properties": {
    "artifact_name": {
      "const": "backtest_plan_bundle.json",
      "default": "backtest_plan_bundle.json",
      "title": "Artifact Name",
      "type": "string"
    },
    "contract_target": {
      "$ref": "#/$defs/ContractCompatibilityTarget"
    },
    "historical_payloads": {
      "additionalProperties": {
        "additionalProperties": true,
        "type": "object"
      },
      "title": "Historical Payloads",
      "type": "object"
    },
    "holdout_windows": {
      "items": {
        "type": "string"
      },
      "title": "Holdout Windows",
      "type": "array"
    },
    "plans": {
      "items": {
        "$ref": "#/$defs/HistoricalValidationPlan"
      },
      "title": "Plans",
      "type": "array"
    },
    "required_fields": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Required Fields",
      "type": "array"
    },
    "schema_version": {
      "default": "1.0",
      "pattern": "^\\d+\\.\\d+$",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "contract_target",
    "required_fields"
  ],
  "title": "BacktestPlanBundle",
  "type": "object"
}
