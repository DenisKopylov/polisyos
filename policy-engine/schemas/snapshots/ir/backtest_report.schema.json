{
  "$defs": {
    "ArtifactID": {
      "description": "IR-local artifact ID model compatible with CAS interfaces.",
      "maxLength": 71,
      "minLength": 71,
      "pattern": "^sha256:[0-9A-Fa-f]{64}$",
      "title": "ArtifactID",
      "type": "string"
    },
    "BacktestFixedUnitTransform": {
      "additionalProperties": false,
      "description": "The actual Fabric factor and definition fingerprints used on both operands.",
      "properties": {
        "canonical_unit": {
          "minLength": 1,
          "title": "Canonical Unit",
          "type": "string"
        },
        "definition_basis_content_sha256": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Definition Basis Content Sha256",
          "type": "string"
        },
        "definition_content_sha256": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Definition Content Sha256",
          "type": "string"
        },
        "executor_version": {
          "const": "polisyos.fabric.units.fixed-multiplicative.v1",
          "title": "Executor Version",
          "type": "string"
        },
        "multiplier": {
          "anyOf": [
            {
              "exclusiveMinimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Multiplier"
        },
        "raw_unit": {
          "minLength": 1,
          "title": "Raw Unit",
          "type": "string"
        },
        "transform_ref": {
          "const": "fabric://units/fixed-multiplicative/v1",
          "title": "Transform Ref",
          "type": "string"
        }
      },
      "required": [
        "raw_unit",
        "canonical_unit",
        "multiplier",
        "definition_basis_content_sha256",
        "definition_content_sha256",
        "transform_ref",
        "executor_version"
      ],
      "title": "BacktestFixedUnitTransform",
      "type": "object"
    },
    "BacktestNumericalRange": {
      "additionalProperties": false,
      "description": "Binary64 range failures without losing representable comparison rows.",
      "properties": {
        "policy_version": {
          "const": "backtest.binary64.v1",
          "title": "Policy Version",
          "type": "string"
        },
        "residual_overflow_cells": {
          "items": {
            "$ref": "#/$defs/BacktestResidualOverflowCell"
          },
          "title": "Residual Overflow Cells",
          "type": "array"
        },
        "unavailable_error_sums": {
          "additionalProperties": {
            "$ref": "#/$defs/_RangeFailure"
          },
          "propertyNames": {
            "$ref": "#/$defs/_ErrorSumName"
          },
          "title": "Unavailable Error Sums",
          "type": "object"
        }
      },
      "required": [
        "policy_version"
      ],
      "title": "BacktestNumericalRange",
      "type": "object"
    },
    "BacktestPooledStratum": {
      "additionalProperties": false,
      "description": "Numerical summary in exactly one selected measurement representation.",
      "properties": {
        "canonical_unit": {
          "minLength": 1,
          "title": "Canonical Unit",
          "type": "string"
        },
        "comparison_count": {
          "exclusiveMinimum": 0,
          "title": "Comparison Count",
          "type": "integer"
        },
        "micro_mae": {
          "minimum": 0.0,
          "title": "Micro Mae",
          "type": "number"
        },
        "micro_rmse": {
          "minimum": 0.0,
          "title": "Micro Rmse",
          "type": "number"
        },
        "representation_ref": {
          "$ref": "#/$defs/SelectedRepresentationRef"
        },
        "scenario_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Scenario Ids",
          "type": "array"
        },
        "semantic_definition_ref": {
          "$ref": "#/$defs/SelectedDefinitionRef"
        },
        "weighted_macro_rmse": {
          "minimum": 0.0,
          "title": "Weighted Macro Rmse",
          "type": "number"
        }
      },
      "required": [
        "representation_ref",
        "semantic_definition_ref",
        "canonical_unit",
        "scenario_ids",
        "comparison_count",
        "micro_rmse",
        "micro_mae",
        "weighted_macro_rmse"
      ],
      "title": "BacktestPooledStratum",
      "type": "object"
    },
    "BacktestPoolingMeasure": {
      "additionalProperties": false,
      "description": "A preflight qualification, tied by position to the selected member.",
      "properties": {
        "canonical_unit": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Canonical Unit"
        },
        "limitation": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Limitation"
        },
        "semantic_definition_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/SelectedDefinitionRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "transform": {
          "anyOf": [
            {
              "$ref": "#/$defs/BacktestFixedUnitTransform"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "title": "BacktestPoolingMeasure",
      "type": "object"
    },
    "BacktestPoolingPolicyRef": {
      "additionalProperties": false,
      "description": "Exact pre-execution selection of historical comparison policy.",
      "properties": {
        "artifact_id": {
          "$ref": "#/$defs/ArtifactID"
        },
        "kind": {
          "const": "ir.backtest_pooling_policy",
          "default": "ir.backtest_pooling_policy",
          "title": "Kind",
          "type": "string"
        },
        "manifest_profile_sha256": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Manifest Profile Sha256",
          "type": "string"
        },
        "media_type": {
          "const": "application/json",
          "default": "application/json",
          "title": "Media Type",
          "type": "string"
        }
      },
      "required": [
        "artifact_id",
        "manifest_profile_sha256"
      ],
      "title": "BacktestPoolingPolicyRef",
      "type": "object"
    },
    "BacktestPoolingProjection": {
      "additionalProperties": false,
      "description": "Selected normalized statistics with explicit nonpooled source members.",
      "properties": {
        "measures": {
          "items": {
            "$ref": "#/$defs/BacktestPoolingMeasure"
          },
          "minItems": 1,
          "title": "Measures",
          "type": "array"
        },
        "policy_ref": {
          "$ref": "#/$defs/BacktestPoolingPolicyRef"
        },
        "strata": {
          "items": {
            "$ref": "#/$defs/BacktestPooledStratum"
          },
          "title": "Strata",
          "type": "array"
        },
        "unavailable": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Unavailable",
          "type": "object"
        }
      },
      "required": [
        "policy_ref",
        "measures",
        "strata",
        "unavailable"
      ],
      "title": "BacktestPoolingProjection",
      "type": "object"
    },
    "BacktestResidualOverflowCell": {
      "additionalProperties": false,
      "description": "Finite operands at an invalid requested cell whose residual overflows.",
      "properties": {
        "metric_name": {
          "minLength": 1,
          "title": "Metric Name",
          "type": "string"
        },
        "observation_index": {
          "minimum": 0,
          "title": "Observation Index",
          "type": "integer"
        },
        "y_pred": {
          "title": "Y Pred",
          "type": "number"
        },
        "y_true": {
          "title": "Y True",
          "type": "number"
        }
      },
      "required": [
        "metric_name",
        "observation_index",
        "y_pred",
        "y_true"
      ],
      "title": "BacktestResidualOverflowCell",
      "type": "object"
    },
    "BacktestScenario": {
      "additionalProperties": false,
      "description": "Historical validation scenario with per-metric forecast comparisons.",
      "properties": {
        "absolute_error_sum": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Absolute Error Sum"
        },
        "compared_count": {
          "default": 0,
          "minimum": 0,
          "title": "Compared Count",
          "type": "integer"
        },
        "coverage_probability": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Coverage Probability"
        },
        "data_source": {
          "default": "",
          "title": "Data Source",
          "type": "string"
        },
        "interval_availability": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Interval Availability"
        },
        "interval_available_count": {
          "default": 0,
          "minimum": 0,
          "title": "Interval Available Count",
          "type": "integer"
        },
        "interval_evaluated_count": {
          "default": 0,
          "minimum": 0,
          "title": "Interval Evaluated Count",
          "type": "integer"
        },
        "interval_hit_count": {
          "default": 0,
          "minimum": 0,
          "title": "Interval Hit Count",
          "type": "integer"
        },
        "interval_hit_rate": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Interval Hit Rate"
        },
        "interval_requested_count": {
          "default": 0,
          "minimum": 0,
          "title": "Interval Requested Count",
          "type": "integer"
        },
        "interval_type": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Interval Type"
        },
        "intervention_date": {
          "default": "",
          "title": "Intervention Date",
          "type": "string"
        },
        "invalid_cells": {
          "items": {
            "maxItems": 2,
            "minItems": 2,
            "prefixItems": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              }
            ],
            "type": "array"
          },
          "title": "Invalid Cells",
          "type": "array"
        },
        "invalid_count": {
          "default": 0,
          "minimum": 0,
          "title": "Invalid Count",
          "type": "integer"
        },
        "jurisdiction": {
          "default": "",
          "title": "Jurisdiction",
          "type": "string"
        },
        "mae": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mae"
        },
        "mape": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mape"
        },
        "metadata": {
          "additionalProperties": true,
          "title": "Metadata",
          "type": "object"
        },
        "missing_cells": {
          "items": {
            "maxItems": 2,
            "minItems": 2,
            "prefixItems": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              }
            ],
            "type": "array"
          },
          "title": "Missing Cells",
          "type": "array"
        },
        "missing_count": {
          "default": 0,
          "minimum": 0,
          "title": "Missing Count",
          "type": "integer"
        },
        "nominal_confidence_level": {
          "anyOf": [
            {
              "exclusiveMaximum": 1.0,
              "exclusiveMinimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Nominal Confidence Level"
        },
        "numerical_range": {
          "anyOf": [
            {
              "$ref": "#/$defs/BacktestNumericalRange"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "outcome_comparisons": {
          "items": {
            "$ref": "#/$defs/OutcomeComparison"
          },
          "title": "Outcome Comparisons",
          "type": "array"
        },
        "percentage_error_count": {
          "default": 0,
          "minimum": 0,
          "title": "Percentage Error Count",
          "type": "integer"
        },
        "percentage_error_sum": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Percentage Error Sum"
        },
        "requested_count": {
          "default": 0,
          "minimum": 0,
          "title": "Requested Count",
          "type": "integer"
        },
        "rmse": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rmse"
        },
        "scenario_id": {
          "minLength": 1,
          "title": "Scenario Id",
          "type": "string"
        },
        "scenario_label": {
          "minLength": 1,
          "title": "Scenario Label",
          "type": "string"
        },
        "squared_error_sum": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Squared Error Sum"
        }
      },
      "required": [
        "scenario_id",
        "scenario_label"
      ],
      "title": "BacktestScenario",
      "type": "object"
    },
    "BacktestUnpooledStratum": {
      "additionalProperties": false,
      "description": "Raw error statistics within one source scenario and metric.",
      "properties": {
        "comparison_count": {
          "minimum": 0,
          "title": "Comparison Count",
          "type": "integer"
        },
        "jurisdiction": {
          "title": "Jurisdiction",
          "type": "string"
        },
        "mae": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Mae"
        },
        "metric_name": {
          "title": "Metric Name",
          "type": "string"
        },
        "rmse": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Rmse"
        },
        "scenario_id": {
          "title": "Scenario Id",
          "type": "string"
        }
      },
      "required": [
        "scenario_id",
        "metric_name",
        "jurisdiction",
        "comparison_count",
        "rmse",
        "mae"
      ],
      "title": "BacktestUnpooledStratum",
      "type": "object"
    },
    "BiasDirection": {
      "description": "Direction of systematic bias detected in historical validation.",
      "enum": [
        "optimistic",
        "pessimistic",
        "neutral",
        "mixed",
        "unknown"
      ],
      "title": "BiasDirection",
      "type": "string"
    },
    "MetricBiasDiagnostic": {
      "additionalProperties": false,
      "description": "One metric's residual description and exact statistical execution state.",
      "properties": {
        "backend_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Backend Id"
        },
        "backend_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Backend Version"
        },
        "direction_status": {
          "enum": [
            "not_established",
            "not_applicable"
          ],
          "title": "Direction Status",
          "type": "string"
        },
        "magnitude": {
          "minimum": 0.0,
          "title": "Magnitude",
          "type": "number"
        },
        "mean_residual": {
          "title": "Mean Residual",
          "type": "number"
        },
        "method_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Method Id"
        },
        "metric_name": {
          "minLength": 1,
          "title": "Metric Name",
          "type": "string"
        },
        "n": {
          "minimum": 0,
          "title": "N",
          "type": "integer"
        },
        "p_value": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "P Value"
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        },
        "residual_sign": {
          "enum": [
            "negative",
            "zero",
            "positive"
          ],
          "title": "Residual Sign",
          "type": "string"
        },
        "scope": {
          "additionalProperties": true,
          "title": "Scope",
          "type": "object"
        },
        "statistic": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Statistic"
        },
        "status": {
          "pattern": "^(exact_zero|available|not_computable|unavailable)$",
          "title": "Status",
          "type": "string"
        },
        "unresolved_assumptions": {
          "items": {
            "type": "string"
          },
          "title": "Unresolved Assumptions",
          "type": "array"
        }
      },
      "required": [
        "metric_name",
        "status",
        "n",
        "mean_residual",
        "magnitude",
        "residual_sign",
        "direction_status"
      ],
      "title": "MetricBiasDiagnostic",
      "type": "object"
    },
    "OutcomeComparison": {
      "additionalProperties": false,
      "description": "Comparison between predicted and observed outcomes for one metric.",
      "properties": {
        "absolute_error": {
          "minimum": 0.0,
          "title": "Absolute Error",
          "type": "number"
        },
        "ci_lower": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ci Lower"
        },
        "ci_upper": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ci Upper"
        },
        "metric_name": {
          "minLength": 1,
          "title": "Metric Name",
          "type": "string"
        },
        "relative_error": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Relative Error"
        },
        "within_ci": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Within Ci"
        },
        "y_pred": {
          "title": "Y Pred",
          "type": "number"
        },
        "y_true": {
          "title": "Y True",
          "type": "number"
        }
      },
      "required": [
        "metric_name",
        "y_pred",
        "y_true",
        "absolute_error"
      ],
      "title": "OutcomeComparison",
      "type": "object"
    },
    "SelectedDefinitionRef": {
      "additionalProperties": false,
      "description": "IR handle for the existing Catalog semantic definition.",
      "properties": {
        "artifact_id": {
          "$ref": "#/$defs/ArtifactID"
        },
        "kind": {
          "const": "catalog.variable_semantic_definition",
          "default": "catalog.variable_semantic_definition",
          "title": "Kind",
          "type": "string"
        },
        "manifest_profile_sha256": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Manifest Profile Sha256",
          "type": "string"
        },
        "media_type": {
          "const": "application/json",
          "default": "application/json",
          "title": "Media Type",
          "type": "string"
        }
      },
      "required": [
        "artifact_id",
        "manifest_profile_sha256"
      ],
      "title": "SelectedDefinitionRef",
      "type": "object"
    },
    "SelectedRepresentationRef": {
      "additionalProperties": false,
      "description": "IR handle for an exact existing Catalog measurement representation.",
      "properties": {
        "artifact_id": {
          "$ref": "#/$defs/ArtifactID"
        },
        "kind": {
          "const": "catalog.variable_representation",
          "default": "catalog.variable_representation",
          "title": "Kind",
          "type": "string"
        },
        "manifest_profile_sha256": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Manifest Profile Sha256",
          "type": "string"
        },
        "media_type": {
          "const": "application/json",
          "default": "application/json",
          "title": "Media Type",
          "type": "string"
        }
      },
      "required": [
        "artifact_id",
        "manifest_profile_sha256"
      ],
      "title": "SelectedRepresentationRef",
      "type": "object"
    },
    "SystematicBias": {
      "additionalProperties": false,
      "description": "Structured bias pattern detected across backtest scenarios.",
      "properties": {
        "affected_metrics": {
          "items": {
            "type": "string"
          },
          "title": "Affected Metrics",
          "type": "array"
        },
        "bias_type": {
          "minLength": 1,
          "title": "Bias Type",
          "type": "string"
        },
        "description": {
          "default": "",
          "title": "Description",
          "type": "string"
        },
        "direction": {
          "$ref": "#/$defs/BiasDirection"
        },
        "magnitude": {
          "minimum": 0.0,
          "title": "Magnitude",
          "type": "number"
        },
        "metadata": {
          "additionalProperties": true,
          "title": "Metadata",
          "type": "object"
        },
        "p_value": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "P Value"
        },
        "statistical_test": {
          "default": "",
          "title": "Statistical Test",
          "type": "string"
        }
      },
      "required": [
        "bias_type",
