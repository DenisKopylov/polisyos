{
  "$defs": {
    "BoundsChannelSpec": {
      "additionalProperties": false,
      "properties": {
        "bound_strategy": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Bound Strategy",
          "type": "string"
        },
        "fallback_reason": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Fallback Reason",
          "type": "string"
        },
        "family": {
          "$ref": "#/$defs/ObservationFamily"
        },
        "notes": {
          "items": {
            "type": "string"
          },
          "title": "Notes",
          "type": "array"
        }
      },
      "required": [
        "family",
        "bound_strategy",
        "fallback_reason"
      ],
      "title": "BoundsChannelSpec",
      "type": "object"
    },
    "ObservationFamily": {
      "enum": [
        "budget_flows",
        "procurement_flows",
        "macro_state",
        "firm_fundamentals",
        "trade_exposure",
        "labor_market",
        "household_distribution",
        "distress_enforcement",
        "spatial_raster_exogenous",
        "public_service_domain_flows",
        "education_human_capital_supply",
        "construction_capital_formation",
        "logistics_friction"
      ],
      "title": "ObservationFamily",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "artifact_name": {
      "const": "bounds_estimation_bundle_v1.json",
      "default": "bounds_estimation_bundle_v1.json",
      "title": "Artifact Name",
      "type": "string"
    },
    "available_estimators": {
      "items": {
        "type": "string"
      },
      "title": "Available Estimators",
      "type": "array"
    },
    "channels": {
      "items": {
        "$ref": "#/$defs/BoundsChannelSpec"
      },
      "minItems": 1,
      "title": "Channels",
      "type": "array"
    },
    "schema_version": {
      "default": "1.0",
      "pattern": "^\\d+\\.\\d+$",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "channels"
  ],
  "title": "BoundsEstimationBundle",
  "type": "object"
}
