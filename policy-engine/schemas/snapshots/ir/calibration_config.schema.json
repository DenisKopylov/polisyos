{
  "$defs": {
    "CalibrationTarget": {
      "additionalProperties": false,
      "description": "Bind one observed Fabric series to the simulation metric being calibrated.\n\nCalibration runners align the Fabric series using ``align``, evaluate the\ntarget-specific loss configured in ``loss``, and optionally restrict which\ntrainable parameters should respond to this target.",
      "properties": {
        "aggregation": {
          "default": "none",
          "description": "\u0410\u0433\u0440\u0435\u0433\u0430\u0446\u0438\u044f \u043c\u0435\u0442\u0440\u0438\u043a\u0438 \u0434\u043b\u044f \u0432\u0435\u043a\u0442\u043e\u0440\u043d\u044b\u0445 \u0441\u043b\u043e\u0442\u043e\u0432 (none|mean|sum|min|max).",
          "pattern": "^(none|mean|sum|min|max)$",
          "title": "Aggregation",
          "type": "string"
        },
        "align": {
          "$ref": "#/$defs/TargetAlignConfig"
        },
        "fabric_metric": {
          "anyOf": [
            {
              "maxLength": 128,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "\u041a\u043e\u043b\u043e\u043d\u043a\u0430/\u043c\u0435\u0442\u0440\u0438\u043a\u0430 \u0438\u0437 \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442\u0430 Fabric (\u0435\u0441\u043b\u0438 \u043d\u0435 \u0437\u0430\u0434\u0430\u043d\u043e \u2014 \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u044c target_id \u0438\u043b\u0438 \u0435\u0434\u0438\u043d\u0441\u0442\u0432\u0435\u043d\u043d\u0443\u044e \u043c\u0435\u0442\u0440\u0438\u043a\u0443).",
          "title": "Fabric Metric"
        },
        "fabric_query": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "\u0417\u0430\u043f\u0440\u043e\u0441/\u0441\u043f\u0435\u0446\u0438\u0444\u0438\u043a\u0430\u0446\u0438\u044f \u043a Fabric/UDF. \u0412 preflight \u0434\u043e\u043b\u0436\u0435\u043d \u0431\u044b\u0442\u044c \u0440\u0430\u0437\u0440\u0435\u0448\u0451\u043d \u0432 \u043c\u0430\u0441\u0441\u0438\u0432 \u0437\u043d\u0430\u0447\u0435\u043d\u0438\u0439.",
          "title": "Fabric Query"
        },
        "loss": {
          "$ref": "#/$defs/TargetLossConfig"
        },
        "model_metric_path": {
          "description": "state_path \u0438\u043b\u0438 slot_id \u0434\u043b\u044f \u0438\u0437\u0432\u043b\u0435\u0447\u0435\u043d\u0438\u044f \u043c\u0435\u0442\u0440\u0438\u043a\u0438 \u0438\u0437 \u0441\u043e\u0441\u0442\u043e\u044f\u043d\u0438\u044f/\u0442\u0440\u0435\u0439\u0441\u0430.",
          "maxLength": 256,
          "title": "Model Metric Path",
          "type": "string"
        },
        "target_id": {
          "description": "\u0418\u0434\u0435\u043d\u0442\u0438\u0444\u0438\u043a\u0430\u0442\u043e\u0440 \u0442\u0430\u0440\u0433\u0435\u0442\u0430 (\u0443\u043d\u0438\u043a\u0430\u043b\u0435\u043d).",
          "maxLength": 128,
          "title": "Target Id",
          "type": "string"
        },
        "trainables": {
          "description": "\u041e\u043f\u0446\u0438\u043e\u043d\u0430\u043b\u044c\u043d\u0430\u044f \u043a\u0430\u0440\u0442\u0430 \u043f\u0430\u0440\u0430\u043c\u0435\u0442\u0440\u043e\u0432, \u0441\u0432\u044f\u0437\u0430\u043d\u043d\u044b\u0445 \u0441 \u044d\u0442\u0438\u043c \u0442\u0430\u0440\u0433\u0435\u0442\u043e\u043c.",
          "items": {
            "$ref": "#/$defs/TrainableParamRef"
          },
          "title": "Trainables",
          "type": "array"
        }
      },
      "required": [
        "target_id",
        "model_metric_path"
      ],
      "title": "CalibrationTarget",
      "type": "object"
    },
    "ConstraintLossConfig": {
      "additionalProperties": false,
      "description": "\u041d\u0430\u0441\u0442\u0440\u043e\u0439\u043a\u0438 \u0448\u0442\u0440\u0430\u0444\u043e\u0432 \u043f\u043e \u043e\u0433\u0440\u0430\u043d\u0438\u0447\u0435\u043d\u0438\u044f\u043c.",
      "properties": {
        "constraint_ids": {
          "description": "\u0415\u0441\u043b\u0438 \u043f\u0443\u0441\u0442\u043e \u2014 \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u044c \u0432\u0441\u0435 \u043e\u0433\u0440\u0430\u043d\u0438\u0447\u0435\u043d\u0438\u044f \u0438\u0437 registry.",
          "items": {
            "type": "string"
          },
          "title": "Constraint Ids",
          "type": "array"
        },
        "enabled": {
          "default": false,
          "title": "Enabled",
          "type": "boolean"
        },
        "epsilon": {
          "default": 1e-08,
          "exclusiveMinimum": 0.0,
          "title": "Epsilon",
          "type": "number"
        },
        "mode": {
          "default": "trajectory",
          "pattern": "^(trajectory|final)$",
          "title": "Mode",
          "type": "string"
        },
        "reduction": {
          "default": "mean",
          "pattern": "^(mean|max)$",
          "title": "Reduction",
          "type": "string"
        },
        "weight": {
          "default": 1.0,
          "minimum": 0.0,
          "title": "Weight",
          "type": "number"
        }
      },
      "title": "ConstraintLossConfig",
      "type": "object"
    },
    "FidelityConfig": {
      "additionalProperties": false,
      "description": "\u041d\u0430\u0441\u0442\u0440\u043e\u0439\u043a\u0438 \u0440\u0435\u0436\u0438\u043c\u0430 \u0438\u0441\u043f\u043e\u043b\u043d\u0435\u043d\u0438\u044f \u0434\u043b\u044f \u043a\u0430\u043b\u0438\u0431\u0440\u0430\u0446\u0438\u0438.",
      "properties": {
        "force_override": {
          "default": true,
          "description": "\u041f\u0440\u0438\u043d\u0443\u0434\u0438\u0442\u0435\u043b\u044c\u043d\u043e \u043f\u0435\u0440\u0435\u0437\u0430\u043f\u0438\u0441\u044b\u0432\u0430\u0442\u044c fidelity \u0432 \u043f\u0430\u0440\u0430\u043c\u0435\u0442\u0440\u0430\u0445 \u043c\u0435\u0445\u0430\u043d\u0438\u0437\u043c\u0430.",
          "title": "Force Override",
          "type": "boolean"
        },
        "mode": {
          "default": "relaxed",
          "description": "\u0420\u0435\u0436\u0438\u043c \u0438\u0441\u043f\u043e\u043b\u043d\u0435\u043d\u0438\u044f (relaxed|discrete).",
          "pattern": "^(relaxed|discrete)$",
          "title": "Mode",
          "type": "string"
        },
        "temperature": {
          "default": 1.0,
          "description": "\u0422\u0435\u043c\u043f\u0435\u0440\u0430\u0442\u0443\u0440\u0430 \u0441\u0433\u043b\u0430\u0436\u0438\u0432\u0430\u043d\u0438\u044f (softmax/gumbel).",
          "exclusiveMinimum": 0.0,
          "title": "Temperature",
          "type": "number"
        }
      },
      "title": "FidelityConfig",
      "type": "object"
    },
    "GradNormConfig": {
      "additionalProperties": false,
      "description": "\u041d\u0430\u0441\u0442\u0440\u043e\u0439\u043a\u0438 GradNorm (\u0432\u044b\u0440\u0430\u0432\u043d\u0438\u0432\u0430\u043d\u0438\u0435 \u043d\u043e\u0440\u043c \u0433\u0440\u0430\u0434\u0438\u0435\u043d\u0442\u043e\u0432 \u043f\u043e \u0442\u0430\u0440\u0433\u0435\u0442\u0430\u043c).",
      "properties": {
        "alpha": {
          "default": 1.0,
          "description": "\u0421\u0442\u0435\u043f\u0435\u043d\u044c \u0432\u044b\u0440\u0430\u0432\u043d\u0438\u0432\u0430\u043d\u0438\u044f \u0441\u043a\u043e\u0440\u043e\u0441\u0442\u0438 \u043e\u0431\u0443\u0447\u0435\u043d\u0438\u044f.",
          "minimum": 0.0,
          "title": "Alpha",
          "type": "number"
        },
        "enabled": {
          "default": false,
          "title": "Enabled",
          "type": "boolean"
        },
        "epsilon": {
          "default": 1e-08,
          "exclusiveMinimum": 0.0,
          "title": "Epsilon",
          "type": "number"
        },
        "lr": {
          "default": 0.1,
          "description": "\u0421\u043a\u043e\u0440\u043e\u0441\u0442\u044c \u0430\u0434\u0430\u043f\u0442\u0430\u0446\u0438\u0438 \u0432\u0435\u0441\u043e\u0432.",
          "minimum": 0.0,
          "title": "Lr",
          "type": "number"
        },
        "max_weight": {
          "default": 10.0,
          "exclusiveMinimum": 0.0,
          "title": "Max Weight",
          "type": "number"
        },
        "min_weight": {
          "default": 0.1,
          "exclusiveMinimum": 0.0,
          "title": "Min Weight",
          "type": "number"
        },
        "update_every": {
          "default": 1,
          "description": "\u0427\u0430\u0441\u0442\u043e\u0442\u0430 \u043e\u0431\u043d\u043e\u0432\u043b\u0435\u043d\u0438\u044f \u0432\u0435\u0441\u043e\u0432 (\u0432 \u0448\u0430\u0433\u0430\u0445).",
          "minimum": 1,
          "title": "Update Every",
          "type": "integer"
        }
      },
      "title": "GradNormConfig",
      "type": "object"
    },
    "HessianConfig": {
      "additionalProperties": false,
      "description": "\u041d\u0430\u0441\u0442\u0440\u043e\u0439\u043a\u0438 \u043e\u0446\u0435\u043d\u043a\u0438 \u043d\u0435\u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0451\u043d\u043d\u043e\u0441\u0442\u0438 \u0447\u0435\u0440\u0435\u0437 Hessian.",
      "properties": {
        "condition_warn": {
          "default": 100000000.0,
          "description": "\u041f\u043e\u0440\u043e\u0433 \u043a\u043e\u043d\u0434\u0438\u0446\u0438\u043e\u043d\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u044f \u0434\u043b\u044f \u0434\u0438\u0430\u0433\u043d\u043e\u0441\u0442\u0438\u043a\u0438.",
          "exclusiveMinimum": 0.0,
          "title": "Condition Warn",
          "type": "number"
        },
        "damping": {
          "default": 1e-06,
          "description": "\u0414\u0438\u0430\u0433\u043e\u043d\u0430\u043b\u044c\u043d\u044b\u0439 \u0441\u0434\u0432\u0438\u0433 \u03bb \u0434\u043b\u044f H + \u03bbI.",
          "minimum": 0.0,
          "title": "Damping",
          "type": "number"
        },
        "enabled": {
          "default": true,
          "title": "Enabled",
          "type": "boolean"
        },
        "max_params": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "\u041e\u0433\u0440\u0430\u043d\u0438\u0447\u0435\u043d\u0438\u0435 \u043d\u0430 \u043a\u043e\u043b\u0438\u0447\u0435\u0441\u0442\u0432\u043e \u043f\u0430\u0440\u0430\u043c\u0435\u0442\u0440\u043e\u0432 \u0434\u043b\u044f \u0440\u0430\u0441\u0447\u0451\u0442\u0430 Hessian.",
          "title": "Max Params"
        },
        "rank_tol": {
          "default": 1e-06,
          "description": "\u041f\u043e\u0440\u043e\u0433 \u0434\u043b\u044f \u043e\u0446\u0435\u043d\u043a\u0438 \u0440\u0430\u043d\u0433\u0430 Hessian.",
          "exclusiveMinimum": 0.0,
          "title": "Rank Tol",
          "type": "number"
        },
        "std_warn": {
          "default": 1000000.0,
          "description": "\u041f\u043e\u0440\u043e\u0433 STD \u0434\u043b\u044f \u0434\u0438\u0430\u0433\u043d\u043e\u0441\u0442\u0438\u043a\u0438 \u043d\u0435\u0438\u0434\u0435\u043d\u0442\u0438\u0444\u0438\u0446\u0438\u0440\u0443\u0435\u043c\u043e\u0441\u0442\u0438.",
          "exclusiveMinimum": 0.0,
          "title": "Std Warn",
          "type": "number"
        }
      },
      "title": "HessianConfig",
      "type": "object"
    },
    "MultiStartConfig": {
      "additionalProperties": false,
      "description": "Configuration for multi-start optimization.",
      "properties": {
        "condition_threshold": {
          "default": 100000000.0,
          "description": "Max acceptable Hessian condition number for best_loss selection.",
          "exclusiveMinimum": 0.0,
          "title": "Condition Threshold",
          "type": "number"
        },
        "n_starts": {
          "default": 5,
          "description": "Number of optimization starts.",
          "minimum": 1,
          "title": "N Starts",
          "type": "integer"
        },
        "perturbation_scale": {
          "default": 0.1,
          "description": "Scale for initial parameter perturbation.",
          "exclusiveMinimum": 0.0,
          "title": "Perturbation Scale",
          "type": "number"
        },
        "selection": {
          "default": "best_loss",
          "description": "Selection criterion: best_loss or best_identifiability.",
          "pattern": "^(best_loss|best_identifiability)$",
          "title": "Selection",
          "type": "string"
        }
      },
      "title": "MultiStartConfig",
      "type": "object"
    },
    "PriorLossConfig": {
      "additionalProperties": false,
      "description": "\u041d\u0430\u0441\u0442\u0440\u043e\u0439\u043a\u0438 Gaussian priors \u043f\u043e trainable \u043f\u0430\u0440\u0430\u043c\u0435\u0442\u0440\u0430\u043c.",
      "properties": {
        "enabled": {
          "default": false,
          "title": "Enabled",
          "type": "boolean"
        },
        "epsilon": {
          "default": 1e-08,
          "exclusiveMinimum": 0.0,
          "title": "Epsilon",
          "type": "number"
        },
        "weight": {
          "default": 1.0,
          "minimum": 0.0,
          "title": "Weight",
          "type": "number"
        }
      },
      "title": "PriorLossConfig",
      "type": "object"
    },
    "TargetAlignConfig": {
      "additionalProperties": false,
      "description": "\u041d\u0430\u0441\u0442\u0440\u043e\u0439\u043a\u0438 \u0432\u044b\u0440\u0430\u0432\u043d\u0438\u0432\u0430\u043d\u0438\u044f \u0438\u0441\u0442\u043e\u0440\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e \u0440\u044f\u0434\u0430 \u043f\u043e\u0434 \u0448\u0430\u0433 \u0441\u0438\u043c\u0443\u043b\u044f\u0446\u0438\u0438.",
      "properties": {
        "fill_value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "\u0427\u0435\u043c \u0437\u0430\u043f\u043e\u043b\u043d\u0438\u0442\u044c \u043f\u0440\u043e\u043f\u0443\u0441\u043a\u0438 (\u0435\u0441\u043b\u0438 None \u2014 \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u044c \u043a\u0440\u0430\u0439\u043d\u0438\u0435 \u0437\u043d\u0430\u0447\u0435\u043d\u0438\u044f/\u0438\u043d\u0442\u0435\u0440\u043f\u043e\u043b\u044f\u0446\u0438\u044e).",
          "title": "Fill Value"
        },
        "frequency": {
          "anyOf": [
            {
              "$ref": "#/$defs/TimeFrequency"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "\u0427\u0430\u0441\u0442\u043e\u0442\u0430 \u0441\u0438\u043c\u0443\u043b\u044f\u0446\u0438\u0438/\u0440\u0435\u0441\u0435\u043c\u043f\u043b\u0438\u043d\u0433\u0430 (\u0435\u0441\u043b\u0438 \u043d\u0443\u0436\u043d\u043e \u043f\u0435\u0440\u0435\u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0438\u0442\u044c)."
        },
        "method": {
          "default": "linear",
          "description": "\u041c\u0435\u0442\u043e\u0434 \u0438\u043d\u0442\u0435\u0440\u043f\u043e\u043b\u044f\u0446\u0438\u0438/\u0440\u0435\u0441\u0435\u043c\u043f\u043b\u0438\u043d\u0433\u0430 (linear|ffill).",
          "pattern": "^(linear|ffill)$",
          "title": "Method",
          "type": "string"
        },
        "steps": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "\u042f\u0432\u043d\u043e\u0435 \u043a\u043e\u043b\u0438\u0447\u0435\u0441\u0442\u0432\u043e \u0448\u0430\u0433\u043e\u0432 \u0441\u0438\u043c\u0443\u043b\u044f\u0446\u0438\u0438 \u0434\u043b\u044f \u0434\u0430\u043d\u043d\u043e\u0433\u043e \u0442\u0430\u0440\u0433\u0435\u0442\u0430.",
          "title": "Steps"
        },
        "time_column": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "\u041d\u0430\u0437\u0432\u0430\u043d\u0438\u0435 \u043a\u043e\u043b\u043e\u043d\u043a\u0438 \u0432\u0440\u0435\u043c\u0435\u043d\u0438 \u0432 \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442\u0430\u0445 Fabric (\u0435\u0441\u043b\u0438 \u0435\u0441\u0442\u044c).",
          "title": "Time Column"
        }
      },
      "title": "TargetAlignConfig",
      "type": "object"
    },
    "TargetLossConfig": {
      "additionalProperties": false,
      "description": "\u041f\u0430\u0440\u0430\u043c\u0435\u0442\u0440\u044b \u0440\u0430\u0441\u0447\u0451\u0442\u0430 \u043e\u0448\u0438\u0431\u043a\u0438 \u043f\u043e \u0442\u0430\u0440\u0433\u0435\u0442\u0443.",
      "properties": {
        "epsilon": {
          "default": 1e-08,
          "description": "\u0421\u0442\u0430\u0431\u0438\u043b\u0438\u0437\u0430\u0446\u0438\u044f \u043f\u0440\u0438 \u043d\u0443\u043b\u0435\u0432\u043e\u043c \u043c\u0430\u0441\u0448\u0442\u0430\u0431\u0435.",
          "title": "Epsilon",
          "type": "number"
        },
        "kind": {
          "default": "mse",
          "description": "mse|huber (MVP \u043f\u043e\u0434\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u0435\u0442 mse).",
          "title": "Kind",
          "type": "string"
        },
        "relative": {
          "default": true,
