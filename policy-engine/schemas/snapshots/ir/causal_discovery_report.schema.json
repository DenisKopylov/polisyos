{
  "$defs": {
    "AlgebraicConstraintFamily": {
      "description": "Select the family of algebraic test implied by a graph or latent-factor block.",
      "enum": [
        "ci",
        "tetrad",
        "overcomplete"
      ],
      "title": "AlgebraicConstraintFamily",
      "type": "string"
    },
    "AlgebraicConstraintReport": {
      "additionalProperties": false,
      "description": "Summarize implied/violated algebraic constraints and suggested graph repairs.",
      "properties": {
        "families_run": {
          "items": {
            "$ref": "#/$defs/AlgebraicConstraintFamily"
          },
          "title": "Families Run",
          "type": "array"
        },
        "implied_constraints_preview": {
          "items": {
            "$ref": "#/$defs/ImpliedConstraintSpec"
          },
          "title": "Implied Constraints Preview",
          "type": "array"
        },
        "implied_constraints_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/ArtifactRefModel"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "n_implied_constraints": {
          "default": 0,
          "minimum": 0,
          "title": "N Implied Constraints",
          "type": "integer"
        },
        "n_violated_constraints": {
          "default": 0,
          "minimum": 0,
          "title": "N Violated Constraints",
          "type": "integer"
        },
        "severity": {
          "default": "info",
          "enum": [
            "info",
            "warning",
            "blocker"
          ],
          "title": "Severity",
          "type": "string"
        },
        "suggested_repairs": {
          "items": {
            "type": "string"
          },
          "title": "Suggested Repairs",
          "type": "array"
        },
        "tested_by_family": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "Tested By Family",
          "type": "object"
        },
        "violated_by_family": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "Violated By Family",
          "type": "object"
        },
        "violated_constraints_preview": {
          "items": {
            "$ref": "#/$defs/ConstraintEvaluationResult"
          },
          "title": "Violated Constraints Preview",
          "type": "array"
        },
        "violated_constraints_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/ArtifactRefModel"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "warnings": {
          "items": {
            "type": "string"
          },
          "title": "Warnings",
          "type": "array"
        }
      },
      "title": "AlgebraicConstraintReport",
      "type": "object"
    },
    "ArtifactID": {
      "description": "IR-local artifact ID model compatible with CAS interfaces.",
      "title": "ArtifactID",
      "type": "string"
    },
    "ArtifactRefModel": {
      "additionalProperties": false,
      "description": "Provide the common mapping-compatible base contract for artifact refs.",
      "properties": {
        "artifact_id": {
          "$ref": "#/$defs/ArtifactID"
        },
        "kind": {
          "title": "Kind",
          "type": "string"
        },
        "media_type": {
          "title": "Media Type",
          "type": "string"
        }
      },
      "required": [
        "artifact_id",
        "kind",
        "media_type"
      ],
      "title": "ArtifactRefModel",
      "type": "object"
    },
    "CausalEdge": {
      "additionalProperties": false,
      "description": "Causal edge public type.",
      "properties": {
        "combined_confidence": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Combined Confidence"
        },
        "data_confidence": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Data Confidence"
        },
        "dst": {
          "minLength": 1,
          "title": "Dst",
          "type": "string"
        },
        "evidence_refs": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Refs",
          "type": "array"
        },
        "expert_confidence": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expert Confidence"
        },
        "lag": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Lag"
        },
        "literature_confidence": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Literature Confidence"
        },
        "llm_confidence": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Llm Confidence"
        },
        "mark_dst": {
          "$ref": "#/$defs/EdgeMark",
          "default": "arrow"
        },
        "mark_src": {
          "$ref": "#/$defs/EdgeMark",
          "default": "tail"
        },
        "metadata": {
          "additionalProperties": true,
          "title": "Metadata",
          "type": "object"
        },
        "p_value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "P Value"
        },
        "simulation_confidence": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Simulation Confidence"
        },
        "sources": {
          "items": {
            "$ref": "#/$defs/EdgeSource"
          },
          "title": "Sources",
          "type": "array"
        },
        "src": {
          "minLength": 1,
          "title": "Src",
          "type": "string"
        },
        "unsupported_by_evidence": {
          "default": false,
          "title": "Unsupported By Evidence",
          "type": "boolean"
        }
      },
      "required": [
        "src",
        "dst"
      ],
      "title": "CausalEdge",
      "type": "object"
    },
    "CausalGraphModel": {
      "additionalProperties": false,
      "description": "DAG / CPDAG / PAG / MGRAPH / ADMG causal graph IR contract.",
      "properties": {
        "discovery_method": {
          "default": "",
          "title": "Discovery Method",
          "type": "string"
        },
        "edges": {
          "items": {
            "$ref": "#/$defs/CausalEdge"
          },
          "title": "Edges",
          "type": "array"
        },
        "graph_type": {
          "$ref": "#/$defs/GraphType"
        },
        "id_confidence_under_pag": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Id Confidence Under Pag"
        },
        "metadata": {
          "additionalProperties": true,
          "title": "Metadata",
          "type": "object"
        },
        "nodes": {
          "items": {
            "type": "string"
          },
          "title": "Nodes",
          "type": "array"
        },
        "pag_identification_policy": {
          "$ref": "#/$defs/PAGIdentificationPolicy",
          "default": "conservative"
        },
        "schema_version": {
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "skg_version_id": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Skg Version Id"
        }
      },
      "required": [
        "graph_type",
        "nodes",
        "edges"
      ],
      "title": "CausalGraphModel",
      "type": "object"
    },
    "ConstraintEvaluationResult": {
      "additionalProperties": false,
      "description": "Store the test outcome for one implied or user-declared algebraic constraint.",
      "properties": {
        "adjusted_p_value": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Adjusted P Value"
        },
        "constraint_id": {
          "minLength": 1,
          "title": "Constraint Id",
          "type": "string"
        },
        "family": {
          "$ref": "#/$defs/AlgebraicConstraintFamily"
        },
        "metadata": {
          "additionalProperties": true,
          "title": "Metadata",
          "type": "object"
        },
        "p_value": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "P Value"
        },
        "severity": {
          "default": "info",
          "enum": [
            "info",
            "warning",
            "blocker"
          ],
          "title": "Severity",
          "type": "string"
        },
        "statistic": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Statistic"
        },
        "status": {
          "enum": [
            "passed",
            "violated",
            "skipped",
            "error",
            "unsupported"
          ],
          "title": "Status",
          "type": "string"
        },
        "warnings": {
          "items": {
            "type": "string"
          },
          "title": "Warnings",
          "type": "array"
        }
      },
      "required": [
        "constraint_id",
        "family",
        "status"
      ],
      "title": "ConstraintEvaluationResult",
      "type": "object"
    },
    "EdgeMark": {
      "description": "Edge mark public type.",
      "enum": [
        "tail",
        "arrow",
        "circle"
      ],
      "title": "EdgeMark",
      "type": "string"
    },
    "EdgeSource": {
      "description": "Edge source public type.",
      "enum": [
        "data",
        "literature",
        "llm_prior",
        "expert",
        "simulation"
      ],
      "title": "EdgeSource",
      "type": "string"
    },
    "GraphType": {
      "description": "Graph type public type.",
      "enum": [
        "dag",
        "cpdag",
        "pag",
        "mgraph",
        "admg"
      ],
      "title": "GraphType",
      "type": "string"
    },
    "ImpliedConstraintSpec": {
      "additionalProperties": false,
      "description": "Represent one graph-implied constraint and its optional conditioning set.",
      "properties": {
        "conditioning_set": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Conditioning Set",
          "type": "array"
        },
        "constraint_id": {
          "minLength": 1,
          "title": "Constraint Id",
          "type": "string"
        },
        "family": {
          "$ref": "#/$defs/AlgebraicConstraintFamily"
        },
        "metadata": {
          "additionalProperties": true,
          "title": "Metadata",
          "type": "object"
        },
        "source_block_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Block Id"
        },
        "statement": {
          "minLength": 1,
          "title": "Statement",
          "type": "string"
        },
        "variables": {
          "items": {
            "type": "string"
          },
          "title": "Variables",
          "type": "array"
        }
      },
      "required": [
        "constraint_id",
        "family",
        "statement",
        "variables"
      ],
      "title": "ImpliedConstraintSpec",
      "type": "object"
    },
    "LatentAssumptionCard": {
      "additionalProperties": false,
      "description": "Document one latent-variable assumption and its falsification hook.",
      "properties": {
        "assumption_id": {
          "minLength": 1,
          "title": "Assumption Id",
          "type": "string"
        },
        "description": {
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "evidence_basis": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Basis",
          "type": "array"
        },
        "falsification_hook": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Falsification Hook"
        },
        "metadata": {
          "additionalProperties": true,
          "title": "Metadata",
          "type": "object"
        },
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "assumption_id",
        "title",
        "description"
      ],
      "title": "LatentAssumptionCard",
      "type": "object"
    },
    "LatentDiscoveryBundle": {
      "additionalProperties": false,
      "description": "Disclose proposed latent nodes, test hooks, and promotion limits.",
      "properties": {
        "assumption_cards": {
          "items": {
            "$ref": "#/$defs/LatentAssumptionCard"
          },
          "title": "Assumption Cards",
          "type": "array"
        },
        "falsification_tests": {
          "items": {
            "type": "string"
          },
          "title": "Falsification Tests",
          "type": "array"
        },
        "human_gate_required": {
          "default": true,
          "title": "Human Gate Required",
          "type": "boolean"
        },
        "identification_conditions": {
          "items": {
            "type": "string"
          },
          "title": "Identification Conditions",
          "type": "array"
        },
        "inducing_environments": {
          "items": {
            "type": "string"
          },
          "title": "Inducing Environments",
          "type": "array"
        },
        "metadata": {
          "additionalProperties": true,
          "title": "Metadata",
          "type": "object"
        },
        "no_promotion_reasons": {
          "items": {
            "type": "string"
          },
          "title": "No Promotion Reasons",
          "type": "array"
        },
        "not_for_decision_support": {
          "default": true,
          "title": "Not For Decision Support",
          "type": "boolean"
        },
        "promotion_allowed": {
          "default": false,
          "title": "Promotion Allowed",
          "type": "boolean"
        },
        "proposed_latent_nodes": {
          "items": {
            "type": "string"
          },
          "title": "Proposed Latent Nodes",
          "type": "array"
        },
        "readiness_cap": {
          "const": "proof_only",
          "default": "proof_only",
          "title": "Readiness Cap",
          "type": "string"
        },
        "trust_level": {
          "$ref": "#/$defs/LatentTrustLevel",
          "default": "research"
        }
      },
      "title": "LatentDiscoveryBundle",
      "type": "object"
    },
    "LatentTrustLevel": {
      "description": "Declare whether a proposed latent structure is research-only, conditional, or validated.",
      "enum": [
        "research",
        "conditional",
        "validated"
      ],
      "title": "LatentTrustLevel",
      "type": "string"
    },
    "PAGIdentificationPolicy": {
      "description": "PAG identification policy data model.",
      "enum": [
        "conservative",
        "optimistic",
        "probabilistic"
      ],
      "title": "PAGIdentificationPolicy",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Output of a causal-discovery run, including optional latent diagnostics.",
  "properties": {
    "algebraic_constraints": {
      "anyOf": [
        {
          "$ref": "#/$defs/AlgebraicConstraintReport"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "bootstrap_stability": {
      "additionalProperties": {
        "type": "number"
      },
      "title": "Bootstrap Stability",
      "type": "object"
    },
    "computation_time_seconds": {
      "default": 0.0,
      "minimum": 0.0,
      "title": "Computation Time Seconds",
      "type": "number"
    },
    "graph": {
      "$ref": "#/$defs/CausalGraphModel"
    },
    "latent_discovery": {
      "anyOf": [
        {
          "$ref": "#/$defs/LatentDiscoveryBundle"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "metadata": {
      "additionalProperties": true,
      "title": "Metadata",
      "type": "object"
    },
    "method": {
      "title": "Method",
      "type": "string"
    },
    "n_bootstrap": {
      "default": 0,
      "minimum": 0,
      "title": "N Bootstrap",
      "type": "integer"
    },
    "resolved_graph": {
      "anyOf": [
        {
          "$ref": "#/$defs/CausalGraphModel"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "schema_version": {
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "significance_level": {
      "default": 0.05,
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Significance Level",
      "type": "number"
    },
    "warnings": {
      "items": {
        "type": "string"
      },
      "title": "Warnings",
      "type": "array"
    }
  },
  "required": [
    "method",
    "graph"
  ],
  "title": "CausalDiscoveryReport",
  "type": "object"
}
