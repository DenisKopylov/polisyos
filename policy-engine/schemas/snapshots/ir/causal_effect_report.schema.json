{
  "$defs": {
    "ArtifactID": {
      "description": "IR-local artifact ID model compatible with CAS interfaces.",
      "title": "ArtifactID",
      "type": "string"
    },
    "BoundMethod": {
      "description": "Bound method public type.",
      "enum": [
        "manski_bounds",
        "transport_bounds",
        "dp_robustness_bounds",
        "iv_bounds",
        "monotone_treatment",
        "lp_balke_pearl",
        "imbens_manski_ci",
        "mtr_bounds",
        "miv_bounds",
        "mts_bounds",
        "general_lp_bounds",
        "copula_bounds",
        "tan_bounds",
        "intersection_bounds",
        "rosenbaum_sharp"
      ],
      "title": "BoundMethod",
      "type": "string"
    },
    "BoundSoundnessLevel": {
      "description": "Soundness tier for one bounds result.",
      "enum": [
        "CERTIFIED",
        "ASSUMPTION_ONLY",
        "HEURISTIC"
      ],
      "title": "BoundSoundnessLevel",
      "type": "string"
    },
    "BoundsTighteningLogRef": {
      "additionalProperties": false,
      "description": "Stable handle for certified bounds-tightening search logs.",
      "properties": {
        "artifact_id": {
          "$ref": "#/$defs/ArtifactID"
        },
        "kind": {
          "const": "ir.bounds_tightening_log",
          "default": "ir.bounds_tightening_log",
          "title": "Kind",
          "type": "string"
        },
        "media_type": {
          "const": "application/json",
          "default": "application/json",
          "title": "Media Type",
          "type": "string"
        }
      },
      "required": [
        "artifact_id"
      ],
      "title": "BoundsTighteningLogRef",
      "type": "object"
    },
    "CausalMethod": {
      "description": "Declare which estimator family produced a ``CausalEffectReport``.\n\nReporting, diagnostics, and uncertainty conversion use this enum to explain\nestimator provenance and to select method-specific governance checks.",
      "enum": [
        "synthetic_control",
        "difference_in_differences",
        "regression_discontinuity",
        "structural_time_series",
        "dowhy_backdoor",
        "dowhy_iv",
        "dowhy_frontdoor",
        "proximal_bridge",
        "distributional_treatment_effect",
        "endogenous_group_inequality_decomposition",
        "kernel_cme",
        "kernel_frontdoor",
        "kernel_transport",
        "kernel_dr_cme",
        "kernel_iv",
        "kernel_proximal_minimax",
        "interference_cate",
        "causal_forest",
        "forest_dr",
        "causal_bcf",
        "double_ml",
        "s_learner",
        "t_learner",
        "x_learner",
        "policy_tree",
        "g_computation",
        "ice_g_formula",
        "ltmle",
        "g_estimation",
        "q_learning_dtr",
        "a_learning_dtr",
        "outcome_weighted_learning",
        "doubly_robust_dtr",
        "off_policy_evaluation",
        "causal_bandit"
      ],
      "title": "CausalMethod",
      "type": "string"
    },
    "DataGap": {
      "additionalProperties": false,
      "description": "Data gap public type.",
      "properties": {
        "available_proxies": {
          "items": {
            "$ref": "#/$defs/ProxyCandidate"
          },
          "title": "Available Proxies",
          "type": "array"
        },
        "best_proxy_confidence": {
          "default": 0.0,
          "title": "Best Proxy Confidence",
          "type": "number"
        },
        "gap_impact": {
          "title": "Gap Impact",
          "type": "string"
        },
        "required_context": {
          "title": "Required Context",
          "type": "string"
        },
        "required_variable": {
          "title": "Required Variable",
          "type": "string"
        },
        "suggested_action": {
          "title": "Suggested Action",
          "type": "string"
        }
      },
      "required": [
        "required_variable",
        "required_context",
        "gap_impact",
        "suggested_action"
      ],
      "title": "DataGap",
      "type": "object"
    },
    "DiagnosticTest": {
      "additionalProperties": false,
      "description": "Named diagnostic emitted alongside a causal estimate.",
      "properties": {
        "details": {
          "additionalProperties": true,
          "title": "Details",
          "type": "object"
        },
        "p_value": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "P Value"
        },
        "passed": {
          "title": "Passed",
          "type": "boolean"
        },
        "statistic": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Statistic"
        },
        "test_name": {
          "title": "Test Name",
          "type": "string"
        }
      },
      "required": [
        "test_name",
        "passed"
      ],
      "title": "DiagnosticTest",
      "type": "object"
    },
    "DistributionType": {
      "description": "Distribution type public type.",
      "enum": [
        "point",
        "empirical",
        "kde",
        "normal",
        "bounded"
      ],
      "title": "DistributionType",
      "type": "string"
    },
    "DualCertificateRef": {
      "additionalProperties": false,
      "description": "Stable handle for persisted LP dual certificates consumed by bounds auditing.",
      "properties": {
        "artifact_id": {
          "$ref": "#/$defs/ArtifactID"
        },
        "kind": {
          "const": "ir.dual_certificate",
          "default": "ir.dual_certificate",
          "title": "Kind",
          "type": "string"
        },
        "media_type": {
          "const": "application/json",
          "default": "application/json",
          "title": "Media Type",
          "type": "string"
        }
      },
      "required": [
        "artifact_id"
      ],
      "title": "DualCertificateRef",
      "type": "object"
    },
    "EstimationStatus": {
      "description": "Report whether a causal run produced decision-grade output or failed a gate.\n\n``CausalEffectReport`` and its uncertainty conversion read this enum to\ndecide whether an estimate is gate-eligible or should emit a non-actionable\nfailure envelope.",
      "enum": [
        "success",
        "input_invalid",
        "assumption_failed",
        "numerical_failure"
      ],
      "title": "EstimationStatus",
      "type": "string"
    },
    "PAGIdentificationPolicy": {
      "description": "PAG identification policy data model.",
      "enum": [
        "conservative",
        "optimistic",
        "probabilistic"
      ],
      "title": "PAGIdentificationPolicy",
      "type": "string"
    },
    "PStarZResult": {
      "additionalProperties": false,
      "description": "Computed P*(Z) (or P*(Z|X)) value with provenance.",
      "properties": {
        "canonical_variable": {
          "title": "Canonical Variable",
          "type": "string"
        },
        "ci_high": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ci High"
        },
        "ci_low": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ci Low"
        },
        "condition_on": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Condition On",
          "type": "object"
        },
        "confidence": {
          "default": 0.0,
          "title": "Confidence",
          "type": "number"
        },
        "data_support_country": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Data Support Country"
        },
        "data_support_year": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Data Support Year"
        },
        "dataset_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Dataset Id"
        },
        "distribution": {
          "anyOf": [
            {
              "items": {
                "type": "number"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Distribution"
        },
        "distribution_type": {
          "$ref": "#/$defs/DistributionType",
          "default": "point"
        },
        "imputation_method": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Imputation Method"
        },
        "imputation_penalty": {
          "default": 0.0,
          "title": "Imputation Penalty",
          "type": "number"
        },
        "is_conditional": {
          "default": false,
          "title": "Is Conditional",
          "type": "boolean"
        },
        "is_proxy": {
          "default": false,
          "title": "Is Proxy",
          "type": "boolean"
        },
        "penalty_breakdown": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Penalty Breakdown",
          "type": "object"
        },
        "proxy_chain": {
          "items": {
            "type": "string"
          },
          "title": "Proxy Chain",
          "type": "array"
        },
        "raw_variable": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Raw Variable"
        },
        "std_error": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Std Error"
        },
        "uncertainty_sources": {
          "items": {
            "type": "string"
          },
          "title": "Uncertainty Sources",
          "type": "array"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Value"
        }
      },
      "required": [
        "canonical_variable",
        "value",
        "dataset_id",
        "raw_variable"
      ],
      "title": "PStarZResult",
      "type": "object"
    },
    "PartialIdentificationResult": {
      "additionalProperties": false,
      "description": "Result of partial identification analysis (e.g., Manski bounds on ATE).",
      "properties": {
        "assumptions_used": {
          "items": {
            "type": "string"
          },
          "title": "Assumptions Used",
          "type": "array"
        },
        "assumptions_violated": {
          "items": {
            "type": "string"
          },
          "title": "Assumptions Violated",
          "type": "array"
        },
        "bound_width": {
          "default": 0.0,
          "title": "Bound Width",
          "type": "number"
        },
        "bounds_type": {
          "default": "manski",
          "enum": [
            "sharp_lp",
            "relaxed_polynomial",
            "manski"
          ],
          "title": "Bounds Type",
          "type": "string"
        },
        "certificate_kind": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Certificate Kind"
        },
        "certificate_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/DualCertificateRef"
            },
            {
              "$ref": "#/$defs/BoundsTighteningLogRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Certificate Ref"
        },
        "chart_type": {
          "default": "interval",
          "title": "Chart Type",
          "type": "string"
        },
        "confidence": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Confidence",
          "type": "number"
        },
        "discretization_converged": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Discretization Converged"
        },
        "discretization_method": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Discretization Method"
        },
        "display_label": {
          "default": "",
          "title": "Display Label",
          "type": "string"
        },
        "informativeness_threshold": {
          "default": 0.5,
          "title": "Informativeness Threshold",
          "type": "number"
        },
        "is_informative": {
          "default": true,
          "title": "Is Informative",
          "type": "boolean"
        },
        "lower_bound": {
          "title": "Lower Bound",
          "type": "number"
        },
        "method": {
          "$ref": "#/$defs/BoundMethod"
        },
        "n_bins_final": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "N Bins Final"
        },
        "n_refinement_steps": {
          "default": 0,
          "minimum": 0,
          "title": "N Refinement Steps",
          "type": "integer"
        },
        "relaxation_gap": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Relaxation Gap"
        },
        "schema_version": {
          "default": "1.0",
          "pattern": "^\\d+\\.\\d+$",
          "title": "Schema Version",
          "type": "string"
        },
        "solver_metadata": {
          "additionalProperties": true,
          "title": "Solver Metadata",
          "type": "object"
        },
        "soundness_level": {
          "anyOf": [
            {
              "$ref": "#/$defs/BoundSoundnessLevel"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "upper_bound": {
          "title": "Upper Bound",
          "type": "number"
        }
      },
      "required": [
        "method",
        "lower_bound",
        "upper_bound",
        "confidence"
      ],
      "title": "PartialIdentificationResult",
      "type": "object"
    },
    "PlaceboResult": {
      "additionalProperties": false,
      "description": "Per-unit placebo diagnostic for synthetic-control style methods.",
      "properties": {
        "effect_estimate": {
          "title": "Effect Estimate",
          "type": "number"
        },
        "rmspe_post": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rmspe Post"
        },
        "rmspe_pre": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rmspe Pre"
        },
        "rmspe_ratio": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rmspe Ratio"
        },
        "unit_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            }
          ],
          "title": "Unit Id"
        }
      },
      "required": [
        "unit_id",
        "effect_estimate"
      ],
      "title": "PlaceboResult",
      "type": "object"
    },
    "ProxyCandidate": {
      "additionalProperties": false,
      "description": "Single proxy variable candidate for a missing target variable.",
      "properties": {
        "base_correlation": {
          "title": "Base Correlation",
          "type": "number"
        },
        "context_adjustment": {
          "title": "Context Adjustment",
          "type": "number"
        },
        "effective_confidence": {
          "title": "Effective Confidence",
          "type": "number"
        },
        "proxy_dataset_id": {
          "title": "Proxy Dataset Id",
          "type": "string"
        },
        "proxy_raw_name": {
          "title": "Proxy Raw Name",
          "type": "string"
        },
        "proxy_variable": {
          "title": "Proxy Variable",
          "type": "string"
        },
        "source": {
          "enum": [
            "meta_analysis",
            "seed_table",
            "skg_correlation"
          ],
          "title": "Source",
          "type": "string"
        }
      },
      "required": [
        "proxy_variable",
        "proxy_dataset_id",
        "proxy_raw_name",
        "base_correlation",
        "context_adjustment",
        "effective_confidence",
        "source"
      ],
      "title": "ProxyCandidate",
      "type": "object"
    },
    "RefutationResult": {
      "additionalProperties": false,
      "description": "Outcome of a single causal refutation or robustness check.",
      "properties": {
        "details": {
          "additionalProperties": true,
          "title": "Details",
          "type": "object"
        },
        "effect_ratio": {
          "title": "Effect Ratio",
          "type": "number"
        },
        "original_estimate": {
          "title": "Original Estimate",
          "type": "number"
        },
        "p_value": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "P Value"
        },
        "passed": {
          "title": "Passed",
          "type": "boolean"
        },
        "refuted_estimate": {
          "title": "Refuted Estimate",
          "type": "number"
        },
        "test_type": {
          "$ref": "#/$defs/RefutationTestType"
        }
      },
      "required": [
        "test_type",
        "original_estimate",
        "refuted_estimate",
        "passed",
        "effect_ratio"
      ],
      "title": "RefutationResult",
      "type": "object"
    },
    "RefutationTestType": {
      "description": "Identify which robustness/refutation check generated a diagnostic result.",
      "enum": [
        "placebo_treatment",
        "random_common_cause",
        "data_subset",
        "bootstrap",
        "unobserved_common_cause"
      ],
      "title": "RefutationTestType",
      "type": "string"
    },
    "SNode": {
      "additionalProperties": false,
      "description": "S node implementation.",
      "properties": {
        "context_dimension": {
          "title": "Context Dimension",
          "type": "string"
        },
        "delta": {
          "title": "Delta",
          "type": "number"
        },
        "legal_constraint_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Legal Constraint Id"
        },
        "origin": {
          "$ref": "#/$defs/SNodeOrigin",
          "default": "context_delta"
        },
        "role": {
          "anyOf": [
            {
              "$ref": "#/$defs/SNodeRole"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "severity": {
          "enum": [
            "low",
            "medium",
            "high"
          ],
          "title": "Severity",
          "type": "string"
        },
        "source_value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "string"
            }
          ],
          "title": "Source Value"
        },
        "target_value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "string"
            }
          ],
          "title": "Target Value"
        },
        "target_variable": {
          "title": "Target Variable",
          "type": "string"
        }
      },
      "required": [
        "target_variable",
        "context_dimension",
        "source_value",
        "target_value",
        "delta",
        "severity"
      ],
      "title": "SNode",
      "type": "object"
    },
    "SNodeOrigin": {
      "description": "Classify why a selection node appears in a transportability diagram.",
      "enum": [
        "context_delta",
        "legal",
        "data_mismatch",
        "privacy"
      ],
      "title": "SNodeOrigin",
      "type": "string"
    },
    "SNodeRole": {
      "description": "Declare the causal role used when deciding whether an S-node is adjustable.",
      "enum": [
        "pre_treatment_covariate",
        "mediator",
        "collider",
        "instrument"
      ],
      "title": "SNodeRole",
      "type": "string"
    },
    "StratificationVariable": {
      "additionalProperties": false,
      "description": "Stratification variable public type.",
      "properties": {
        "condition_on_treatment": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Condition On Treatment"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "requires_conditional": {
          "title": "Requires Conditional",
          "type": "boolean"
        },
        "role": {
          "$ref": "#/$defs/SNodeRole"
        }
      },
      "required": [
        "name",
        "role",
        "requires_conditional"
      ],
      "title": "StratificationVariable",
      "type": "object"
    },
    "TransportFormula": {
      "additionalProperties": false,
      "description": "Transport formula public type.",
      "properties": {
        "adjustment_type": {
          "default": "direct",
          "title": "Adjustment Type",
          "type": "string"
        },
        "formula_str": {
          "title": "Formula Str",
          "type": "string"
        },
        "source_quantities": {
          "items": {
            "type": "string"
          },
          "title": "Source Quantities",
          "type": "array"
        },
        "stratification_details": {
          "items": {
            "$ref": "#/$defs/StratificationVariable"
          },
          "title": "Stratification Details",
          "type": "array"
        },
        "stratification_variables": {
          "items": {
            "type": "string"
          },
          "title": "Stratification Variables",
          "type": "array"
        },
        "target_quantities": {
          "items": {
            "type": "string"
          },
          "title": "Target Quantities",
          "type": "array"
        }
      },
      "required": [
        "formula_str"
      ],
      "title": "TransportFormula",
      "type": "object"
    },
    "TransportMode": {
      "description": "Describe the execution path implied by a ``TransportabilityResult``.",
      "enum": [
        "direct",
        "transport_formula",
        "bounds_only",
        "none"
      ],
      "title": "TransportMode",
      "type": "string"
    },
    "TransportabilityResult": {
      "additionalProperties": false,
      "description": "Persist the transportability decision, formula, and fallback diagnostics.\n\nReadiness gates and reporting layers inspect ``status`` and\n``transport_mode`` to decide whether a query can be transported directly,\nrequires a transport formula, falls back to bounds, or is unsupported. The\nmodel also upgrades legacy payload aliases so older persisted artifacts can\nstill be read during migration. Normalization happens before instance\ncreation so validated models no longer rewrite their own fields.",
      "properties": {
        "algorithm_version": {
          "default": "trso_v2",
          "title": "Algorithm Version",
          "type": "string"
        },
        "assumes_time_stationarity": {
