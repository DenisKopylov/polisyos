{
  "$defs": {
    "CausalContrastSpec": {
      "additionalProperties": false,
      "description": "Typed target/comparator arms for an attribution query.\n\nThe target is deliberately an :class:`InterventionSpec`, making an\ninterventional target impossible to confuse with an observational regime.\nThe comparator remains a tagged regime because observational and explicit\ninterventional baselines have materially different semantics.",
      "properties": {
        "comparator": {
          "$ref": "#/$defs/CausalRegime"
        },
        "target": {
          "$ref": "#/$defs/InterventionSpec"
        }
      },
      "required": [
        "target",
        "comparator"
      ],
      "title": "CausalContrastSpec",
      "type": "object"
    },
    "CausalEstimatorInterval": {
      "additionalProperties": false,
      "description": "An iid-unit bootstrap interval from refitted replicate estimators.\n\nThe record describes sampling inference under its declared iid/model scope.\nSource custody, graph identification and domain authority remain separate.",
      "properties": {
        "confidence_level": {
          "default": 0.95,
          "exclusiveMaximum": 1.0,
          "exclusiveMinimum": 0.0,
          "title": "Confidence Level",
          "type": "number"
        },
        "coverage_profile": {
          "const": "approximate_iid_percentile_fixed_identified_graph",
          "default": "approximate_iid_percentile_fixed_identified_graph",
          "title": "Coverage Profile",
          "type": "string"
        },
        "data_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Data Sha256",
          "type": "string"
        },
        "fit_profile": {
          "minLength": 1,
          "title": "Fit Profile",
          "type": "string"
        },
        "fit_request_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Fit Request Sha256",
          "type": "string"
        },
        "graph_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Graph Sha256",
          "type": "string"
        },
        "interval": {
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Interval",
          "type": "array"
        },
        "method": {
          "const": "iid_unit_refit_bootstrap",
          "default": "iid_unit_refit_bootstrap",
          "title": "Method",
          "type": "string"
        },
        "n_units": {
          "minimum": 2,
          "title": "N Units",
          "type": "integer"
        },
        "point_estimate": {
          "title": "Point Estimate",
          "type": "number"
        },
        "refit_scope": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Refit Scope",
          "type": "array"
        },
        "refit_worker_response": {
          "additionalProperties": true,
          "title": "Refit Worker Response",
          "type": "object"
        },
        "replicate_count": {
          "minimum": 2,
          "title": "Replicate Count",
          "type": "integer"
        },
        "replicate_estimates": {
          "items": {
            "type": "number"
          },
          "title": "Replicate Estimates",
          "type": "array"
        },
        "resample_indices_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Resample Indices Sha256",
          "type": "string"
        },
        "resampling_unit": {
          "const": "iid_observation_row",
          "default": "iid_observation_row",
          "title": "Resampling Unit",
          "type": "string"
        },
        "result_kind": {
          "const": "estimator_confidence_interval",
          "default": "estimator_confidence_interval",
          "title": "Result Kind",
          "type": "string"
        },
        "row_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Row Sha256",
          "type": "string"
        },
        "seed": {
          "title": "Seed",
          "type": "integer"
        },
        "source_artifact_id": {
          "minLength": 1,
          "title": "Source Artifact Id",
          "type": "string"
        },
        "source_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Source Sha256",
          "type": "string"
        },
        "target_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Target Sha256",
          "type": "string"
        }
      },
      "required": [
        "point_estimate",
        "interval",
        "source_artifact_id",
        "source_sha256",
        "data_sha256",
        "row_sha256",
        "graph_sha256",
        "resample_indices_sha256",
        "target_sha256",
        "n_units",
        "replicate_count",
        "seed",
        "refit_scope",
        "fit_profile",
        "fit_request_sha256",
        "refit_worker_response",
        "replicate_estimates"
      ],
      "title": "CausalEstimatorInterval",
      "type": "object"
    },
    "CausalQuery": {
      "additionalProperties": false,
      "description": "Fully specified causal query contract for execution or persistence.",
      "properties": {
        "condition": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Condition",
          "type": "object"
        },
        "contrast": {
          "anyOf": [
            {
              "$ref": "#/$defs/CausalContrastSpec"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "intervention_spec": {
          "anyOf": [
            {
              "$ref": "#/$defs/InterventionSpec"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "n_samples": {
          "default": 1000,
          "minimum": 1,
          "title": "N Samples",
          "type": "integer"
        },
        "outcome_variable": {
          "title": "Outcome Variable",
          "type": "string"
        },
        "query_type": {
          "$ref": "#/$defs/QueryType"
        },
        "treatment_value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Treatment Value"
        },
        "treatment_variable": {
          "title": "Treatment Variable",
          "type": "string"
        }
      },
      "required": [
        "query_type",
        "treatment_variable",
        "outcome_variable"
      ],
      "title": "CausalQuery",
      "type": "object"
    },
    "CausalRegime": {
      "additionalProperties": false,
      "description": "Describe an attribution comparator without conflating observation and intervention.",
      "properties": {
        "intervention": {
          "anyOf": [
            {
              "$ref": "#/$defs/InterventionSpec"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "kind": {
          "enum": [
            "observational",
            "interventional"
          ],
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "kind"
      ],
      "title": "CausalRegime",
      "type": "object"
    },
    "CausalResultKind": {
      "description": "Meaning of draws from a fixed SCM, distinct from estimator sampling.",
      "enum": [
        "outcome_distribution",
        "ite_distribution",
        "posterior_credible_interval"
      ],
      "title": "CausalResultKind",
      "type": "string"
    },
    "InterventionSpec": {
      "additionalProperties": false,
      "description": "Treatment perturbation attached to a causal query.",
      "properties": {
        "bounds": {
          "anyOf": [
            {
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Bounds"
        },
        "distribution": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Distribution"
        },
        "legal_constraint_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Legal Constraint Id"
        },
        "shift": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Shift"
        },
        "type": {
          "$ref": "#/$defs/InterventionType",
          "default": "atomic"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        }
      },
      "title": "InterventionSpec",
      "type": "object"
    },
    "InterventionType": {
      "description": "Mechanics of the treatment perturbation encoded in a query.",
      "enum": [
        "atomic",
        "truncated",
        "shifted",
        "stochastic"
      ],
      "title": "InterventionType",
      "type": "string"
    },
    "QueryType": {
      "description": "High-level family of causal query requested from the engine.",
      "enum": [
        "interventional",
        "counterfactual",
        "attribution",
        "soft_intervention"
      ],
      "title": "QueryType",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Result payload returned for a persisted or in-memory causal query.",
  "properties": {
    "computation_time_seconds": {
      "default": 0.0,
      "minimum": 0.0,
      "title": "Computation Time Seconds",
      "type": "number"
    },
    "estimator_interval": {
      "anyOf": [
        {
          "$ref": "#/$defs/CausalEstimatorInterval"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "interval_level": {
      "default": 0.95,
      "exclusiveMaximum": 1.0,
      "exclusiveMinimum": 0.0,
      "title": "Interval Level",
      "type": "number"
    },
    "metadata": {
      "additionalProperties": true,
      "title": "Metadata",
      "type": "object"
    },
    "query": {
      "$ref": "#/$defs/CausalQuery"
    },
    "result_ci": {
      "maxItems": 2,
      "minItems": 2,
      "prefixItems": [
        {
          "type": "number"
        },
        {
          "type": "number"
        }
      ],
      "title": "Result Ci",
      "type": "array"
    },
    "result_distribution": {
      "anyOf": [
        {
          "items": {
            "type": "number"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Result Distribution"
    },
    "result_kind": {
      "$ref": "#/$defs/CausalResultKind",
      "default": "outcome_distribution"
    },
    "result_mean": {
      "title": "Result Mean",
      "type": "number"
    },
    "result_std": {
      "minimum": 0.0,
      "title": "Result Std",
      "type": "number"
    },
    "schema_version": {
      "default": "1.2",
      "pattern": "^\\d+\\.\\d+$",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "query",
    "result_mean",
    "result_std",
    "result_ci"
  ],
  "title": "CausalQueryResult",
  "type": "object"
}
