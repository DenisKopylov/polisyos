{
  "$defs": {
    "ConflictResolutionCandidate": {
      "additionalProperties": false,
      "properties": {
        "claim_id": {
          "pattern": "^[a-z][a-z0-9_.-]*$",
          "title": "Claim Id",
          "type": "string"
        },
        "score_breakdown": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Score Breakdown",
          "type": "object"
        },
        "score_total": {
          "pattern": "^-?\\d+(?:\\.\\d+)?$",
          "title": "Score Total",
          "type": "string"
        }
      },
      "required": [
        "claim_id",
        "score_total"
      ],
      "title": "ConflictResolutionCandidate",
      "type": "object"
    },
    "ConflictResolutionInputs": {
      "additionalProperties": false,
      "properties": {
        "claim_ids": {
          "items": {
            "pattern": "^[a-z][a-z0-9_.-]*$",
            "type": "string"
          },
          "title": "Claim Ids",
          "type": "array"
        },
        "doc_version_ids": {
          "items": {
            "pattern": "^[a-z][a-z0-9_.-]*$",
            "type": "string"
          },
          "title": "Doc Version Ids",
          "type": "array"
        },
        "trust_assessment_ids": {
          "items": {
            "pattern": "^[a-z][a-z0-9_.-]*$",
            "type": "string"
          },
          "title": "Trust Assessment Ids",
          "type": "array"
        }
      },
      "title": "ConflictResolutionInputs",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "algorithm_version": {
      "title": "Algorithm Version",
      "type": "string"
    },
    "candidates": {
      "items": {
        "$ref": "#/$defs/ConflictResolutionCandidate"
      },
      "minItems": 1,
      "title": "Candidates",
      "type": "array"
    },
    "conflict_set_id": {
      "pattern": "^[a-z][a-z0-9_.-]*$",
      "title": "Conflict Set Id",
      "type": "string"
    },
    "inputs": {
      "$ref": "#/$defs/ConflictResolutionInputs"
    },
    "notes": {
      "items": {
        "type": "string"
      },
      "title": "Notes",
      "type": "array"
    },
    "policy_id": {
      "pattern": "^[a-z][a-z0-9_.-]*$",
      "title": "Policy Id",
      "type": "string"
    },
    "schema_version": {
      "default": "1.0",
      "pattern": "^\\d+\\.\\d+$",
      "title": "Schema Version",
      "type": "string"
    },
    "tie_break_rule": {
      "const": "lexicographic_claim_id",
      "default": "lexicographic_claim_id",
      "title": "Tie Break Rule",
      "type": "string"
    },
    "winner_claim_id": {
      "pattern": "^[a-z][a-z0-9_.-]*$",
      "title": "Winner Claim Id",
      "type": "string"
    }
  },
  "required": [
    "conflict_set_id",
    "policy_id",
    "algorithm_version",
    "candidates",
    "winner_claim_id",
    "inputs"
  ],
  "title": "ConflictResolution",
  "type": "object"
}
