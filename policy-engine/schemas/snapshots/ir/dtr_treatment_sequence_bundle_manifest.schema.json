{
  "$defs": {
    "BundleAxisSemantic": {
      "additionalProperties": false,
      "description": "Human-readable meaning attached to one bundle axis.",
      "properties": {
        "axis": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Axis",
          "type": "string"
        },
        "description": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Description",
          "type": "string"
        }
      },
      "required": [
        "axis",
        "description"
      ],
      "title": "BundleAxisSemantic",
      "type": "object"
    },
    "BundleLineageRef": {
      "additionalProperties": false,
      "description": "Lineage edge from a bundle back to an upstream observation artifact.",
      "properties": {
        "notes": {
          "items": {
            "type": "string"
          },
          "title": "Notes",
          "type": "array"
        },
        "source_artifact": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Source Artifact",
          "type": "string"
        },
        "source_confidence_tier": {
          "$ref": "#/$defs/SourceConfidenceTier",
          "default": "validated"
        },
        "source_family": {
          "anyOf": [
            {
              "$ref": "#/$defs/ObservationFamily"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "source_artifact"
      ],
      "title": "BundleLineageRef",
      "type": "object"
    },
    "ContractCompatibilityTarget": {
      "additionalProperties": false,
      "description": "Identifier of a downstream contract that an observation bundle targets.",
      "properties": {
        "contract_fqn": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Contract Fqn",
          "type": "string"
        },
        "contract_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Contract Id",
          "type": "string"
        }
      },
      "required": [
        "contract_id",
        "contract_fqn"
      ],
      "title": "ContractCompatibilityTarget",
      "type": "object"
    },
    "ObservationFamily": {
      "description": "Classify raw evidence into stable observation families for routing.\n\nFamilies partition raw evidence into domains such as budget flows, firm\nfundamentals, or household distribution so measurement rules, governance\ndefaults, and contract compilers can branch on a stable domain label.",
      "enum": [
        "budget_flows",
        "procurement_flows",
        "macro_state",
        "firm_fundamentals",
        "trade_exposure",
        "labor_market",
        "household_distribution",
        "distress_enforcement",
        "spatial_raster_exogenous",
        "public_service_domain_flows",
        "education_human_capital_supply",
        "construction_capital_formation",
        "logistics_friction"
      ],
      "title": "ObservationFamily",
      "type": "string"
    },
    "RequiredArraySpec": {
      "additionalProperties": false,
      "description": "Manifest entry describing a required dense array payload.",
      "properties": {
        "axes": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Axes",
          "type": "array"
        },
        "description": {
          "anyOf": [
            {
              "maxLength": 255,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "dtype": {
          "anyOf": [
            {
              "maxLength": 64,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Dtype"
        },
        "name": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "required": {
          "default": true,
          "title": "Required",
          "type": "boolean"
        }
      },
      "required": [
        "name",
        "axes"
      ],
      "title": "RequiredArraySpec",
      "type": "object"
    },
    "SourceConfidenceTier": {
      "description": "Declare the raw provenance tier consumed by measurement trust normalization.\n\n:class:`polisyos.ir.observation.measurement.MeasurementRegistry` maps this\nsource-side tier and coverage metadata into a ``MeasurementTrustTier`` used\nby calibration losses and readiness routing.",
      "enum": [
        "core",
        "validated",
        "exploratory"
      ],
      "title": "SourceConfidenceTier",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Describe the tensor payload required by sequential/DTR estimators.\n\n``TemporalDTRTask`` may reference this manifest directly, so axis semantics\nand required-array declarations must be complete enough for deterministic\nreconstruction of treatment, covariate, and outcome tensors.",
  "properties": {
    "artifact_name": {
      "const": "dtr_treatment_sequence_bundle_v1.npz",
      "default": "dtr_treatment_sequence_bundle_v1.npz",
      "title": "Artifact Name",
      "type": "string"
    },
    "axis_semantics": {
      "items": {
        "$ref": "#/$defs/BundleAxisSemantic"
      },
      "minItems": 1,
      "title": "Axis Semantics",
      "type": "array"
    },
    "contract_payload": {
      "additionalProperties": true,
      "title": "Contract Payload",
      "type": "object"
    },
    "contract_target": {
      "$ref": "#/$defs/ContractCompatibilityTarget"
    },
    "lineage": {
      "items": {
        "$ref": "#/$defs/BundleLineageRef"
      },
      "title": "Lineage",
      "type": "array"
    },
    "required_arrays": {
      "items": {
        "$ref": "#/$defs/RequiredArraySpec"
      },
      "minItems": 1,
      "title": "Required Arrays",
      "type": "array"
    },
    "schema_version": {
      "default": "1.0",
      "pattern": "^\\d+\\.\\d+$",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "contract_target",
    "required_arrays",
    "axis_semantics"
  ],
  "title": "DTRTreatmentSequenceBundleManifest",
  "type": "object"
}
