    "FactPIIEntity": {
      "additionalProperties": false,
      "description": "Fact PII entity public type.",
      "properties": {
        "column": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Column"
        },
        "end": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "End"
        },
        "entity_type": {
          "title": "Entity Type",
          "type": "string"
        },
        "redacted_text": {
          "default": "***",
          "title": "Redacted Text",
          "type": "string"
        },
        "score": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
