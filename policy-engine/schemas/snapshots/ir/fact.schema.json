              "type": "null"
            }
          ],
          "default": null,
          "title": "Score"
        },
        "severity": {
          "title": "Severity",
          "type": "string"
        },
        "start": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Start"
        }
      },
      "required": [
        "entity_type",
        "severity"
      ],
      "title": "FactPIIEntity",
      "type": "object"
    },
    "FactProvenance": {
