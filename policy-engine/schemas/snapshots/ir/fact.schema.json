  "additionalProperties": false,
  "description": "Fact public type.",
  "properties": {
    "fact_id": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Fact Id",
      "type": "string"
    },
    "legal": {
      "anyOf": [
        {
          "$ref": "#/$defs/FactLegal"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "object_value": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "integer"
        },
        {
          "type": "boolean"
        },
        {
          "type": "number"
        },
        {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Object Value"
    },
    "predicate_id": {
      "pattern": "^[a-z][a-z0-9_.-]*$",
      "title": "Predicate Id",
      "type": "string"
    },
    "provenance": {
      "$ref": "#/$defs/FactProvenance"
    },
    "schema_version": {
      "default": "1.0",
      "pattern": "^\\d+\\.\\d+$",
      "title": "Schema Version",
      "type": "string"
    },
    "subject_id": {
      "pattern": "^[a-z][a-z0-9_.-]*$",
      "title": "Subject Id",
      "type": "string"
    },
    "target_id": {
      "anyOf": [
        {
          "pattern": "^[a-z][a-z0-9_.-]*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Target Id"
    },
    "trust": {
      "anyOf": [
        {
          "$ref": "#/$defs/FactTrust"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "tx_time": {
      "title": "Tx Time",
      "type": "string"
    },
    "valid_time": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Valid Time"
    }
  },
  "required": [
    "fact_id",
    "subject_id",
    "predicate_id",
    "tx_time",
    "provenance"
  ],
  "title": "Fact",
  "type": "object"
}
