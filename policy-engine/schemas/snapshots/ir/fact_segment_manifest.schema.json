{
  "additionalProperties": false,
  "description": "Fact segment manifest data model.",
  "properties": {
    "duplicate_count": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Duplicate Count"
    },
    "notes": {
      "items": {
        "type": "string"
      },
      "title": "Notes",
      "type": "array"
    },
    "null_count": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Null Count"
    },
    "path": {
      "title": "Path",
      "type": "string"
    },
    "row_count": {
      "title": "Row Count",
      "type": "integer"
    },
    "schema_version": {
      "default": "1.0",
      "pattern": "^\\d+\\.\\d+$",
      "title": "Schema Version",
      "type": "string"
    },
    "segment_id": {
      "pattern": "^[a-z][a-z0-9_.-]*$",
      "title": "Segment Id",
      "type": "string"
    },
    "sha256": {
      "title": "Sha256",
      "type": "string"
    },
    "stats": {
      "additionalProperties": {
        "anyOf": [
          {
            "type": "integer"
          },
          {
            "type": "number"
          },
          {
            "type": "string"
          }
        ]
      },
      "title": "Stats",
      "type": "object"
    },
    "time_end": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Time End"
    },
    "time_start": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Time Start"
    }
  },
  "required": [
    "segment_id",
    "path",
    "row_count",
    "sha256"
  ],
  "title": "FactSegmentManifest",
  "type": "object"
}
