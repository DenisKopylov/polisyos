{
  "$defs": {
    "ArtifactID": {
      "description": "IR-local artifact ID model compatible with CAS interfaces.",
      "title": "ArtifactID",
      "type": "string"
    },
    "ArtifactRefModel": {
      "additionalProperties": false,
      "description": "Provide the common mapping-compatible base contract for artifact refs.",
      "properties": {
        "artifact_id": {
          "$ref": "#/$defs/ArtifactID"
        },
        "kind": {
          "title": "Kind",
          "type": "string"
        },
        "manifest_profile_sha256": {
          "anyOf": [
            {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Manifest Profile Sha256"
        },
        "media_type": {
          "title": "Media Type",
          "type": "string"
        }
      },
      "required": [
        "artifact_id",
        "kind",
        "media_type"
      ],
      "title": "ArtifactRefModel",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Execution and risk context presented to a governance approver.",
  "properties": {
    "artifact_refs": {
      "anyOf": [
        {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Artifact Refs"
    },
    "governance_profile": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Governance Profile"
    },
    "is_escalated": {
      "default": false,
      "title": "Is Escalated",
      "type": "boolean"
    },
    "issue_summary": {
      "anyOf": [
        {
          "additionalProperties": {
            "type": "integer"
          },
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Issue Summary"
    },
    "iteration": {
      "default": 1,
      "minimum": 1,
      "title": "Iteration",
      "type": "integer"
    },
    "node_alias": {
      "title": "Node Alias",
      "type": "string"
    },
    "phase": {
      "title": "Phase",
      "type": "string"
    },
    "policy_summary": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Policy Summary"
    },
    "replay_summary": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Replay Summary"
    },
    "risk_indicators": {
      "items": {
        "type": "string"
      },
      "title": "Risk Indicators",
      "type": "array"
    },
    "selected_replay_refs": {
      "anyOf": [
        {
          "additionalProperties": {
            "$ref": "#/$defs/ArtifactRefModel"
          },
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Selected Replay Refs"
    },
    "simulation_results": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Simulation Results"
    },
    "transport_summary": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Transport Summary"
    },
    "workflow_id": {
      "title": "Workflow Id",
      "type": "string"
    }
  },
  "required": [
    "workflow_id",
    "node_alias",
    "phase"
  ],
  "title": "GateContext",
  "type": "object"
}
