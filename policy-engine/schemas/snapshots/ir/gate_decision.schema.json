{
  "$defs": {
    "GateVerdict": {
      "description": "Final outcome produced by a governance gate.",
      "enum": [
        "approve",
        "reject",
        "escalate",
        "timeout"
      ],
      "title": "GateVerdict",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Recorded gate verdict with approver identity and supporting evidence.",
  "properties": {
    "approver_id": {
      "title": "Approver Id",
      "type": "string"
    },
    "comment": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Comment"
    },
    "decided_at": {
      "format": "date-time",
      "title": "Decided At",
      "type": "string"
    },
    "evidence_refs": {
      "items": {
        "type": "string"
      },
      "title": "Evidence Refs",
      "type": "array"
    },
    "reason_codes": {
      "items": {
        "type": "string"
      },
      "title": "Reason Codes",
      "type": "array"
    },
    "request_id": {
      "title": "Request Id",
      "type": "string"
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "default": "1.0",
      "pattern": "^\\d+\\.\\d+$",
      "title": "Schema Version",
      "type": "string"
    },
    "verdict": {
      "$ref": "#/$defs/GateVerdict"
    }
  },
  "required": [
    "request_id",
    "run_id",
    "verdict",
    "approver_id"
  ],
  "title": "GateDecision",
  "type": "object"
}
