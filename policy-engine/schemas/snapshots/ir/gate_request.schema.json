{
  "$defs": {
    "ArtifactID": {
      "description": "IR-local artifact ID model compatible with CAS interfaces.",
      "title": "ArtifactID",
      "type": "string"
    },
    "ArtifactRefModel": {
      "additionalProperties": false,
      "description": "Provide the common mapping-compatible base contract for artifact refs.",
      "properties": {
        "artifact_id": {
          "$ref": "#/$defs/ArtifactID"
        },
        "kind": {
          "title": "Kind",
          "type": "string"
        },
        "manifest_profile_sha256": {
          "anyOf": [
            {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Manifest Profile Sha256"
        },
        "media_type": {
          "title": "Media Type",
          "type": "string"
        }
      },
      "required": [
        "artifact_id",
        "kind",
        "media_type"
      ],
      "title": "ArtifactRefModel",
      "type": "object"
    },
    "GateContext": {
      "additionalProperties": false,
      "description": "Execution and risk context presented to a governance approver.",
      "properties": {
        "artifact_refs": {
          "anyOf": [
            {
              "additionalProperties": {
                "type": "string"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Artifact Refs"
        },
        "governance_profile": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Governance Profile"
        },
        "is_escalated": {
          "default": false,
          "title": "Is Escalated",
          "type": "boolean"
        },
        "issue_summary": {
          "anyOf": [
            {
              "additionalProperties": {
                "type": "integer"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Issue Summary"
        },
        "iteration": {
          "default": 1,
          "minimum": 1,
          "title": "Iteration",
          "type": "integer"
        },
        "node_alias": {
          "title": "Node Alias",
          "type": "string"
        },
        "phase": {
          "title": "Phase",
          "type": "string"
        },
        "policy_summary": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Policy Summary"
        },
        "replay_summary": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Replay Summary"
        },
        "risk_indicators": {
          "items": {
            "type": "string"
          },
          "title": "Risk Indicators",
          "type": "array"
        },
        "selected_replay_refs": {
          "anyOf": [
            {
              "additionalProperties": {
                "$ref": "#/$defs/ArtifactRefModel"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Selected Replay Refs"
        },
        "simulation_results": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Simulation Results"
        },
        "transport_summary": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Transport Summary"
        },
        "workflow_id": {
          "title": "Workflow Id",
          "type": "string"
        }
      },
      "required": [
        "workflow_id",
        "node_alias",
        "phase"
      ],
      "title": "GateContext",
      "type": "object"
    },
    "GatePriority": {
      "description": "Scheduling priority assigned to a gate request.",
      "enum": [
        "low",
        "normal",
        "high",
        "critical"
      ],
      "title": "GatePriority",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "schema_version": {
            "const": "1.2"
          }
        }
      },
      "then": {
        "properties": {
          "context": {
            "properties": {
              "selected_replay_refs": {
                "not": {
                  "type": "null"
                }
              }
            },
            "required": [
              "selected_replay_refs"
            ]
          }
        }
      }
    }
  ],
  "description": "Approval request payload emitted when execution needs governance review.",
  "properties": {
    "context": {
      "$ref": "#/$defs/GateContext"
    },
    "priority": {
      "$ref": "#/$defs/GatePriority",
      "default": "normal"
    },
    "reason": {
      "title": "Reason",
      "type": "string"
    },
    "request_id": {
      "title": "Request Id",
      "type": "string"
    },
    "requested_at": {
      "format": "date-time",
      "title": "Requested At",
      "type": "string"
    },
    "requested_by": {
      "default": "system",
      "title": "Requested By",
      "type": "string"
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "default": "1.2",
      "pattern": "^\\d+\\.\\d+$",
      "title": "Schema Version",
      "type": "string"
    },
    "timeout_seconds": {
      "anyOf": [
        {
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Timeout Seconds"
    }
  },
  "required": [
    "request_id",
    "run_id",
    "reason",
    "context"
  ],
  "title": "GateRequest",
  "type": "object"
}
