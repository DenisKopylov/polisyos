{
  "additionalProperties": false,
  "description": "Input bundle for Leontief input-output analysis and optimization.",
  "properties": {
    "artifact_name": {
      "const": "leontief_io_bundle_v1.json",
      "default": "leontief_io_bundle_v1.json",
      "title": "Artifact Name",
      "type": "string"
    },
    "contract_payload": {
      "additionalProperties": true,
      "title": "Contract Payload",
      "type": "object"
    },
    "final_demand": {
      "items": {
        "type": "number"
      },
      "title": "Final Demand",
      "type": "array"
    },
    "optimization_target": {
      "default": "optimization.io_leontief",
      "minLength": 1,
      "title": "Optimization Target",
      "type": "string"
    },
    "region_index_map": {
      "additionalProperties": {
        "type": "integer"
      },
      "title": "Region Index Map",
      "type": "object"
    },
    "regions": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Regions",
      "type": "array"
    },
    "required_tables": {
      "items": {
        "type": "string"
      },
      "title": "Required Tables",
      "type": "array"
    },
    "schema_version": {
      "default": "1.0",
      "pattern": "^\\d+\\.\\d+$",
      "title": "Schema Version",
      "type": "string"
    },
    "sector_index_map": {
      "additionalProperties": {
        "type": "integer"
      },
      "title": "Sector Index Map",
      "type": "object"
    },
    "sector_names": {
      "items": {
        "type": "string"
      },
      "title": "Sector Names",
      "type": "array"
    },
    "sectors": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Sectors",
      "type": "array"
    },
    "technical_coefficients": {
      "items": {
        "items": {
          "type": "number"
        },
        "type": "array"
      },
      "title": "Technical Coefficients",
      "type": "array"
    },
    "value_added": {
      "items": {
        "type": "number"
      },
      "title": "Value Added",
      "type": "array"
    }
  },
  "required": [
    "regions",
    "sectors"
  ],
  "title": "LeontiefIOBundle",
  "type": "object"
}
