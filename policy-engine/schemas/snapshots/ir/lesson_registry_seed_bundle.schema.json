{
  "$defs": {
    "ContractCompatibilityTarget": {
      "additionalProperties": false,
      "properties": {
        "contract_fqn": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Contract Fqn",
          "type": "string"
        },
        "contract_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Contract Id",
          "type": "string"
        }
      },
      "required": [
        "contract_id",
        "contract_fqn"
      ],
      "title": "ContractCompatibilityTarget",
      "type": "object"
    },
    "LessonRegistrySeedEntry": {
      "additionalProperties": false,
      "properties": {
        "failure_type": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Failure Type",
          "type": "string"
        },
        "fidelity_level": {
          "minimum": 0,
          "title": "Fidelity Level",
          "type": "integer"
        },
        "notes": {
          "items": {
            "type": "string"
          },
          "title": "Notes",
          "type": "array"
        },
        "stage_name": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Stage Name",
          "type": "string"
        },
        "summary": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Summary",
          "type": "string"
        },
        "tags": {
          "items": {
            "type": "string"
          },
          "title": "Tags",
          "type": "array"
        }
      },
      "required": [
        "summary",
        "failure_type",
        "stage_name",
        "fidelity_level"
      ],
      "title": "LessonRegistrySeedEntry",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "artifact_name": {
      "const": "lesson_registry_seed_v1.json",
      "default": "lesson_registry_seed_v1.json",
      "title": "Artifact Name",
      "type": "string"
    },
    "contract_target": {
      "$ref": "#/$defs/ContractCompatibilityTarget"
    },
    "schema_version": {
      "default": "1.0",
      "pattern": "^\\d+\\.\\d+$",
      "title": "Schema Version",
      "type": "string"
    },
    "seed_entries": {
      "items": {
        "$ref": "#/$defs/LessonRegistrySeedEntry"
      },
      "minItems": 1,
      "title": "Seed Entries",
      "type": "array"
    }
  },
  "required": [
    "contract_target",
    "seed_entries"
  ],
  "title": "LessonRegistrySeedBundle",
  "type": "object"
}
