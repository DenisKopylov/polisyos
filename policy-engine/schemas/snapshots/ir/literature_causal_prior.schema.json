{
  "$defs": {
    "CausalDirection": {
      "description": "Causal direction public type.",
      "enum": [
        "positive",
        "negative",
        "null",
        "mixed",
        "ambiguous",
        "non_linear"
      ],
      "title": "CausalDirection",
      "type": "string"
    },
    "EnvironmentAuditReport": {
      "additionalProperties": false,
      "description": "Environment audit report data model.",
      "properties": {
        "icp_p_values": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Icp P Values",
          "type": "object"
        },
        "icp_passed": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Icp Passed"
        },
        "icp_run": {
          "default": false,
          "title": "Icp Run",
          "type": "boolean"
        },
        "invariant_features": {
          "items": {
            "type": "integer"
          },
          "title": "Invariant Features",
          "type": "array"
        },
        "ks_p_values": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Ks P Values",
          "type": "object"
        },
        "ks_passed": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ks Passed"
        },
        "ks_rejected_variables": {
          "items": {
            "type": "integer"
          },
          "title": "Ks Rejected Variables",
          "type": "array"
        },
        "metadata": {
          "additionalProperties": true,
          "title": "Metadata",
          "type": "object"
        },
        "n_environments": {
          "default": 0,
          "minimum": 0,
          "title": "N Environments",
          "type": "integer"
        },
        "provenance_refs": {
          "items": {
            "type": "string"
          },
          "title": "Provenance Refs",
          "type": "array"
        },
        "status": {
          "default": "skipped",
          "enum": [
            "ok",
            "warning",
            "skipped",
            "degraded"
          ],
          "title": "Status",
          "type": "string"
        },
        "variant_features": {
          "items": {
            "type": "integer"
          },
          "title": "Variant Features",
          "type": "array"
        },
        "warnings": {
          "items": {
            "type": "string"
          },
          "title": "Warnings",
          "type": "array"
        }
      },
      "title": "EnvironmentAuditReport",
      "type": "object"
    },
    "EvidenceStrength": {
      "description": "Evidence strength public type.",
      "enum": [
        "rct",
        "quasi_natural",
        "quasi_natural_event",
        "meta_analysis",
        "panel_fe",
        "structural",
        "observational",
        "cross_sectional",
        "theoretical",
        "unknown"
      ],
      "title": "EvidenceStrength",
      "type": "string"
    },
    "LiteratureEdgePrior": {
      "additionalProperties": false,
      "description": "Literature edge prior public type.",
      "properties": {
        "article_refs": {
          "items": {
            "type": "string"
          },
          "title": "Article Refs",
          "type": "array"
        },
        "confidence": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Confidence",
          "type": "number"
        },
        "direction": {
          "$ref": "#/$defs/CausalDirection",
          "default": "mixed"
        },
        "dst": {
          "title": "Dst",
          "type": "string"
        },
        "evidence_strength": {
          "$ref": "#/$defs/EvidenceStrength",
          "default": "unknown"
        },
        "meta_effect_size": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Meta Effect Size"
        },
        "metadata": {
          "additionalProperties": true,
          "title": "Metadata",
          "type": "object"
        },
        "n_articles": {
          "default": 0,
          "minimum": 0,
          "title": "N Articles",
          "type": "integer"
        },
        "scope_conditions": {
          "items": {
            "type": "string"
          },
          "title": "Scope Conditions",
          "type": "array"
        },
        "src": {
          "title": "Src",
          "type": "string"
        }
      },
      "required": [
        "src",
        "dst",
        "confidence"
      ],
      "title": "LiteratureEdgePrior",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Literature causal prior public type.",
  "properties": {
    "edges": {
      "items": {
        "$ref": "#/$defs/LiteratureEdgePrior"
      },
      "title": "Edges",
      "type": "array"
    },
    "environment_audit": {
      "anyOf": [
        {
          "$ref": "#/$defs/EnvironmentAuditReport"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "metadata": {
      "additionalProperties": true,
      "title": "Metadata",
      "type": "object"
    },
    "schema_version": {
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "skg_snapshot_ref": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Skg Snapshot Ref"
    },
    "skg_version_id": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Skg Version Id"
    }
  },
  "title": "LiteratureCausalPrior",
  "type": "object"
}
