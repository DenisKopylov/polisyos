{
  "$defs": {
    "AgentConfig": {
      "additionalProperties": false,
      "description": "Bundle all agent populations and interaction topology for a world model.\n\n``ModelSpec`` validators check agent-type uniqueness and population-share\nfeasibility through this object before simulation starts.",
      "properties": {
        "agent_types": {
          "description": "Agent type configurations",
          "items": {
            "$ref": "#/$defs/AgentTypeConfig"
          },
          "maxItems": 50,
          "title": "Agent Types",
          "type": "array"
        },
        "interaction_topology": {
          "anyOf": [
            {
              "enum": [
                "random",
                "lattice",
                "network",
                "spatial"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Agent interaction topology",
          "title": "Interaction Topology"
        },
        "max_agents": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Maximum agent capacity",
          "title": "Max Agents"
        },
        "network_graph_ref": {
          "anyOf": [
            {
              "pattern": "^sha256:[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Reference to network graph artifact",
          "title": "Network Graph Ref"
        },
        "total_agents": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Total agent population",
          "title": "Total Agents"
        }
      },
      "title": "AgentConfig",
      "type": "object"
    },
    "AgentTypeConfig": {
      "additionalProperties": false,
      "description": "Describe one simulated agent population and its behavioral heterogeneity.\n\nUse ``population_count`` or ``population_share`` to size the cohort,\n``utility_function`` and behavioral scalars for decision logic, and\n``attribute_distributions`` to parameterize heterogeneity consumed by the\nruntime agent factory.",
      "properties": {
        "adaptive": {
          "default": false,
          "description": "Whether agents use learned policies",
          "title": "Adaptive",
          "type": "boolean"
        },
        "agent_type_id": {
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Agent Type Id",
          "type": "string"
        },
        "attribute_distributions": {
          "additionalProperties": true,
          "description": "Distribution specs for heterogeneous attributes",
          "title": "Attribute Distributions",
          "type": "object"
        },
        "discount_rate": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Discount Rate"
        },
        "entity_type": {
          "$ref": "#/$defs/EntityType"
        },
        "max_population": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Population"
        },
        "name": {
          "anyOf": [
            {
              "$ref": "#/$defs/TranslatableString"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "notes": {
          "items": {
            "type": "string"
          },
          "maxItems": 5,
          "title": "Notes",
          "type": "array"
        },
        "policy_model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "RL policy model type if adaptive",
          "title": "Policy Model"
        },
        "population_count": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Population Count"
        },
        "population_share": {
          "anyOf": [
            {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
                  "type": "string"
                }
              ],
              "ge": 0,
              "le": 1
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Population Share"
        },
        "risk_aversion": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Risk Aversion"
        },
        "utility_function": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9_]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Reference to utility function",
          "title": "Utility Function"
        }
      },
      "required": [
        "agent_type_id",
        "entity_type"
      ],
      "title": "AgentTypeConfig",
      "type": "object"
    },
    "AssumptionSpec": {
      "additionalProperties": false,
      "description": "Record one explicit world-model assumption for governance and sensitivity.\n\nAssumptions are first-class model metadata: reporting, calibration, and\nrobustness tooling can surface them, prioritize ``sensitivity_flag=True``\nentries, and compare alternative ``ModelSpec`` variants that differ only in\nassumption values or confidence.",
      "properties": {
        "assumption_id": {
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Assumption Id",
          "type": "string"
        },
        "assumption_type": {
          "$ref": "#/$defs/AssumptionType"
        },
        "confidence": {
          "anyOf": [
            {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
                  "type": "string"
                }
              ],
              "ge": 0,
              "le": 1
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Confidence in this assumption (0-1)",
          "title": "Confidence"
        },
        "description": {
          "maxLength": 500,
          "title": "Description",
          "type": "string"
        },
        "notes": {
          "items": {
            "type": "string"
          },
          "maxItems": 5,
          "title": "Notes",
          "type": "array"
        },
        "sensitivity_flag": {
          "default": false,
          "description": "Flag for sensitivity analysis priority",
          "title": "Sensitivity Flag",
          "type": "boolean"
        },
        "source": {
          "anyOf": [
            {
              "maxLength": 200,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Source/citation",
          "title": "Source"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "string"
            },
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Quantified assumption value if applicable",
          "title": "Value"
        }
      },
      "required": [
        "assumption_id",
        "assumption_type",
        "description"
      ],
      "title": "AssumptionSpec",
      "type": "object"
    },
    "AssumptionType": {
      "description": "Classify which downstream mechanism or uncertainty layer an assumption affects.",
      "enum": [
        "behavioral",
        "structural",
        "parametric",
        "distributional",
        "temporal",
        "boundary"
      ],
      "title": "AssumptionType",
      "type": "string"
    },
    "EntityType": {
      "description": "\u0422\u0438\u043f\u044b \u0430\u0433\u0435\u043d\u0442\u043e\u0432 \u0438 \u043e\u0431\u044a\u0435\u043a\u0442\u043e\u0432 \u0432 \u0441\u0438\u0441\u0442\u0435\u043c\u0435.",
      "enum": [
        "agent",
        "resource",
        "infrastructure",
        "environment"
      ],
      "title": "EntityType",
      "type": "string"
    },
    "EnvironmentConfig": {
      "additionalProperties": false,
      "description": "Collect exogenous parameters and stochastic execution controls.",
      "properties": {
        "parallel_worlds": {
          "default": 1,
          "description": "Number of parallel simulations",
          "minimum": 1,
          "title": "Parallel Worlds",
          "type": "integer"
        },
        "params": {
          "description": "Environment parameters",
          "items": {
            "$ref": "#/$defs/EnvironmentParam"
          },
          "maxItems": 100,
          "title": "Params",
          "type": "array"
        },
        "random_seed": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "RNG seed for reproducibility",
          "title": "Random Seed"
        },
        "stochastic": {
          "default": true,
          "description": "Whether simulation is stochastic",
          "title": "Stochastic",
          "type": "boolean"
        }
      },
      "title": "EnvironmentConfig",
      "type": "object"
    },
    "EnvironmentParam": {
      "additionalProperties": false,
      "description": "Declare one exogenous world parameter or time-varying external driver.\n\nUse ``time_series_ref`` when the value should be sourced from a persisted\nartifact instead of the inline ``value`` scalar.",
      "properties": {
        "description": {
          "anyOf": [
            {
              "maxLength": 200,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "param_id": {
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Param Id",
          "type": "string"
        },
        "time_series_ref": {
          "anyOf": [
            {
              "pattern": "^sha256:[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Reference to time series data",
          "title": "Time Series Ref"
        },
        "time_varying": {
          "default": false,
          "description": "Whether value changes over time",
          "title": "Time Varying",
          "type": "boolean"
        },
        "unit_id": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9_]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit Id"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "string"
            },
            {
              "type": "boolean"
            }
          ],
          "title": "Value"
        }
      },
      "required": [
        "param_id",
        "value"
      ],
      "title": "EnvironmentParam",
      "type": "object"
    },
    "FidelityLevel": {
      "description": "Select the execution fidelity expected by simulation and calibration runners.\n\nSearch and orchestration layers use this enum to trade speed against model\ndetail; lower-fidelity surrogates are useful for fast scans, while\n``FULL_DISCRETE`` is reserved for high-detail confirmation runs.",
      "enum": [
        "surrogate_fluid",
        "surrogate_discrete",
        "hybrid",
        "full_discrete"
      ],
      "title": "FidelityLevel",
      "type": "string"
    },
    "TimeFrequency": {
      "description": "\u0415\u0434\u0438\u043d\u0438\u0446\u044b \u0432\u0440\u0435\u043c\u0435\u043d\u0438 \u0434\u043b\u044f \u0441\u0438\u043c\u0443\u043b\u044f\u0446\u0438\u0438.",
      "enum": [
        "M",
        "Q",
        "Y"
      ],
      "title": "TimeFrequency",
      "type": "string"
    },
    "TimeSemantics": {
      "additionalProperties": false,
      "description": "Time semantics public type.",
      "properties": {
        "end_date": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "End Date"
        },
        "frequency": {
          "$ref": "#/$defs/TimeFrequency"
        },
        "notes": {
          "items": {
            "type": "string"
          },
          "title": "Notes",
          "type": "array"
        },
        "start_date": {
          "title": "Start Date",
          "type": "string"
        },
        "step_count": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Step Count"
        }
      },
      "required": [
        "frequency",
        "start_date"
      ],
      "title": "TimeSemantics",
      "type": "object"
    },
    "TranslatableString": {
      "additionalProperties": false,
      "description": "\u041c\u0443\u043b\u044c\u0442\u0438\u044f\u0437\u044b\u0447\u043d\u0430\u044f \u0441\u0442\u0440\u043e\u043a\u0430.\nLLM \u0432\u0438\u0434\u0438\u0442 'en' \u0434\u043b\u044f \u043b\u043e\u0433\u0438\u043a\u0438, \u0430 'ua'/'ru' \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u044e\u0442\u0441\u044f \u0434\u043b\u044f UI.",
      "properties": {
        "en": {
          "description": "English text for LLM logic",
          "maxLength": 200,
          "title": "En",
          "type": "string"
        },
        "ru": {
          "anyOf": [
            {
              "maxLength": 200,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Russian text (optional)",
          "title": "Ru"
        },
        "ua": {
          "description": "Ukrainian text for Reporting/UI",
          "maxLength": 200,
          "title": "Ua",
          "type": "string"
        }
      },
      "required": [
        "en",
        "ua"
      ],
      "title": "TranslatableString",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Define the Trinity ``how`` contract for simulation assumptions and state.\n\n``ModelSpec`` answers \"how is the world represented when evaluating this\npolicy?\" It should hold content-addressed references to initial data and\nregistries, declare agent/environment structure, and make modeling\nassumptions explicit enough for robustness sweeps and governance review.\n``ProblemFrame`` owns objectives, ``PolicySpec`` owns interventions, and\n``ModelSpec`` owns simulation mechanics and fidelity.\n\nAttributes:\n    model_id: Stable identifier for the world-model variant.\n    data_snapshot_ref: Content-addressed initial state artifact consumed by\n        simulation runtime.\n    registry_bundle_ref: Optional link to the mechanism/unit registry bundle.\n    time_semantics: Simulation clock, discounting, and horizon semantics.\n    agent_config: Agent populations and interaction topology.\n    assumptions: Explicit model assumptions surfaced for review and sweeps.\n    environment_config: Exogenous parameters and stochastic runtime knobs.\n    fidelity_level: Simulation detail level requested from the runtime.\n    calibrated: Whether this model variant is known to have been calibrated.\n    calibration_ref: Optional reference to persisted calibration outputs.",
  "properties": {
    "agent_config": {
      "$ref": "#/$defs/AgentConfig",
      "description": "Agent population and behavior configuration"
    },
    "assumptions": {
      "description": "Explicit modeling assumptions",
      "items": {
        "$ref": "#/$defs/AssumptionSpec"
      },
      "maxItems": 100,
      "title": "Assumptions",
      "type": "array"
    },
    "calibrated": {
      "default": false,
      "description": "Whether model has been calibrated",
      "title": "Calibrated",
      "type": "boolean"
    },
    "calibration_ref": {
      "anyOf": [
        {
          "pattern": "^sha256:[a-f0-9]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Reference to calibration results",
      "title": "Calibration Ref"
    },
    "data_snapshot_ref": {
      "description": "Reference to DataSnapshot artifact (initial world state)",
      "pattern": "^sha256:[a-f0-9]{64}$",
      "title": "Data Snapshot Ref",
      "type": "string"
    },
    "description": {
      "anyOf": [
        {
          "maxLength": 2000,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Description"
    },
    "environment_config": {
      "$ref": "#/$defs/EnvironmentConfig",
      "description": "Environment parameters and configuration"
    },
    "fidelity_level": {
      "$ref": "#/$defs/FidelityLevel",
      "default": "hybrid",
      "description": "Simulation fidelity level"
    },
    "labels": {
      "items": {
        "type": "string"
      },
      "maxItems": 20,
      "title": "Labels",
      "type": "array"
    },
    "model_id": {
      "description": "Unique model identifier",
      "pattern": "^[a-z][a-z0-9_]*$",
      "title": "Model Id",
      "type": "string"
    },
    "name": {
      "anyOf": [
        {
          "$ref": "#/$defs/TranslatableString"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Human-readable model name"
    },
    "notes": {
      "items": {
        "type": "string"
      },
      "maxItems": 50,
      "title": "Notes",
      "type": "array"
    },
    "registry_bundle_ref": {
      "anyOf": [
        {
          "pattern": "^sha256:[a-f0-9]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Reference to RegistryBundle for mechanisms/units",
      "title": "Registry Bundle Ref"
    },
    "schema_version": {
      "default": "1.0",
      "pattern": "^\\d+\\.\\d+$",
      "title": "Schema Version",
      "type": "string"
    },
    "time_semantics": {
      "anyOf": [
        {
          "$ref": "#/$defs/TimeSemantics"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Temporal configuration (step duration, discounting)"
    },
    "version_tag": {
      "anyOf": [
        {
          "maxLength": 50,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Semantic version tag",
      "title": "Version Tag"
    }
  },
  "required": [
    "model_id",
    "data_snapshot_ref"
  ],
  "title": "ModelSpec",
  "type": "object"
}
