{
  "$defs": {
    "ContractCompatibilityTarget": {
      "additionalProperties": false,
      "properties": {
        "contract_fqn": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Contract Fqn",
          "type": "string"
        },
        "contract_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Contract Id",
          "type": "string"
        }
      },
      "required": [
        "contract_id",
        "contract_fqn"
      ],
      "title": "ContractCompatibilityTarget",
      "type": "object"
    },
    "MultiplexGraphLayerId": {
      "enum": [
        "budget",
        "procurement",
        "trade",
        "distress",
        "public_service"
      ],
      "title": "MultiplexGraphLayerId",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "artifact_name": {
      "const": "network_causal_contract_bundle_v1.json",
      "default": "network_causal_contract_bundle_v1.json",
      "title": "Artifact Name",
      "type": "string"
    },
    "contract_target": {
      "$ref": "#/$defs/ContractCompatibilityTarget"
    },
    "exposure_fields": {
      "items": {
        "type": "string"
      },
      "title": "Exposure Fields",
      "type": "array"
    },
    "interference_required": {
      "default": true,
      "title": "Interference Required",
      "type": "boolean"
    },
    "schema_version": {
      "default": "1.0",
      "pattern": "^\\d+\\.\\d+$",
      "title": "Schema Version",
      "type": "string"
    },
    "supported_layers": {
      "items": {
        "$ref": "#/$defs/MultiplexGraphLayerId"
      },
      "minItems": 1,
      "title": "Supported Layers",
      "type": "array"
    }
  },
  "required": [
    "contract_target",
    "supported_layers"
  ],
  "title": "NetworkCausalContractBundle",
  "type": "object"
}
