{
  "$defs": {
    "ContractCompatibilityTarget": {
      "additionalProperties": false,
      "description": "Identifier of a downstream contract that an observation bundle targets.",
      "properties": {
        "contract_fqn": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Contract Fqn",
          "type": "string"
        },
        "contract_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Contract Id",
          "type": "string"
        }
      },
      "required": [
        "contract_id",
        "contract_fqn"
      ],
      "title": "ContractCompatibilityTarget",
      "type": "object"
    },
    "MultiplexGraphLayerId": {
      "description": "Select the graph layer consumed by network compilers and interference checks.",
      "enum": [
        "budget",
        "procurement",
        "trade",
        "distress",
        "public_service"
      ],
      "title": "MultiplexGraphLayerId",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Bundle carrying graph structures for network-oriented runtime contracts.",
  "properties": {
    "alignment_keys": {
      "items": {
        "type": "string"
      },
      "title": "Alignment Keys",
      "type": "array"
    },
    "artifact_name": {
      "const": "network_contract_bundle_v1.json",
      "default": "network_contract_bundle_v1.json",
      "title": "Artifact Name",
      "type": "string"
    },
    "contract_payloads": {
      "additionalProperties": {
        "additionalProperties": true,
        "type": "object"
      },
      "title": "Contract Payloads",
      "type": "object"
    },
    "contract_targets": {
      "items": {
        "$ref": "#/$defs/ContractCompatibilityTarget"
      },
      "minItems": 1,
      "title": "Contract Targets",
      "type": "array"
    },
    "graph_layers": {
      "items": {
        "$ref": "#/$defs/MultiplexGraphLayerId"
      },
      "minItems": 1,
      "title": "Graph Layers",
      "type": "array"
    },
    "low_rank_factors": {
      "additionalProperties": {
        "additionalProperties": {
          "items": {
            "items": {
              "type": "number"
            },
            "type": "array"
          },
          "type": "array"
        },
        "type": "object"
      },
      "title": "Low Rank Factors",
      "type": "object"
    },
    "node_index_map": {
      "additionalProperties": {
        "type": "integer"
      },
      "title": "Node Index Map",
      "type": "object"
    },
    "node_order": {
      "items": {
        "type": "string"
      },
      "title": "Node Order",
      "type": "array"
    },
    "schema_version": {
      "default": "1.0",
      "pattern": "^\\d+\\.\\d+$",
      "title": "Schema Version",
      "type": "string"
    },
    "slice_settings": {
      "additionalProperties": true,
      "title": "Slice Settings",
      "type": "object"
    },
    "source_artifacts": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Source Artifacts",
      "type": "array"
    },
    "sparse_edges": {
      "additionalProperties": {
        "items": {
          "additionalProperties": true,
          "type": "object"
        },
        "type": "array"
      },
      "title": "Sparse Edges",
      "type": "object"
    }
  },
  "required": [
    "contract_targets",
    "graph_layers",
    "source_artifacts"
  ],
  "title": "NetworkContractBundle",
  "type": "object"
}
