{
  "$defs": {
    "AnchorKind": {
      "enum": [
        "article",
        "section",
        "clause",
        "paragraph",
        "page",
        "table",
        "figure",
        "heading",
        "chunk",
        "other"
      ],
      "title": "AnchorKind",
      "type": "string"
    },
    "ApplicabilityEntitySelector": {
      "additionalProperties": false,
      "properties": {
        "actors": {
          "$ref": "#/$defs/IdSelector"
        },
        "concepts": {
          "$ref": "#/$defs/IdSelector"
        },
        "schema_version": {
          "default": "1.0",
          "pattern": "^\\d+\\.\\d+$",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "title": "ApplicabilityEntitySelector",
      "type": "object"
    },
    "BackendExpr": {
      "additionalProperties": false,
      "description": "Backend-specific expression payload.",
      "properties": {
        "backend": {
          "title": "Backend",
          "type": "string"
        },
        "expr": {
          "title": "Expr",
          "type": "string"
        },
        "language": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Language"
        },
        "notes": {
          "items": {
            "type": "string"
          },
          "title": "Notes",
          "type": "array"
        }
      },
      "required": [
        "backend",
        "expr"
      ],
      "title": "BackendExpr",
      "type": "object"
    },
    "CitationRef": {
      "additionalProperties": false,
      "description": "Citation-grade reference to a specific document fragment.",
      "properties": {
        "doc": {
          "$ref": "#/$defs/DocumentRef"
        },
        "evidence_ref": {
          "anyOf": [
            {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Evidence Ref"
        },
        "fragment_id": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9_.-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fragment Id"
        },
        "locator": {
          "anyOf": [
            {
              "$ref": "#/$defs/FragmentLocator"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "notes": {
          "items": {
            "type": "string"
          },
          "title": "Notes",
          "type": "array"
        },
        "props": {
          "additionalProperties": true,
          "title": "Props",
          "type": "object"
        },
        "provenance_ref": {
          "anyOf": [
            {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Provenance Ref"
        },
        "quote_hash": {
          "anyOf": [
            {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Quote Hash"
        },
        "schema_version": {
          "default": "1.0",
          "pattern": "^\\d+\\.\\d+$",
          "title": "Schema Version",
          "type": "string"
        },
        "text_hash": {
          "anyOf": [
            {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Text Hash"
        }
      },
      "required": [
        "doc"
      ],
      "title": "CitationRef",
      "type": "object"
    },
    "ConditionExpr": {
      "additionalProperties": false,
      "properties": {
        "expr": {
          "minLength": 1,
          "title": "Expr",
          "type": "string"
        },
        "language": {
          "minLength": 1,
          "title": "Language",
          "type": "string"
        },
        "notes": {
          "items": {
            "type": "string"
          },
          "title": "Notes",
          "type": "array"
        },
        "refs": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Refs",
          "type": "object"
        },
        "schema_version": {
          "default": "1.0",
          "pattern": "^\\d+\\.\\d+$",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "language",
        "expr"
      ],
      "title": "ConditionExpr",
      "type": "object"
    },
    "DocumentRef": {
      "additionalProperties": false,
      "description": "Document identity with optional version binding.",
      "properties": {
        "doc_id": {
          "pattern": "^[a-z][a-z0-9_.-]*$",
          "title": "Doc Id",
          "type": "string"
        },
        "doc_version_id": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9_.-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Doc Version Id"
        },
        "doc_version_ref": {
          "anyOf": [
            {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Doc Version Ref"
        },
        "schema_version": {
          "default": "1.0",
          "pattern": "^\\d+\\.\\d+$",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "doc_id"
      ],
      "title": "DocumentRef",
      "type": "object"
    },
    "FragmentLocator": {
      "additionalProperties": false,
      "description": "Declarative locator within a specific document version.",
      "properties": {
        "anchor_kind": {
          "$ref": "#/$defs/AnchorKind"
        },
        "anchor_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Anchor Path"
        },
        "offset_end": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Offset End"
        },
        "offset_start": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Offset Start"
        },
        "page_end": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Page End"
        },
        "page_start": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Page Start"
        },
        "schema_version": {
          "default": "1.0",
          "pattern": "^\\d+\\.\\d+$",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "anchor_kind"
      ],
      "title": "FragmentLocator",
      "type": "object"
    },
    "IdSelector": {
      "additionalProperties": false,
      "properties": {
        "all_of": {
          "items": {
            "type": "string"
          },
          "title": "All Of",
          "type": "array"
        },
        "any_of": {
          "items": {
            "type": "string"
          },
          "title": "Any Of",
          "type": "array"
        },
        "none_of": {
          "items": {
            "type": "string"
          },
          "title": "None Of",
          "type": "array"
        },
        "schema_version": {
          "default": "1.0",
          "pattern": "^\\d+\\.\\d+$",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "title": "IdSelector",
      "type": "object"
    },
    "NormApplicability": {
      "additionalProperties": false,
      "properties": {
        "conditions": {
          "items": {
            "$ref": "#/$defs/ConditionExpr"
          },
          "title": "Conditions",
          "type": "array"
        },
        "exceptions": {
          "items": {
            "$ref": "#/$defs/NormApplicability"
          },
          "title": "Exceptions",
          "type": "array"
        },
        "jurisdiction": {
          "$ref": "#/$defs/IdSelector"
        },
        "notes": {
          "items": {
            "type": "string"
          },
          "title": "Notes",
          "type": "array"
        },
        "object": {
          "$ref": "#/$defs/ApplicabilityEntitySelector"
        },
        "schema_version": {
          "default": "1.0",
          "pattern": "^\\d+\\.\\d+$",
          "title": "Schema Version",
          "type": "string"
        },
        "subject": {
          "$ref": "#/$defs/ApplicabilityEntitySelector"
        },
        "time": {
          "$ref": "#/$defs/TimeWindow"
        }
      },
      "title": "NormApplicability",
      "type": "object"
    },
    "NormRef": {
      "additionalProperties": false,
      "description": "Reference to a normative document provision.",
      "properties": {
        "citations": {
          "items": {
            "$ref": "#/$defs/CitationRef"
          },
          "title": "Citations",
          "type": "array"
        },
        "provision_id": {
          "pattern": "^[a-z][a-z0-9_.-]*$",
          "title": "Provision Id",
          "type": "string"
        },
        "schema_version": {
          "default": "1.0",
          "pattern": "^\\d+\\.\\d+$",
          "title": "Schema Version",
          "type": "string"
        },
        "source_document": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "DEPRECATED: use citations instead",
          "title": "Source Document"
        },
        "version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "DEPRECATED: use citations instead",
          "title": "Version"
        }
      },
      "required": [
        "provision_id"
      ],
      "title": "NormRef",
      "type": "object"
    },
    "RuleType": {
      "description": "Deontic classification of normative rules.",
      "enum": [
        "obligation",
        "prohibition",
        "permission"
      ],
      "title": "RuleType",
      "type": "string"
    },
    "TimeWindow": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "default": "1.0",
          "pattern": "^\\d+\\.\\d+$",
          "title": "Schema Version",
          "type": "string"
        },
        "valid_from": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Valid From"
        },
        "valid_to": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Valid To"
        }
      },
      "title": "TimeWindow",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Single rule within a norm pack.",
  "properties": {
    "applicability": {
      "$ref": "#/$defs/NormApplicability"
    },
    "backend_exprs": {
      "items": {
        "$ref": "#/$defs/BackendExpr"
      },
      "title": "Backend Exprs",
      "type": "array"
    },
    "backend_metadata": {
      "additionalProperties": true,
      "description": "Backend-specific rule data (not interpreted by IR)",
      "title": "Backend Metadata",
      "type": "object"
    },
    "backend_refs": {
      "items": {
        "type": "string"
      },
      "title": "Backend Refs",
      "type": "array"
    },
    "description": {
      "title": "Description",
      "type": "string"
    },
    "norm_id": {
      "pattern": "^[a-z][a-z0-9_.-]*$",
      "title": "Norm Id",
      "type": "string"
    },
    "notes": {
      "items": {
        "type": "string"
      },
      "title": "Notes",
      "type": "array"
    },
    "provision_refs": {
      "items": {
        "$ref": "#/$defs/NormRef"
      },
      "title": "Provision Refs",
      "type": "array"
    },
    "rule_type": {
      "$ref": "#/$defs/RuleType"
    },
    "schema_version": {
      "default": "1.0",
      "pattern": "^\\d+\\.\\d+$",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "norm_id",
    "rule_type",
    "description"
  ],
  "title": "NormRule",
  "type": "object"
}
