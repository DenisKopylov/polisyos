{
  "$defs": {
    "EntityScope": {
      "description": "Granularity at which an observation is measured.\n\nThe scope determines which locator fields must be present on an\n:class:`ObservationRecord` and which downstream contracts can consume the\nresulting panel.",
      "enum": [
        "global",
        "agent",
        "firm",
        "household",
        "cell",
        "household_cell",
        "region",
        "sector"
      ],
      "title": "EntityScope",
      "type": "string"
    },
    "IdentificationMode": {
      "description": "Declare the causal identification contract assumed by records and bundles.\n\nThese modes distinguish point-identified data from partially identified,\nproxy-based, interference-aware, or sequential settings so downstream\ncomponents can enforce the right guardrails. The value is read by\n:class:`polisyos.ir.observation.measurement.IdentificationModeRouter`,\nobservation contract compilers, and causal-readiness checks to select\nfallback paths or block unsafe execution.",
      "enum": [
        "point_identified",
        "partially_identified",
        "bounds_only",
        "proxy_identified",
        "interference_aware",
        "sequential"
      ],
      "title": "IdentificationMode",
      "type": "string"
    },
    "ObservationFamily": {
      "description": "Classify raw evidence into stable observation families for routing.\n\nFamilies partition raw evidence into domains such as budget flows, firm\nfundamentals, or household distribution so measurement rules, governance\ndefaults, and contract compilers can branch on a stable domain label.",
      "enum": [
        "budget_flows",
        "procurement_flows",
        "macro_state",
        "firm_fundamentals",
        "trade_exposure",
        "labor_market",
        "household_distribution",
        "distress_enforcement",
        "spatial_raster_exogenous",
        "public_service_domain_flows",
        "education_human_capital_supply",
        "construction_capital_formation",
        "logistics_friction"
      ],
      "title": "ObservationFamily",
      "type": "string"
    },
    "ObservationRecord": {
      "additionalProperties": false,
      "description": "Store one raw normalized measurement and the metadata needed for routing.\n\nRepresents one metric value for a specific entity scope and time window,\ntogether with the metadata needed for measurement-aware loss weighting,\nschema-regime boundary handling, and causal readiness routing.\n\nAttributes:\n    observation_id: Stable lineage identifier for the measurement.\n    family: Observation domain used by governance and compiler registries.\n    entity_scope: Granularity that determines which locator field is required.\n    coverage_estimate: Estimated share of the target population covered.\n    trust_weight: Raw source confidence weight before registry normalization.\n    identification_mode: Assumptions under which the value may be used causally.",
      "properties": {
        "cell_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cell Id"
        },
        "censoring_mask": {
          "default": false,
          "title": "Censoring Mask",
          "type": "boolean"
        },
        "coverage_estimate": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Coverage Estimate",
          "type": "number"
        },
        "entity_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Entity Id"
        },
        "entity_scope": {
          "$ref": "#/$defs/EntityScope"
        },
        "family": {
          "$ref": "#/$defs/ObservationFamily"
        },
        "identification_mode": {
          "$ref": "#/$defs/IdentificationMode"
        },
        "lag_days_estimate": {
          "default": 0,
          "minimum": 0,
          "title": "Lag Days Estimate",
          "type": "integer"
        },
        "measurement_bias_flag": {
          "default": false,
          "title": "Measurement Bias Flag",
          "type": "boolean"
        },
        "metric_id": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Metric Id",
          "type": "string"
        },
        "notes_json": {
          "additionalProperties": true,
          "title": "Notes Json",
          "type": "object"
        },
        "observation_id": {
          "pattern": "^[a-z][a-z0-9_.-]*$",
          "title": "Observation Id",
          "type": "string"
        },
        "observed_value": {
          "title": "Observed Value",
          "type": "number"
        },
        "period_end": {
          "format": "date",
          "title": "Period End",
          "type": "string"
        },
        "period_start": {
          "format": "date",
          "title": "Period Start",
          "type": "string"
        },
        "proxy_source_id": {
          "anyOf": [
            {
              "maxLength": 120,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Proxy Source Id"
        },
        "regime_id": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Regime Id",
          "type": "string"
        },
        "region_code": {
          "anyOf": [
            {
              "maxLength": 64,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Region Code"
        },
        "schema_regime_id": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Schema Regime Id",
          "type": "string"
        },
        "schema_version": {
          "default": "1.0",
          "pattern": "^\\d+\\.\\d+$",
          "title": "Schema Version",
          "type": "string"
        },
        "sector_id": {
          "anyOf": [
            {
              "maxLength": 64,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sector Id"
        },
        "shock_mask": {
          "default": false,
          "title": "Shock Mask",
          "type": "boolean"
        },
        "source_confidence_tier": {
          "$ref": "#/$defs/SourceConfidenceTier",
          "default": "validated"
        },
        "source_id": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "source_version": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Source Version",
          "type": "string"
        },
        "time_grain": {
          "$ref": "#/$defs/TimeFrequency"
        },
        "trust_weight": {
          "minimum": 0.0,
          "title": "Trust Weight",
          "type": "number"
        },
        "unit": {
          "maxLength": 32,
          "minLength": 1,
          "title": "Unit",
          "type": "string"
        }
      },
      "required": [
        "observation_id",
        "family",
        "time_grain",
        "period_start",
        "period_end",
        "entity_scope",
        "metric_id",
        "observed_value",
        "unit",
        "coverage_estimate",
        "trust_weight",
        "source_id",
        "source_version",
        "regime_id",
        "schema_regime_id",
        "identification_mode"
      ],
      "title": "ObservationRecord",
      "type": "object"
    },
    "SourceConfidenceTier": {
      "description": "Declare the raw provenance tier consumed by measurement trust normalization.\n\n:class:`polisyos.ir.observation.measurement.MeasurementRegistry` maps this\nsource-side tier and coverage metadata into a ``MeasurementTrustTier`` used\nby calibration losses and readiness routing.",
      "enum": [
        "core",
        "validated",
        "exploratory"
      ],
      "title": "SourceConfidenceTier",
      "type": "string"
    },
    "TimeFrequency": {
      "description": "\u0415\u0434\u0438\u043d\u0438\u0446\u044b \u0432\u0440\u0435\u043c\u0435\u043d\u0438 \u0434\u043b\u044f \u0441\u0438\u043c\u0443\u043b\u044f\u0446\u0438\u0438.",
      "enum": [
        "M",
        "Q",
        "Y"
      ],
      "title": "TimeFrequency",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Group homogeneous raw observations before compiler and readiness stages.\n\nPanels guarantee a shared observation family and time grain so compiler\nstages can align records onto a single timeline and materialize bundle\nartifacts deterministically.",
  "properties": {
    "family": {
      "$ref": "#/$defs/ObservationFamily"
    },
    "notes": {
      "items": {
        "type": "string"
      },
      "title": "Notes",
      "type": "array"
    },
    "panel_id": {
      "pattern": "^[a-z][a-z0-9_.-]*$",
      "title": "Panel Id",
      "type": "string"
    },
    "records": {
      "items": {
        "$ref": "#/$defs/ObservationRecord"
      },
      "minItems": 1,
      "title": "Records",
      "type": "array"
    },
    "schema_version": {
      "default": "1.0",
      "pattern": "^\\d+\\.\\d+$",
      "title": "Schema Version",
      "type": "string"
    },
    "time_grain": {
      "$ref": "#/$defs/TimeFrequency"
    }
  },
  "required": [
    "panel_id",
    "family",
    "time_grain",
    "records"
  ],
  "title": "ObservationPanel",
  "type": "object"
}
