{
  "$defs": {
    "ArtifactID": {
      "description": "IR-local artifact ID model compatible with CAS interfaces.",
      "title": "ArtifactID",
      "type": "string"
    },
    "InterventionCostManifoldRef": {
      "additionalProperties": false,
      "description": "Stable handle for a persisted ``InterventionCostManifold`` spec.",
      "properties": {
        "artifact_id": {
          "$ref": "#/$defs/ArtifactID"
        },
        "kind": {
          "const": "ir.intervention_cost_manifold",
          "default": "ir.intervention_cost_manifold",
          "title": "Kind",
          "type": "string"
        },
        "media_type": {
          "const": "application/json",
          "default": "application/json",
          "title": "Media Type",
          "type": "string"
        }
      },
      "required": [
        "artifact_id"
      ],
      "title": "InterventionCostManifoldRef",
      "type": "object"
    },
    "RecourseSemantics": {
      "description": "Recourse semantic regime selected by the query.\n\nDistinguishes individualized counterfactual semantics from weaker\nprobabilistic / subpopulation / bounded regimes. The proof kernel uses\nthis field to choose identification pathways and refuse requests that\ncannot be supported under the selected regime.",
      "enum": [
        "counterfactual_unit",
        "probabilistic_counterfactual_unit",
        "interventional_subpopulation",
        "bounded_recourse"
      ],
      "title": "RecourseSemantics",
      "type": "string"
    },
    "RecourseSuccessMode": {
      "description": "How ``g(a) >= tau`` is evaluated by the planner.",
      "enum": [
        "point_probability",
        "lower_confidence_bound",
        "lower_identification_bound"
      ],
      "title": "RecourseSuccessMode",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Typed causal query for algorithmic recourse.\n\nThe planner minimises ``C_man([a])`` subject to ``g(a) >= threshold_tau``,\nwhere ``g`` is the success functional derived from\n``semantics`` / ``success_mode`` and the recoverability status returned by\nthe proof kernel.",
  "properties": {
    "action_library_ref": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Action Library Ref"
    },
    "factual_unit_ref": {
      "title": "Factual Unit Ref",
      "type": "string"
    },
    "immutable_nodes": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Immutable Nodes",
      "type": "array"
    },
    "intervention_cost_manifold_ref": {
      "$ref": "#/$defs/InterventionCostManifoldRef"
    },
    "metadata": {
      "additionalProperties": true,
      "title": "Metadata",
      "type": "object"
    },
    "mutable_nodes": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Mutable Nodes",
      "type": "array"
    },
    "robustness_spec_ref": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Robustness Spec Ref"
    },
    "schema_version": {
      "default": "1.0",
      "pattern": "^\\d+\\.\\d+$",
      "title": "Schema Version",
      "type": "string"
    },
    "semantics": {
      "$ref": "#/$defs/RecourseSemantics"
    },
    "success_mode": {
      "$ref": "#/$defs/RecourseSuccessMode",
      "default": "point_probability"
    },
    "support_budget": {
      "anyOf": [
        {
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Support Budget"
    },
    "target_outcome": {
      "title": "Target Outcome",
      "type": "string"
    },
    "target_value": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "integer"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        }
      ],
      "default": 1,
      "title": "Target Value"
    },
    "threshold_tau": {
      "exclusiveMaximum": 1.0,
      "exclusiveMinimum": 0.0,
      "title": "Threshold Tau",
      "type": "number"
    }
  },
  "required": [
    "factual_unit_ref",
    "target_outcome",
    "threshold_tau",
    "semantics",
    "intervention_cost_manifold_ref",
    "mutable_nodes"
  ],
  "title": "OptimalRecourseInterventionQuery",
  "type": "object"
}
