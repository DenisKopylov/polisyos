{
  "$defs": {
    "BoundMethod": {
      "enum": [
        "manski_bounds",
        "iv_bounds",
        "monotone_treatment"
      ],
      "title": "BoundMethod",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Result of partial identification analysis (e.g., Manski bounds on ATE).",
  "properties": {
    "assumptions_used": {
      "items": {
        "type": "string"
      },
      "title": "Assumptions Used",
      "type": "array"
    },
    "assumptions_violated": {
      "items": {
        "type": "string"
      },
      "title": "Assumptions Violated",
      "type": "array"
    },
    "bound_width": {
      "default": 0.0,
      "title": "Bound Width",
      "type": "number"
    },
    "confidence": {
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Confidence",
      "type": "number"
    },
    "informativeness_threshold": {
      "default": 0.5,
      "title": "Informativeness Threshold",
      "type": "number"
    },
    "is_informative": {
      "default": true,
      "title": "Is Informative",
      "type": "boolean"
    },
    "lower_bound": {
      "title": "Lower Bound",
      "type": "number"
    },
    "method": {
      "$ref": "#/$defs/BoundMethod"
    },
    "schema_version": {
      "default": "1.0",
      "pattern": "^\\d+\\.\\d+$",
      "title": "Schema Version",
      "type": "string"
    },
    "upper_bound": {
      "title": "Upper Bound",
      "type": "number"
    }
  },
  "required": [
    "method",
    "lower_bound",
    "upper_bound",
    "confidence"
  ],
  "title": "PartialIdentificationResult",
  "type": "object"
}
