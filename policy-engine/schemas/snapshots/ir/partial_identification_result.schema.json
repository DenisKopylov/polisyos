{
  "$defs": {
    "ArtifactID": {
      "description": "IR-local artifact ID model compatible with CAS interfaces.",
      "title": "ArtifactID",
      "type": "string"
    },
    "BoundMethod": {
      "description": "Bound method public type.",
      "enum": [
        "manski_bounds",
        "transport_bounds",
        "dp_robustness_bounds",
        "iv_bounds",
        "monotone_treatment",
        "lp_balke_pearl",
        "imbens_manski_ci",
        "mtr_bounds",
        "miv_bounds",
        "mts_bounds",
        "general_lp_bounds",
        "copula_bounds",
        "tan_bounds",
        "intersection_bounds",
        "rosenbaum_sharp"
      ],
      "title": "BoundMethod",
      "type": "string"
    },
    "BoundSoundnessLevel": {
      "description": "Soundness tier for one bounds result.",
      "enum": [
        "CERTIFIED",
        "ASSUMPTION_ONLY",
        "HEURISTIC"
      ],
      "title": "BoundSoundnessLevel",
      "type": "string"
    },
    "BoundsTighteningLogRef": {
      "additionalProperties": false,
      "description": "Stable handle for certified bounds-tightening search logs.",
      "properties": {
        "artifact_id": {
          "$ref": "#/$defs/ArtifactID"
        },
        "kind": {
          "const": "ir.bounds_tightening_log",
          "default": "ir.bounds_tightening_log",
          "title": "Kind",
          "type": "string"
        },
        "media_type": {
          "const": "application/json",
          "default": "application/json",
          "title": "Media Type",
          "type": "string"
        }
      },
      "required": [
        "artifact_id"
      ],
      "title": "BoundsTighteningLogRef",
      "type": "object"
    },
    "DualCertificateRef": {
      "additionalProperties": false,
      "description": "Stable handle for persisted LP dual certificates consumed by bounds auditing.",
      "properties": {
        "artifact_id": {
          "$ref": "#/$defs/ArtifactID"
        },
        "kind": {
          "const": "ir.dual_certificate",
          "default": "ir.dual_certificate",
          "title": "Kind",
          "type": "string"
        },
        "media_type": {
          "const": "application/json",
          "default": "application/json",
          "title": "Media Type",
          "type": "string"
        }
      },
      "required": [
        "artifact_id"
      ],
      "title": "DualCertificateRef",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Result of partial identification analysis (e.g., Manski bounds on ATE).",
  "properties": {
    "assumptions_used": {
      "items": {
        "type": "string"
      },
      "title": "Assumptions Used",
      "type": "array"
    },
    "assumptions_violated": {
      "items": {
        "type": "string"
      },
      "title": "Assumptions Violated",
      "type": "array"
    },
    "bound_width": {
      "default": 0.0,
      "title": "Bound Width",
      "type": "number"
    },
    "bounds_type": {
      "default": "manski",
      "enum": [
        "sharp_lp",
        "relaxed_polynomial",
        "manski"
      ],
      "title": "Bounds Type",
      "type": "string"
    },
    "certificate_kind": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Certificate Kind"
    },
    "certificate_ref": {
      "anyOf": [
        {
          "$ref": "#/$defs/DualCertificateRef"
        },
        {
          "$ref": "#/$defs/BoundsTighteningLogRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Certificate Ref"
    },
    "chart_type": {
      "default": "interval",
      "title": "Chart Type",
      "type": "string"
    },
    "confidence": {
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Confidence",
      "type": "number"
    },
    "discretization_converged": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Discretization Converged"
    },
    "discretization_method": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Discretization Method"
    },
    "display_label": {
      "default": "",
      "title": "Display Label",
      "type": "string"
    },
    "informativeness_threshold": {
      "default": 0.5,
      "title": "Informativeness Threshold",
      "type": "number"
    },
    "is_informative": {
      "default": true,
      "title": "Is Informative",
      "type": "boolean"
    },
    "lower_bound": {
      "title": "Lower Bound",
      "type": "number"
    },
    "method": {
      "$ref": "#/$defs/BoundMethod"
    },
    "n_bins_final": {
      "anyOf": [
        {
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "N Bins Final"
    },
    "n_refinement_steps": {
      "default": 0,
      "minimum": 0,
      "title": "N Refinement Steps",
      "type": "integer"
    },
    "relaxation_gap": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Relaxation Gap"
    },
    "schema_version": {
      "default": "1.0",
      "pattern": "^\\d+\\.\\d+$",
      "title": "Schema Version",
      "type": "string"
    },
    "solver_metadata": {
      "additionalProperties": true,
      "title": "Solver Metadata",
      "type": "object"
    },
    "soundness_level": {
      "anyOf": [
        {
          "$ref": "#/$defs/BoundSoundnessLevel"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "upper_bound": {
      "title": "Upper Bound",
      "type": "number"
    }
  },
  "required": [
    "method",
    "lower_bound",
    "upper_bound",
    "confidence"
  ],
  "title": "PartialIdentificationResult",
  "type": "object"
}
