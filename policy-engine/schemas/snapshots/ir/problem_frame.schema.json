{
  "$defs": {
    "ConstraintSpec": {
      "additionalProperties": false,
      "description": "Specify one feasibility boundary or soft penalty attached to a metric slot.\n\nHard constraints are expected to fail governance or search admission when\nviolated, whereas soft constraints may be traded off using\n``penalty_weight``. Use ``slot_id`` and ``operator`` when the constraint is\ntied to a concrete metric channel.",
      "properties": {
        "constraint_id": {
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Constraint Id",
          "type": "string"
        },
        "constraint_type": {
          "$ref": "#/$defs/ConstraintType",
          "default": "hard",
          "description": "Hard (must satisfy) or soft (preferred)"
        },
        "notes": {
          "items": {
            "type": "string"
          },
          "maxItems": 5,
          "title": "Notes",
          "type": "array"
        },
        "operator": {
          "anyOf": [
            {
              "enum": [
                "<",
                "<=",
                "==",
                "!=",
                ">=",
                ">"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Comparison operator (if applicable)",
          "title": "Operator"
        },
        "penalty_weight": {
          "anyOf": [
            {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
                  "type": "string"
                }
              ],
              "ge": 0
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Penalty weight for soft constraint violation",
          "title": "Penalty Weight"
        },
        "slot_id": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9_.]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Slot this constrains",
          "title": "Slot Id"
        },
        "value": {
          "anyOf": [
            {
              "$ref": "#/$defs/MoneyValue"
            },
            {
              "$ref": "#/$defs/RateValue"
            },
            {
              "$ref": "#/$defs/CountValue"
            },
            {
              "$ref": "#/$defs/DurationValue"
            },
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "integer"
            },
            {
              "type": "string"
            },
            {
              "type": "boolean"
            }
          ],
          "description": "Constraint value or threshold",
          "title": "Value"
        }
      },
      "required": [
        "constraint_id",
        "value"
      ],
      "title": "ConstraintSpec",
      "type": "object"
    },
    "ConstraintType": {
      "description": "Declare whether a constraint is a hard feasibility gate or a soft penalty.\n\n``ProblemFrame`` validators keep hard and soft constraints in separate\ncollections, while portfolio/search routines can use ``SOFT`` entries with\n``ConstraintSpec.penalty_weight`` as a scalarized penalty term.",
      "enum": [
        "hard",
        "soft"
      ],
      "title": "ConstraintType",
      "type": "string"
    },
    "CountValue": {
      "additionalProperties": false,
      "description": "Count value public type.",
      "properties": {
        "label": {
          "anyOf": [
            {
              "maxLength": 64,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Label"
        },
        "value": {
          "minimum": 0,
          "title": "Value",
          "type": "integer"
        }
      },
      "required": [
        "value"
      ],
      "title": "CountValue",
      "type": "object"
    },
    "DurationValue": {
      "additionalProperties": false,
      "description": "Duration value public type.",
      "properties": {
        "unit": {
          "default": "step",
          "enum": [
            "step",
            "day",
            "month",
            "quarter",
            "year"
          ],
          "title": "Unit",
          "type": "string"
        },
        "value": {
          "minimum": 0,
          "title": "Value",
          "type": "integer"
        }
      },
      "required": [
        "value"
      ],
      "title": "DurationValue",
      "type": "object"
    },
    "EntityType": {
      "description": "\u0422\u0438\u043f\u044b \u0430\u0433\u0435\u043d\u0442\u043e\u0432 \u0438 \u043e\u0431\u044a\u0435\u043a\u0442\u043e\u0432 \u0432 \u0441\u0438\u0441\u0442\u0435\u043c\u0435.",
      "enum": [
        "agent",
        "resource",
        "infrastructure",
        "environment"
      ],
      "title": "EntityType",
      "type": "string"
    },
    "KPISpec": {
      "additionalProperties": false,
      "description": "Describe one measurable success signal anchored to the metric registry.\n\nA KPI is the user-facing metric vocabulary for the ``what`` artifact: it\nlinks narrative objectives to a concrete ``metric_id``, optional\nbaseline/target values, and an optimization direction that downstream\nscoring and reporting stages can interpret consistently.",
      "properties": {
        "baseline_value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Current/starting value",
          "title": "Baseline Value"
        },
        "direction": {
          "$ref": "#/$defs/OptimizationDirection",
          "description": "Optimization direction: maximize, minimize, or maintain_range"
        },
        "kpi_id": {
          "description": "Unique KPI identifier",
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Kpi Id",
          "type": "string"
        },
        "metric_id": {
          "description": "Reference to metric registry",
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Metric Id",
          "type": "string"
        },
        "name": {
          "anyOf": [
            {
              "$ref": "#/$defs/TranslatableString"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Human-readable KPI name"
        },
        "notes": {
          "items": {
            "type": "string"
          },
          "maxItems": 10,
          "title": "Notes",
          "type": "array"
        },
        "target_value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Desired target value",
          "title": "Target Value"
        },
        "unit_id": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9_]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Unit of measurement",
          "title": "Unit Id"
        },
        "weight": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "default": "1",
          "description": "Relative importance weight (0-100)",
          "ge": 0,
          "le": 100,
          "title": "Weight"
        }
      },
      "required": [
        "kpi_id",
        "metric_id",
        "direction"
      ],
      "title": "KPISpec",
      "type": "object"
    },
    "MoneyValue": {
      "additionalProperties": false,
      "description": "Money value public type.",
      "properties": {
        "amount": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Amount"
        },
        "currency": {
          "pattern": "^[A-Z]{3}$",
          "title": "Currency",
          "type": "string"
        },
        "nominal_year": {
          "anyOf": [
            {
              "maximum": 2100,
              "minimum": 1900,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Nominal Year"
        }
      },
      "required": [
        "amount",
        "currency"
      ],
      "title": "MoneyValue",
      "type": "object"
    },
    "NormativeArbitrationPolicy": {
      "description": "Supported formal arbitration policies.",
      "enum": [
        "lexicographic_rights",
        "weighted_welfare",
        "max_min_harm",
        "pareto_filter"
      ],
      "title": "NormativeArbitrationPolicy",
      "type": "string"
    },
    "NormativeComparisonMode": {
      "description": "Supported comparison modes for arbitration.",
      "enum": [
        "proposal_vs_baseline"
      ],
      "title": "NormativeComparisonMode",
      "type": "string"
    },
    "NormativeComparisonTarget": {
      "description": "Which quantity a right condition evaluates.",
      "enum": [
        "proposal",
        "baseline",
        "delta"
      ],
      "title": "NormativeComparisonTarget",
      "type": "string"
    },
    "NormativeFrame": {
      "additionalProperties": false,
      "description": "Formal value-conflict model used by normative arbitration.",
      "properties": {
        "comparison_mode": {
          "$ref": "#/$defs/NormativeComparisonMode",
          "default": "proposal_vs_baseline"
        },
        "default_policy": {
          "$ref": "#/$defs/NormativeArbitrationPolicy",
          "default": "lexicographic_rights"
        },
        "enabled_policies": {
          "items": {
            "$ref": "#/$defs/NormativeArbitrationPolicy"
          },
          "maxItems": 4,
          "title": "Enabled Policies",
          "type": "array"
        },
        "hard_constraint_refs": {
          "items": {
            "type": "string"
          },
          "maxItems": 50,
          "title": "Hard Constraint Refs",
          "type": "array"
        },
        "notes": {
          "items": {
            "type": "string"
          },
          "maxItems": 20,
          "title": "Notes",
          "type": "array"
        },
        "rights_catalog": {
          "items": {
            "$ref": "#/$defs/StakeholderRightSpec"
          },
          "maxItems": 500,
          "title": "Rights Catalog",
          "type": "array"
        },
        "stakeholder_bindings": {
          "items": {
            "$ref": "#/$defs/StakeholderOutcomeBinding"
          },
          "maxItems": 500,
          "title": "Stakeholder Bindings",
          "type": "array"
        },
        "utility_terms": {
          "items": {
            "$ref": "#/$defs/StakeholderUtilityTerm"
          },
          "maxItems": 500,
          "title": "Utility Terms",
          "type": "array"
        }
      },
      "title": "NormativeFrame",
      "type": "object"
    },
    "NormativeOutcomeChannel": {
      "description": "Canonical channels that can feed normative utilities/rights.",
      "enum": [
        "simulation_metric",
        "distributional_net_impact",
        "distributional_losers_share",
        "distributional_winners_share",
        "distributional_overall_gini_delta",
        "uncertainty_ci_width_ratio",
        "synthesized"
      ],
      "title": "NormativeOutcomeChannel",
      "type": "string"
    },
    "ObjectiveSpec": {
      "additionalProperties": false,
      "description": "Formal objective specification linking to metrics.\n\nPreserves compatibility with existing ObjectiveSpec in surface.py.",
      "properties": {
        "direction": {
          "$ref": "#/$defs/OptimizationDirection"
        },
        "kpi_refs": {
          "description": "References to KPIs this objective relates to",
          "items": {
            "type": "string"
          },
          "title": "Kpi Refs",
          "type": "array"
        },
        "metric_id": {
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Metric Id",
          "type": "string"
        },
        "objective_id": {
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Objective Id",
          "type": "string"
        },
        "target": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target"
        },
        "weight": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "default": "1",
          "ge": 0,
          "title": "Weight"
        }
      },
      "required": [
        "objective_id",
        "metric_id",
        "direction"
      ],
      "title": "ObjectiveSpec",
      "type": "object"
    },
    "OptimizationDirection": {
      "description": "\u041a\u0443\u0434\u0430 \u0434\u0432\u0438\u0433\u0430\u0442\u044c \u043c\u0435\u0442\u0440\u0438\u043a\u0443.",
      "enum": [
        "maximize",
        "minimize",
        "maintain_range"
      ],
      "title": "OptimizationDirection",
      "type": "string"
    },
    "ProblemDomain": {
      "description": "Classify the domain vocabulary used to route metrics and templates.\n\nThe domain label is consumed by authoring tools and reporting layers to\nchoose problem-specific defaults; ``CUSTOM`` is the escape hatch when no\nbuilt-in domain taxonomy applies.",
      "enum": [
        "fiscal",
        "monetary",
        "social",
        "environmental",
        "labor",
        "healthcare",
        "education",
        "infrastructure",
        "regulatory",
        "trade",
        "custom"
      ],
      "title": "ProblemDomain",
      "type": "string"
    },
    "RateValue": {
      "additionalProperties": false,
      "description": "Rate value public type.",
      "properties": {
        "base": {
          "default": "ratio",
          "enum": [
            "ratio",
            "percent"
          ],
          "title": "Base",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Value"
        }
      },
      "required": [
        "value"
      ],
      "title": "RateValue",
      "type": "object"
    },
    "StakeholderOutcomeBinding": {
      "additionalProperties": false,
      "description": "Map a stakeholder to a concrete outcome channel and key.",
      "properties": {
        "binding_id": {
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Binding Id",
          "type": "string"
        },
        "channel": {
          "$ref": "#/$defs/NormativeOutcomeChannel"
        },
        "notes": {
          "items": {
            "type": "string"
          },
          "maxItems": 10,
          "title": "Notes",
          "type": "array"
        },
        "outcome_key": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Outcome Key",
          "type": "string"
        },
        "stakeholder_id": {
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Stakeholder Id",
          "type": "string"
        },
        "weight": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "default": "1",
          "ge": 0,
          "title": "Weight"
        }
      },
      "required": [
        "binding_id",
        "stakeholder_id",
        "channel",
        "outcome_key"
      ],
      "title": "StakeholderOutcomeBinding",
      "type": "object"
    },
    "StakeholderRightSpec": {
      "additionalProperties": false,
      "description": "Explicit normative right attached to a stakeholder.",
      "properties": {
        "binding_ref": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9_]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Binding Ref"
        },
        "compare_to": {
          "$ref": "#/$defs/NormativeComparisonTarget",
          "default": "delta"
        },
        "hard": {
          "default": true,
          "title": "Hard",
          "type": "boolean"
        },
        "notes": {
          "items": {
            "type": "string"
          },
          "maxItems": 10,
          "title": "Notes",
          "type": "array"
        },
        "operator": {
          "enum": [
            "<",
            "<=",
            "==",
            "!=",
            ">=",
            ">"
          ],
          "title": "Operator",
          "type": "string"
        },
        "right_id": {
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Right Id",
          "type": "string"
        },
        "stakeholder_id": {
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Stakeholder Id",
          "type": "string"
        },
        "threshold": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "integer"
            },
            {
              "type": "string"
            },
            {
              "type": "boolean"
            }
          ],
          "title": "Threshold"
        }
      },
      "required": [
        "right_id",
        "stakeholder_id",
        "operator",
        "threshold"
      ],
      "title": "StakeholderRightSpec",
      "type": "object"
    },
    "StakeholderSpec": {
      "additionalProperties": false,
      "description": "Capture the affected actor set used by equity and arbitration passes.\n\nStakeholders define whose outcomes must be tracked in ``ProblemFrame`` and\noptionally prioritized in ``NormativeFrame``. Downstream fairness,\ndistributional, and policy communication layers read this contract to align\nmetric impacts with stakeholder semantics.",
      "properties": {
        "attributes": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              },
              {
                "type": "boolean"
              }
            ]
          },
          "title": "Attributes",
          "type": "object"
        },
        "entity_type": {
          "$ref": "#/$defs/EntityType"
        },
        "impact_direction": {
          "anyOf": [
            {
              "enum": [
                "positive",
                "negative",
                "mixed",
                "neutral"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Expected policy impact direction",
          "title": "Impact Direction"
        },
        "name": {
          "anyOf": [
            {
              "$ref": "#/$defs/TranslatableString"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "priority": {
          "default": 5,
          "description": "Stakeholder priority (1-10)",
          "maximum": 10,
          "minimum": 1,
          "title": "Priority",
          "type": "integer"
        },
        "role": {
          "anyOf": [
            {
              "maxLength": 100,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Role in the problem space",
          "title": "Role"
        },
        "stakeholder_id": {
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Stakeholder Id",
          "type": "string"
        }
      },
      "required": [
        "stakeholder_id",
        "entity_type"
      ],
      "title": "StakeholderSpec",
      "type": "object"
    },
    "StakeholderUtilityTerm": {
      "additionalProperties": false,
      "description": "Explicit utility term for stakeholder welfare aggregation.",
      "properties": {
        "binding_refs": {
          "items": {
            "type": "string"
          },
          "maxItems": 10,
          "title": "Binding Refs",
          "type": "array"
        },
        "coefficient": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "default": "1",
          "title": "Coefficient"
        },
        "direction": {
          "$ref": "#/$defs/UtilityDirection",
          "default": "maximize"
        },
        "notes": {
          "items": {
            "type": "string"
          },
          "maxItems": 10,
          "title": "Notes",
          "type": "array"
        },
        "stakeholder_id": {
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Stakeholder Id",
          "type": "string"
        },
        "term_id": {
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Term Id",
          "type": "string"
        },
        "welfare_weight": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "default": "1",
          "ge": 0,
          "title": "Welfare Weight"
        }
      },
      "required": [
        "term_id",
        "stakeholder_id"
      ],
      "title": "StakeholderUtilityTerm",
      "type": "object"
    },
    "SuccessCriterion": {
      "additionalProperties": false,
      "description": "Formal success criterion with threshold and operator.\n\nDefines when an objective/KPI is considered achieved.",
      "properties": {
        "confidence_level": {
          "anyOf": [
            {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
                  "type": "string"
                }
              ],
              "ge": 0,
              "le": 1
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Required confidence level (0-1)",
          "title": "Confidence Level"
        },
        "criterion_id": {
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Criterion Id",
          "type": "string"
        },
        "kpi_id": {
          "description": "KPI this criterion evaluates",
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Kpi Id",
          "type": "string"
        },
        "notes": {
          "items": {
            "type": "string"
          },
          "maxItems": 5,
          "title": "Notes",
          "type": "array"
        },
        "operator": {
          "description": "Comparison operator",
          "enum": [
            "<",
            "<=",
            "==",
            "!=",
            ">=",
            ">"
          ],
          "title": "Operator",
          "type": "string"
        },
        "threshold": {
          "anyOf": [
            {
              "type": "number"
            },
            {
