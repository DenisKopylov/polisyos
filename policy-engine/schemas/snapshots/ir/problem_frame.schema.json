  "additionalProperties": false,
  "description": "Define the Trinity ``what`` contract for objectives, metrics, and guardrails.\n\n``ProblemFrame`` answers \"what problem are we solving and under which\nboundaries?\" and is expected to remain stable while ``PolicySpec`` explores\ninterventions and ``ModelSpec`` explores simulation assumptions. Use this\nartifact as the canonical anchor for optimizer objectives, governance\nconstraints, stakeholder interpretation, and human-facing summaries.\n\nAttributes:\n    problem_id: Stable identifier for the policy problem within a project.\n    domain: Domain taxonomy used for reporting and authoring defaults.\n    objectives: Formal optimization objectives tied to registry metrics.\n    kpis: Business-facing KPI definitions that quantify progress.\n    success_criteria: Threshold tests that define when a KPI is considered met.\n    hard_constraints: Non-negotiable feasibility boundaries.\n    soft_constraints: Penalty-based preferences that search may trade off.\n    stakeholders: Affected actor groups used by equity and arbitration logic.\n    normative_frame: Optional welfare/rights model for normative arbitration.\n    narrative: Human-readable problem statement preserved alongside the schema.",
  "properties": {
    "domain": {
      "$ref": "#/$defs/ProblemDomain",
      "description": "Policy domain classification"
    },
    "hard_constraints": {
      "description": "Inviolable constraints",
      "items": {
        "$ref": "#/$defs/ConstraintSpec"
      },
      "maxItems": 50,
      "title": "Hard Constraints",
      "type": "array"
    },
    "kpis": {
      "description": "Key Performance Indicators",
      "items": {
        "$ref": "#/$defs/KPISpec"
      },
      "maxItems": 30,
      "title": "Kpis",
      "type": "array"
    },
    "labels": {
      "items": {
        "type": "string"
      },
      "maxItems": 20,
      "title": "Labels",
      "type": "array"
    },
    "narrative": {
      "anyOf": [
        {
          "maxLength": 5000,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Human-readable problem description",
      "title": "Narrative"
    },
    "normative_frame": {
      "anyOf": [
        {
          "$ref": "#/$defs/NormativeFrame"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Optional formal normative arbitration model"
    },
    "notes": {
      "items": {
        "type": "string"
      },
      "maxItems": 50,
      "title": "Notes",
      "type": "array"
    },
    "objectives": {
      "description": "Formal optimization objectives",
      "items": {
        "$ref": "#/$defs/ObjectiveSpec"
      },
      "maxItems": 20,
      "title": "Objectives",
      "type": "array"
    },
    "problem_id": {
      "description": "Unique problem identifier",
      "pattern": "^[a-z][a-z0-9_]*$",
      "title": "Problem Id",
      "type": "string"
    },
    "schema_version": {
      "default": "1.0",
      "pattern": "^\\d+\\.\\d+$",
      "title": "Schema Version",
      "type": "string"
    },
    "soft_constraints": {
      "description": "Preferred but flexible constraints",
      "items": {
        "$ref": "#/$defs/ConstraintSpec"
      },
      "maxItems": 50,
      "title": "Soft Constraints",
      "type": "array"
    },
    "stakeholders": {
      "description": "Entities affected by the problem",
      "items": {
        "$ref": "#/$defs/StakeholderSpec"
      },
      "maxItems": 100,
      "title": "Stakeholders",
      "type": "array"
    },
    "success_criteria": {
      "description": "Formal success thresholds",
      "items": {
        "$ref": "#/$defs/SuccessCriterion"
      },
      "maxItems": 20,
      "title": "Success Criteria",
      "type": "array"
    }
  },
  "required": [
    "problem_id",
    "domain"
  ],
  "title": "ProblemFrame",
  "type": "object"
}
