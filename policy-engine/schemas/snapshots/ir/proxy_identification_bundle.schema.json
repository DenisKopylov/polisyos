{
  "$defs": {
    "ContractCompatibilityTarget": {
      "additionalProperties": false,
      "properties": {
        "contract_fqn": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Contract Fqn",
          "type": "string"
        },
        "contract_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Contract Id",
          "type": "string"
        }
      },
      "required": [
        "contract_id",
        "contract_fqn"
      ],
      "title": "ContractCompatibilityTarget",
      "type": "object"
    },
    "ObservationFamily": {
      "enum": [
        "budget_flows",
        "procurement_flows",
        "macro_state",
        "firm_fundamentals",
        "trade_exposure",
        "labor_market",
        "household_distribution",
        "distress_enforcement",
        "spatial_raster_exogenous",
        "public_service_domain_flows",
        "education_human_capital_supply",
        "construction_capital_formation",
        "logistics_friction"
      ],
      "title": "ObservationFamily",
      "type": "string"
    },
    "ProxyChannelSpec": {
      "additionalProperties": false,
      "properties": {
        "family": {
          "$ref": "#/$defs/ObservationFamily"
        },
        "latent_variable": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Latent Variable",
          "type": "string"
        },
        "notes": {
          "items": {
            "type": "string"
          },
          "title": "Notes",
          "type": "array"
        },
        "proxy_variable": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Proxy Variable",
          "type": "string"
        },
        "target_contract": {
          "$ref": "#/$defs/ContractCompatibilityTarget"
        },
        "verification_method": {
          "default": "identify_with_proxy",
          "maxLength": 120,
          "minLength": 1,
          "title": "Verification Method",
          "type": "string"
        }
      },
      "required": [
        "family",
        "proxy_variable",
        "latent_variable",
        "target_contract"
      ],
      "title": "ProxyChannelSpec",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "artifact_name": {
      "const": "proxy_identification_bundle_v1.json",
      "default": "proxy_identification_bundle_v1.json",
      "title": "Artifact Name",
      "type": "string"
    },
    "contract_target": {
      "$ref": "#/$defs/ContractCompatibilityTarget"
    },
    "proxy_channels": {
      "items": {
        "$ref": "#/$defs/ProxyChannelSpec"
      },
      "minItems": 1,
      "title": "Proxy Channels",
      "type": "array"
    },
    "schema_version": {
      "default": "1.0",
      "pattern": "^\\d+\\.\\d+$",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "contract_target",
    "proxy_channels"
  ],
  "title": "ProxyIdentificationBundle",
  "type": "object"
}
