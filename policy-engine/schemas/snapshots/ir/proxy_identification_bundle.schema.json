{
  "$defs": {
    "ContractCompatibilityTarget": {
      "additionalProperties": false,
      "description": "Identifier of a downstream contract that an observation bundle targets.",
      "properties": {
        "contract_fqn": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Contract Fqn",
          "type": "string"
        },
        "contract_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Contract Id",
          "type": "string"
        }
      },
      "required": [
        "contract_id",
        "contract_fqn"
      ],
      "title": "ContractCompatibilityTarget",
      "type": "object"
    },
    "ObservationFamily": {
      "description": "Classify raw evidence into stable observation families for routing.\n\nFamilies partition raw evidence into domains such as budget flows, firm\nfundamentals, or household distribution so measurement rules, governance\ndefaults, and contract compilers can branch on a stable domain label.",
      "enum": [
        "budget_flows",
        "procurement_flows",
        "macro_state",
        "firm_fundamentals",
        "trade_exposure",
        "labor_market",
        "household_distribution",
        "distress_enforcement",
        "spatial_raster_exogenous",
        "public_service_domain_flows",
        "education_human_capital_supply",
        "construction_capital_formation",
        "logistics_friction"
      ],
      "title": "ObservationFamily",
      "type": "string"
    },
    "ProxyChannelSpec": {
      "additionalProperties": false,
      "description": "Proxy-identification contract for one latent measurement pathway.",
      "properties": {
        "family": {
          "$ref": "#/$defs/ObservationFamily"
        },
        "latent_variable": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Latent Variable",
          "type": "string"
        },
        "notes": {
          "items": {
            "type": "string"
          },
          "title": "Notes",
          "type": "array"
        },
        "outcome_variable": {
          "anyOf": [
            {
              "maxLength": 120,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Outcome Variable"
        },
        "proxy_variable": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Proxy Variable",
          "type": "string"
        },
        "target_contract": {
          "$ref": "#/$defs/ContractCompatibilityTarget"
        },
        "treatment_variable": {
          "anyOf": [
            {
              "maxLength": 120,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Treatment Variable"
        },
        "verification_method": {
          "default": "identify_with_proxy",
          "maxLength": 120,
          "minLength": 1,
          "title": "Verification Method",
          "type": "string"
        }
      },
      "required": [
        "family",
        "proxy_variable",
        "latent_variable",
        "target_contract"
      ],
      "title": "ProxyChannelSpec",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Package proxy-identification channels and the compiler payload they target.\n\nThis bundle bridges latent-variable observation families to\n``ProxyMeasurementData``-style contracts and is consumed by proxy readiness\nchecks before proxy-based estimators run.",
  "properties": {
    "artifact_name": {
      "const": "proxy_identification_bundle_v1.json",
      "default": "proxy_identification_bundle_v1.json",
      "title": "Artifact Name",
      "type": "string"
    },
    "contract_payload": {
      "additionalProperties": true,
      "title": "Contract Payload",
      "type": "object"
    },
    "contract_target": {
      "$ref": "#/$defs/ContractCompatibilityTarget"
    },
    "proxy_channels": {
      "items": {
        "$ref": "#/$defs/ProxyChannelSpec"
      },
      "minItems": 1,
      "title": "Proxy Channels",
      "type": "array"
    },
    "proxy_map": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Proxy Map",
      "type": "object"
    },
    "schema_version": {
      "default": "1.0",
      "pattern": "^\\d+\\.\\d+$",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "contract_target",
    "proxy_channels"
  ],
  "title": "ProxyIdentificationBundle",
  "type": "object"
}
