{
  "$defs": {
    "QualityIssue": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "title": "Code",
          "type": "string"
        },
        "context_json": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "items": {},
              "type": "array"
            }
          ],
          "title": "Context Json"
        },
        "msg": {
          "title": "Msg",
          "type": "string"
        },
        "severity": {
          "$ref": "#/$defs/QualityIssueSeverity"
        }
      },
      "required": [
        "code",
        "severity",
        "msg"
      ],
      "title": "QualityIssue",
      "type": "object"
    },
    "QualityIssueSeverity": {
      "enum": [
        "info",
        "warn",
        "error"
      ],
      "title": "QualityIssueSeverity",
      "type": "string"
    },
    "QualityScope": {
      "enum": [
        "docs_pipeline",
        "claims_pipeline",
        "conflict_resolution"
      ],
      "title": "QualityScope",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "algorithm_version": {
      "title": "Algorithm Version",
      "type": "string"
    },
    "issues": {
      "items": {
        "$ref": "#/$defs/QualityIssue"
      },
      "title": "Issues",
      "type": "array"
    },
    "metrics": {
      "additionalProperties": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "integer"
          },
          {
            "type": "boolean"
          }
        ]
      },
      "title": "Metrics",
      "type": "object"
    },
    "policy_id": {
      "pattern": "^[a-z][a-z0-9_.-]*$",
      "title": "Policy Id",
      "type": "string"
    },
    "props": {
      "additionalProperties": true,
      "title": "Props",
      "type": "object"
    },
    "quality_report_id": {
      "pattern": "^[a-z][a-z0-9_.-]*$",
      "title": "Quality Report Id",
      "type": "string"
    },
    "run_event_id": {
      "pattern": "^[a-z][a-z0-9_.-]*$",
      "title": "Run Event Id",
      "type": "string"
    },
    "schema_version": {
      "default": "1.0",
      "pattern": "^\\d+\\.\\d+$",
      "title": "Schema Version",
      "type": "string"
    },
    "scope": {
      "$ref": "#/$defs/QualityScope"
    }
  },
  "required": [
    "quality_report_id",
    "scope",
    "run_event_id",
    "policy_id",
    "algorithm_version"
  ],
  "title": "QualityReport",
  "type": "object"
}
