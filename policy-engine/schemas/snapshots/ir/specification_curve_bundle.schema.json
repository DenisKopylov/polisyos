{
  "$defs": {
    "ObservationFamily": {
      "description": "Classify raw evidence into stable observation families for routing.\n\nFamilies partition raw evidence into domains such as budget flows, firm\nfundamentals, or household distribution so measurement rules, governance\ndefaults, and contract compilers can branch on a stable domain label.",
      "enum": [
        "budget_flows",
        "procurement_flows",
        "macro_state",
        "firm_fundamentals",
        "trade_exposure",
        "labor_market",
        "household_distribution",
        "distress_enforcement",
        "spatial_raster_exogenous",
        "public_service_domain_flows",
        "education_human_capital_supply",
        "construction_capital_formation",
        "logistics_friction"
      ],
      "title": "ObservationFamily",
      "type": "string"
    },
    "SpecificationCurveSource": {
      "additionalProperties": false,
      "description": "One source-combination entry inside a specification-curve bundle.",
      "properties": {
        "included_families": {
          "items": {
            "$ref": "#/$defs/ObservationFamily"
          },
          "minItems": 1,
          "title": "Included Families",
          "type": "array"
        },
        "notes": {
          "items": {
            "type": "string"
          },
          "title": "Notes",
          "type": "array"
        },
        "sensitivity_axes": {
          "items": {
            "type": "string"
          },
          "title": "Sensitivity Axes",
          "type": "array"
        },
        "source_combination_id": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Source Combination Id",
          "type": "string"
        }
      },
      "required": [
        "source_combination_id",
        "included_families"
      ],
      "title": "SpecificationCurveSource",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Persist source combinations and estimates for specification-curve analysis.\n\nScientist robustness tooling reads this bundle to rank specification choices,\nrecompute curve diagnostics, and preserve the observation-family mix behind\neach estimate.",
  "properties": {
    "artifact_name": {
      "const": "specification_curve_input_v1.json",
      "default": "specification_curve_input_v1.json",
      "title": "Artifact Name",
      "type": "string"
    },
    "contract_payload": {
      "additionalProperties": true,
      "title": "Contract Payload",
      "type": "object"
    },
    "estimates": {
      "items": {
        "type": "number"
      },
      "title": "Estimates",
      "type": "array"
    },
    "schema_version": {
      "default": "1.0",
      "pattern": "^\\d+\\.\\d+$",
      "title": "Schema Version",
      "type": "string"
    },
    "source_specifications": {
      "items": {
        "$ref": "#/$defs/SpecificationCurveSource"
      },
      "minItems": 1,
      "title": "Source Specifications",
      "type": "array"
    },
    "specification_ids": {
      "items": {
        "type": "string"
      },
      "title": "Specification Ids",
      "type": "array"
    },
    "standard_errors": {
      "items": {
        "type": "number"
      },
      "title": "Standard Errors",
      "type": "array"
    }
  },
  "required": [
    "source_specifications"
  ],
  "title": "SpecificationCurveBundle",
  "type": "object"
}
