{
  "$defs": {
    "CausalEdge": {
      "additionalProperties": false,
      "description": "Causal edge public type.",
      "properties": {
        "combined_confidence": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Combined Confidence"
        },
        "data_confidence": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Data Confidence"
        },
        "dst": {
          "minLength": 1,
          "title": "Dst",
          "type": "string"
        },
        "evidence_refs": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Refs",
          "type": "array"
        },
        "expert_confidence": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expert Confidence"
        },
        "lag": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Lag"
        },
        "literature_confidence": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Literature Confidence"
        },
        "llm_confidence": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Llm Confidence"
        },
        "mark_dst": {
          "$ref": "#/$defs/EdgeMark",
          "default": "arrow"
        },
        "mark_src": {
          "$ref": "#/$defs/EdgeMark",
          "default": "tail"
        },
        "metadata": {
          "additionalProperties": true,
          "title": "Metadata",
          "type": "object"
        },
        "p_value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "P Value"
        },
        "simulation_confidence": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Simulation Confidence"
        },
        "sources": {
          "items": {
            "$ref": "#/$defs/EdgeSource"
          },
          "title": "Sources",
          "type": "array"
        },
        "src": {
          "minLength": 1,
          "title": "Src",
          "type": "string"
        },
        "unsupported_by_evidence": {
          "default": false,
          "title": "Unsupported By Evidence",
          "type": "boolean"
        }
      },
      "required": [
        "src",
        "dst"
      ],
      "title": "CausalEdge",
      "type": "object"
    },
    "CausalGraphModel": {
      "additionalProperties": false,
      "description": "DAG / CPDAG / PAG / MGRAPH / ADMG causal graph IR contract.",
      "properties": {
        "discovery_method": {
          "default": "",
          "title": "Discovery Method",
          "type": "string"
        },
        "edges": {
          "items": {
            "$ref": "#/$defs/CausalEdge"
          },
          "title": "Edges",
          "type": "array"
        },
        "graph_type": {
          "$ref": "#/$defs/GraphType"
        },
        "id_confidence_under_pag": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Id Confidence Under Pag"
        },
        "metadata": {
          "additionalProperties": true,
          "title": "Metadata",
          "type": "object"
        },
        "nodes": {
          "items": {
            "type": "string"
          },
          "title": "Nodes",
          "type": "array"
        },
        "pag_identification_policy": {
          "$ref": "#/$defs/PAGIdentificationPolicy",
          "default": "conservative"
        },
        "schema_version": {
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "skg_version_id": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Skg Version Id"
        }
      },
      "required": [
        "graph_type",
        "nodes",
        "edges"
      ],
      "title": "CausalGraphModel",
      "type": "object"
    },
    "EdgeMark": {
      "description": "Edge mark public type.",
      "enum": [
        "tail",
        "arrow",
        "circle"
      ],
      "title": "EdgeMark",
      "type": "string"
    },
    "EdgeSource": {
      "description": "Edge source public type.",
      "enum": [
        "data",
        "literature",
        "llm_prior",
        "expert",
        "simulation"
      ],
      "title": "EdgeSource",
      "type": "string"
    },
    "GraphType": {
      "description": "Graph type public type.",
      "enum": [
        "dag",
        "cpdag",
        "pag",
        "mgraph",
        "admg"
      ],
      "title": "GraphType",
      "type": "string"
    },
    "MechanismFamily": {
      "description": "Allowed mechanism families for SCM node equations.",
      "enum": [
        "linear",
        "additive_noise",
        "post_nonlinear",
        "classifier",
        "empirical",
        "parametric_prior"
      ],
      "title": "MechanismFamily",
      "type": "string"
    },
    "MechanismSource": {
      "description": "Where a node mechanism was sourced from.",
      "enum": [
        "data_fitted",
        "literature_prior",
        "hybrid",
        "default"
      ],
      "title": "MechanismSource",
      "type": "string"
    },
    "NodeMechanism": {
      "additionalProperties": false,
      "description": "Structural equation metadata for one variable in an SCM.",
      "properties": {
        "family": {
          "$ref": "#/$defs/MechanismFamily"
        },
        "family_params": {
          "additionalProperties": true,
          "title": "Family Params",
          "type": "object"
        },
        "literature_prior": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Literature Prior"
        },
        "noise_distribution": {
          "default": "empirical",
          "title": "Noise Distribution",
          "type": "string"
        },
        "parents": {
          "items": {
            "type": "string"
          },
          "title": "Parents",
          "type": "array"
        },
        "sensitivity_to_latent": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sensitivity To Latent"
        },
        "source": {
          "$ref": "#/$defs/MechanismSource",
          "default": "data_fitted"
        },
        "variable": {
          "title": "Variable",
          "type": "string"
        }
      },
      "required": [
        "variable",
        "family"
      ],
      "title": "NodeMechanism",
      "type": "object"
    },
    "PAGIdentificationPolicy": {
      "description": "PAG identification policy data model.",
      "enum": [
        "conservative",
        "optimistic",
        "probabilistic"
      ],
      "title": "PAGIdentificationPolicy",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Serializable structural causal model with graph and node mechanisms.",
  "properties": {
    "fit_method": {
      "anyOf": [
        {
          "enum": [
            "auto",
            "manual",
            "gcm",
            "hybrid"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Fit Method"
    },
    "fit_metrics": {
      "additionalProperties": {
        "type": "number"
      },
      "title": "Fit Metrics",
      "type": "object"
    },
    "fitted": {
      "default": false,
      "title": "Fitted",
      "type": "boolean"
    },
    "graph": {
      "$ref": "#/$defs/CausalGraphModel"
    },
    "mechanism_source_summary": {
      "additionalProperties": {
        "type": "integer"
      },
      "title": "Mechanism Source Summary",
      "type": "object"
    },
    "mechanisms": {
      "items": {
        "$ref": "#/$defs/NodeMechanism"
      },
      "title": "Mechanisms",
      "type": "array"
    },
    "schema_version": {
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "skg_snapshot_ref": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Skg Snapshot Ref"
    }
  },
  "required": [
    "graph"
  ],
  "title": "StructuralCausalModelSpec",
  "type": "object"
}
