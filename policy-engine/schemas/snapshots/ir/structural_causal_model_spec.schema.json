{
  "$defs": {
    "ArtifactID": {
      "description": "IR-local artifact ID model compatible with CAS interfaces.",
      "title": "ArtifactID",
      "type": "string"
    },
    "ArtifactRefModel": {
      "additionalProperties": false,
      "description": "Provide the common mapping-compatible base contract for artifact refs.",
      "properties": {
        "artifact_id": {
          "$ref": "#/$defs/ArtifactID"
        },
        "kind": {
          "title": "Kind",
          "type": "string"
        },
        "media_type": {
          "title": "Media Type",
          "type": "string"
        }
      },
      "required": [
        "artifact_id",
        "kind",
        "media_type"
      ],
      "title": "ArtifactRefModel",
      "type": "object"
    },
    "CausalEdge": {
      "additionalProperties": false,
      "description": "Causal edge public type.",
      "properties": {
        "combined_confidence": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Combined Confidence"
        },
        "data_confidence": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Data Confidence"
        },
        "dst": {
          "minLength": 1,
          "title": "Dst",
          "type": "string"
        },
        "evidence_refs": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Refs",
          "type": "array"
        },
        "expert_confidence": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expert Confidence"
        },
        "lag": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Lag"
        },
        "literature_confidence": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Literature Confidence"
        },
        "llm_confidence": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Llm Confidence"
        },
        "mark_dst": {
          "$ref": "#/$defs/EdgeMark",
          "default": "arrow"
        },
        "mark_src": {
          "$ref": "#/$defs/EdgeMark",
          "default": "tail"
        },
        "metadata": {
          "additionalProperties": true,
          "title": "Metadata",
          "type": "object"
        },
        "p_value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "P Value"
        },
        "simulation_confidence": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Simulation Confidence"
        },
        "sources": {
          "items": {
            "$ref": "#/$defs/EdgeSource"
          },
          "title": "Sources",
          "type": "array"
        },
        "src": {
          "minLength": 1,
          "title": "Src",
          "type": "string"
        },
        "unsupported_by_evidence": {
          "default": false,
          "title": "Unsupported By Evidence",
          "type": "boolean"
        }
      },
      "required": [
        "src",
        "dst"
      ],
      "title": "CausalEdge",
      "type": "object"
    },
    "CausalGraphModel": {
      "additionalProperties": false,
      "description": "DAG / CPDAG / PAG / MGRAPH / ADMG causal graph IR contract.",
      "properties": {
        "discovery_method": {
          "default": "",
          "title": "Discovery Method",
          "type": "string"
        },
        "edges": {
          "items": {
            "$ref": "#/$defs/CausalEdge"
          },
          "title": "Edges",
          "type": "array"
        },
        "graph_type": {
          "$ref": "#/$defs/GraphType"
        },
        "id_confidence_under_pag": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Id Confidence Under Pag"
        },
        "metadata": {
          "additionalProperties": true,
          "title": "Metadata",
          "type": "object"
        },
        "nodes": {
          "items": {
            "type": "string"
          },
          "title": "Nodes",
          "type": "array"
        },
        "pag_identification_policy": {
          "$ref": "#/$defs/PAGIdentificationPolicy",
          "default": "conservative"
        },
        "schema_version": {
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "skg_version_id": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Skg Version Id"
        }
      },
      "required": [
        "graph_type",
        "nodes",
        "edges"
      ],
      "title": "CausalGraphModel",
      "type": "object"
    },
    "EdgeMark": {
      "description": "Edge mark public type.",
      "enum": [
        "tail",
        "arrow",
        "circle"
      ],
      "title": "EdgeMark",
      "type": "string"
    },
    "EdgeSource": {
      "description": "Edge source public type.",
      "enum": [
        "data",
        "literature",
        "llm_prior",
        "expert",
        "simulation"
      ],
      "title": "EdgeSource",
      "type": "string"
    },
    "GraphType": {
      "description": "Graph type public type.",
      "enum": [
        "dag",
        "cpdag",
        "pag",
        "mgraph",
        "admg"
      ],
      "title": "GraphType",
      "type": "string"
    },
    "MechanismFamily": {
      "description": "Allowed mechanism families for SCM node equations.",
      "enum": [
        "linear",
        "additive_noise",
        "post_nonlinear",
        "classifier",
        "empirical",
        "parametric_prior"
      ],
      "title": "MechanismFamily",
      "type": "string"
    },
    "MechanismSource": {
      "description": "Where a node mechanism was sourced from.",
      "enum": [
        "data_fitted",
        "literature_prior",
        "hybrid",
        "default"
      ],
      "title": "MechanismSource",
      "type": "string"
    },
    "NodeMechanism": {
      "additionalProperties": false,
      "description": "Structural equation metadata for one variable in an SCM.",
      "properties": {
        "family": {
          "$ref": "#/$defs/MechanismFamily"
        },
        "family_params": {
          "additionalProperties": true,
          "title": "Family Params",
          "type": "object"
        },
        "literature_prior": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Literature Prior"
        },
        "noise_distribution": {
          "default": "empirical",
          "title": "Noise Distribution",
          "type": "string"
        },
        "parents": {
          "items": {
            "type": "string"
          },
          "title": "Parents",
          "type": "array"
        },
        "sensitivity_to_latent": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sensitivity To Latent"
        },
        "source": {
          "$ref": "#/$defs/MechanismSource",
          "default": "data_fitted"
        },
        "variable": {
          "title": "Variable",
          "type": "string"
        }
      },
      "required": [
        "variable",
        "family"
      ],
      "title": "NodeMechanism",
      "type": "object"
    },
    "PAGIdentificationPolicy": {
      "description": "PAG identification policy data model.",
      "enum": [
        "conservative",
        "optimistic",
        "probabilistic"
      ],
      "title": "PAGIdentificationPolicy",
      "type": "string"
    },
    "SCMFitProvenance": {
      "additionalProperties": false,
      "description": "Observed selected-worker identities for an actual GCM mechanism fit.",
      "properties": {
        "fit_function": {
          "const": "dowhy.gcm.fit",
          "default": "dowhy.gcm.fit",
          "title": "Fit Function",
          "type": "string"
        },
        "profile": {
          "const": "dowhy-014",
          "default": "dowhy-014",
          "title": "Profile",
          "type": "string"
        },
        "python": {
          "pattern": "^3\\.12\\.\\d+$",
          "title": "Python",
          "type": "string"
        },
        "request_id": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Request Id",
          "type": "string"
        },
        "request_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Request Sha256",
          "type": "string"
        },
        "resample_indices": {
          "anyOf": [
            {
              "items": {
                "type": "integer"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Resample Indices"
        },
        "seed": {
          "title": "Seed",
          "type": "integer"
        },
        "versions": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Versions",
          "type": "object"
        },
        "worker_code_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Worker Code Sha256",
          "type": "string"
        },
        "worker_lock_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Worker Lock Sha256",
          "type": "string"
        },
        "worker_response": {
          "additionalProperties": true,
          "title": "Worker Response",
          "type": "object"
        }
      },
      "required": [
        "python",
        "versions",
        "seed",
        "request_id",
        "request_sha256",
        "worker_code_sha256",
        "worker_lock_sha256",
        "worker_response"
      ],
      "title": "SCMFitProvenance",
      "type": "object"
    },
    "SCMTrainingRows": {
      "additionalProperties": false,
      "description": "Content-bound aligned observational rows retained for complete refits.\n\nHash reconciliation checks content; the parent CAS resolver establishes\nsource custody. Neither establishes the iid law or causal identification.",
      "properties": {
        "columns": {
          "items": {
            "type": "string"
          },
          "title": "Columns",
          "type": "array"
        },
        "data_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Data Sha256",
          "type": "string"
        },
        "fit_input": {
          "additionalProperties": true,
          "title": "Fit Input",
          "type": "object"
        },
        "graph_payload": {
          "additionalProperties": true,
          "title": "Graph Payload",
          "type": "object"
        },
        "graph_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Graph Sha256",
          "type": "string"
        },
        "row_ids": {
          "items": {
            "type": "string"
          },
          "title": "Row Ids",
          "type": "array"
        },
        "row_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Row Sha256",
          "type": "string"
        },
        "rows": {
          "items": {
            "items": {
              "type": "number"
            },
            "type": "array"
          },
          "title": "Rows",
          "type": "array"
        },
        "source_ref": {
          "$ref": "#/$defs/ArtifactRefModel"
        },
        "source_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Source Sha256",
          "type": "string"
        }
      },
      "required": [
        "rows",
        "columns",
        "row_ids",
        "source_ref",
        "source_sha256",
        "data_sha256",
        "row_sha256",
        "graph_sha256",
        "graph_payload",
        "fit_input"
      ],
      "title": "SCMTrainingRows",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Serializable structural causal model with graph and node mechanisms.",
  "properties": {
    "fit_method": {
      "anyOf": [
        {
          "enum": [
            "auto",
            "manual",
            "gcm",
            "hybrid",
            "native_hybrid"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Fit Method"
    },
    "fit_metrics": {
      "additionalProperties": {
        "type": "number"
      },
      "title": "Fit Metrics",
      "type": "object"
    },
    "fit_provenance": {
      "anyOf": [
        {
          "$ref": "#/$defs/SCMFitProvenance"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "fitted": {
      "default": false,
      "title": "Fitted",
      "type": "boolean"
    },
    "graph": {
      "$ref": "#/$defs/CausalGraphModel"
    },
    "mechanism_source_summary": {
      "additionalProperties": {
        "type": "integer"
      },
      "title": "Mechanism Source Summary",
      "type": "object"
    },
    "mechanisms": {
      "items": {
        "$ref": "#/$defs/NodeMechanism"
      },
      "title": "Mechanisms",
      "type": "array"
    },
    "schema_version": {
      "default": "1.1",
      "title": "Schema Version",
      "type": "string"
    },
    "skg_snapshot_ref": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Skg Snapshot Ref"
    },
    "training_rows": {
      "anyOf": [
        {
          "$ref": "#/$defs/SCMTrainingRows"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "graph"
  ],
  "title": "StructuralCausalModelSpec",
  "type": "object"
}
