{
  "$defs": {
    "BundleLineageRef": {
      "additionalProperties": false,
      "description": "Lineage edge from a bundle back to an upstream observation artifact.",
      "properties": {
        "notes": {
          "items": {
            "type": "string"
          },
          "title": "Notes",
          "type": "array"
        },
        "source_artifact": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Source Artifact",
          "type": "string"
        },
        "source_confidence_tier": {
          "$ref": "#/$defs/SourceConfidenceTier",
          "default": "validated"
        },
        "source_family": {
          "anyOf": [
            {
              "$ref": "#/$defs/ObservationFamily"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "source_artifact"
      ],
      "title": "BundleLineageRef",
      "type": "object"
    },
    "ContractCompatibilityTarget": {
      "additionalProperties": false,
      "description": "Identifier of a downstream contract that an observation bundle targets.",
      "properties": {
        "contract_fqn": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Contract Fqn",
          "type": "string"
        },
        "contract_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Contract Id",
          "type": "string"
        }
      },
      "required": [
        "contract_id",
        "contract_fqn"
      ],
      "title": "ContractCompatibilityTarget",
      "type": "object"
    },
    "ObservationFamily": {
      "description": "Classify raw evidence into stable observation families for routing.\n\nFamilies partition raw evidence into domains such as budget flows, firm\nfundamentals, or household distribution so measurement rules, governance\ndefaults, and contract compilers can branch on a stable domain label.",
      "enum": [
        "budget_flows",
        "procurement_flows",
        "macro_state",
        "firm_fundamentals",
        "trade_exposure",
        "labor_market",
        "household_distribution",
        "distress_enforcement",
        "spatial_raster_exogenous",
        "public_service_domain_flows",
        "education_human_capital_supply",
        "construction_capital_formation",
        "logistics_friction"
      ],
      "title": "ObservationFamily",
      "type": "string"
    },
    "RequiredColumnSpec": {
      "additionalProperties": false,
      "description": "Manifest entry describing a required tabular column.",
      "properties": {
        "description": {
          "anyOf": [
            {
              "maxLength": 255,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "dtype": {
          "anyOf": [
            {
              "maxLength": 64,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Dtype"
        },
        "name": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "nullable": {
          "default": false,
          "title": "Nullable",
          "type": "boolean"
        }
      },
      "required": [
        "name"
      ],
      "title": "RequiredColumnSpec",
      "type": "object"
    },
    "SourceConfidenceTier": {
      "description": "Declare the raw provenance tier consumed by measurement trust normalization.\n\n:class:`polisyos.ir.observation.measurement.MeasurementRegistry` maps this\nsource-side tier and coverage metadata into a ``MeasurementTrustTier`` used\nby calibration losses and readiness routing.",
      "enum": [
        "core",
        "validated",
        "exploratory"
      ],
      "title": "SourceConfidenceTier",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Describe survival-analysis tables consumed by hazard or duration models.",
  "properties": {
    "artifact_name": {
      "const": "survival_data_bundle_v1.parquet",
      "default": "survival_data_bundle_v1.parquet",
      "title": "Artifact Name",
      "type": "string"
    },
    "contract_payload": {
      "additionalProperties": true,
      "title": "Contract Payload",
      "type": "object"
    },
    "contract_target": {
      "$ref": "#/$defs/ContractCompatibilityTarget"
    },
    "lineage": {
      "items": {
        "$ref": "#/$defs/BundleLineageRef"
      },
      "title": "Lineage",
      "type": "array"
    },
    "required_columns": {
      "items": {
        "$ref": "#/$defs/RequiredColumnSpec"
      },
      "minItems": 1,
      "title": "Required Columns",
      "type": "array"
    },
    "schema_version": {
      "default": "1.0",
      "pattern": "^\\d+\\.\\d+$",
      "title": "Schema Version",
      "type": "string"
    },
    "table_rows": {
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "title": "Table Rows",
      "type": "array"
    }
  },
  "required": [
    "contract_target",
    "required_columns"
  ],
  "title": "SurvivalDataBundleManifest",
  "type": "object"
}
