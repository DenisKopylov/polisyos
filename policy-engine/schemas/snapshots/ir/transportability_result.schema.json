{
  "$defs": {
    "BoundMethod": {
      "description": "Bound method public type.",
      "enum": [
        "manski_bounds",
        "transport_bounds",
        "iv_bounds",
        "monotone_treatment",
        "lp_balke_pearl",
        "imbens_manski_ci",
        "mtr_bounds",
        "miv_bounds",
        "mts_bounds",
        "general_lp_bounds",
        "copula_bounds",
        "tan_bounds",
        "intersection_bounds",
        "rosenbaum_sharp"
      ],
      "title": "BoundMethod",
      "type": "string"
    },
    "DataGap": {
      "additionalProperties": false,
      "description": "Data gap public type.",
      "properties": {
        "available_proxies": {
          "items": {
            "$ref": "#/$defs/ProxyCandidate"
          },
          "title": "Available Proxies",
          "type": "array"
        },
        "best_proxy_confidence": {
          "default": 0.0,
          "title": "Best Proxy Confidence",
          "type": "number"
        },
        "gap_impact": {
          "title": "Gap Impact",
          "type": "string"
        },
        "required_context": {
          "title": "Required Context",
          "type": "string"
        },
        "required_variable": {
          "title": "Required Variable",
          "type": "string"
        },
        "suggested_action": {
          "title": "Suggested Action",
          "type": "string"
        }
      },
      "required": [
        "required_variable",
        "required_context",
        "gap_impact",
        "suggested_action"
      ],
      "title": "DataGap",
      "type": "object"
    },
    "DistributionType": {
      "description": "Distribution type public type.",
      "enum": [
        "point",
        "empirical",
        "kde",
        "normal",
        "bounded"
      ],
      "title": "DistributionType",
      "type": "string"
    },
    "PAGIdentificationPolicy": {
      "description": "PAG identification policy data model.",
      "enum": [
        "conservative",
        "optimistic",
        "probabilistic"
      ],
      "title": "PAGIdentificationPolicy",
      "type": "string"
    },
    "PStarZResult": {
      "additionalProperties": false,
      "description": "Computed P*(Z) (or P*(Z|X)) value with provenance.",
      "properties": {
        "canonical_variable": {
          "title": "Canonical Variable",
          "type": "string"
        },
        "ci_high": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ci High"
        },
        "ci_low": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ci Low"
        },
        "condition_on": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Condition On",
          "type": "object"
        },
        "confidence": {
          "default": 0.0,
          "title": "Confidence",
          "type": "number"
        },
        "data_support_country": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Data Support Country"
        },
        "data_support_year": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Data Support Year"
        },
        "dataset_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Dataset Id"
        },
        "distribution": {
          "anyOf": [
            {
              "items": {
                "type": "number"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Distribution"
        },
        "distribution_type": {
          "$ref": "#/$defs/DistributionType",
          "default": "point"
        },
        "imputation_method": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Imputation Method"
        },
        "imputation_penalty": {
          "default": 0.0,
          "title": "Imputation Penalty",
          "type": "number"
        },
        "is_conditional": {
          "default": false,
          "title": "Is Conditional",
          "type": "boolean"
        },
        "is_proxy": {
          "default": false,
          "title": "Is Proxy",
          "type": "boolean"
        },
        "penalty_breakdown": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Penalty Breakdown",
          "type": "object"
        },
        "proxy_chain": {
          "items": {
            "type": "string"
          },
          "title": "Proxy Chain",
          "type": "array"
        },
        "raw_variable": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Raw Variable"
        },
        "std_error": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Std Error"
        },
        "uncertainty_sources": {
          "items": {
            "type": "string"
          },
          "title": "Uncertainty Sources",
          "type": "array"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Value"
        }
      },
      "required": [
        "canonical_variable",
        "value",
        "dataset_id",
        "raw_variable"
      ],
      "title": "PStarZResult",
      "type": "object"
    },
    "PartialIdentificationResult": {
      "additionalProperties": false,
      "description": "Result of partial identification analysis (e.g., Manski bounds on ATE).",
      "properties": {
        "assumptions_used": {
          "items": {
            "type": "string"
          },
          "title": "Assumptions Used",
          "type": "array"
        },
        "assumptions_violated": {
          "items": {
            "type": "string"
          },
          "title": "Assumptions Violated",
          "type": "array"
        },
        "bound_width": {
          "default": 0.0,
          "title": "Bound Width",
          "type": "number"
        },
        "bounds_type": {
          "default": "manski",
          "enum": [
            "sharp_lp",
            "relaxed_polynomial",
            "manski"
          ],
          "title": "Bounds Type",
          "type": "string"
        },
        "chart_type": {
          "default": "interval",
          "title": "Chart Type",
          "type": "string"
        },
        "confidence": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Confidence",
          "type": "number"
        },
        "discretization_converged": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Discretization Converged"
        },
        "discretization_method": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Discretization Method"
        },
        "display_label": {
          "default": "",
          "title": "Display Label",
          "type": "string"
        },
        "informativeness_threshold": {
          "default": 0.5,
          "title": "Informativeness Threshold",
          "type": "number"
        },
        "is_informative": {
          "default": true,
          "title": "Is Informative",
          "type": "boolean"
        },
        "lower_bound": {
          "title": "Lower Bound",
          "type": "number"
        },
        "method": {
          "$ref": "#/$defs/BoundMethod"
        },
        "n_bins_final": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "N Bins Final"
        },
        "n_refinement_steps": {
          "default": 0,
          "minimum": 0,
          "title": "N Refinement Steps",
          "type": "integer"
        },
        "relaxation_gap": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Relaxation Gap"
        },
        "schema_version": {
          "default": "1.0",
          "pattern": "^\\d+\\.\\d+$",
          "title": "Schema Version",
          "type": "string"
        },
        "upper_bound": {
          "title": "Upper Bound",
          "type": "number"
        }
      },
      "required": [
        "method",
        "lower_bound",
        "upper_bound",
        "confidence"
      ],
      "title": "PartialIdentificationResult",
      "type": "object"
    },
    "ProxyCandidate": {
      "additionalProperties": false,
      "description": "Single proxy variable candidate for a missing target variable.",
      "properties": {
        "base_correlation": {
          "title": "Base Correlation",
          "type": "number"
        },
        "context_adjustment": {
          "title": "Context Adjustment",
          "type": "number"
        },
        "effective_confidence": {
          "title": "Effective Confidence",
          "type": "number"
        },
        "proxy_dataset_id": {
          "title": "Proxy Dataset Id",
          "type": "string"
        },
        "proxy_raw_name": {
          "title": "Proxy Raw Name",
          "type": "string"
        },
        "proxy_variable": {
          "title": "Proxy Variable",
          "type": "string"
        },
        "source": {
          "enum": [
            "meta_analysis",
            "seed_table",
            "skg_correlation"
          ],
          "title": "Source",
          "type": "string"
        }
      },
      "required": [
        "proxy_variable",
        "proxy_dataset_id",
        "proxy_raw_name",
        "base_correlation",
        "context_adjustment",
        "effective_confidence",
        "source"
      ],
      "title": "ProxyCandidate",
      "type": "object"
    },
    "SNode": {
      "additionalProperties": false,
      "description": "S node implementation.",
      "properties": {
        "context_dimension": {
          "title": "Context Dimension",
          "type": "string"
        },
        "delta": {
          "title": "Delta",
          "type": "number"
        },
        "legal_constraint_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Legal Constraint Id"
        },
        "origin": {
          "$ref": "#/$defs/SNodeOrigin",
          "default": "context_delta"
        },
        "role": {
          "anyOf": [
            {
              "$ref": "#/$defs/SNodeRole"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "severity": {
          "enum": [
            "low",
            "medium",
            "high"
          ],
          "title": "Severity",
          "type": "string"
        },
        "source_value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "string"
            }
          ],
          "title": "Source Value"
        },
        "target_value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "string"
            }
          ],
          "title": "Target Value"
        },
        "target_variable": {
          "title": "Target Variable",
          "type": "string"
        }
      },
      "required": [
        "target_variable",
        "context_dimension",
        "source_value",
        "target_value",
        "delta",
        "severity"
      ],
      "title": "SNode",
      "type": "object"
    },
    "SNodeOrigin": {
      "description": "Classify why a selection node appears in a transportability diagram.",
      "enum": [
        "context_delta",
        "legal",
        "data_mismatch"
      ],
      "title": "SNodeOrigin",
      "type": "string"
    },
    "SNodeRole": {
      "description": "Declare the causal role used when deciding whether an S-node is adjustable.",
      "enum": [
        "pre_treatment_covariate",
        "mediator",
        "collider",
        "instrument"
      ],
      "title": "SNodeRole",
      "type": "string"
    },
    "StratificationVariable": {
      "additionalProperties": false,
      "description": "Stratification variable public type.",
      "properties": {
        "condition_on_treatment": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Condition On Treatment"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "requires_conditional": {
          "title": "Requires Conditional",
          "type": "boolean"
        },
        "role": {
          "$ref": "#/$defs/SNodeRole"
        }
      },
      "required": [
        "name",
        "role",
        "requires_conditional"
      ],
      "title": "StratificationVariable",
      "type": "object"
    },
    "TransportFormula": {
      "additionalProperties": false,
      "description": "Transport formula public type.",
      "properties": {
        "adjustment_type": {
          "default": "direct",
          "title": "Adjustment Type",
          "type": "string"
        },
        "formula_str": {
          "title": "Formula Str",
          "type": "string"
        },
        "source_quantities": {
          "items": {
            "type": "string"
          },
          "title": "Source Quantities",
          "type": "array"
        },
        "stratification_details": {
          "items": {
            "$ref": "#/$defs/StratificationVariable"
          },
          "title": "Stratification Details",
          "type": "array"
        },
        "stratification_variables": {
          "items": {
            "type": "string"
          },
          "title": "Stratification Variables",
          "type": "array"
        },
        "target_quantities": {
          "items": {
            "type": "string"
          },
          "title": "Target Quantities",
          "type": "array"
        }
      },
      "required": [
        "formula_str"
      ],
      "title": "TransportFormula",
      "type": "object"
    },
    "TransportMode": {
      "description": "Describe the execution path implied by a ``TransportabilityResult``.",
      "enum": [
        "direct",
        "transport_formula",
        "bounds_only",
        "none"
      ],
      "title": "TransportMode",
      "type": "string"
    },
    "TransportabilityStatus": {
      "description": "Report whether transportability is identified, bounded, or blocked.\n\nReadiness gates and reporting code inspect this status to decide whether a\ntransported estimate can proceed directly, requires partial-identification\nfallback, or must be treated as unsupported.",
      "enum": [
        "identified",
        "partially_identified",
        "bounded_non_identified",
        "unsupported"
      ],
      "title": "TransportabilityStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Persist the transportability decision, formula, and fallback diagnostics.\n\nReadiness gates and reporting layers inspect ``status`` and\n``transport_mode`` to decide whether a query can be transported directly,\nrequires a transport formula, falls back to bounds, or is unsupported. The\nmodel also upgrades legacy payload aliases so older persisted artifacts can\nstill be read during migration. Normalization happens before instance\ncreation so validated models no longer rewrite their own fields.",
  "properties": {
    "algorithm_version": {
      "default": "trso_v2",
      "title": "Algorithm Version",
      "type": "string"
    },
    "assumes_time_stationarity": {
      "default": true,
      "title": "Assumes Time Stationarity",
      "type": "boolean"
    },
    "base_confidence": {
      "default": 1.0,
      "title": "Base Confidence",
      "type": "number"
    },
    "blocking_s_nodes": {
      "items": {
        "$ref": "#/$defs/SNode"
      },
      "title": "Blocking S Nodes",
      "type": "array"
    },
    "context_distance_penalty": {
      "default": 0.0,
      "title": "Context Distance Penalty",
      "type": "number"
    },
    "data_availability_penalty": {
      "default": 0.0,
      "title": "Data Availability Penalty",
      "type": "number"
    },
    "data_gaps": {
      "items": {
        "$ref": "#/$defs/DataGap"
      },
      "title": "Data Gaps",
      "type": "array"
    },
    "estimand_ast": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Estimand Ast"
    },
    "expert_review_reasons": {
      "items": {
        "type": "string"
      },
      "title": "Expert Review Reasons",
      "type": "array"
    },
    "feasible": {
      "default": true,
      "title": "Feasible",
      "type": "boolean"
    },
    "final_confidence": {
      "default": 1.0,
      "title": "Final Confidence",
      "type": "number"
    },
    "hard_legal_constraints": {
      "items": {
        "type": "string"
      },
      "title": "Hard Legal Constraints",
      "type": "array"
    },
    "id_confidence_under_pag": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Id Confidence Under Pag"
    },
    "identification_engine": {
      "default": "simplified_legacy",
      "title": "Identification Engine",
      "type": "string"
    },
    "identification_trace": {
      "items": {
        "type": "string"
      },
      "title": "Identification Trace",
      "type": "array"
    },
    "identified_region": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Identified Region"
    },
    "lagged_edge_count": {
      "default": 0,
      "minimum": 0,
      "title": "Lagged Edge Count",
      "type": "integer"
    },
    "lagged_edges_in_query": {
      "default": false,
      "title": "Lagged Edges In Query",
      "type": "boolean"
    },
    "legal_s_nodes": {
      "items": {
        "$ref": "#/$defs/SNode"
      },
      "title": "Legal S Nodes",
      "type": "array"
    },
    "metadata": {
      "additionalProperties": true,
      "title": "Metadata",
      "type": "object"
    },
    "notes": {
      "items": {
        "type": "string"
      },
      "title": "Notes",
      "type": "array"
    },
    "outer_search_best_score": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Outer Search Best Score"
    },
    "outer_search_configs_evaluated": {
      "default": 0,
      "minimum": 0,
      "title": "Outer Search Configs Evaluated",
      "type": "integer"
    },
    "outer_search_truncated": {
      "default": false,
      "title": "Outer Search Truncated",
      "type": "boolean"
    },
    "p_star_values": {
      "additionalProperties": {
        "$ref": "#/$defs/PStarZResult"
      },
      "title": "P Star Values",
      "type": "object"
    },
    "pag_dag_sample_size": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Pag Dag Sample Size"
    },
    "pag_identification_policy": {
      "anyOf": [
        {
          "$ref": "#/$defs/PAGIdentificationPolicy"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "pag_transportable_count": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Pag Transportable Count"
    },
    "partial_identification_result": {
      "anyOf": [
        {
          "$ref": "#/$defs/PartialIdentificationResult"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "proxy_penalties": {
      "additionalProperties": {
        "type": "number"
      },
      "title": "Proxy Penalties",
      "type": "object"
    },
    "proxy_validity": {
      "additionalProperties": {
        "additionalProperties": true,
        "type": "object"
      },
      "title": "Proxy Validity",
      "type": "object"
    },
    "query": {
      "default": "",
      "title": "Query",
      "type": "string"
    },
    "required_target_data": {
      "items": {
        "type": "string"
      },
      "title": "Required Target Data",
      "type": "array"
    },
    "requires_expert_review": {
      "default": false,
      "title": "Requires Expert Review",
      "type": "boolean"
    },
    "resolution_rounds": {
      "default": 1,
      "minimum": 1,
      "title": "Resolution Rounds",
      "type": "integer"
    },
    "schema_version": {
      "default": "2.0",
      "pattern": "^\\d+\\.\\d+$",
      "title": "Schema Version",
      "type": "string"
    },
    "search_budget_exhausted": {
      "default": false,
      "title": "Search Budget Exhausted",
      "type": "boolean"
    },
    "search_events": {
      "items": {
        "type": "string"
      },
      "title": "Search Events",
      "type": "array"
    },
    "selection_diagram_ref": {
      "default": "",
      "title": "Selection Diagram Ref",
      "type": "string"
    },
    "source_context_id": {
      "default": "",
      "title": "Source Context Id",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/TransportabilityStatus",
      "default": "identified"
    },
    "sutva_assumed": {
      "default": true,
      "title": "Sutva Assumed",
      "type": "boolean"
    },
    "sutva_violation_risk": {
      "anyOf": [
        {
          "enum": [
            "high",
            "medium",
            "low"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Sutva Violation Risk"
    },
    "target_context_id": {
      "default": "",
      "title": "Target Context Id",
      "type": "string"
    },
    "temporal_distance_penalty": {
      "default": 0.0,
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Temporal Distance Penalty",
      "type": "number"
    },
    "time_stationarity_warning": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Time Stationarity Warning"
    },
    "transport_formula": {
      "anyOf": [
        {
          "$ref": "#/$defs/TransportFormula"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "transport_mode": {
      "$ref": "#/$defs/TransportMode",
