{
  "$defs": {
    "DistributionFamily": {
      "description": "Declare the assumed sampling/posterior family behind an interval estimate.",
      "enum": [
        "normal",
        "bootstrap",
        "bayesian",
        "uniform",
        "triangular",
        "unknown"
      ],
      "title": "DistributionFamily",
      "type": "string"
    },
    "IntervalSemantics": {
      "description": "Tell governance/reporting whether an interval is statistical or heuristic.\n\n``UncertaintyEnvelope`` validators use this enum to enforce when\n``confidence_level`` must be present and when the interval must be marked\nnon-gate-eligible.",
      "enum": [
        "confidence_interval",
        "credible_interval",
        "deterministic_bounds",
        "heuristic_range"
      ],
      "title": "IntervalSemantics",
      "type": "string"
    },
    "PropagationMethod": {
      "description": "Declare how uncertainty was propagated before the interval reached the IR.",
      "enum": [
        "delta_method",
        "monte_carlo",
        "analytical",
        "none"
      ],
      "title": "PropagationMethod",
      "type": "string"
    },
    "UncertaintySource": {
      "description": "Origin of the uncertainty interval carried in the IR.",
      "enum": [
        "calibration",
        "trust",
        "conflict_resolution",
        "causal",
        "bootstrap",
        "ensemble",
        "manual"
      ],
      "title": "UncertaintySource",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Unified uncertainty contract for Policy OS IR layer.",
  "properties": {
    "confidence_interval": {
      "maxItems": 2,
      "minItems": 2,
      "prefixItems": [
        {
          "type": "number"
        },
        {
          "type": "number"
        }
      ],
      "title": "Confidence Interval",
      "type": "array"
    },
    "confidence_level": {
      "anyOf": [
        {
          "exclusiveMaximum": 1.0,
          "exclusiveMinimum": 0.0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": 0.95,
      "title": "Confidence Level"
    },
    "distribution_family": {
      "$ref": "#/$defs/DistributionFamily",
      "default": "unknown"
    },
    "gate_eligible": {
      "default": true,
      "title": "Gate Eligible",
      "type": "boolean"
    },
    "interval_semantics": {
      "$ref": "#/$defs/IntervalSemantics",
      "default": "confidence_interval"
    },
    "is_heuristic_ci": {
      "default": false,
      "title": "Is Heuristic Ci",
      "type": "boolean"
    },
    "metadata": {
      "additionalProperties": true,
      "title": "Metadata",
      "type": "object"
    },
    "point_estimate": {
      "title": "Point Estimate",
      "type": "number"
    },
    "propagation_method": {
      "$ref": "#/$defs/PropagationMethod",
      "default": "none"
    },
    "sample_size": {
      "anyOf": [
        {
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Sample Size"
    },
    "schema_version": {
      "default": "1.0",
      "pattern": "^\\d+\\.\\d+$",
      "title": "Schema Version",
      "type": "string"
    },
    "source": {
      "$ref": "#/$defs/UncertaintySource"
    }
  },
  "required": [
    "point_estimate",
    "confidence_interval",
    "source"
  ],
  "title": "UncertaintyEnvelope",
  "type": "object"
}
