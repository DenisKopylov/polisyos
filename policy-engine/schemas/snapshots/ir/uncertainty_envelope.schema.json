{
  "$defs": {
    "CertificateKind": {
      "description": "Machine-readable approximation/error certificate attached to a composition chain.",
      "enum": [
        "exact",
        "kolmogorov",
        "wasserstein_1",
        "taylor_remainder",
        "qmc_variation",
        "rqmc_replicates"
      ],
      "title": "CertificateKind",
      "type": "string"
    },
    "ComposedFlavour": {
      "description": "Declare the native and composed family used to transport uncertainty.",
      "enum": [
        "analytical",
        "monte_carlo",
        "delta",
        "quasi_monte_carlo",
        "mixed"
      ],
      "title": "ComposedFlavour",
      "type": "string"
    },
    "CompositionProvenance": {
      "additionalProperties": false,
      "description": "Persist the history, exactness, and certificates behind a composed envelope.",
      "properties": {
        "native_flavour": {
          "$ref": "#/$defs/ComposedFlavour"
        },
        "composed_flavour": {
          "$ref": "#/$defs/ComposedFlavour"
        },
        "exactness": {
          "$ref": "#/$defs/ExactnessKind"
        },
        "certificate_kind": {
          "$ref": "#/$defs/CertificateKind"
        },
        "certificate_radius": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "additionalProperties": {
                "type": "number"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Certificate Radius"
        },
        "confidence_level": {
          "anyOf": [
            {
              "exclusiveMaximum": 1.0,
              "exclusiveMinimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Confidence Level"
        },
        "scope": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Scope",
          "type": "array"
        },
        "origin_envelope_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Origin Envelope Ids",
          "type": "array"
        },
        "operator_history": {
          "default": [],
          "items": {
            "$ref": "#/$defs/CompositionStep"
          },
          "title": "Operator History",
          "type": "array"
        }
      },
      "required": [
        "native_flavour",
        "composed_flavour",
        "exactness",
        "certificate_kind"
      ],
      "title": "CompositionProvenance",
      "type": "object"
    },
    "CompositionStep": {
      "additionalProperties": false,
      "description": "One explicit transformation applied during uncertainty composition.",
      "properties": {
        "op": {
          "enum": [
            "join",
            "push_forward",
            "pull_back",
            "compress",
            "resample"
          ],
          "title": "Op",
          "type": "string"
        },
        "stage_name": {
          "minLength": 1,
          "title": "Stage Name",
          "type": "string"
        },
        "input_flavours": {
          "items": {
            "$ref": "#/$defs/ComposedFlavour"
          },
          "title": "Input Flavours",
          "type": "array"
        },
        "output_flavour": {
          "$ref": "#/$defs/ComposedFlavour"
        },
        "map_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Map Name"
        },
        "lipschitz_bound": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Lipschitz Bound"
        },
        "bias_bound": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Bias Bound"
        },
        "variance_bound": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Variance Bound"
        },
        "sample_size": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sample Size"
        },
        "replicate_count": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Replicate Count"
        },
        "qmc_method": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Qmc Method"
        },
        "scrambled": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Scrambled"
        },
        "assumptions": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Assumptions",
          "type": "array"
        },
        "notes": {
          "additionalProperties": true,
          "title": "Notes",
          "type": "object"
        }
      },
      "required": [
        "op",
        "stage_name",
        "input_flavours",
        "output_flavour"
      ],
      "title": "CompositionStep",
      "type": "object"
    },
    "DistributionFamily": {
      "description": "Declare the assumed sampling/posterior family behind an interval estimate.",
      "enum": [
        "normal",
        "bootstrap",
        "bayesian",
        "uniform",
        "triangular",
        "unknown"
      ],
      "title": "DistributionFamily",
      "type": "string"
    },
    "ExactnessKind": {
      "description": "Disclose whether an envelope is exact, approximated, or only a constraint hull.",
      "enum": [
        "exact",
        "outer_bound",
        "approximation",
        "constraint_only"
      ],
      "title": "ExactnessKind",
      "type": "string"
    },
    "IntervalSemantics": {
      "description": "Tell governance/reporting whether an interval is statistical or heuristic.",
      "enum": [
        "confidence_interval",
        "credible_interval",
        "deterministic_bounds",
        "heuristic_range"
      ],
      "title": "IntervalSemantics",
      "type": "string"
    },
    "MixtureComponent": {
      "additionalProperties": false,
      "description": "One component of a mixture distribution carrier.",
      "properties": {
        "weight": {
          "exclusiveMinimum": 0.0,
          "title": "Weight",
          "type": "number"
        },
        "family": {
          "$ref": "#/$defs/DistributionFamily"
        },
        "parameters": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Parameters",
          "type": "object"
        }
      },
      "required": [
        "weight",
        "family",
        "parameters"
      ],
      "title": "MixtureComponent",
      "type": "object"
    },
    "MixtureDistributionCarrier": {
      "additionalProperties": false,
      "description": "Carry a finite mixture approximation of the posterior distribution.",
      "properties": {
        "carrier_type": {
          "const": "mixture_distribution",
          "default": "mixture_distribution",
          "title": "Carrier Type",
          "type": "string"
        },
        "components": {
          "items": {
            "$ref": "#/$defs/MixtureComponent"
          },
          "title": "Components",
          "type": "array"
        }
      },
      "required": [
        "components"
      ],
      "title": "MixtureDistributionCarrier",
      "type": "object"
    },
    "NumericPolicySpec": {
      "additionalProperties": false,
      "description": "Explicit numeric policy for envelope canonicalization.",
      "properties": {
        "policy_id": {
          "default": "bounded_float_v1",
          "title": "Policy Id",
          "type": "string"
        },
        "mode": {
          "$ref": "#/$defs/NumericToleranceMode",
          "default": "float_round_12"
        },
        "decimal_places": {
          "default": 12,
          "maximum": 15,
          "minimum": 0,
          "title": "Decimal Places",
          "type": "integer"
        },
        "absolute_tolerance": {
          "default": 1e-12,
          "minimum": 0.0,
          "title": "Absolute Tolerance",
          "type": "number"
        }
      },
      "title": "NumericPolicySpec",
      "type": "object"
    },
    "NumericToleranceMode": {
      "description": "How float payloads are canonicalized before persistence and composition.",
      "enum": [
        "decimal_exact",
        "float_round_12",
        "hybrid"
      ],
      "title": "NumericToleranceMode",
      "type": "string"
    },
    "ParametricFitCarrier": {
      "additionalProperties": false,
      "description": "Carry the parameters of a parametric fit used to derive the interval.",
      "properties": {
        "carrier_type": {
          "const": "parametric_fit",
          "default": "parametric_fit",
          "title": "Carrier Type",
          "type": "string"
        },
        "family": {
          "$ref": "#/$defs/DistributionFamily"
        },
        "parameters": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Parameters",
          "type": "object"
        },
        "support": {
          "anyOf": [
            {
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Support"
        }
      },
      "required": [
        "family",
        "parameters"
      ],
      "title": "ParametricFitCarrier",
      "type": "object"
    },
    "PosteriorSamplesCarrier": {
      "additionalProperties": false,
      "description": "Carry posterior/bootstrap draws when an interval alone is not expressive enough.",
      "properties": {
        "carrier_type": {
          "const": "posterior_samples",
          "default": "posterior_samples",
          "title": "Carrier Type",
          "type": "string"
        },
        "samples": {
          "items": {
            "type": "number"
          },
          "title": "Samples",
          "type": "array"
        },
        "sample_axis": {
          "default": "draw",
          "title": "Sample Axis",
          "type": "string"
        },
        "weights": {
          "anyOf": [
            {
              "items": {
                "type": "number"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Weights"
        }
      },
      "required": [
        "samples"
      ],
      "title": "PosteriorSamplesCarrier",
      "type": "object"
    },
    "PropagationMethod": {
      "description": "Declare how uncertainty was propagated before the interval reached the IR.",
      "enum": [
        "delta_method",
        "monte_carlo",
        "analytical",
        "none"
      ],
      "title": "PropagationMethod",
      "type": "string"
    },
    "QuantileSummaryCarrier": {
      "additionalProperties": false,
      "description": "Carry quantile summaries for calibrated posteriors.",
      "properties": {
        "carrier_type": {
          "const": "quantile_summary",
          "default": "quantile_summary",
          "title": "Carrier Type",
          "type": "string"
        },
        "quantiles": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Quantiles",
          "type": "object"
        }
      },
      "required": [
        "quantiles"
      ],
      "title": "QuantileSummaryCarrier",
      "type": "object"
    },
    "UncertaintySource": {
      "description": "Origin of the uncertainty interval carried in the IR.",
      "enum": [
        "calibration",
        "trust",
        "conflict_resolution",
        "causal",
        "bootstrap",
        "ensemble",
        "manual"
      ],
      "title": "UncertaintySource",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Unified uncertainty contract for Policy OS IR layer.",
  "properties": {
    "schema_version": {
      "default": "1.1",
      "pattern": "^\\d+\\.\\d+$",
      "title": "Schema Version",
      "type": "string"
    },
    "numeric_policy": {
      "$ref": "#/$defs/NumericPolicySpec"
    },
    "point_estimate": {
      "title": "Point Estimate",
      "type": "number"
    },
    "confidence_interval": {
      "maxItems": 2,
      "minItems": 2,
      "prefixItems": [
        {
          "type": "number"
        },
        {
          "type": "number"
        }
      ],
      "title": "Confidence Interval",
      "type": "array"
    },
    "confidence_level": {
      "anyOf": [
        {
          "exclusiveMaximum": 1.0,
          "exclusiveMinimum": 0.0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": 0.95,
      "title": "Confidence Level"
    },
    "distribution_family": {
      "$ref": "#/$defs/DistributionFamily",
      "default": "unknown"
    },
    "source": {
      "$ref": "#/$defs/UncertaintySource"
    },
    "propagation_method": {
      "$ref": "#/$defs/PropagationMethod",
      "default": "none"
    },
    "interval_semantics": {
      "$ref": "#/$defs/IntervalSemantics",
      "default": "confidence_interval"
    },
    "distribution_payload": {
      "anyOf": [
        {
          "discriminator": {
            "mapping": {
              "mixture_distribution": "#/$defs/MixtureDistributionCarrier",
              "parametric_fit": "#/$defs/ParametricFitCarrier",
              "posterior_samples": "#/$defs/PosteriorSamplesCarrier",
              "quantile_summary": "#/$defs/QuantileSummaryCarrier"
            },
            "propertyName": "carrier_type"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/PosteriorSamplesCarrier"
            },
            {
              "$ref": "#/$defs/QuantileSummaryCarrier"
            },
            {
              "$ref": "#/$defs/ParametricFitCarrier"
            },
            {
              "$ref": "#/$defs/MixtureDistributionCarrier"
            }
          ]
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Distribution Payload"
    },
    "composition_provenance": {
      "anyOf": [
        {
          "$ref": "#/$defs/CompositionProvenance"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "sample_size": {
      "anyOf": [
        {
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Sample Size"
    },
    "is_heuristic_ci": {
      "default": false,
      "title": "Is Heuristic Ci",
      "type": "boolean"
    },
    "gate_eligible": {
      "default": true,
      "title": "Gate Eligible",
      "type": "boolean"
    },
    "metadata": {
      "additionalProperties": true,
      "title": "Metadata",
      "type": "object"
    }
  },
  "required": [
    "point_estimate",
    "confidence_interval",
    "source"
  ],
  "title": "UncertaintyEnvelope",
  "type": "object"
}
