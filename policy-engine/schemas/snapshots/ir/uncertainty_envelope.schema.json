{
  "$defs": {
    "DistributionFamily": {
      "description": "Declare the assumed sampling/posterior family behind an interval estimate.",
      "enum": [
        "normal",
        "bootstrap",
        "bayesian",
        "uniform",
        "triangular",
        "unknown"
      ],
      "title": "DistributionFamily",
      "type": "string"
    },
    "IntervalSemantics": {
      "description": "Tell governance/reporting whether an interval is statistical or heuristic.",
      "enum": [
        "confidence_interval",
        "credible_interval",
        "deterministic_bounds",
        "heuristic_range"
      ],
      "title": "IntervalSemantics",
      "type": "string"
    },
    "MixtureComponent": {
      "additionalProperties": false,
      "description": "One component of a mixture distribution carrier.",
      "properties": {
        "family": {
          "$ref": "#/$defs/DistributionFamily"
        },
        "parameters": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Parameters",
          "type": "object"
        },
        "weight": {
          "exclusiveMinimum": 0.0,
          "title": "Weight",
          "type": "number"
        }
      },
      "required": [
        "weight",
        "family",
        "parameters"
      ],
      "title": "MixtureComponent",
      "type": "object"
    },
    "MixtureDistributionCarrier": {
      "additionalProperties": false,
      "description": "Carry a finite mixture approximation of the posterior distribution.",
      "properties": {
        "carrier_type": {
          "const": "mixture_distribution",
          "default": "mixture_distribution",
          "title": "Carrier Type",
          "type": "string"
        },
        "components": {
          "items": {
            "$ref": "#/$defs/MixtureComponent"
          },
          "title": "Components",
          "type": "array"
        }
      },
      "required": [
        "components"
      ],
      "title": "MixtureDistributionCarrier",
      "type": "object"
    },
    "NumericPolicySpec": {
      "additionalProperties": false,
      "description": "Explicit numeric policy for envelope canonicalization.",
      "properties": {
        "absolute_tolerance": {
          "default": 1e-12,
          "minimum": 0.0,
          "title": "Absolute Tolerance",
          "type": "number"
        },
        "decimal_places": {
          "default": 12,
          "maximum": 15,
          "minimum": 0,
          "title": "Decimal Places",
          "type": "integer"
        },
        "mode": {
          "$ref": "#/$defs/NumericToleranceMode",
          "default": "float_round_12"
        },
        "policy_id": {
          "default": "bounded_float_v1",
          "title": "Policy Id",
          "type": "string"
        }
      },
      "title": "NumericPolicySpec",
      "type": "object"
    },
    "NumericToleranceMode": {
      "description": "How float payloads are canonicalized before persistence and composition.",
      "enum": [
        "decimal_exact",
        "float_round_12",
        "hybrid"
      ],
      "title": "NumericToleranceMode",
      "type": "string"
    },
    "ParametricFitCarrier": {
      "additionalProperties": false,
      "description": "Carry the parameters of a parametric fit used to derive the interval.",
      "properties": {
        "carrier_type": {
          "const": "parametric_fit",
          "default": "parametric_fit",
          "title": "Carrier Type",
          "type": "string"
        },
        "family": {
          "$ref": "#/$defs/DistributionFamily"
        },
        "parameters": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Parameters",
          "type": "object"
        },
        "support": {
          "anyOf": [
            {
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Support"
        }
      },
      "required": [
        "family",
        "parameters"
      ],
      "title": "ParametricFitCarrier",
      "type": "object"
    },
    "PosteriorSamplesCarrier": {
      "additionalProperties": false,
      "description": "Carry posterior/bootstrap draws when an interval alone is not expressive enough.",
      "properties": {
        "carrier_type": {
          "const": "posterior_samples",
          "default": "posterior_samples",
          "title": "Carrier Type",
          "type": "string"
        },
        "sample_axis": {
          "default": "draw",
          "title": "Sample Axis",
          "type": "string"
        },
        "samples": {
          "items": {
            "type": "number"
          },
          "title": "Samples",
          "type": "array"
        },
        "weights": {
          "anyOf": [
            {
              "items": {
                "type": "number"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Weights"
        }
      },
      "required": [
        "samples"
      ],
      "title": "PosteriorSamplesCarrier",
      "type": "object"
    },
    "PropagationMethod": {
      "description": "Declare how uncertainty was propagated before the interval reached the IR.",
      "enum": [
        "delta_method",
        "monte_carlo",
        "analytical",
        "none"
      ],
      "title": "PropagationMethod",
      "type": "string"
    },
    "QuantileSummaryCarrier": {
      "additionalProperties": false,
      "description": "Carry quantile summaries for calibrated posteriors.",
      "properties": {
        "carrier_type": {
          "const": "quantile_summary",
          "default": "quantile_summary",
          "title": "Carrier Type",
          "type": "string"
        },
        "quantiles": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Quantiles",
          "type": "object"
        }
      },
      "required": [
        "quantiles"
      ],
      "title": "QuantileSummaryCarrier",
      "type": "object"
    },
    "UncertaintySource": {
      "description": "Origin of the uncertainty interval carried in the IR.",
      "enum": [
        "calibration",
        "trust",
        "conflict_resolution",
        "causal",
        "bootstrap",
        "ensemble",
        "manual"
      ],
      "title": "UncertaintySource",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Unified uncertainty contract for Policy OS IR layer.",
  "properties": {
    "confidence_interval": {
      "maxItems": 2,
      "minItems": 2,
      "prefixItems": [
        {
          "type": "number"
        },
        {
          "type": "number"
        }
      ],
      "title": "Confidence Interval",
      "type": "array"
    },
    "confidence_level": {
      "anyOf": [
        {
          "exclusiveMaximum": 1.0,
          "exclusiveMinimum": 0.0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": 0.95,
      "title": "Confidence Level"
    },
    "distribution_family": {
      "$ref": "#/$defs/DistributionFamily",
      "default": "unknown"
    },
    "distribution_payload": {
      "anyOf": [
        {
          "discriminator": {
            "mapping": {
              "mixture_distribution": "#/$defs/MixtureDistributionCarrier",
              "parametric_fit": "#/$defs/ParametricFitCarrier",
              "posterior_samples": "#/$defs/PosteriorSamplesCarrier",
              "quantile_summary": "#/$defs/QuantileSummaryCarrier"
            },
            "propertyName": "carrier_type"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/PosteriorSamplesCarrier"
            },
            {
              "$ref": "#/$defs/QuantileSummaryCarrier"
            },
            {
              "$ref": "#/$defs/ParametricFitCarrier"
            },
            {
              "$ref": "#/$defs/MixtureDistributionCarrier"
            }
          ]
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Distribution Payload"
    },
    "gate_eligible": {
      "default": true,
      "title": "Gate Eligible",
      "type": "boolean"
    },
    "interval_semantics": {
      "$ref": "#/$defs/IntervalSemantics",
      "default": "confidence_interval"
    },
    "is_heuristic_ci": {
      "default": false,
      "title": "Is Heuristic Ci",
      "type": "boolean"
    },
    "metadata": {
      "additionalProperties": true,
      "title": "Metadata",
      "type": "object"
    },
    "numeric_policy": {
      "$ref": "#/$defs/NumericPolicySpec"
    },
    "point_estimate": {
      "title": "Point Estimate",
      "type": "number"
    },
    "propagation_method": {
      "$ref": "#/$defs/PropagationMethod",
      "default": "none"
    },
    "sample_size": {
      "anyOf": [
        {
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Sample Size"
    },
    "schema_version": {
      "default": "1.0",
      "pattern": "^\\d+\\.\\d+$",
      "title": "Schema Version",
      "type": "string"
    },
    "source": {
      "$ref": "#/$defs/UncertaintySource"
    }
  },
  "required": [
    "point_estimate",
    "confidence_interval",
    "source"
  ],
  "title": "UncertaintyEnvelope",
  "type": "object"
}
