{
  "$defs": {
    "ArtifactID": {
      "description": "Represent a normalized CAS identifier in `sha256:<64hex>` form.\n\nThe `sha256:` prefix and lowercase 64-hex digest are part of the stable ABI\nused in manifests, runtime URLs, CLI arguments, and signature statements.",
      "maxLength": 71,
      "minLength": 71,
      "pattern": "^sha256:[0-9A-Fa-f]{64}$",
      "title": "ArtifactID",
      "type": "string"
    },
    "ArtifactRef": {
      "additionalProperties": false,
      "description": "Reference an artifact across service, registry, and governance boundaries.",
      "properties": {
        "artifact_id": {
          "$ref": "#/$defs/ArtifactID"
        },
        "kind": {
          "title": "Kind",
          "type": "string"
        },
        "manifest_profile_sha256": {
          "anyOf": [
            {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Manifest Profile Sha256"
        },
        "media_type": {
          "title": "Media Type",
          "type": "string"
        }
      },
      "required": [
        "artifact_id",
        "kind",
        "media_type"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "RetainedSKGSnapshotChunk": {
      "additionalProperties": false,
      "description": "Current public chunk type; v1.0 keeps the original private schema name.",
      "properties": {
        "byte_size": {
          "exclusiveMinimum": 0,
          "maximum": 1048576,
          "title": "Byte Size",
          "type": "integer"
        },
        "ref": {
          "$ref": "#/$defs/ArtifactRef"
        }
      },
      "required": [
        "ref",
        "byte_size"
      ],
      "title": "RetainedSKGSnapshotChunk",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Current descriptor with local content identity and observed source version.",
  "properties": {
    "byte_size": {
      "exclusiveMinimum": 0,
      "title": "Byte Size",
      "type": "integer"
    },
    "chunks": {
      "items": {
        "$ref": "#/$defs/RetainedSKGSnapshotChunk"
      },
      "minItems": 1,
      "title": "Chunks",
      "type": "array"
    },
    "query_version": {
      "minLength": 1,
      "title": "Query Version",
      "type": "string"
    },
    "schema_version": {
      "const": "1.1",
      "title": "Schema Version",
      "type": "string"
    },
    "source_binding_schema_version": {
      "minLength": 1,
      "title": "Source Binding Schema Version",
      "type": "string"
    },
    "source_reference": {
      "minLength": 1,
      "title": "Source Reference",
      "type": "string"
    },
    "source_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Source Sha256",
      "type": "string"
    },
    "source_version_id": {
      "exclusiveMinimum": 0,
      "title": "Source Version Id",
      "type": "integer"
    },
    "version_identity_kind": {
      "const": "content_digest",
      "title": "Version Identity Kind",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "source_reference",
    "source_sha256",
    "byte_size",
    "source_binding_schema_version",
    "query_version",
    "chunks",
    "source_version_id",
    "version_identity_kind"
  ],
  "title": "RetainedSKGSnapshotV11",
  "type": "object"
}
