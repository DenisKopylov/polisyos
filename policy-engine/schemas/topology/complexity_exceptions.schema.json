{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "polisyos://schemas/topology/complexity_exceptions.schema.json",
  "title": "Complexity Exceptions Registry",
  "type": "object",
  "required": ["complexity_exceptions", "exception"],
  "properties": {
    "complexity_exceptions": {
      "type": "object",
      "required": ["version", "default_max_module_lines", "default_max_complexity"],
      "properties": {
        "version": {"type": "integer"},
        "status": {"type": "string"},
        "default_max_module_lines": {"type": "integer", "minimum": 1},
        "default_max_complexity": {"type": "integer", "minimum": 1},
        "description": {"type": "string"}
      }
    },
    "exception": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "reason", "owner", "sunset_phase"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "reason": {"type": "string", "minLength": 1},
          "lines": {"type": "integer", "minimum": 1},
          "owner": {"type": "string", "minLength": 1},
          "sunset_phase": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
