{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "polisyos://schemas/topology/generated_artifacts.schema.json",
  "title": "Generated Artifacts Registry",
  "type": "object",
  "required": ["generated_artifacts", "family"],
  "properties": {
    "generated_artifacts": {
      "type": "object",
      "required": ["version"],
      "properties": {
        "version": {"type": "integer"}
      }
    },
    "family": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "owner", "source_of_truth", "outputs", "regenerate_commands", "commit_policy"],
        "properties": {
          "id": {"type": "string"},
          "owner": {"type": "string"},
          "source_of_truth": {"type": "string"},
          "outputs": {"type": "array", "items": {"type": "string"}},
          "regenerate_commands": {"type": "array", "items": {"type": "string"}},
          "commit_policy": {"type": "string"},
          "freshness_rule": {"type": "string"},
          "drift_gate": {"type": "string"}
        }
      }
    }
  }
}
