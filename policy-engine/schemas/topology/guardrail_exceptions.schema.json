{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "polisyos://schemas/topology/guardrail_exceptions.schema.json",
  "title": "Architecture Guardrail Exceptions Registry",
  "type": "object",
  "required": ["guardrail_exceptions"],
  "properties": {
    "guardrail_exceptions": {
      "type": "object",
      "required": ["version", "status", "owner"],
      "properties": {
        "version": {"type": "integer", "minimum": 1},
        "status": {"type": "string", "minLength": 1},
        "owner": {"type": "string", "minLength": 1},
        "description": {"type": "string"}
      }
    },
    "exception": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "check", "owner", "reason", "expires"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "check": {
            "enum": [
              "deep_import",
              "generated_artifact",
              "public_surface",
              "readme_policy",
              "workflow_config"
            ]
          },
          "owner": {"type": "string", "minLength": 1},
          "reason": {"type": "string", "minLength": 1},
          "expires": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "subject_glob": {"type": "string"},
          "detail_glob": {"type": "string"},
          "source_module_glob": {"type": "string"},
          "target_module_glob": {"type": "string"}
        }
      }
    }
  }
}
