#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"

printf '%s\n' 'DEPRECATED: `scripts/core-runtime-closeout` is a compatibility wrapper; use `polisyos-tools workspace core-runtime-closeout` instead.' >&2
exec python3 -m tools.cli workspace core-runtime-closeout "$@"
