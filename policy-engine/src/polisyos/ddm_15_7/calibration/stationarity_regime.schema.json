{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://polisyos.local/schemas/ddm_15_7/stationarity_regime.schema.json",
  "title": "DDM-15.7 StationarityRegime",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "model_id",
    "model_version",
    "reference_period",
    "calibration_period",
    "holdout_stationary_period",
    "seasonality_strata",
    "allowed_dependency_model",
    "block_length",
    "label_delay_model",
    "invalidation_triggers"
  ],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "model_id": { "type": "string", "minLength": 1 },
    "model_version": { "type": "string", "minLength": 1 },
    "reference_period": { "$ref": "#/$defs/period" },
    "calibration_period": { "$ref": "#/$defs/period" },
    "holdout_stationary_period": { "$ref": "#/$defs/period" },
    "seasonality_strata": { "type": "array", "items": { "type": "string" } },
    "allowed_dependency_model": { "const": "moving_block_bootstrap" },
    "block_length": { "type": "integer", "minimum": 1 },
    "label_delay_model": { "type": "string", "minLength": 1 },
    "invalidation_triggers": { "type": "array", "items": { "type": "string" } }
  },
  "$defs": {
    "period": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end"],
      "properties": {
        "start": { "type": "string", "format": "date-time" },
        "end": { "type": "string", "format": "date-time" }
      }
    }
  }
}
