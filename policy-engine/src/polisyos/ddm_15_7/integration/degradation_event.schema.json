{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://polisyos.local/schemas/ddm_15_7/degradation_event.schema.json",
  "title": "DDM-15.7 PerformanceDegradationEvent.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_type",
    "event_id",
    "timestamp",
    "model_id",
    "model_version",
    "metric",
    "metric_direction",
    "source",
    "estimator",
    "reference_value",
    "current_estimate",
    "confidence_interval_95",
    "budget_used"
  ],
  "properties": {
    "event_type": { "const": "ml.problem_15_7.degradation.v1" },
    "event_id": { "type": "string", "minLength": 1 },
    "timestamp": { "type": "string", "format": "date-time" },
    "model_id": { "type": "string", "minLength": 1 },
    "model_version": { "type": "string", "minLength": 1 },
    "metric": { "type": "string", "minLength": 1 },
    "metric_direction": { "enum": ["higher_is_better", "lower_is_better"] },
    "source": { "enum": ["estimated_performance", "realized_performance"] },
    "estimator": { "type": "string", "minLength": 1 },
    "reference_value": { "type": "number" },
    "minimum_acceptable_value": { "type": ["number", "null"] },
    "maximum_acceptable_value": { "type": ["number", "null"] },
    "current_estimate": { "type": "number" },
    "confidence_interval_95": {
      "type": "array",
      "prefixItems": [{ "type": "number" }, { "type": "number" }],
      "minItems": 2,
      "maxItems": 2
    },
    "budget_used": { "type": "number", "minimum": 0, "maximum": 1 },
    "label_delay_days_p50": { "type": ["number", "null"], "minimum": 0 },
    "label_delay_days_p90": { "type": ["number", "null"], "minimum": 0 },
    "corroborating_shift_event_ids": {
      "type": "array",
      "items": { "type": "string" },
      "default": []
    },
    "readiness_state": { "enum": ["R4", "R3", "R2", "R1", "R0", null] },
    "recommended_action": { "type": ["string", "null"] },
    "calibration_id": { "type": ["string", "null"] }
  }
}
