{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://polisyos.local/schemas/ddm_15_7/incident_payload.schema.json",
  "title": "DDM-15.7 IncidentPayload.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_type",
    "event_id",
    "timestamp",
    "model_id",
    "model_version",
    "readiness_event_id",
    "readiness_state",
    "severity",
    "required_actions",
    "attach_event_ids",
    "create_ticket",
    "notify_owner",
    "page_owner",
    "trigger_shadow_retrain",
    "freeze_rollout",
    "rollback_or_fallback"
  ],
  "properties": {
    "event_type": { "const": "ml.problem_15_7.incident_payload.v1" },
    "event_id": { "type": "string", "minLength": 1 },
    "timestamp": { "type": "string", "format": "date-time" },
    "model_id": { "type": "string", "minLength": 1 },
    "model_version": { "type": "string", "minLength": 1 },
    "readiness_event_id": { "type": "string", "minLength": 1 },
    "readiness_state": { "enum": ["R4", "R3", "R2", "R1", "R0"] },
    "severity": { "enum": ["none", "watch", "investigate", "retrain", "rollback"] },
    "root_cause_bundle_id": { "type": ["string", "null"] },
    "required_actions": { "type": "array", "items": { "type": "string" } },
    "attach_event_ids": { "type": "array", "items": { "type": "string" } },
    "create_ticket": { "type": "boolean" },
    "notify_owner": { "type": "boolean" },
    "page_owner": { "type": "boolean" },
    "trigger_shadow_retrain": { "type": "boolean" },
    "freeze_rollout": { "type": "boolean" },
    "rollback_or_fallback": { "type": "boolean" }
  }
}
