import threading
from collections import deque
from collections.abc import Callable, Generator, Iterator, Mapping
from contextlib import contextmanager
from dataclasses import dataclass, field
from os import PathLike
from typing import Any

from _typeshed import Incomplete

from polisyos.core.registry import BaseRegistry
from polisyos.foundry.methods.base import FoundryMethod, MethodMetadata, MethodSignature
from polisyos.foundry.methods.lifecycle import LifecycleLog
from polisyos.foundry.methods.lifecycle import MethodLifecycle as MethodLifecycle
from polisyos.foundry.methods.selection.resolution import ResolutionPolicy, VersionConstraint

__all__ = [
    "MethodEntry",
    "MethodLifecycle",
    "MethodRegistry",
    "RegistryAuditEvent",
    "RegistryAuditLog",
    "RegistrySnapshot",
    "RegistrySnapshotEntry",
    "get_registry",
    "get_registry_audit_log",
    "registry_scope",
]

@dataclass(slots=True)
class RegistryAuditEvent:
    event: str
    fqn: str
    timestamp: float
    caller: str
    details: dict[str, Any]

class RegistryAuditLog:
    DEFAULT_MAX_EVENTS: int
    _events: deque[RegistryAuditEvent]
    _lock: Incomplete
    _max_events: Incomplete

    def __init__(self, *, max_events: int = ...) -> None: ...
    def record(self, event: str, fqn: str, caller: str = "", **details: object) -> None: ...
    def get_history(self, fqn: str | None = None) -> list[RegistryAuditEvent]: ...
    def clear(self) -> None: ...
    def export_jsonl(self, path: str | PathLike[str]) -> None: ...
    def __len__(self) -> int: ...
    @property
    def max_events(self) -> int: ...

def get_registry_audit_log() -> RegistryAuditLog: ...

MethodFactory = Callable[[], type[FoundryMethod[Any, Any]]]

@dataclass(slots=True)
class MethodEntry:
    signature: MethodSignature
    metadata: MethodMetadata
    factory: MethodFactory
    loaded: bool = ...
    _cached_class: type[FoundryMethod[Any, Any]] | None = field(default=None, repr=False)
    import_module: str | None = ...
    import_qualname: str | None = ...
    lifecycle_log: LifecycleLog = field(default_factory=LifecycleLog, repr=False)
    load_lock: threading.Lock = field(default_factory=threading.Lock, repr=False, compare=False)

    @property
    def fqn(self) -> str: ...
    @property
    def persistable_import_target(self) -> tuple[str, str] | None: ...

@dataclass(frozen=True, slots=True)
class RegistrySnapshotEntry:
    signature: MethodSignature
    metadata: MethodMetadata
    loaded: bool
    import_module: str | None = ...
    import_qualname: str | None = ...

    @property
    def fqn(self) -> str: ...
    @property
    def persistable_import_target(self) -> tuple[str, str] | None: ...
    @classmethod
    def from_entry(cls, entry: MethodEntry) -> RegistrySnapshotEntry: ...

class _MethodEntryStore(BaseRegistry[str, MethodEntry]):
    def __init__(self) -> None: ...
    def duplicate_error(
        self, *, key: str, existing: MethodEntry, incoming: MethodEntry
    ) -> Exception: ...

class RegistrySnapshot:
    __slots__: Incomplete
    _methods: Incomplete
    _timestamp: Incomplete

    def __init__(self, methods: Mapping[str, RegistrySnapshotEntry], timestamp: float) -> None: ...
    @property
    def timestamp(self) -> float: ...
    def __len__(self) -> int: ...
    def __iter__(self) -> Iterator[str]: ...
    def signatures(self) -> Iterator[MethodSignature]: ...
    def entries(self) -> Iterator[RegistrySnapshotEntry]: ...

class MethodRegistry:
    _instance: MethodRegistry | None
    _instance_lock: threading.Lock

    def __new__(cls) -> MethodRegistry: ...
    _entries: Incomplete
    _default_policy: ResolutionPolicy
    _reg_lock: Incomplete
    _registration_count: int
    _last_modified: Incomplete

    def _initialize(self) -> None: ...
    @classmethod
    def get_instance(cls) -> MethodRegistry: ...
    @classmethod
    def reset_instance(cls) -> None: ...
    @classmethod
    def _create_fresh(cls) -> MethodRegistry: ...
    def set_default_policy(self, policy: ResolutionPolicy) -> None: ...
    def get_default_policy(self) -> ResolutionPolicy: ...
    def register(
        self, method_class: type[FoundryMethod[Any, Any]], *, override: bool = False
    ) -> str: ...
    def register_lazy(
        self,
        signature: MethodSignature,
        metadata: MethodMetadata,
        factory: MethodFactory,
        *,
        override: bool = False,
        import_target: tuple[str, str] | str | None = None,
    ) -> str: ...
    def unregister(self, fqn: str) -> bool: ...
    def _sort_versions(self, versions: list[str]) -> list[str]: ...
    def _available_versions(self, base_name: str) -> list[str]: ...
    def _touch_modified(self) -> None: ...
    def get(
        self,
        name: str,
        version: str | None = None,
        *,
        policy: ResolutionPolicy | None = None,
        constraint: VersionConstraint | None = None,
    ) -> type[FoundryMethod[Any, Any]]: ...
    def get_entry(self, fqn: str) -> MethodEntry | None: ...
    def get_signature(self, fqn: str) -> MethodSignature | None: ...
    def _resolve_base_name(self, name: str) -> str: ...
    def _load_entry(self, entry: MethodEntry) -> type[FoundryMethod[Any, Any]]: ...
    def query(
        self,
        *,
        namespace: str | None = None,
        tags: set[str] | None = None,
        input_slots: set[str] | None = None,
        output_slots: set[str] | None = None,
        name_pattern: str | None = None,
    ) -> Iterator[MethodSignature]: ...
    def find_by_output_slot(self, slot_name: str) -> Iterator[MethodSignature]: ...
    def find_by_input_slot(self, slot_name: str) -> Iterator[MethodSignature]: ...
    def find_connectable(self, source_fqn: str) -> Iterator[MethodSignature]: ...
    def list_all(self) -> list[MethodSignature]: ...
    def list_versions(self, base_name: str) -> list[str]: ...
    def list_namespaces(self) -> list[str]: ...
    def list_tags(self) -> list[str]: ...
    def snapshot(self) -> RegistrySnapshot: ...
    @contextmanager
    def snapshot_scope(self) -> Generator[RegistrySnapshot]: ...
    def __len__(self) -> int: ...
    def __contains__(self, fqn: str) -> bool: ...
    def __iter__(self) -> Iterator[str]: ...
    def stats(self) -> dict[str, Any]: ...
    def __repr__(self) -> str: ...

@contextmanager
def registry_scope() -> Generator[MethodRegistry]: ...
def get_registry() -> MethodRegistry: ...
